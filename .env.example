# Zone d'administration (/admin) — voir README.md pour les instructions.

# Obligatoire : mot de passe de connexion à l'administration.
ADMIN_PASSWORD=

# Obligatoire en production (Vercel) : jeton d'accès personnel GitHub avec la
# permission "Contents: Read and write" sur ce dépôt. Permet à l'admin de
# publier ses modifications par un commit direct sur main.
# Non nécessaire en local : les enregistrements écrivent alors sur le disque
# et créent un commit git local.
GITHUB_TOKEN=

# Optionnel — valeurs par défaut déjà correctes pour ce dépôt.
# GITHUB_OWNER=ChristopheDesmur
# GITHUB_REPO=ateliersdecalligraphie
# GITHUB_BRANCH=main

# Optionnel — API Vercel Web Analytics pour la page /admin/analytics
# Jeton d'accès personnel Vercel (https://vercel.com/account/tokens)
# VERCEL_TOKEN=
# Identifiant ou nom du projet Vercel (défaut : ateliersdecalligraphie)
# VERCEL_PROJECT_ID=ateliersdecalligraphie
# Identifiant de l'équipe Vercel (si applicable)
# VERCEL_TEAM_ID=
