---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import InfoBox from "@/components/info-box.astro";

import "../styles/global.css";
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title?: string;
  description?: string;
  showSidebar?: boolean;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, showSidebar = false, ogImage, noindex = false } = Astro.props;

// src/data/contact.ts lit contact.yaml via fs au chargement du module — cela
// fonctionne au build (pages statiques) mais casse à l'exécution sur les
// pages rendues à la demande (ex. /admin), où le répertoire courant du
// serverless Vercel n'est pas la racine du dépôt (ENOENT). Un import
// statique en tête de fichier s'exécuterait pour TOUTES les pages qui
// utilisent ce layout, y compris les pages noindex (admin) qui n'affichent
// jamais le bloc JSON-LD ci-dessous : on ne l'importe donc que si on va
// réellement l'utiliser, ce qui n'arrive qu'au build pour les pages
// publiques statiques.
let contactJsonLd: { telephone: string[]; email: string } | null = null;
if (!noindex) {
  const { contact, telHref } = await import("@/data/contact");
  contactJsonLd = { telephone: [telHref(contact.mobile), telHref(contact.landline)], email: contact.email };
}
const metaDescription = description ?? "Cours de calligraphie chinoise à Lyon avec Christophe Desmur. Ateliers collectifs au Dojo Zen et Miroirs du Ciel, cours particuliers et interventions en écoles et entreprises.";

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const resolvedImageWithDomain = new URL(ogImage || "/assets/opengraph.webp", Astro.site).toString();

const siteSuffix = "Calligraphie chinoise Lyon";
const isAdmin = Astro.url.pathname.startsWith('/admin');

let hasAdminSession = false;
if (isAdmin) {
  const { authenticateRequest } = await import("@/lib/admin/auth");
  hasAdminSession = Boolean(authenticateRequest(Astro.request).session);
}

const makeTitle = !title
  ? (isAdmin ? "Administration · Ateliers de calligraphie" : "Calligraphie chinoise Lyon — Christophe Desmur")
  : isAdmin
    ? (title.includes("Ateliers de calligraphie") ? title : `${title} · Ateliers de calligraphie`)
    : (title.includes(siteSuffix) || title.includes("Lyon") ? title : `${title} | ${siteSuffix}`);
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <SEO
      title={makeTitle}
      description={metaDescription}
      canonical={canonicalURL}
      noindex={noindex}
      nofollow={noindex}
      twitter={{
        card: "summary_large_image",
        title: makeTitle,
        description: metaDescription,
        image: resolvedImageWithDomain,
        imageAlt: makeTitle,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: makeTitle,
        },
        optional: {
          description: metaDescription,
          siteName: "Calligraphie chinoise Lyon — Christophe Desmur",
          locale: "fr_FR",
        },
      }}
    />
    <Analytics />
    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": ["LocalBusiness", "EducationalOrganization"],
        "name": "Christophe Desmur — Calligraphie chinoise Lyon",
        "alternateName": "Ateliers de calligraphie chinoise à Lyon",
        "description": "Cours hebdomadaires de calligraphie chinoise, cours particuliers et ateliers sur mesure à Lyon avec Christophe Desmur. Pratique au pinceau, encre de Chine et philosophie.",
        "url": "https://ateliersdecalligraphie.com",
        "telephone": contactJsonLd!.telephone,
        "email": contactJsonLd!.email,
        "image": "https://ateliersdecalligraphie.com/assets/opengraph.webp",
        "priceRange": "€€",
        "founder": {
          "@type": "Person",
          "name": "Christophe Desmur",
          "url": "https://ateliersdecalligraphie.com/le-calligraphe"
        },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "11, rue Dumenge",
        "postalCode": "69004",
        "addressLocality": "Lyon",
        "addressRegion": "Auvergne-Rhône-Alpes",
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 45.776853,
        "longitude": 4.831559
      },
      "areaServed": [
        { "@type": "City", "name": "Lyon" },
        { "@type": "AdministrativeArea", "name": "Métropole de Lyon" },
        { "@type": "AdministrativeArea", "name": "Rhône" }
      ],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Monday",
          "opens": "18:30",
          "closes": "20:30"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Wednesday",
          "opens": "10:00",
          "closes": "12:00"
        }
      ],
      "location": [
        {
          "@type": "Place",
          "name": "Dojo zen de Lyon",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "11, rue Dumenge",
            "postalCode": "69004",
            "addressLocality": "Lyon",
            "addressCountry": "FR"
          }
        },
        {
          "@type": "Place",
          "name": "Boutique Miroirs du Ciel",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "9, rue de Belfort",
            "postalCode": "69004",
            "addressLocality": "Lyon",
            "addressCountry": "FR"
          }
        }
      ]
    })} />
    )}
    <slot name="head" />
  </head>
  <body class={isAdmin
    ? "bg-stone-100/70 text-gray-900 dark:bg-[#0c0d12] dark:text-gray-100 min-h-screen flex flex-col font-sans antialiased"
    : "bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100 min-h-screen flex flex-col font-sans antialiased"
  }>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-gray-900 focus:text-white focus:rounded-lg focus:shadow-lg focus:outline-none">
      Aller au contenu principal
    </a>

    {isAdmin ? (
      <header class="sticky top-0 z-40 w-full border-b border-gray-200/90 dark:border-gray-800/90 bg-white/95 dark:bg-gray-900/95 backdrop-blur-md shadow-2xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3 sm:gap-4">
          <!-- Marque & Identité ADMINISTRATION -->
          <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
            <a href="/admin" class="font-serif text-lg sm:text-xl font-bold text-gray-900 dark:text-white tracking-tight hover:text-indigo-600 dark:hover:text-indigo-400 transition truncate focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-md">
              Ateliers de calligraphie
            </a>
            <span class="h-4 w-px bg-gray-300 dark:bg-gray-700 shrink-0" aria-hidden="true"></span>
            <span class="inline-flex items-center text-[10px] sm:text-[11px] font-semibold tracking-widest uppercase text-indigo-700 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/60 px-2 py-0.5 rounded border border-indigo-100 dark:border-indigo-900/50 shrink-0 select-none">
              Administration
            </span>
          </div>

          <!-- Actions secondaires persistantes -->
          <div class="flex items-center gap-2 sm:gap-3 shrink-0">
            <a
              href="/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700/80 border border-gray-200 dark:border-gray-700 shadow-2xs transition focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-500"
              title="Ouvrir le site public dans un nouvel onglet"
            >
              <span>Voir le site public</span>
              <span class="font-mono text-xs text-gray-400 dark:text-gray-500" aria-hidden="true">↗</span>
            </a>

            <button
              type="button"
              id="theme-toggle"
              class="p-1.5 rounded-lg text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-2xs transition cursor-pointer focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-500"
              aria-label="Basculer le mode sombre"
              title="Basculer le mode sombre"
            >
              <svg id="icon-sun" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <svg id="icon-moon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
            </button>

            {hasAdminSession && (
              <button
                id="admin-logout-btn"
                type="button"
                class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-gray-500 hover:text-rose-600 dark:text-gray-400 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition cursor-pointer focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-rose-500"
              >
                Se déconnecter
              </button>
            )}
          </div>
        </div>
      </header>
    ) : (
      <Navbar />
    )}

    {isAdmin ? (
      <main id="main-content" class="flex-1 w-full px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
        <slot />
      </main>
    ) : showSidebar ? (
      <main id="main-content" class="flex-1 mx-auto max-w-[1300px] w-full flex flex-col lg:flex-row gap-8 px-4 sm:px-6 py-8">
        <div class="flex-1 min-w-0">
          <slot />
        </div>
        <aside class="lg:w-80 shrink-0">
          <InfoBox />
        </aside>
      </main>
    ) : (
      <main id="main-content" class="flex-1 mx-auto max-w-[1300px] w-full px-4 sm:px-6 py-8">
        <slot />
      </main>
    )}

    {isAdmin ? (
      <footer class="mt-auto border-t border-gray-200/90 dark:border-gray-800/90 py-4 px-4 sm:px-6 bg-white/40 dark:bg-gray-900/40 backdrop-blur-xs text-xs text-gray-500 dark:text-gray-400">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="font-serif font-semibold text-gray-700 dark:text-gray-300">Ateliers de calligraphie</span>
            <span class="text-gray-300 dark:text-gray-700 select-none" aria-hidden="true">·</span>
            <span class="text-[10px] uppercase tracking-wider font-semibold text-gray-500 dark:text-gray-400">Espace d'administration</span>
          </div>
          <div class="flex items-center gap-4">
            <a href="/" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition flex items-center gap-1">
              <span>Voir le site public</span>
              <span class="font-mono text-xs" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </footer>
    ) : (
      <Footer />
    )}

    <script>
      function syncIcon() {
        const isDark = document.documentElement.classList.contains('dark');
        const sun = document.getElementById('icon-sun');
        const moon = document.getElementById('icon-moon');
        if (sun) sun.classList.toggle('hidden', !isDark);
        if (moon) moon.classList.toggle('hidden', isDark);
      }

      syncIcon();

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        syncIcon();
      });

      document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/admin/auth', { method: 'DELETE' }).catch(() => {});
        window.location.href = '/admin';
      });
    </script>
  </body>
</html>
