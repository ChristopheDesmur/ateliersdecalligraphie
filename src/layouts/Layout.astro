---
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import InfoBox from "@/components/info-box.astro";

import "../styles/global.css";
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  title?: string;
  description?: string;
  showSidebar?: boolean;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, showSidebar = false, ogImage, noindex = false } = Astro.props;

// src/data/contact.ts lit contact.yaml via fs au chargement du module — cela
// fonctionne au build (pages statiques) mais casse à l'exécution sur les
// pages rendues à la demande (ex. /admin), où le répertoire courant du
// serverless Vercel n'est pas la racine du dépôt (ENOENT). Un import
// statique en tête de fichier s'exécuterait pour TOUTES les pages qui
// utilisent ce layout, y compris les pages noindex (admin) qui n'affichent
// jamais le bloc JSON-LD ci-dessous : on ne l'importe donc que si on va
// réellement l'utiliser, ce qui n'arrive qu'au build pour les pages
// publiques statiques.
let contactJsonLd: { telephone: string[]; email: string } | null = null;
if (!noindex) {
  const { contact, telHref } = await import("@/data/contact");
  contactJsonLd = { telephone: [telHref(contact.mobile), telHref(contact.landline)], email: contact.email };
}
const metaDescription = description ?? "Cours de calligraphie chinoise à Lyon avec Christophe Desmur. Ateliers collectifs au Dojo Zen et Miroirs du Ciel, cours particuliers et interventions en écoles et entreprises.";

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const resolvedImageWithDomain = new URL(ogImage || "/assets/opengraph.webp", Astro.site).toString();

const siteSuffix = "Calligraphie chinoise Lyon";
const isAdmin = Astro.url.pathname.startsWith('/admin');

let hasAdminSession = false;
let currentAdminTab = "dashboard";

if (isAdmin) {
  try {
    const { authenticateRequest } = await import("@/lib/admin/auth");
    hasAdminSession = Boolean(authenticateRequest(Astro.request).session);
  } catch {
    hasAdminSession = false;
  }

  const pathname = Astro.url.pathname.replace(/\/$/, "");
  if (pathname === "/admin") currentAdminTab = "dashboard";
  else if (pathname.startsWith("/admin/hero")) currentAdminTab = "hero";
  else if (pathname.startsWith("/admin/pages")) currentAdminTab = "pages";
  else if (pathname.startsWith("/admin/events")) currentAdminTab = "events";
  else if (pathname.startsWith("/admin/venues")) currentAdminTab = "venues";
  else if (pathname.startsWith("/admin/prices")) currentAdminTab = "prices";
  else if (pathname.startsWith("/admin/interventions")) currentAdminTab = "interventions";
  else if (pathname.startsWith("/admin/institutions")) currentAdminTab = "institutions";
  else if (pathname.startsWith("/admin/testimonials")) currentAdminTab = "testimonials";
  else if (pathname.startsWith("/admin/faq")) currentAdminTab = "faq";
  else if (pathname.startsWith("/admin/products")) currentAdminTab = "products";
  else if (pathname.startsWith("/admin/contact")) currentAdminTab = "contact";
}

const adminNavItems = [
  {
    id: "dashboard",
    label: "Tableau de bord",
    href: "/admin",
    svg: `<svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;min-width:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>`,
  },
  {
    id: "hero",
    label: "En-tête",
    href: "/admin/hero",
    group: "Contenu",
    svg: `<svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;min-width:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 7.125C2.25 6.504 2.754 6 3.375 6h6c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125h-6A1.125 1.125 0 0 1 2.25 9.375v-2.25ZM2.25 14.625c0-.621.504-1.125 1.125-1.125h6c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125h-6a1.125 1.125 0 0 1-1.125-1.125v-2.25ZM13.5 7.125c0-.621.504-1.125 1.125-1.125h6c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-6a1.125 1.125 0 0 1-1.125-1.125v-9.75Z" /></svg>`,
  },
  {
    id: "pages",
    label: "Pages",
    href: "/admin/pages",
    group: "Contenu",
    svg: `<svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;min-width:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>`,
  },
  {
    id: "events",
    label: "Cours",
    href: "/admin/events",
    group: "Activités",
    svg: `<svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;min-width:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5" /></svg>`,
  },
  {
    id: "venues",
    label: "Lieux",
    href: "/admin/venues",
    svg: `<svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;min-width:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>`,
  },
  {
    id: "interventions",
    label: "Formats",
    href: "/admin/interventions",
    svg: `<svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;min-width:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>`,
  },
  {
    id: "institutions",
    label: "Organismes",
    href: "/admin/institutions",
    svg: `<svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;min-width:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.5m-15 10.5V10.5M3 21h18M3 10.5h18" /></svg>`,
  },
  {
    id: "prices",
    label: "Tarifs",
    href: "/admin/prices",
    svg: `<svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;min-width:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
  {
    id: "products",
    label: "Galerie",
    href: "/admin/products",
    group: "Vente",
    svg: `<svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;min-width:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" /></svg>`,
  },
  {
    id: "testimonials",
    label: "Témoignages",
    href: "/admin/testimonials",
    group: "Promo",
    svg: `<svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;min-width:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>`,
  },
  {
    id: "faq",
    label: "FAQ",
    href: "/admin/faq",
    svg: `<svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;min-width:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" /></svg>`,
  },
  {
    id: "contact",
    label: "Contact",
    href: "/admin/contact",
    group: "Contact",
    svg: `<svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;min-width:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>`,
  },
];

const makeTitle = !title
  ? (isAdmin ? "Administration · Ateliers de calligraphie" : "Calligraphie chinoise Lyon — Christophe Desmur")
  : isAdmin
    ? (title.includes("Ateliers de calligraphie") ? title : `${title} · Ateliers de calligraphie`)
    : (title.includes(siteSuffix) || title.includes("Lyon") ? title : `${title} | ${siteSuffix}`);
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type={isAdmin ? "image/svg+xml" : "image/webp"} href={isAdmin ? "/admin-logo.svg" : "/favicon.webp"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <SEO
      title={makeTitle}
      description={metaDescription}
      canonical={canonicalURL}
      noindex={noindex}
      nofollow={noindex}
      twitter={{
        card: "summary_large_image",
        title: makeTitle,
        description: metaDescription,
        image: resolvedImageWithDomain,
        imageAlt: makeTitle,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: makeTitle,
        },
        optional: {
          description: metaDescription,
          siteName: "Calligraphie chinoise Lyon — Christophe Desmur",
          locale: "fr_FR",
        },
      }}
    />
    <Analytics />
    <SpeedInsights />
    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": ["LocalBusiness", "EducationalOrganization"],
        "name": "Christophe Desmur — Calligraphie chinoise Lyon",
        "alternateName": "Ateliers de calligraphie chinoise à Lyon",
        "description": "Cours hebdomadaires de calligraphie chinoise, cours particuliers et ateliers sur mesure à Lyon avec Christophe Desmur. Pratique au pinceau, encre de Chine et philosophie.",
        "url": "https://ateliersdecalligraphie.com",
        "telephone": contactJsonLd!.telephone,
        "email": contactJsonLd!.email,
        "image": "https://ateliersdecalligraphie.com/assets/opengraph.webp",
        "priceRange": "€€",
        "founder": {
          "@type": "Person",
          "name": "Christophe Desmur",
          "url": "https://ateliersdecalligraphie.com/le-calligraphe"
        },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "11, rue Dumenge",
        "postalCode": "69004",
        "addressLocality": "Lyon",
        "addressRegion": "Auvergne-Rhône-Alpes",
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 45.776853,
        "longitude": 4.831559
      },
      "areaServed": [
        { "@type": "City", "name": "Lyon" },
        { "@type": "AdministrativeArea", "name": "Métropole de Lyon" },
        { "@type": "AdministrativeArea", "name": "Rhône" }
      ],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Monday",
          "opens": "18:30",
          "closes": "20:30"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Wednesday",
          "opens": "10:00",
          "closes": "12:00"
        }
      ],
      "location": [
        {
          "@type": "Place",
          "name": "Dojo zen de Lyon",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "11, rue Dumenge",
            "postalCode": "69004",
            "addressLocality": "Lyon",
            "addressCountry": "FR"
          }
        },
        {
          "@type": "Place",
          "name": "Boutique Miroirs du Ciel",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "9, rue de Belfort",
            "postalCode": "69004",
            "addressLocality": "Lyon",
            "addressCountry": "FR"
          }
        }
      ]
    })} />
    )}
    <slot name="head" />
    {isAdmin && (
      <style is:inline>
        .admin-shell svg {
          width: 16px;
          height: 16px;
          max-width: 16px;
          max-height: 16px;
          flex-shrink: 0;
        }
        .admin-shell #icon-sun,
        .admin-shell #icon-moon {
          width: 14px !important;
          height: 14px !important;
          max-width: 14px !important;
          max-height: 14px !important;
        }
        @media (min-width: 1024px) {
          #admin-sidebar:not(.collapsed) {
            width: 12rem;
          }
        }
        @media (min-width: 768px) {
          #admin-sidebar.collapsed {
            width: 3.25rem !important;
          }
        }
      </style>
    )}
  </head>
  <body class={isAdmin
    ? "bg-[#f0f0f1] text-gray-900 dark:bg-[#0c0d10] dark:text-gray-100 min-h-screen flex flex-col font-sans antialiased"
    : "bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100 min-h-screen flex flex-col font-sans antialiased"
  }>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-gray-900 focus:text-white focus:rounded-lg focus:shadow-lg focus:outline-none">
      Aller au contenu principal
    </a>

    {isAdmin ? (
      <div class="admin-shell min-h-screen flex flex-col flex-1">
        <header class="sticky top-0 z-40 h-8 w-full bg-[#1d2327] dark:bg-[#101315] text-[#c3c4c7] border-b border-[#2c3338] dark:border-[#1e2327] px-2 sm:px-3 flex items-center justify-between text-xs select-none shadow-2xs">
          <div class="flex items-center gap-1.5 sm:gap-2.5 min-w-0">
            {hasAdminSession && (
              <button
                type="button"
                id="admin-mobile-toggle"
                class="md:hidden p-1 text-[#c3c4c7] hover:text-white rounded hover:bg-[#2c3338] transition cursor-pointer min-w-[30px] min-h-[30px] flex items-center justify-center focus:outline-none focus:ring-1 focus:ring-[#72aee6]"
                aria-label="Menu d'administration"
                aria-expanded="false"
                aria-controls="admin-sidebar"
              >
                <svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;min-width:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
              </button>
            )}

            <a href="/admin" class="font-normal text-xs text-white tracking-tight hover:text-[#72aee6] transition truncate flex items-center gap-1.5">
              <span class="w-4 h-4 rounded-xs bg-white flex items-center justify-center p-0.5 shrink-0 shadow-2xs">
                <img src="/admin-logo.svg" alt="Astro" class="w-full h-full object-contain" />
              </span>
              <span class="truncate font-semibold">Ateliers de calligraphie</span>
            </a>

            <span class="text-[#50575e] hidden sm:inline select-none" aria-hidden="true">|</span>

            <span class="hidden sm:inline-block text-[11px] text-[#a7aaad]">
              Administration
            </span>

            <a
              href="/"
              target="_blank"
              rel="noopener noreferrer"
              class="hidden md:inline-flex items-center gap-1 text-[11px] text-[#c3c4c7] hover:text-[#72aee6] transition ml-1"
              title="Voir le site public (s'ouvre dans un nouvel onglet)"
            >
              <span>Voir le site</span>
              <span class="font-mono text-[10px]" aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
            <a
              href="/"
              target="_blank"
              rel="noopener noreferrer"
              class="md:hidden inline-flex items-center gap-1 text-[11px] text-[#c3c4c7] hover:text-[#72aee6] px-1.5 py-0.5 rounded hover:bg-[#2c3338] transition min-h-[28px] flex items-center"
              title="Voir le site public"
            >
              <span class="hidden xs:inline">Voir le site</span>
              <span class="xs:hidden">Site</span>
              <span class="font-mono text-[10px]" aria-hidden="true">↗</span>
            </a>

            <button
              type="button"
              id="theme-toggle"
              class="p-1 min-w-[28px] min-h-[28px] flex items-center justify-center rounded text-[#c3c4c7] hover:text-white hover:bg-[#2c3338] transition cursor-pointer focus:outline-none focus:ring-1 focus:ring-[#72aee6]"
              aria-label="Basculer le mode sombre"
              title="Basculer le mode sombre"
            >
              <svg id="icon-sun" width="13" height="13" class="w-3.5 h-3.5 hidden" style="width:13px;height:13px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <svg id="icon-moon" width="13" height="13" class="w-3.5 h-3.5 hidden" style="width:13px;height:13px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
            </button>

            {hasAdminSession && (
              <button
                id="admin-logout-btn"
                type="button"
                class="text-[11px] text-[#c3c4c7] hover:text-white px-2 py-0.5 rounded hover:bg-[#2c3338] transition cursor-pointer min-h-[28px] flex items-center focus:outline-none focus:ring-1 focus:ring-[#72aee6]"
                title="Se déconnecter"
              >
                <span class="hidden sm:inline">Se déconnecter</span>
                <span class="sm:hidden flex items-center gap-1">
                  <svg width="14" height="14" class="w-3.5 h-3.5" style="width:14px;height:14px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
                  </svg>
                </span>
              </button>
            )}
          </div>
        </header>

        {hasAdminSession ? (
          <div class="flex-1 flex min-h-[calc(100vh-2rem)] relative">
            <div
              id="admin-sidebar-overlay"
              class="fixed inset-0 bg-black/50 z-40 md:hidden hidden backdrop-blur-2xs transition-opacity duration-200"
              aria-hidden="true"
            ></div>

            <aside
              id="admin-sidebar"
              class="fixed inset-y-0 left-0 z-50 md:static w-64 max-w-[80vw] md:w-48 bg-[#1d2327] dark:bg-[#101315] text-[#c3c4c7] border-r border-[#2c3338] dark:border-[#1e2327] flex flex-col shrink-0 transform -translate-x-full md:translate-x-0 transition-all duration-200 ease-in-out md:min-h-[calc(100vh-2rem)] md:sticky md:top-8 md:self-start md:h-[calc(100vh-2rem)] overflow-y-auto select-none shadow-xl md:shadow-none"
              aria-label="Navigation de l'administration"
            >
              <div class="px-3 py-2 border-b border-[#2c3338] dark:border-[#1e2327] flex items-center justify-between md:hidden">
                <div class="sidebar-header-text min-w-0 flex items-center gap-2">
                  <span class="w-5 h-5 rounded-xs bg-white flex items-center justify-center p-0.5 shrink-0 shadow-2xs">
                    <img src="/admin-logo.svg" alt="Astro" class="w-full h-full object-contain" />
                  </span>
                  <div class="min-w-0">
                    <div class="font-semibold text-xs text-white truncate">Ateliers de calligraphie</div>
                  </div>
                </div>
                <button
                  id="admin-sidebar-close"
                  type="button"
                  class="text-[#a7aaad] hover:text-white p-1 rounded cursor-pointer min-w-[32px] min-h-[32px] flex items-center justify-center focus:outline-none focus:ring-1 focus:ring-[#72aee6]"
                  aria-label="Fermer le menu"
                >
                  <svg width="16" height="16" class="w-4 h-4" style="width:16px;height:16px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <nav class="flex-1 py-1.5 overflow-y-auto">
                <ul class="space-y-0.5 text-xs font-normal">
                  {adminNavItems.map((item, i) => {
                    const isActive = currentAdminTab === item.id;
                    const previousGroup = i > 0 ? adminNavItems[i - 1].group : undefined;
                    const showGroupLabel = item.group && item.group !== previousGroup;
                    return (
                      <>
                        {showGroupLabel && (
                          <li class="nav-group-label px-3 pt-3 pb-1 first:pt-1.5" aria-hidden="true">
                            <span class="text-[10px] font-semibold uppercase tracking-wider text-[#6c7176]">{item.group}</span>
                          </li>
                        )}
                        <li>
                          <a
                            href={item.href}
                            aria-current={isActive ? "page" : undefined}
                            title={item.label}
                            class={`nav-link min-h-[34px] flex items-center gap-2.5 px-3 py-1.5 transition-colors ${
                              isActive
                                ? "bg-[#2271b1] text-white font-medium border-l-[4px] border-[#72aee6]"
                                : "text-[#c3c4c7] hover:text-[#72aee6] hover:bg-[#2c3338] border-l-[4px] border-transparent"
                            }`}
                          >
                            <span class="shrink-0 text-current inline-flex items-center justify-center w-4 h-4" style="width:16px;height:16px;min-width:16px;line-height:0;" set:html={item.svg} />
                            <span class="nav-label truncate text-[13px]">{item.label}</span>
                          </a>
                        </li>
                      </>
                    );
                  })}
                </ul>
              </nav>

              <!-- Mobile-only footer link -->
              <div class="md:hidden p-2.5 border-t border-[#2c3338] dark:border-[#1e2327]">
                <a
                  href="/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="min-h-[36px] flex items-center justify-between px-2.5 py-1.5 rounded text-xs text-[#72aee6] hover:text-white hover:bg-[#2c3338] transition font-medium"
                >
                  <span>Voir le site public</span>
                  <span class="font-mono text-xs" aria-hidden="true">↗</span>
                </a>
              </div>

              <!-- Tablet/Desktop Collapse Toggle button -->
              <button
                type="button"
                id="admin-sidebar-collapse-btn"
                class="hidden md:flex items-center gap-2 w-full px-3 py-2 text-xs text-[#8c8f94] hover:text-[#72aee6] hover:bg-[#2c3338] border-t border-[#2c3338] dark:border-[#1e2327] transition-colors cursor-pointer shrink-0"
                aria-label="Réduire le menu"
                title="Réduire le menu"
              >
                <svg id="collapse-icon" width="14" height="14" class="collapse-icon w-3.5 h-3.5 shrink-0 transition-transform duration-200" style="width:14px;height:14px;display:block;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
                </svg>
                <span class="nav-label truncate text-xs">Réduire le menu</span>
              </button>
            </aside>

            <main id="main-content" class="flex-1 min-w-0 bg-[#f0f0f1] dark:bg-[#121517] p-3 sm:p-5 lg:p-6 flex flex-col">
              <div class="flex-1 min-w-0 w-full max-w-6xl">
                <slot />
              </div>

              <footer class="mt-8 pt-3 border-t border-[#dcdcde] dark:border-[#242a2f] text-xs text-[#646970] dark:text-[#8c8f94] flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
                <div>Administration · Ateliers de calligraphie</div>
                <div>
                  <a href="/" target="_blank" rel="noopener noreferrer" class="hover:text-[#2271b1] dark:hover:text-[#72aee6] transition">Voir le site public ↗</a>
                </div>
              </footer>
            </main>
          </div>
        ) : (
          <main id="main-content" class="flex-1 flex items-center justify-center p-4 min-h-[calc(100vh-2rem)] bg-[#f0f0f1] dark:bg-[#121517]">
            <slot />
          </main>
        )}
      </div>
    ) : (
      <Navbar />
    )}

    {!isAdmin && (
      showSidebar ? (
        <main id="main-content" class="flex-1 mx-auto max-w-[1300px] w-full flex flex-col lg:flex-row gap-8 px-4 sm:px-6 py-8">
          <div class="flex-1 min-w-0">
            <slot />
          </div>
          <aside class="lg:w-80 shrink-0">
            <InfoBox />
          </aside>
        </main>
      ) : (
        <main id="main-content" class="flex-1 mx-auto max-w-[1300px] w-full px-4 sm:px-6 py-8">
          <slot />
        </main>
      )
    )}

    {!isAdmin && <Footer />}

    <script>
      function initLayoutScripts() {
        const syncIcon = () => {
          const isDark = document.documentElement.classList.contains('dark');
          const sun = document.getElementById('icon-sun');
          const moon = document.getElementById('icon-moon');
          if (sun) sun.classList.toggle('hidden', !isDark);
          if (moon) moon.classList.toggle('hidden', isDark);
        };
        syncIcon();

        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle && !themeToggle.dataset.init) {
          themeToggle.dataset.init = 'true';
          themeToggle.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            syncIcon();
          });
        }

        const adminLogout = document.getElementById('admin-logout-btn');
        if (adminLogout && !adminLogout.dataset.init) {
          adminLogout.dataset.init = 'true';
          adminLogout.addEventListener('click', async () => {
            await fetch('/api/admin/auth', { method: 'DELETE' }).catch(() => {});
            window.location.href = '/admin';
          });
        }

        const mobileToggle = document.getElementById('admin-mobile-toggle');
        const sidebar = document.getElementById('admin-sidebar');
        const overlay = document.getElementById('admin-sidebar-overlay');
        const sidebarClose = document.getElementById('admin-sidebar-close');
        const collapseBtn = document.getElementById('admin-sidebar-collapse-btn');

        function isMobile() {
          return window.innerWidth < 768;
        }

        function openSidebar() {
          sidebar?.classList.remove('-translate-x-full');
          overlay?.classList.remove('hidden');
          mobileToggle?.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          sidebarClose?.focus();
        }

        function closeSidebar() {
          sidebar?.classList.add('-translate-x-full');
          overlay?.classList.add('hidden');
          mobileToggle?.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          mobileToggle?.focus();
        }

        if (mobileToggle && !mobileToggle.dataset.init) {
          mobileToggle.dataset.init = 'true';
          mobileToggle.addEventListener('click', () => {
            const isClosed = sidebar?.classList.contains('-translate-x-full');
            if (isClosed) openSidebar();
            else closeSidebar();
          });
        }

        if (overlay && !overlay.dataset.init) {
          overlay.dataset.init = 'true';
          overlay.addEventListener('click', closeSidebar);
        }

        if (sidebarClose && !sidebarClose.dataset.init) {
          sidebarClose.dataset.init = 'true';
          sidebarClose.addEventListener('click', closeSidebar);
        }

        if (!(window as any).__adminKeydownInit) {
          (window as any).__adminKeydownInit = true;
          window.addEventListener('keydown', (e) => {
            const sb = document.getElementById('admin-sidebar');
            if (e.key === 'Escape' && window.innerWidth < 768 && sb && !sb.classList.contains('-translate-x-full')) {
              const ov = document.getElementById('admin-sidebar-overlay');
              const mt = document.getElementById('admin-mobile-toggle');
              sb.classList.add('-translate-x-full');
              ov?.classList.add('hidden');
              mt?.setAttribute('aria-expanded', 'false');
              document.body.style.overflow = '';
              mt?.focus();
            }
          });
        }

        if (sidebar && !sidebar.dataset.trapInit) {
          sidebar.dataset.trapInit = 'true';
          sidebar.addEventListener('keydown', (e) => {
            if (!isMobile() || sidebar.classList.contains('-translate-x-full')) return;
            if (e.key === 'Tab') {
              const focusables = sidebar.querySelectorAll('a, button:not([disabled])');
              if (focusables.length === 0) return;
              const first = focusables[0] as HTMLElement;
              const last = focusables[focusables.length - 1] as HTMLElement;
              if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
              } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
              }
            }
          });
        }

        function setSidebarCollapsed(collapsed: boolean) {
          if (!sidebar) return;
          if (collapsed) {
            sidebar.classList.add('collapsed');
            collapseBtn?.setAttribute('aria-label', 'Déplier le menu');
            collapseBtn?.setAttribute('title', 'Déplier le menu');
            const label = collapseBtn?.querySelector('.nav-label');
            if (label) label.textContent = 'Déplier le menu';
          } else {
            sidebar.classList.remove('collapsed');
            collapseBtn?.setAttribute('aria-label', 'Réduire le menu');
            collapseBtn?.setAttribute('title', 'Réduire le menu');
            const label = collapseBtn?.querySelector('.nav-label');
            if (label) label.textContent = 'Réduire le menu';
          }
        }

        if (collapseBtn && !collapseBtn.dataset.init) {
          collapseBtn.dataset.init = 'true';
          collapseBtn.addEventListener('click', () => {
            const isCollapsed = sidebar?.classList.contains('collapsed');
            const next = !isCollapsed;
            setSidebarCollapsed(next);
            localStorage.setItem('admin_sidebar_collapsed', next ? '1' : '0');
          });
        }

        const savedCollapsed = localStorage.getItem('admin_sidebar_collapsed');
        if (savedCollapsed === '1') {
          setSidebarCollapsed(true);
        } else if (savedCollapsed === null && window.innerWidth >= 768 && window.innerWidth < 1024) {
          setSidebarCollapsed(true);
        }
      }

      document.addEventListener('astro:page-load', initLayoutScripts);
    </script>
  </body>
</html>
