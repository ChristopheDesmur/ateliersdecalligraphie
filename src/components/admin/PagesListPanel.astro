---
import AdminPanel from './AdminPanel.astro';
import type { DiscoveredPage } from '@/lib/pages/discover';
import type { PageCollectionConfig } from '@/lib/pages/collections';

interface Props {
  initialPages: DiscoveredPage[];
  initialErrors?: string[];
  csrfToken: string;
  collections: PageCollectionConfig[];
}

const { initialPages = [], initialErrors = [], csrfToken, collections = [] } = Astro.props;
---

<div id="pages-admin-root" data-csrf-token={csrfToken}>
  <!-- Source / sync info: secondary, collapsed by default -->
  <p class="text-[11px] text-[#646970] dark:text-[#8c8f94] mb-2">
    <button type="button" id="pages-source-toggle" class="text-[#2271b1] dark:text-[#72aee6] hover:underline cursor-pointer font-medium">
      Source &amp; synchronisation
    </button>
  </p>
  <div id="pages-source-panel" class="hidden mb-3 px-3 py-2 rounded-[3px] bg-[#f6f7f7] dark:bg-[#161a1d] border border-[#dcdcde] dark:border-[#2c3338] text-[11px] text-[#646970] dark:text-[#8c8f94] flex flex-wrap items-center gap-x-4 gap-y-1">
    <span><strong class="font-semibold text-[#2c3338] dark:text-[#dcdcde]">Source :</strong> <code class="font-mono">src/content/blog/*.md</code></span>
    <span>Synchronisation automatique Git &amp; GitHub</span>
  </div>

  <div id="pages-errors-wrap" class="mb-3"></div>

  <!-- Toolbar: search + category filter + bulk actions, sticky -->
  <div id="pages-toolbar" class="sticky top-8 z-20 bg-[#f0f0f1] dark:bg-[#101315] py-2 space-y-2">
    <!-- Status subtabs (WordPress-style: Tous | Publié | Brouillon) -->
    <div id="status-tabs" class="flex items-center gap-1.5 px-1 text-xs text-[#646970] dark:text-[#8c8f94]">
      <button type="button" class="status-tab cursor-pointer" data-status="">Tous <span id="status-count-all">(0)</span></button>
      <span class="text-[#c3c4c7] dark:text-[#50575e]" aria-hidden="true">|</span>
      <button type="button" class="status-tab cursor-pointer" data-status="published">Publié <span id="status-count-published">(0)</span></button>
      <span class="text-[#c3c4c7] dark:text-[#50575e]" aria-hidden="true">|</span>
      <button type="button" class="status-tab cursor-pointer" data-status="draft">Brouillon <span id="status-count-draft">(0)</span></button>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center gap-2 p-2.5 rounded-[3px] bg-white dark:bg-[#1a1e22] border border-[#dcdcde] dark:border-[#2c3338] shadow-2xs">
      <div role="search" class="flex-1 min-w-0 flex items-center gap-2 px-2.5 py-1.5 bg-[#f6f7f7] dark:bg-[#161a1d] rounded-[3px] border border-[#dcdcde] dark:border-[#2c3338]">
        <span class="text-[#8c8f94] text-xs" aria-hidden="true">🔍</span>
        <label for="pages-search-input" class="sr-only">Rechercher une page</label>
        <input
          type="search"
          id="pages-search-input"
          placeholder="Rechercher par titre, chemin ou catégorie…"
          class="w-full text-xs bg-transparent border-0 focus:ring-0 text-[#1d2327] dark:text-white placeholder-[#8c8f94]"
        />
      </div>
      <label for="pages-filter-category" class="sr-only">Filtrer par catégorie</label>
      <select
        id="pages-filter-category"
        class="px-2.5 py-1.5 text-xs rounded-[3px] border border-[#dcdcde] dark:border-[#2c3338] bg-white dark:bg-[#1a1e22] text-[#2c3338] dark:text-[#dcdcde] transition cursor-pointer"
      >
        <option value="">Toutes les catégories</option>
      </select>
    </div>

    <!-- Bulk actions bar -->
    <div class="flex items-center gap-2 px-1 text-xs">
      <label for="bulk-action-select" class="sr-only">Actions groupées</label>
      <select id="bulk-action-select" class="px-2.5 py-1.5 text-xs rounded-[3px] border border-[#dcdcde] dark:border-[#2c3338] bg-white dark:bg-[#1a1e22] text-[#2c3338] dark:text-[#dcdcde] cursor-pointer">
        <option value="">Actions groupées</option>
        <option value="delete">Supprimer</option>
      </select>
      <button type="button" id="bulk-action-apply" class="astro-btn astro-btn-secondary text-xs">Appliquer</button>
      <span id="pages-selection-label" class="text-[#646970] dark:text-[#8c8f94]"></span>
      <span id="pages-count-label" class="ml-auto text-[#646970] dark:text-[#8c8f94]"></span>
    </div>
  </div>

  <!-- List surface -->
  <AdminPanel noPadding class="mt-1">
    <div id="pages-list-container"><!-- Rendered client-side --></div>
  </AdminPanel>
</div>

<!-- New page modal -->
<div id="pages-new-modal" class="hidden fixed inset-0 z-150 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
  <div class="bg-white dark:bg-[#1a1e22] rounded-[3px] p-6 max-w-md w-full border border-[#c3c4c7] dark:border-[#2c3338] shadow-2xl space-y-4">
    <h3 class="text-lg font-semibold text-[#1d2327] dark:text-white">Nouvelle page</h3>
    <div>
      <label for="new-page-collection" class="field-label">Rubrique</label>
      <select id="new-page-collection" class="field-input">
        {collections.map((c) => <option value={c.id}>{c.label}</option>)}
      </select>
    </div>
    <div>
      <label for="new-page-title" class="field-label">Titre</label>
      <input id="new-page-title" type="text" class="field-input" placeholder="ex : L'art de la calligraphie zen" />
    </div>
    <div>
      <label for="new-page-slug" class="field-label">Slug (URL)</label>
      <input id="new-page-slug" type="text" class="field-input" placeholder="généré depuis le titre" />
    </div>
    <div>
      <label for="new-page-image-src" class="field-label">Image — chemin (obligatoire)</label>
      <input id="new-page-image-src" type="text" class="field-input" placeholder="/assets/exemple.webp" />
    </div>
    <div>
      <label for="new-page-image-alt" class="field-label">Image — texte alternatif</label>
      <input id="new-page-image-alt" type="text" class="field-input" />
    </div>
    <div id="new-page-error" class="hidden astro-notice astro-notice-error text-xs"></div>
    <div class="flex items-center gap-2 justify-end pt-1">
      <button type="button" id="new-page-cancel" class="astro-btn astro-btn-secondary text-xs">Annuler</button>
      <button type="button" id="new-page-submit" class="astro-btn astro-btn-primary text-xs">Créer la page</button>
    </div>
  </div>
</div>

<!-- Bulk delete confirmation modal -->
<div id="bulk-delete-modal" class="hidden fixed inset-0 z-150 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
  <div class="bg-white dark:bg-[#1a1e22] rounded-[3px] p-6 max-w-md w-full border border-[#c3c4c7] dark:border-[#2c3338] shadow-2xl space-y-4">
    <h3 class="text-lg font-semibold text-[#b32d2e]">Supprimer <span id="bulk-delete-count">0</span> page(s) ?</h3>
    <p class="text-xs text-[#646970] dark:text-[#8c8f94]">
      Cette action supprime définitivement les fichiers source sur GitHub. Pour confirmer, tapez <strong class="text-[#1d2327] dark:text-white font-mono">SUPPRIMER</strong> ci-dessous :
    </p>
    <input id="bulk-delete-input" type="text" class="field-input" />
    <div id="bulk-delete-error" class="hidden astro-notice astro-notice-error text-xs"></div>
    <div id="bulk-delete-progress" class="hidden text-xs text-[#646970] dark:text-[#8c8f94]"></div>
    <div class="flex items-center gap-2 justify-end pt-1">
      <button type="button" id="bulk-delete-cancel" class="astro-btn astro-btn-secondary text-xs">Annuler</button>
      <button type="button" id="bulk-delete-confirm" disabled class="astro-btn astro-btn-danger text-xs">Supprimer définitivement</button>
    </div>
  </div>
</div>

<script id="initial-pages-data" type="application/json" set:html={JSON.stringify(initialPages)}></script>
<script id="initial-pages-errors" type="application/json" set:html={JSON.stringify(initialErrors)}></script>

<script>
  interface PageRow {
    collection: string;
    collectionLabel: string;
    slug: string;
    file: string;
    title: string;
    snippet: string;
    category: string;
    draft: boolean;
    publishDate: string;
    url: string;
  }

  const PAGE_SIZE = 25;

  let pages: PageRow[] = [];
  try {
    pages = JSON.parse(document.getElementById('initial-pages-data')?.textContent || '[]');
  } catch {
    pages = [];
  }

  function showErrors(errors: string[]) {
    const wrap = document.getElementById('pages-errors-wrap');
    if (!wrap) return;
    if (!errors || errors.length === 0) {
      wrap.innerHTML = '';
      return;
    }
    wrap.innerHTML = `<div class="astro-notice astro-notice-warning text-xs"><p class="font-semibold mb-1">⚠️ Certaines rubriques n'ont pas pu être chargées :</p><ul class="list-disc pl-4">${errors.map((e) => `<li>${e}</li>`).join('')}</ul></div>`;
  }
  try {
    showErrors(JSON.parse(document.getElementById('initial-pages-errors')?.textContent || '[]'));
  } catch {
    // ignore
  }

  document.getElementById('pages-source-toggle')?.addEventListener('click', () => {
    document.getElementById('pages-source-panel')?.classList.toggle('hidden');
  });

  let searchQuery = '';
  let selectedCategory = '';
  let selectedStatus: '' | 'published' | 'draft' = '';
  let sortField: 'title' | 'publishDate' | 'category' | null = null;
  let sortDir: 'asc' | 'desc' = 'asc';
  let page = 1;
  const selected = new Set<string>(); // "collection:slug"

  const container = document.getElementById('pages-list-container');
  const countLabel = document.getElementById('pages-count-label');
  const selectionLabel = document.getElementById('pages-selection-label');
  const searchInput = document.getElementById('pages-search-input') as HTMLInputElement | null;
  const categorySelect = document.getElementById('pages-filter-category') as HTMLSelectElement | null;
  const refreshBtn = document.getElementById('pages-refresh-btn');
  const refreshIcon = document.getElementById('pages-refresh-icon');
  const refreshLabel = document.getElementById('pages-refresh-label');
  const bulkActionSelect = document.getElementById('bulk-action-select') as HTMLSelectElement | null;
  const bulkActionApply = document.getElementById('bulk-action-apply');

  function rowKey(p: PageRow): string {
    return `${p.collection}:${p.slug}`;
  }

  function populateCategoryFilter() {
    if (!categorySelect) return;
    const seen = new Set<string>();
    for (const p of pages) if (p.category) seen.add(p.category);
    const current = categorySelect.value;
    categorySelect.innerHTML = '<option value="">Toutes les catégories</option>';
    for (const cat of [...seen].sort((a, b) => a.localeCompare(b, 'fr'))) {
      const opt = document.createElement('option');
      opt.value = cat;
      opt.textContent = cat;
      categorySelect.appendChild(opt);
    }
    categorySelect.value = current;
  }

  function formatDate(iso: string): string {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  function escapeHtml(s: string): string {
    return String(s || '').replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c] || c));
  }

  function getFiltered(): PageRow[] {
    const q = searchQuery.trim().toLowerCase();
    return pages.filter((p) => {
      if (selectedCategory && p.category !== selectedCategory) return false;
      if (selectedStatus === 'draft' && !p.draft) return false;
      if (selectedStatus === 'published' && p.draft) return false;
      if (q) {
        const hay = `${p.title} ${p.url} ${p.file} ${p.category}`.toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });
  }

  function updateStatusTabs() {
    const allCount = pages.length;
    const draftCount = pages.filter((p) => p.draft).length;
    const publishedCount = allCount - draftCount;

    const setCount = (id: string, n: number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = `(${n})`;
    };
    setCount('status-count-all', allCount);
    setCount('status-count-published', publishedCount);
    setCount('status-count-draft', draftCount);

    document.querySelectorAll<HTMLButtonElement>('.status-tab').forEach((btn) => {
      const status = btn.getAttribute('data-status') || '';
      const isActive = status === selectedStatus;
      btn.className = isActive
        ? 'font-semibold text-[#1d2327] dark:text-white'
        : 'status-tab cursor-pointer text-[#2271b1] dark:text-[#72aee6] hover:underline';
    });
  }

  function sortRows(rows: PageRow[]): PageRow[] {
    if (!sortField) return rows;
    const dir = sortDir === 'asc' ? 1 : -1;
    return [...rows].sort((a, b) => {
      const av = sortField === 'title' ? a.title : sortField === 'category' ? a.category : a.publishDate;
      const bv = sortField === 'title' ? b.title : sortField === 'category' ? b.category : b.publishDate;
      return av.localeCompare(bv) * dir;
    });
  }

  function sortIndicator(field: string): string {
    if (sortField !== field) return '<span class="text-[#c3c4c7] dark:text-[#50575e]">↕</span>';
    return sortDir === 'asc' ? '<span class="text-[#2c3338] dark:text-[#dcdcde]">↑</span>' : '<span class="text-[#2c3338] dark:text-[#dcdcde]">↓</span>';
  }

  function rowHtml(p: PageRow, checked: boolean): string {
    const key = rowKey(p);
    return `
      <tr class="border-b border-[#f0f0f1] dark:border-[#2c3338] last:border-0 hover:bg-[#f6f7f7]/70 dark:hover:bg-[#181d22] transition" data-row-key="${key}">
        <td class="w-8 px-3 py-2 align-top">
          <input type="checkbox" class="page-row-checkbox mt-0.5 cursor-pointer" data-key="${key}" aria-label="Sélectionner « ${escapeHtml(p.title)} »" ${checked ? 'checked' : ''} />
        </td>
        <td class="px-3 py-2 min-w-[220px]">
          <div class="flex items-center gap-1.5 flex-wrap">
            <span class="text-[13px] font-medium text-[#1d2327] dark:text-white">${escapeHtml(p.title)}</span>
            ${p.draft ? '<span class="astro-badge astro-badge-muted">Brouillon</span>' : ''}
          </div>
          <div class="text-[11px] font-mono text-[#8c8f94] truncate mt-0.5" title="${escapeHtml(p.file)}">${escapeHtml(p.url)}</div>
        </td>
        <td class="px-3 py-2 text-[11px] text-[#646970] dark:text-[#8c8f94] whitespace-nowrap hidden md:table-cell">${escapeHtml(p.category) || '—'}</td>
        <td class="px-3 py-2 text-[11px] text-[#646970] dark:text-[#8c8f94] font-mono whitespace-nowrap hidden sm:table-cell">${formatDate(p.publishDate)}</td>
        <td class="px-3 py-2 text-right whitespace-nowrap">
          <a href="${p.url}" target="_blank" rel="noopener noreferrer" class="text-[11px] text-[#646970] dark:text-[#8c8f94] hover:text-[#2271b1] dark:hover:text-[#72aee6] hover:underline mr-3">Aperçu</a>
          <a href="/admin/pages/${p.collection}/${p.slug}" class="text-[11px] font-semibold text-[#2271b1] dark:text-[#72aee6] hover:underline">Modifier</a>
        </td>
      </tr>
    `;
  }

  function tableHead(): string {
    return `
      <thead class="bg-[#f6f7f7] dark:bg-[#161a1d] border-b border-[#dcdcde] dark:border-[#2c3338] text-[#646970] dark:text-[#8c8f94] uppercase text-[10px] tracking-wider">
        <tr>
          <th scope="col" class="w-8 px-3 py-2 font-semibold">
            <input type="checkbox" class="select-all-checkbox cursor-pointer" aria-label="Tout sélectionner" />
          </th>
          <th scope="col" class="px-3 py-2 font-semibold">
            <button type="button" class="sort-btn inline-flex items-center gap-1 hover:text-[#2c3338] dark:hover:text-[#dcdcde] cursor-pointer" data-sort="title">Page ${sortIndicator('title')}</button>
          </th>
          <th scope="col" class="px-3 py-2 font-semibold hidden md:table-cell">
            <button type="button" class="sort-btn inline-flex items-center gap-1 hover:text-[#2c3338] dark:hover:text-[#dcdcde] cursor-pointer" data-sort="category">Catégorie ${sortIndicator('category')}</button>
          </th>
          <th scope="col" class="px-3 py-2 font-semibold hidden sm:table-cell">
            <button type="button" class="sort-btn inline-flex items-center gap-1 hover:text-[#2c3338] dark:hover:text-[#dcdcde] cursor-pointer" data-sort="publishDate">Date ${sortIndicator('publishDate')}</button>
          </th>
          <th scope="col" class="px-3 py-2 font-semibold text-right">Actions</th>
        </tr>
      </thead>
    `;
  }

  function emptyState(): string {
    if (pages.length === 0) {
      return `
        <div class="p-10 text-center text-[#646970] dark:text-[#8c8f94] text-xs">
          <p class="font-semibold text-sm text-[#2c3338] dark:text-[#dcdcde] mb-1">Aucune page</p>
          <button type="button" id="empty-create-btn" class="text-[#2271b1] dark:text-[#72aee6] hover:underline font-medium cursor-pointer">Créer votre première page →</button>
        </div>
      `;
    }
    return `
      <div class="p-10 text-center text-[#646970] dark:text-[#8c8f94] text-xs space-y-2">
        <p>Aucune page ne correspond à votre recherche.</p>
        <button type="button" id="pages-reset-filters" class="text-[#2271b1] dark:text-[#72aee6] hover:underline font-medium cursor-pointer">Réinitialiser les filtres</button>
      </div>
    `;
  }

  function updateSelectionUI() {
    if (selectionLabel) {
      selectionLabel.textContent = selected.size > 0 ? `${selected.size} sélectionnée${selected.size > 1 ? 's' : ''}` : '';
    }
  }

  function render() {
    if (!container) return;

    const filtered = getFiltered();
    const isFiltered = filtered.length !== pages.length || searchQuery || selectedCategory || selectedStatus;

    if (countLabel) {
      countLabel.textContent = isFiltered
        ? `${filtered.length} page${filtered.length > 1 ? 's' : ''} trouvée${filtered.length > 1 ? 's' : ''} · filtrées depuis ${pages.length}`
        : `${pages.length} page${pages.length > 1 ? 's' : ''}`;
    }
    updateSelectionUI();
    updateStatusTabs();

    if (pages.length === 0 || filtered.length === 0) {
      container.innerHTML = emptyState();
      document.getElementById('empty-create-btn')?.addEventListener('click', () => {
        document.getElementById('pages-new-btn')?.dispatchEvent(new Event('click'));
      });
      document.getElementById('pages-reset-filters')?.addEventListener('click', () => {
        searchQuery = '';
        selectedCategory = '';
        selectedStatus = '';
        if (searchInput) searchInput.value = '';
        if (categorySelect) categorySelect.value = '';
        render();
      });
      return;
    }

    const sorted = sortRows(filtered);
    const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
    if (page > totalPages) page = totalPages;
    const start = (page - 1) * PAGE_SIZE;
    const pageRows = sorted.slice(start, start + PAGE_SIZE);

    let html = `<div class="overflow-x-auto"><table class="w-full text-left">${tableHead()}<tbody>`;
    html += pageRows.map((p) => rowHtml(p, selected.has(rowKey(p)))).join('');
    html += `</tbody></table></div>`;

    if (totalPages > 1) {
      html += `
        <div class="flex items-center justify-between px-3 py-2 border-t border-[#dcdcde] dark:border-[#2c3338] text-[11px] text-[#646970] dark:text-[#8c8f94]">
          <span>Page ${page} sur ${totalPages}</span>
          <div class="flex items-center gap-1">
            <button type="button" id="pages-prev-btn" ${page <= 1 ? 'disabled' : ''} class="astro-btn astro-btn-secondary text-[11px] disabled:opacity-40 disabled:pointer-events-none">‹ Précédent</button>
            <button type="button" id="pages-next-btn" ${page >= totalPages ? 'disabled' : ''} class="astro-btn astro-btn-secondary text-[11px] disabled:opacity-40 disabled:pointer-events-none">Suivant ›</button>
          </div>
        </div>
      `;
    }

    container.innerHTML = html;
    wireRowEvents();
    document.getElementById('pages-prev-btn')?.addEventListener('click', () => { page--; render(); });
    document.getElementById('pages-next-btn')?.addEventListener('click', () => { page++; render(); });
  }

  function wireRowEvents() {
    if (!container) return;

    container.querySelectorAll<HTMLInputElement>('.page-row-checkbox').forEach((cb) => {
      cb.addEventListener('change', () => {
        const key = cb.getAttribute('data-key') || '';
        if (cb.checked) selected.add(key);
        else selected.delete(key);
        updateSelectionUI();
      });
    });

    container.querySelectorAll<HTMLInputElement>('.select-all-checkbox').forEach((cb) => {
      cb.addEventListener('change', () => {
        const rows = cb.closest('table')?.querySelectorAll<HTMLInputElement>('.page-row-checkbox') || [];
        rows.forEach((rowCb) => {
          rowCb.checked = cb.checked;
          const key = rowCb.getAttribute('data-key') || '';
          if (cb.checked) selected.add(key);
          else selected.delete(key);
        });
        updateSelectionUI();
      });
    });

    container.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const field = btn.getAttribute('data-sort') as 'title' | 'publishDate' | 'category';
        if (sortField === field) {
          sortDir = sortDir === 'asc' ? 'desc' : 'asc';
        } else {
          sortField = field;
          sortDir = 'asc';
        }
        render();
      });
    });
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    page = 1;
    render();
  });
  categorySelect?.addEventListener('change', (e) => {
    selectedCategory = (e.target as HTMLSelectElement).value;
    page = 1;
    render();
  });

  document.getElementById('status-tabs')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.status-tab');
    if (!btn) return;
    selectedStatus = (btn.getAttribute('data-status') || '') as '' | 'published' | 'draft';
    page = 1;
    render();
  });

  refreshBtn?.addEventListener('click', async () => {
    if (!refreshBtn || !refreshIcon || !refreshLabel) return;
    (refreshBtn as HTMLButtonElement).disabled = true;
    refreshIcon.textContent = '…';
    refreshLabel.textContent = 'Actualisation…';
    try {
      const res = await fetch('/api/admin/pages', { cache: 'no-store' });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || "Erreur lors de l'actualisation.");
      pages = data.pages || [];
      showErrors(data.errors || []);
      populateCategoryFilter();
      render();
    } catch (err: any) {
      showErrors([err.message || 'Impossible de joindre le serveur.']);
    } finally {
      (refreshBtn as HTMLButtonElement).disabled = false;
      refreshIcon.textContent = '↻';
      refreshLabel.textContent = 'Actualiser';
    }
  });

  // Bulk actions
  const csrfToken = (document.getElementById('pages-admin-root') as HTMLElement | null)?.dataset.csrfToken || '';
  const bulkDeleteModal = document.getElementById('bulk-delete-modal');
  const bulkDeleteCount = document.getElementById('bulk-delete-count');
  const bulkDeleteInput = document.getElementById('bulk-delete-input') as HTMLInputElement | null;
  const bulkDeleteError = document.getElementById('bulk-delete-error');
  const bulkDeleteProgress = document.getElementById('bulk-delete-progress');
  const bulkDeleteCancel = document.getElementById('bulk-delete-cancel');
  const bulkDeleteConfirm = document.getElementById('bulk-delete-confirm') as HTMLButtonElement | null;

  bulkActionApply?.addEventListener('click', () => {
    const action = bulkActionSelect?.value || '';
    if (!action) return;
    if (selected.size === 0) {
      showErrors(['Sélectionnez au moins une page pour appliquer une action groupée.']);
      return;
    }
    if (action === 'delete') {
      if (bulkDeleteCount) bulkDeleteCount.textContent = String(selected.size);
      if (bulkDeleteInput) bulkDeleteInput.value = '';
      bulkDeleteError?.classList.add('hidden');
      bulkDeleteProgress?.classList.add('hidden');
      if (bulkDeleteConfirm) bulkDeleteConfirm.disabled = true;
      bulkDeleteModal?.classList.remove('hidden');
      setTimeout(() => bulkDeleteInput?.focus(), 50);
    }
  });

  bulkDeleteCancel?.addEventListener('click', () => bulkDeleteModal?.classList.add('hidden'));
  bulkDeleteModal?.addEventListener('click', (e) => {
    if (e.target === bulkDeleteModal) bulkDeleteModal.classList.add('hidden');
  });
  bulkDeleteInput?.addEventListener('input', () => {
    if (bulkDeleteConfirm) bulkDeleteConfirm.disabled = bulkDeleteInput.value.trim() !== 'SUPPRIMER';
  });

  bulkDeleteConfirm?.addEventListener('click', async () => {
    if (!bulkDeleteConfirm) return;
    bulkDeleteConfirm.disabled = true;
    bulkDeleteError?.classList.add('hidden');
    const keys = [...selected];
    let done = 0;
    let failed = 0;

    for (const key of keys) {
      const [collection, slug] = key.split(':');
      if (bulkDeleteProgress) {
        bulkDeleteProgress.textContent = `Suppression ${done + 1} / ${keys.length}…`;
        bulkDeleteProgress.classList.remove('hidden');
      }
      try {
        const fileRes = await fetch(`/api/admin/pages/file?collection=${encodeURIComponent(collection)}&slug=${encodeURIComponent(slug)}`, { cache: 'no-store' });
        const fileData = await fileRes.json();
        if (!fileRes.ok || fileData.error) throw new Error(fileData.error || 'lecture impossible');

        const delRes = await fetch('/api/admin/pages/file', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ collection, slug, expectedVersion: fileData.version }),
        });
        const delData = await delRes.json();
        if (!delRes.ok || delData.error) throw new Error(delData.error || 'suppression impossible');

        pages = pages.filter((p) => rowKey(p) !== key);
        selected.delete(key);
        done++;
      } catch {
        failed++;
      }
    }

    bulkDeleteProgress?.classList.add('hidden');
    bulkDeleteModal?.classList.add('hidden');
    if (bulkActionSelect) bulkActionSelect.value = '';
    populateCategoryFilter();
    render();

    if (failed > 0) {
      showErrors([`${done} page(s) supprimée(s), ${failed} échec(s). Rechargez et réessayez si nécessaire.`]);
    }
  });

  // New page modal
  const newBtn = document.getElementById('pages-new-btn');
  const newModal = document.getElementById('pages-new-modal');
  const newCollection = document.getElementById('new-page-collection') as HTMLSelectElement | null;
  const newTitle = document.getElementById('new-page-title') as HTMLInputElement | null;
  const newSlug = document.getElementById('new-page-slug') as HTMLInputElement | null;
  const newImageSrc = document.getElementById('new-page-image-src') as HTMLInputElement | null;
  const newImageAlt = document.getElementById('new-page-image-alt') as HTMLInputElement | null;
  const newError = document.getElementById('new-page-error');
  const newCancel = document.getElementById('new-page-cancel');
  const newSubmit = document.getElementById('new-page-submit') as HTMLButtonElement | null;
  let slugManuallyEdited = false;

  function slugifyClient(text: string): string {
    return text.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  }

  function openNewModal() {
    if (!newModal) return;
    slugManuallyEdited = false;
    if (newTitle) newTitle.value = '';
    if (newSlug) newSlug.value = '';
    if (newImageSrc) newImageSrc.value = '';
    if (newImageAlt) newImageAlt.value = '';
    if (newError) newError.classList.add('hidden');
    newModal.classList.remove('hidden');
    setTimeout(() => newTitle?.focus(), 50);
  }
  function closeNewModal() {
    newModal?.classList.add('hidden');
  }

  newBtn?.addEventListener('click', openNewModal);
  newCancel?.addEventListener('click', closeNewModal);
  newModal?.addEventListener('click', (e) => {
    if (e.target === newModal) closeNewModal();
  });
  newTitle?.addEventListener('input', () => {
    if (!slugManuallyEdited && newSlug) newSlug.value = slugifyClient(newTitle.value);
  });
  newSlug?.addEventListener('input', () => {
    slugManuallyEdited = true;
  });

  newSubmit?.addEventListener('click', async () => {
    if (!newCollection || !newTitle || !newSubmit) return;
    const title = newTitle.value.trim();
    const slug = (newSlug?.value || '').trim();
    const imageSrc = (newImageSrc?.value || '').trim();
    const imageAlt = (newImageAlt?.value || '').trim();
    if (newError) newError.classList.add('hidden');

    if (!title) {
      if (newError) { newError.textContent = 'Le titre est requis.'; newError.classList.remove('hidden'); }
      return;
    }
    if (!imageSrc) {
      if (newError) { newError.textContent = "L'image est obligatoire."; newError.classList.remove('hidden'); }
      return;
    }

    newSubmit.disabled = true;
    newSubmit.textContent = 'Création…';
    try {
      const res = await fetch('/api/admin/pages/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ collection: newCollection.value, title, slug, imageSrc, imageAlt }),
      });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || 'Erreur lors de la création.');
      window.location.href = `/admin/pages/${data.collection}/${data.slug}`;
    } catch (err: any) {
      if (newError) { newError.textContent = err.message || 'Erreur lors de la création.'; newError.classList.remove('hidden'); }
    } finally {
      newSubmit.disabled = false;
      newSubmit.textContent = 'Créer la page';
    }
  });

  populateCategoryFilter();
  render();
</script>
