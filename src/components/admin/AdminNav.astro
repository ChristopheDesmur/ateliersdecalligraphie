---
export interface Props {
  active: "dashboard" | "prices" | "products" | "events" | "institutions" | "interventions" | "testimonials" | "venues" | "contact" | "faq";
}
const { active } = Astro.props;

const labels: Record<string, string> = {
  dashboard: "Tableau de bord",
  events: "Événements",
  institutions: "Institutions",
  interventions: "Formats d'ateliers",
  prices: "Tarifs",
  products: "Galerie",
  testimonials: "Témoignages",
  venues: "Lieux",
  contact: "Contact",
  faq: "FAQ",
};

const currentLabel = labels[active] || "Administration";
---

{active !== "dashboard" && (
  <nav aria-label="Fil d'Ariane" class="flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400 mb-3 select-none">
    <a href="/admin" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition font-medium">
      Administration
    </a>
    <span class="text-gray-400 dark:text-gray-600" aria-hidden="true">/</span>
    <span class="text-gray-800 dark:text-gray-200 font-semibold" aria-current="page">
      {currentLabel}
    </span>
  </nav>
)}
