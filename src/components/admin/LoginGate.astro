---
---
<div class="max-w-[340px] w-full mx-auto my-12 bg-white dark:bg-[#1a1e22] rounded-[3px] p-6 sm:p-7 border border-[#c3c4c7] dark:border-[#2c3338] shadow-xs">
  <div class="text-center mb-5">
    <div class="w-10 h-10 mx-auto mb-2.5 rounded-[4px] bg-[#1d2327] flex items-center justify-center p-1.5 shadow-2xs">
      <img src="/admin-logo.svg" alt="Astro" class="w-full h-full object-contain filter invert" />
    </div>
    <h1 class="text-base font-semibold text-[#1d2327] dark:text-white">
      Ateliers de calligraphie
    </h1>
    <p class="text-xs text-[#646970] dark:text-[#8c8f94] mt-0.5">
      Connexion à l'espace d'administration
    </p>
  </div>

  <form id="admin-login-form" class="space-y-3.5">
    <div>
      <label for="admin-password" class="field-label">
        Mot de passe
      </label>
      <input
        type="password"
        id="admin-password"
        name="password"
        required
        autocomplete="current-password"
        placeholder="••••••••••••"
        class="field-input"
      />
      <div id="login-error" class="hidden text-xs text-[#b32d2e] dark:text-[#ff8585] font-medium mt-1.5 astro-notice astro-notice-error py-1.5 px-2"></div>
    </div>

    <button
      type="submit"
      id="login-submit-btn"
      class="astro-btn astro-btn-primary w-full py-1.5 text-xs font-semibold cursor-pointer disabled:opacity-60"
    >
      Se connecter
    </button>
  </form>

  <div class="mt-5 pt-3.5 border-t border-[#dcdcde] dark:border-[#2c3338] text-center">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-xs text-[#646970] hover:text-[#2271b1] dark:text-[#8c8f94] dark:hover:text-[#72aee6] transition"
    >
      <span aria-hidden="true">←</span>
      <span>Revenir au site public</span>
    </a>
  </div>
</div>

<script>
  const loginForm = document.getElementById("admin-login-form");
  const loginError = document.getElementById("login-error");
  const submitBtn = document.getElementById("login-submit-btn") as HTMLButtonElement | null;
  const passwordInput = document.getElementById("admin-password") as HTMLInputElement | null;

  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!passwordInput || !submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Connexion en cours…";
    loginError?.classList.add("hidden");

    try {
      const res = await fetch("/api/admin/auth", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password: passwordInput.value }),
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || "Mot de passe incorrect.");
      window.location.reload();
    } catch (err: any) {
      if (loginError) {
        loginError.textContent = err.message;
        loginError.classList.remove("hidden");
      }
      submitBtn.disabled = false;
      submitBtn.textContent = "Se connecter";
    }
  });
</script>
