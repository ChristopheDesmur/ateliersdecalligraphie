---
---
<div class="max-w-md mx-auto my-12 bg-white dark:bg-gray-800 rounded-3xl p-8 border border-gray-200 dark:border-gray-700 shadow-md">
  <div class="text-center mb-6">
    <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 flex items-center justify-center text-2xl">
      🔒
    </div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Administration</h1>
    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
      Saisissez le mot de passe administrateur pour continuer.
    </p>
  </div>

  <form id="admin-login-form" class="space-y-4">
    <div>
      <label for="admin-password" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1.5">
        Mot de passe
      </label>
      <input
        type="password"
        id="admin-password"
        name="password"
        required
        autocomplete="current-password"
        placeholder="••••••••••••"
        class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition"
      />
      <div id="login-error" class="hidden text-xs text-rose-500 font-medium mt-2"></div>
    </div>

    <button
      type="submit"
      id="login-submit-btn"
      class="w-full py-3 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold shadow-xs transition cursor-pointer disabled:opacity-60"
    >
      Se connecter
    </button>
  </form>

  <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700/80 text-center">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-xs text-gray-500 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400 transition"
    >
      <span aria-hidden="true">←</span>
      <span>Retourner au site public</span>
    </a>
  </div>
</div>

<script>
  const loginForm = document.getElementById("admin-login-form");
  const loginError = document.getElementById("login-error");
  const submitBtn = document.getElementById("login-submit-btn") as HTMLButtonElement | null;
  const passwordInput = document.getElementById("admin-password") as HTMLInputElement | null;

  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!passwordInput || !submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Connexion en cours…";
    loginError?.classList.add("hidden");

    try {
      const res = await fetch("/api/admin/auth", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password: passwordInput.value }),
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || "Mot de passe incorrect.");
      window.location.reload();
    } catch (err: any) {
      if (loginError) {
        loginError.textContent = err.message;
        loginError.classList.remove("hidden");
      }
      submitBtn.disabled = false;
      submitBtn.textContent = "Se connecter";
    }
  });
</script>
