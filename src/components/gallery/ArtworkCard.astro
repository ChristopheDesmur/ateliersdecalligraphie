---
import type { Artwork } from "@/data/artworks";

export interface Props {
  artwork: Artwork;
  priority?: boolean;
}

const { artwork, priority = false } = Astro.props;
const isSold = artwork.availability === "Vendue";
---

<article
  class="artwork-card group flex flex-col"
  data-availability={artwork.availability}
  data-category={artwork.category}>

  <a
    href={`/galerie/${artwork.slug}`}
    class="block"
    aria-label={`Découvrir la calligraphie ${artwork.character} — ${artwork.frenchMeaning}`}>
    <!-- Fond papier : l’œuvre garde son format d’origine, sans recadrage -->
    <div class="ink-frame flex items-center justify-center p-[8%] aspect-square">
      <img
        src={artwork.src}
        alt={artwork.alt}
        width={artwork.width}
        height={artwork.height}
        loading={priority ? "eager" : "lazy"}
        decoding="async"
        class="max-h-full max-w-full object-contain mix-blend-multiply dark:mix-blend-normal"
      />
    </div>
  </a>

  <!-- Informations sur l’œuvre -->
  <div class="mt-5 flex flex-1 flex-col border-t border-warm-grey pt-4">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <p class="eyebrow">{artwork.category}</p>
      {artwork.style && <p class="meta text-xs">{artwork.style}</p>}
    </div>

    <h3 class="font-serif text-4xl leading-none text-ink mt-3" lang="zh-Hant">
      <a href={`/galerie/${artwork.slug}`} class="hover:text-soft-ink transition-colors">
        {artwork.character}
      </a>
    </h3>

    <p class="font-serif text-lg text-soft-ink mt-2 leading-snug">
      {artwork.frenchMeaning}
    </p>

    <p class="meta mt-3 line-clamp-2">
      {artwork.description}
    </p>

    <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <p class="meta">
        <span class="text-ink">{isSold ? "Vendue" : "Disponible à l’acquisition"}</span>
        {!isSold && <span> · {artwork.price}</span>}
      </p>

      <a
        href={`/galerie/${artwork.slug}`}
        class="link-arrow text-sm"
        aria-label={`Détails et acquisition de l’œuvre ${artwork.character}`}>
        <span>Détails &amp; acquisition</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>
