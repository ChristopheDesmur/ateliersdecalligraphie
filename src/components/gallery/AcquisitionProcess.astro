---
// AcquisitionProcess.astro - Explication claire et rassurante de la démarche d’acquisition directe
const steps = [
  {
    title: "Choisissez une œuvre",
    text: "Explorez les calligraphies originales disponibles à l’acquisition et découvrez la symbolique de chaque caractère traditionnel.",
    note: "Pièce unique originale",
  },
  {
    title: "Contactez le calligraphe",
    text: "Adressez un message ou un appel à Christophe Desmur en indiquant l’œuvre que vous souhaitez acquérir.",
    note: "Par courriel ou téléphone",
  },
  {
    title: "Échangez avec le calligraphe",
    text: "Christophe Desmur vous précise le prix de l’œuvre, les conseils d’encadrement, et convient avec vous d’une remise en main propre à Lyon ou d’une expédition protégée.",
    note: "Remise en main propre ou envoi",
  },
];
---

<section class="section border-t border-warm-grey" aria-labelledby="process-heading">
  <div class="max-w-3xl">
    <p class="eyebrow mb-4">Démarche d’acquisition</p>
    <h2 id="process-heading" class="h-section">
      Comment acquérir une calligraphie ?
    </h2>
    <p class="lede mt-6">
      L’acquisition d’une œuvre originale se fait sans intermédiaire ni paiement automatisé en ligne, dans le respect de l’échange direct entre l’acquéreur et le calligraphe.
    </p>
  </div>

  <ol class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-10">
    {steps.map((step, i) => (
      <li data-reveal class="border-t border-warm-grey pt-5">
        <span class="numeral" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="font-serif text-xl sm:text-2xl leading-snug text-ink mt-2">{step.title}</h3>
        <p class="meta mt-2">{step.text}</p>
        <p class="meta mt-3 font-serif italic text-[0.95rem]">{step.note}</p>
      </li>
    ))}
  </ol>
</section>
