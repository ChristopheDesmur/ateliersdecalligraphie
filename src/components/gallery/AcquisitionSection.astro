---
import type { Artwork } from "@/data/artworks";
import { contact, telHref } from "@/data/contact";

export interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
const isSold = artwork.availability === "Vendue";

const mailSubject = `Demande d’information — ${artwork.character} · ${artwork.frenchMeaning}`;
const mailBody = `Bonjour Christophe,

Je souhaiterais avoir des informations concernant votre calligraphie originale :
« ${artwork.character} — ${artwork.frenchMeaning} »

(Modalités d’acquisition, options d’encadrement, remise en main propre à Lyon ou expédition).

Dans l’attente de votre réponse,

Bien cordialement,
`;

const mailHref = `mailto:${contact.email}?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(mailBody)}`;

const customMailSubject = `Demande de création personnalisée — Inspirée de ${artwork.character}`;
const customMailHref = `mailto:${contact.email}?subject=${encodeURIComponent(customMailSubject)}`;
---

<section
  class="border-t border-ink/80 pt-8"
  aria-labelledby="acquisition-heading">

  <p class="eyebrow eyebrow-mark mb-3">
    {isSold ? "Œuvre en collection" : "Acquisition directe"}
  </p>

  <h2 id="acquisition-heading" class="h-item">
    {isSold ? "Cette œuvre vous inspire ?" : "Cette œuvre vous intéresse ?"}
  </h2>

  <p class="body-copy mt-3">
    {isSold ? (
      "Cette pièce originale a déjà été acquise. Christophe Desmur peut réaliser pour vous une nouvelle calligraphie autour de ce sinogramme ou concevoir une pièce sur mesure adaptée à votre sensibilité."
    ) : (
      "Pour connaître les modalités d’acquisition de cette calligraphie originale, échanger sur l’encadrement ou organiser une remise en main propre à Lyon ou une expédition protégée, contactez directement le calligraphe."
    )}
  </p>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
    <a href={isSold ? customMailHref : mailHref} class="btn btn-ink">
      {isSold ? "Commander une œuvre similaire" : "Demander des informations"}
    </a>
    <div class="flex flex-wrap gap-3">
      <a
        href={`tel:${telHref(contact.mobile)}`}
        class="btn btn-line flex-1 sm:flex-none px-4 tabular-nums"
        aria-label={`Appeler Christophe Desmur au ${contact.mobile}`}>
        {contact.mobile}
      </a>
      <a
        href={`tel:${telHref(contact.landline)}`}
        class="btn btn-line flex-1 sm:flex-none px-4 tabular-nums"
        aria-label={`Appeler Christophe Desmur au ${contact.landline}`}>
        {contact.landline}
      </a>
    </div>
  </div>

  <ul class="mt-6 border-t border-warm-grey pt-4 meta space-y-1.5">
    <li>Échange direct et personnalisé avec le calligraphe — aucun paiement automatisé en ligne.</li>
    <li>Retrait possible à Lyon (Croix-Rousse) ou expédition soignée à plat entre cartons rigides.</li>
  </ul>
</section>
