---
// PersonalizedCalligraphyCTA.astro - Section dédiée aux commandes personnalisées
import { contact, telHref } from "@/data/contact";
const customMailHref = `mailto:${contact.email}?subject=Demande%20de%20calligraphie%20personnalis%C3%A9e&body=Bonjour%20Christophe%2C%0A%0AJe%20souhaiterais%20vous%20consulter%20concernant%20la%20r%C3%A9alisation%20d’une%20calligraphie%20personnalis%C3%A9e%20%3A%0A%0A-%20Caract%C3%A8re%2C%20pr%C3%A9nom%20ou%20expression%20souhait%C3%A9e%20%3A%20%0A-%20Style%20ou%20ambiance%20envisag%C3%A9e%20%3A%20%0A-%20Format%20souhait%C3%A9%20%3A%20%0A%0AMerci%20d’avance%2C%0A`;
---

<section
  id="calligraphie-personnalisee"
  class="section band mt-20 scroll-mt-12"
  aria-labelledby="custom-heading">

  <div class="max-w-3xl">
    <p class="eyebrow eyebrow-mark mb-5">
      Création sur mesure & Commandes
    </p>

    <h2 id="custom-heading" class="h-section">
      Vous recherchez une calligraphie personnalisée ?
    </h2>

    <p class="lede mt-6">
      Vous souhaitez faire réaliser un caractère, un prénom, un mot ou une expression particulière ? Christophe Desmur peut créer une calligraphie originale selon votre demande, avec l’assurance d’un tracé traditionnel respectueux de l’esprit et de l’étymologie des sinogrammes.
    </p>

    <!-- Distinction claire : Œuvres disponibles vs Commandes sur mesure -->
    <dl class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-x-10 border-t border-warm-grey">
      <div class="border-b border-warm-grey py-5">
        <dt class="font-serif text-xl text-ink">Œuvres originales à vendre</dt>
        <dd class="meta mt-1.5">
          Pièces uniques déjà réalisées, visibles dans la collection ci-dessus, disponibles immédiatement pour une acquisition directe.
        </dd>
      </div>
      <div class="border-b border-warm-grey py-5">
        <dt class="font-serif text-xl text-ink">Calligraphies sur mesure</dt>
        <dd class="meta mt-1.5">
          Création personnalisée d’après votre choix de sinogramme, devise, poème classique ou prénom transcrit.
        </dd>
      </div>
    </dl>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-6">
      <a href={customMailHref} class="btn btn-ink">
        Demander une calligraphie personnalisée
      </a>
      <a href="/le-calligraphe" class="link-arrow">
        <span>Découvrir le calligraphe Christophe Desmur</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <p class="meta mt-6">
      Vous pouvez également joindre Christophe Desmur par téléphone au <a href={`tel:${telHref(contact.mobile)}`} class="underline underline-offset-4 hover:text-ink">{contact.mobile}</a> ou au <a href={`tel:${telHref(contact.landline)}`} class="underline underline-offset-4 hover:text-ink">{contact.landline}</a> pour échanger de vive voix sur votre projet.
    </p>
  </div>
</section>
