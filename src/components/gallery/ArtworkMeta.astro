---
import type { Artwork } from "@/data/artworks";

export interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
---

<div class="border-t border-warm-grey pt-5">
  <h2 class="eyebrow mb-4">
    Caractéristiques de l’œuvre
  </h2>

  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8">
    <div class="border-t border-warm-grey py-3">
      <dt class="meta text-xs">Sinogramme</dt>
      <dd class="mt-1 flex items-baseline gap-2 text-ink">
        <span class="text-2xl font-serif" lang="zh-Hant">{artwork.character}</span>
        {artwork.pinyin && <span class="meta text-xs">({artwork.pinyin})</span>}
      </dd>
    </div>

    <div class="border-t border-warm-grey py-3">
      <dt class="meta text-xs">Sens &amp; Signification</dt>
      <dd class="mt-1 font-serif italic text-ink">{artwork.frenchMeaning}</dd>
    </div>

    <div class="border-t border-warm-grey py-3">
      <dt class="meta text-xs">Technique</dt>
      <dd class="mt-1 text-[0.95rem] text-ink">{artwork.technique}</dd>
    </div>

    <div class="border-t border-warm-grey py-3">
      <dt class="meta text-xs">Support</dt>
      <dd class="mt-1 text-[0.95rem] text-ink">{artwork.medium}</dd>
    </div>

    {artwork.style && (
      <div class="border-t border-warm-grey py-3">
        <dt class="meta text-xs">Style calligraphique</dt>
        <dd class="mt-1 text-[0.95rem] text-ink">{artwork.style}</dd>
      </div>
    )}

    <div class="border-t border-warm-grey py-3">
      <dt class="meta text-xs">Statut de l’exemplaire</dt>
      <dd class="mt-1 text-[0.95rem] text-ink">Pièce originale unique, signée et scellée au cinabre</dd>
    </div>

    <div class="border-t border-b border-warm-grey py-3">
      <dt class="meta text-xs">Disponibilité</dt>
      <dd class="mt-1 text-[0.95rem] text-ink">
        {artwork.availability === "Disponible"
          ? "Disponible à l’acquisition"
          : "Œuvre vendue / En collection privée"}
      </dd>
    </div>

    <div class="border-t border-b border-warm-grey py-3">
      <dt class="meta text-xs">Acquisition</dt>
      <dd class="mt-1 text-[0.95rem] text-ink">{artwork.price}</dd>
    </div>
  </dl>
</div>
