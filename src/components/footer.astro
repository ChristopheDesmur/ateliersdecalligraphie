---
// Footer.astro - Pied de page avec NAP local complet, navigation thématique et mentions
import { contact, telHref } from "@/data/contact";
import { prices } from "@/data/prices";
import { venues } from "@/data/venues";

const dojo = venues["dojo-zen-de-lyon"];
const miroirs = venues["miroirs-du-ciel"];
---

<footer class="pb-12 text-sm text-soft-ink" aria-label="Pied de page">
  <div class="wrap">
    <div class="border-t border-ink/80 pt-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-x-10 gap-y-12">
      
      <!-- Colonne 1 : Identité & Contact local Lyon -->
      <div class="space-y-5 lg:col-span-3">
        <div>
          <h3 class="font-serif text-3xl font-medium text-ink">
            Christophe Desmur
          </h3>
          <p class="eyebrow mt-2">
            Calligraphie chinoise à Lyon
          </p>
          <p class="text-sm mt-3 leading-relaxed max-w-xs">
            Enseignement traditionnel au pinceau, encre de Chine et transmission culturelle.
          </p>
        </div>
        
        <div class="space-y-3 text-sm">
          <p>
            <strong class="font-medium text-ink">{dojo.name} :</strong><br />
            {dojo.address} ({dojo.district})
          </p>
          <p>
            <strong class="font-medium text-ink">{miroirs.name} :</strong><br />
            {miroirs.address}
          </p>
        </div>

        <div class="pt-4 border-t border-warm-grey text-sm">
          <p>
            <a href={`tel:${telHref(contact.mobile)}`} class="text-ink hover:text-soft-ink tabular-nums transition inline-flex items-center min-h-10">
              {contact.mobile}
            </a>
          </p>
          <p>
            <a href={`tel:${telHref(contact.landline)}`} class="text-ink hover:text-soft-ink tabular-nums transition inline-flex items-center min-h-10">
              {contact.landline}
            </a>
          </p>
          <p>
            <a href={`mailto:${contact.email}`} class="text-ink underline decoration-warm-grey underline-offset-4 hover:decoration-current transition inline-flex items-center min-h-10">
              {contact.email}
            </a>
          </p>
        </div>
      </div>

      <!-- Colonne 2 : Cours & Tarifs -->
      <div class="lg:col-span-3">
        <h3 class="eyebrow mb-4">
          Cours & Formules
        </h3>
        <ul class="space-y-1 text-sm">
          <li>
            <a href="/cours-collectifs" class="footer-link">
              Cours collectifs hebdomadaires (Lyon 4<sup>e</sup>)
            </a>
          </li>
          <li>
            <a href="/cours-individuel-a-domicile" class="footer-link">
              Cours individuels à domicile ({prices.cours_individuel_domicile.reduction_impot_pct} % crédit d’impôt)
            </a>
          </li>
          <li>
            <a href="/tarifs" class="footer-link">
              Grille tarifaire détaillée
            </a>
          </li>
          <li>
            <a href="/cours-collectifs#trial-heading" class="footer-link">
              Première séance d’essai
            </a>
          </li>
          <li>
            <a href="/cours-de-chinois" class="footer-link">
              Cours de langue chinoise & sinogrammes
            </a>
          </li>
          <li>
            <a href="/contact" class="footer-link">
              Contacter Christophe Desmur
            </a>
          </li>
        </ul>
      </div>

      <!-- Colonne 3 : Établissements & Groupes -->
      <div class="lg:col-span-3">
        <h3 class="eyebrow mb-4">
          Pour les structures
        </h3>
        <ul class="space-y-1 text-sm">
          <li>
            <a href="/atelier-de-groupe" class="footer-link">
              Vue d’ensemble des ateliers de groupe
            </a>
          </li>
          <li>
            <a href="/ecoles-primaires" class="footer-link">
              Écoles primaires & enfants (Sumi-e)
            </a>
          </li>
          <li>
            <a href="/colleges" class="footer-link">
              Collèges (temps scolaire)
            </a>
          </li>
          <li>
            <a href="/formats-atelier-pour-les-lycees" class="footer-link">
              Lycées (pause méridienne & projets)
            </a>
          </li>
          <li>
            <a href="/universites-et-grandes-ecoles" class="footer-link">
              Universités & Grandes écoles
            </a>
          </li>
          <li>
            <a href="/comites-entreprise" class="footer-link">
              Comités d’entreprise (CSE) & cohésion
            </a>
          </li>
          <li>
            <a href="/maisons-de-retraite" class="footer-link">
              Maisons de retraite & résidences seniors (EHPAD)
            </a>
          </li>
        </ul>
      </div>

      <!-- Colonne 4 : Découverte & Culture -->
      <div class="lg:col-span-3">
        <h3 class="eyebrow mb-4">
          Découvrir & Culture
        </h3>
        <ul class="space-y-1 text-sm">
          <li>
            <a href="/le-calligraphe" class="footer-link">
              Christophe Desmur (parcours & diplômes)
            </a>
          </li>
          <li>
            <a href="/debuter-calligraphie-chinoise" class="footer-link">
              Guide pour débuter la calligraphie (matériel & Yong)
            </a>
          </li>
          <li>
            <a href="/galerie" class="footer-link">
              Œuvres à vendre (calligraphies originales)
            </a>
          </li>
          <li>
            <a href="/shodo-voie-pinceau" class="footer-link">
              La voie du pinceau (Shodo)
            </a>
          </li>
          <li>
            <a href="/calligraphie-zen" class="footer-link">
              Calligraphie zen & tradition
            </a>
          </li>
          <li>
            <a href="/faq" class="footer-link">
              Foire aux questions (FAQ)
            </a>
          </li>
          <li>
            <a href="/traductions" class="footer-link">
              Traductions littéraires (sommaire & études)
            </a>
          </li>
          <li>
            <a href="/pere-nouvelle" class="footer-link">
              Nouvelle « Père » de Lu Yin (1924)
            </a>
          </li>
          <li>
            <a href="/zeng-jixin-la-guerre-entre-les-rats-et-les-hommes-nouvelle" class="footer-link">
              Nouvelle « La Guerre des rats » de Zeng Jixin
            </a>
          </li>
          <li>
            <a href="/blog" class="footer-link">
              Index de tous les articles et textes
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Mentions de bas de page -->
    <div class="mt-16 pt-6 border-t border-warm-grey flex flex-col sm:flex-row justify-between sm:items-center gap-3 text-xs text-soft-ink">
      <p>
        © {new Date().getFullYear()} Christophe Desmur — Calligraphie chinoise à Lyon. Tous droits réservés.
      </p>
      <p class="sm:text-right">
        Services à domicile agréés Coop A Dom n° {contact.coop_a_dom_agrement} (CGI art. 199 sexdecies).
      </p>
    </div>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    display: inline-block;
    padding-block: 0.4rem;
    line-height: 1.4;
    color: var(--color-soft-ink);
    transition: color 0.2s;
  }
  .footer-link:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-warm-grey);
  }
</style>
