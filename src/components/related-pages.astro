---
export interface Props {
  current: string;
}
const { current } = Astro.props;

const audienceLinks = [
  { href: "/ecoles-primaires", label: "Écoles primaires & enfants" },
  { href: "/colleges", label: "Collèges (temps scolaire)" },
  { href: "/formats-atelier-pour-les-lycees", label: "Lycées (modules & pause méridienne)" },
  { href: "/universites-et-grandes-ecoles", label: "Universités & grandes écoles" },
  { href: "/comites-entreprise", label: "Comités d’entreprise (CSE) & équipes" },
  { href: "/maisons-de-retraite", label: "Maisons de retraite & résidences seniors" },
].filter((p) => p.href !== current);

const generalLinks = [
  { href: "/cours-collectifs", label: "Cours collectifs hebdomadaires à Lyon" },
  { href: "/cours-individuel-a-domicile", label: "Cours individuels à domicile (Lyon)" },
  { href: "/tarifs", label: "Tarifs des cours et ateliers" },
  { href: "/atelier-de-groupe", label: "Ateliers de groupe pour structures" },
].filter((p) => p.href !== current);

const editorialLinks = [
  { href: "/debuter-calligraphie-chinoise", label: "Guide : débuter la calligraphie chinoise" },
  { href: "/calligraphie-zen", label: "Calligraphie zen : geste & respiration" },
  { href: "/shodo-voie-pinceau", label: "Shodō : la voie du pinceau" },
  { href: "/cours-de-chinois", label: "Cours de chinois & calligraphie" },
  { href: "/traductions", label: "Traductions littéraires du chinois" },
  { href: "/galerie", label: "Œuvres originales à vendre" },
  { href: "/le-calligraphe", label: "Christophe Desmur (parcours & diplômes)" },
].filter((p) => p.href !== current);
---

<nav class="mt-16 pt-10 border-t border-warm-grey" aria-label="Pour aller plus loin">
  <h2 class="eyebrow mb-8">
    Pour aller plus loin
  </h2>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 text-sm">
    <!-- Groupe 1 : Autres publics -->
    <div>
      <h3 class="eyebrow mb-3">
        Pour d’autres publics
      </h3>
      <ul>
        {audienceLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="related-link">
              <span class="text-warm-grey select-none" aria-hidden="true">&rarr;</span>
              <span>{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Groupe 2 : Cours & Formules à Lyon -->
    <div>
      <h3 class="eyebrow mb-3">
        Formules & Pratique à Lyon
      </h3>
      <ul>
        {generalLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="related-link">
              <span class="text-warm-grey select-none" aria-hidden="true">&rarr;</span>
              <span>{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Groupe 3 : Culture & Découverte -->
    <div>
      <h3 class="eyebrow mb-3">
        Culture & Découverte
      </h3>
      <ul>
        {editorialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="related-link">
              <span class="text-warm-grey select-none" aria-hidden="true">&rarr;</span>
              <span>{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<style>
  .related-link {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    min-height: 2.5rem;
    padding-block: 0.35rem;
    color: var(--color-soft-ink);
    transition: color 0.2s;
  }
  .related-link:hover {
    color: var(--color-ink);
  }
  .related-link:hover span:last-child {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-warm-grey);
  }
</style>
