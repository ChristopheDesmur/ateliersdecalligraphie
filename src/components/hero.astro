---
// Hero.astro - Section principale d'accueil : claire, concise et orientée décision
---

<section class="pt-4 sm:pt-8 pb-10 sm:pb-14 lg:pb-16" aria-labelledby="hero-title">
  <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- Colonne texte & actions -->
    <div class="lg:col-span-7 flex flex-col">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200/80 dark:border-indigo-800/60 text-xs font-semibold text-indigo-700 dark:text-indigo-300 w-fit mb-3">
        <span>📍 Lyon 4<sup>e</sup> (Croix-Rousse) & Métropole</span>
        <span>•</span>
        <span>Christophe Desmur</span>
      </div>

      <h1
        id="hero-title"
        class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold tracking-tight text-gray-950 dark:text-white leading-[1.12]">
        Calligraphie chinoise à Lyon
      </h1>

      <p class="text-xl sm:text-2xl font-serif italic text-indigo-800 dark:text-indigo-300 mt-2">
        L'art du pinceau, du souffle et de l'encre de Chine
      </p>

      <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 mt-4 leading-relaxed max-w-xl">
        Découvrez la calligraphie chinoise traditionnelle avec <strong>Christophe Desmur</strong>, calligraphe depuis plus de 30 ans. Cours hebdomadaires en petit groupe à la Croix-Rousse, cours particuliers à domicile et ateliers pour structures.
      </p>

      <!-- Reassurance line -->
      <div class="mt-4 flex items-center flex-wrap gap-2 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">
        <span class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-400">
          <span class="text-base">✓</span> Débutants bienvenus
        </span>
        <span class="text-gray-300 dark:text-gray-600 hidden sm:inline">•</span>
        <span class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-400">
          <span class="text-base">✓</span> Petits groupes (2 à 8)
        </span>
        <span class="text-gray-300 dark:text-gray-600 hidden sm:inline">•</span>
        <span class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-400">
          <span class="text-base">✓</span> Matériel 100 % fourni
        </span>
      </div>

      <!-- Actions de conversion principales -->
      <div class="mt-6 sm:mt-8 flex flex-wrap gap-3 sm:gap-4 items-center">
        <!-- CTA Primaire visuellement dominant -->
        <a
          href="/cours-collectifs#trial-heading"
          class="px-6 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl text-sm sm:text-base transition shadow-sm hover:shadow-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 inline-flex items-center justify-center">
          Essayer un cours
        </a>

        <!-- CTA Secondaire -->
        <a
          href="#cours-lyon"
          class="px-5 py-3.5 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 font-medium rounded-xl text-sm sm:text-base transition border border-gray-300 dark:border-gray-700 shadow-2xs inline-flex items-center justify-center">
          Voir les cours
        </a>

        <!-- Lien direct rassurant -->
        <a
          href="tel:+33472078861"
          class="text-xs sm:text-sm text-gray-600 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-white font-medium transition inline-flex items-center gap-1.5 py-2 px-2"
          aria-label="Appeler Christophe Desmur au 04 72 07 88 61">
          <span aria-hidden="true">📞</span> 04 72 07 88 61
        </a>
      </div>

    </div>

    <!-- Colonne visuelle : Oeuvre & Pratique -->
    <div class="lg:col-span-5 relative mt-4 lg:mt-0">
      <div class="relative mx-auto max-w-md lg:max-w-none">
        <!-- Cadre élégant avec ombre douce -->
        <div class="overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg bg-white dark:bg-gray-800">
          <img
            src="/assets/personne-realisant-de-la-calligraphie-avec-un-pinceau-sur-du-papier.webp"
            alt="Christophe Desmur enseignant le maniement du pinceau de calligraphie sur papier absorbant"
            width="600"
            height="420"
            loading="eager"
            class="w-full h-auto object-cover"
          />
          <div class="p-3.5 bg-gray-50/90 dark:bg-gray-800/90 text-xs text-gray-600 dark:text-gray-300 border-t border-gray-100 dark:border-gray-700 flex justify-between items-center">
            <span>Pratique au pinceau & encre de Chine</span>
            <a href="/galerie" class="text-indigo-600 dark:text-indigo-400 font-medium hover:underline inline-flex items-center gap-1">
              Galerie &rarr;
            </a>
          </div>
        </div>

        <!-- Encadré lieu & horaire superposé -->
        <div class="mt-3 sm:mt-0 sm:absolute sm:-bottom-5 sm:-left-5 bg-white dark:bg-gray-800 rounded-xl p-3.5 shadow-md border border-gray-200 dark:border-gray-700 text-xs max-w-xs">
          <p class="font-bold text-gray-900 dark:text-gray-100">Dojo Zen & Miroirs du Ciel</p>
          <p class="text-gray-600 dark:text-gray-300 mt-0.5">Lundi 18&nbsp;h&nbsp;30 • Mercredi 10&nbsp;h</p>
          <p class="text-indigo-600 dark:text-indigo-400 font-semibold mt-0.5">80 € / trimestre (matériel inclus)</p>
        </div>
      </div>
    </div>

  </div>
</section>
