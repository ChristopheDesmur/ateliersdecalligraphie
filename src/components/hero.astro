---
// Hero.astro - Section principale d'accueil : claire, concise et orientée décision
---

<section class="pt-2 sm:pt-6 pb-8 sm:pb-12 lg:pb-14" aria-labelledby="hero-title">
  <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- Colonne texte & actions -->
    <div class="lg:col-span-7 flex flex-col">
      <p class="text-xs uppercase tracking-widest font-semibold text-indigo-700 dark:text-indigo-400 mb-2.5">
        Lyon 4<sup>e</sup> (Croix-Rousse) &bull; Christophe Desmur
      </p>

      <h1
        id="hero-title"
        class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold tracking-tight text-gray-950 dark:text-white leading-[1.12]">
        Calligraphie chinoise à Lyon
      </h1>

      <p class="text-xl sm:text-2xl font-serif italic text-indigo-900 dark:text-indigo-300 mt-2">
        L'art du pinceau, du souffle et de l'encre de Chine
      </p>

      <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 mt-4 leading-relaxed max-w-xl">
        Découvrez la calligraphie chinoise traditionnelle avec <strong>Christophe Desmur</strong>, calligraphe depuis plus de 30 ans. Cours hebdomadaires en petit groupe à la Croix-Rousse, cours particuliers à domicile et ateliers pour structures.
      </p>

      <!-- Ligne de réassurance sobre -->
      <div class="mt-4 flex items-center flex-wrap gap-x-3.5 gap-y-1.5 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300">
        <span class="inline-flex items-center gap-1.5">
          <span class="text-indigo-600 dark:text-indigo-400 text-xs font-bold" aria-hidden="true">✓</span>
          <span>Débutants bienvenus</span>
        </span>
        <span class="text-gray-300 dark:text-gray-600 hidden sm:inline" aria-hidden="true">•</span>
        <span class="inline-flex items-center gap-1.5">
          <span class="text-indigo-600 dark:text-indigo-400 text-xs font-bold" aria-hidden="true">✓</span>
          <span>Petits groupes (2 à 8)</span>
        </span>
        <span class="text-gray-300 dark:text-gray-600 hidden sm:inline" aria-hidden="true">•</span>
        <span class="inline-flex items-center gap-1.5">
          <span class="text-indigo-600 dark:text-indigo-400 text-xs font-bold" aria-hidden="true">✓</span>
          <span>Matériel 100 % fourni</span>
        </span>
      </div>

      <!-- Actions de conversion principales -->
      <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row gap-3 sm:items-center">
        <!-- CTA Primaire visuellement dominant -->
        <a
          href="/cours-collectifs#trial-heading"
          class="w-full sm:w-auto px-6 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl text-sm sm:text-base transition shadow-xs hover:shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-indigo-500 inline-flex items-center justify-center text-center">
          Essayer un cours
        </a>

        <div class="flex items-center gap-2.5 w-full sm:w-auto">
          <!-- CTA Secondaire sobre -->
          <a
            href="#cours-lyon"
            class="flex-1 sm:flex-none px-4 py-3 sm:py-3.5 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 font-medium rounded-xl text-sm sm:text-base transition border border-gray-300 dark:border-gray-700 shadow-2xs inline-flex items-center justify-center text-center">
            Voir les cours
          </a>

          <!-- Lien direct rassurant -->
          <a
            href="tel:+33472078861"
            class="flex-1 sm:flex-none px-3.5 py-3 sm:py-3.5 text-xs sm:text-sm text-gray-700 hover:text-indigo-600 dark:text-gray-300 dark:hover:text-white font-medium transition border border-gray-200 sm:border-transparent dark:border-gray-700 dark:sm:border-transparent rounded-xl text-center inline-flex items-center justify-center gap-1.5"
            aria-label="Appeler Christophe Desmur au 04 72 07 88 61">
            <span aria-hidden="true">📞</span> 04 72 07 88 61
          </a>
        </div>
      </div>

    </div>

    <!-- Colonne visuelle : Oeuvre & Pratique -->
    <div class="lg:col-span-5 relative mt-4 lg:mt-0">
      <div class="relative mx-auto max-w-md lg:max-w-none">
        <div class="overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm bg-white dark:bg-gray-800">
          <img
            src="/assets/personne-realisant-de-la-calligraphie-avec-un-pinceau-sur-du-papier.webp"
            alt="Christophe Desmur enseignant le maniement du pinceau de calligraphie sur papier absorbant"
            width="600"
            height="420"
            loading="eager"
            class="w-full h-auto object-cover"
          />
          <div class="p-3 bg-gray-50/90 dark:bg-gray-800/90 text-xs text-gray-600 dark:text-gray-400 border-t border-gray-100 dark:border-gray-700 flex justify-between items-center">
            <span>Pratique au pinceau & encre de Chine</span>
            <a href="/galerie" class="text-indigo-600 dark:text-indigo-400 font-medium hover:underline inline-flex items-center gap-1">
              Voir la galerie &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
