---
// Features.astro - Sections centrales de la page d'accueil :
// 1. "Quel format vous convient ?" (Offer selection)
// 2. "Cours à Lyon" (Schedules & Decision section : DAY → TIME → LOCATION → PRICE → ACTION)
// 3. "La pratique" (Short explanation of the practice)
// 4. "L'enseignant" (Instructor / credibility)
// 5. "Aperçu de la galerie" (Gallery preview)

const groupAudienceLinks = [
  { title: "Écoles primaires", href: "/ecoles-primaires" },
  { title: "Collèges & Lycées", href: "/colleges" },
  { title: "Universités", href: "/universites-et-grandes-ecoles" },
  { title: "Comités d'entreprise (CSE)", href: "/comites-entreprise" },
  { title: "Résidences seniors (EHPAD)", href: "/maisons-de-retraite" },
];

const galleryArtworks = [
  {
    src: "/assets/FUKU-Bonheur.webp",
    alt: "Calligraphie chinoise du caractère 福 (Fú) signifiant Bonheur",
    title: "福 (Fú) — Bonheur",
    category: "Caractère traditionnel",
  },
  {
    src: "/assets/Shin-1-c2g.webp",
    alt: "Calligraphie du caractère 心 (Xīn), l'Esprit et le Cœur en encre de Chine",
    title: "心 (Xīn) — Cœur & Esprit",
    category: "Philosophie classique",
  },
  {
    src: "/assets/mushotoku-c2g.webp",
    alt: "Calligraphie zen de l'esprit Mushotoku",
    title: "無所得 (Mushotoku)",
    category: "Calligraphie zen",
  },
  {
    src: "/assets/cours-calligraphie-comites-entreprise.webp",
    alt: "Calligraphie traditionnelle du caractère 平 (Píng) signifiant la Paix",
    title: "平 (Píng) — Paix & Sérénité",
    category: "Harmonie du trait",
  },
];
---

<div class="space-y-16 sm:space-y-20 lg:space-y-24 mt-2 sm:mt-6">

  <!-- ================================================================= -->
  <!-- 1. QUEL FORMAT VOUS CONVIENT ? (Offer Selection)                  -->
  <!-- ================================================================= -->
  <section id="formats" aria-labelledby="formats-heading" class="scroll-mt-6">
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-12">
      <span class="text-indigo-600 dark:text-indigo-400 uppercase tracking-widest text-xs font-semibold">
        Que recherchez-vous ?
      </span>
      <h2 id="formats-heading" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-gray-950 dark:text-gray-100 mt-1.5">
        Quel format vous convient ?
      </h2>
      <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base mt-2 leading-relaxed">
        Trois approches de la calligraphie chinoise selon vos attentes, votre rythme et votre localisation.
      </p>
    </div>

    <!-- 3 Cartes sobres & éditoriales (sans artifices SaaS) -->
    <div class="grid md:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto">
      
      <!-- Option A : COURS COLLECTIFS -->
      <div class="bg-white dark:bg-gray-800/90 rounded-2xl p-6 sm:p-7 border border-gray-200/90 dark:border-gray-700/80 shadow-2xs hover:border-indigo-200 dark:hover:border-indigo-900 transition flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-xs uppercase tracking-wider font-semibold text-indigo-700 dark:text-indigo-400">
              Hebdomadaire
            </span>
            <span class="text-xs text-gray-500 dark:text-gray-400">Lyon 4<sup>e</sup></span>
          </div>

          <h3 class="text-2xl font-serif font-bold text-gray-950 dark:text-gray-100">
            Cours collectifs
          </h3>
          <p class="text-sm font-serif italic text-indigo-800 dark:text-indigo-300 mt-0.5">
            Cours hebdomadaires à Lyon
          </p>

          <p class="text-sm text-gray-600 dark:text-gray-300 mt-3 leading-relaxed">
            Pour progresser chaque semaine en petit groupe convivial. Apprentissage du maniement du pinceau, des 8 traits fondamentaux et des styles classiques.
          </p>

          <!-- Spécifications typographiques claires -->
          <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700/70 space-y-2 text-xs text-gray-700 dark:text-gray-300">
            <p>
              <strong class="text-gray-900 dark:text-gray-100 font-medium">Lieux :</strong> Dojo Zen (lundi 18h30) & Miroirs du Ciel (mercredi 10h)
            </p>
            <p>
              <strong class="text-gray-900 dark:text-gray-100 font-medium">Groupe :</strong> 2 à 8 personnes · Débutants et initiés
            </p>
            <p>
              <strong class="text-gray-900 dark:text-gray-100 font-medium">Tarif :</strong> <span class="font-bold text-indigo-700 dark:text-indigo-400 text-sm">80 € / trimestre</span> (matériel inclus)
            </p>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700/70">
          <a
            href="#cours-lyon"
            class="w-full py-2.5 px-4 rounded-xl bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-900 dark:text-gray-100 text-sm font-medium transition text-center inline-flex items-center justify-center gap-1">
            Voir les cours & horaires &darr;
          </a>
        </div>
      </div>

      <!-- Option B : COURS INDIVIDUELS -->
      <div class="bg-white dark:bg-gray-800/90 rounded-2xl p-6 sm:p-7 border border-gray-200/90 dark:border-gray-700/80 shadow-2xs hover:border-emerald-200 dark:hover:border-emerald-900 transition flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-xs uppercase tracking-wider font-semibold text-emerald-800 dark:text-emerald-400">
              Crédit d'impôt 50 %
            </span>
            <span class="text-xs text-gray-500 dark:text-gray-400">À domicile</span>
          </div>

          <h3 class="text-2xl font-serif font-bold text-gray-950 dark:text-gray-100">
            Cours individuels
          </h3>
          <p class="text-sm font-serif italic text-emerald-800 dark:text-emerald-300 mt-0.5">
            Un accompagnement personnalisé
          </p>

          <p class="text-sm text-gray-600 dark:text-gray-300 mt-3 leading-relaxed">
            Pour apprendre à votre rythme avec l'attention exclusive de Christophe Desmur, directement chez vous avec tout le matériel mis à disposition.
          </p>

          <!-- Spécifications typographiques claires -->
          <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700/70 space-y-2 text-xs text-gray-700 dark:text-gray-300">
            <p>
              <strong class="text-gray-900 dark:text-gray-100 font-medium">Lieu :</strong> À votre domicile (Lyon & métropole)
            </p>
            <p>
              <strong class="text-gray-900 dark:text-gray-100 font-medium">Rythme :</strong> Horaires et fréquence entièrement modulables
            </p>
            <p>
              <strong class="text-gray-900 dark:text-gray-100 font-medium">Tarif :</strong> <span class="font-bold text-emerald-800 dark:text-emerald-400 text-sm">40 € TTC / h</span> (soit 20 € net après crédit d'impôt Coop A Dom)
            </p>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700/70">
          <a
            href="/cours-individuel-a-domicile"
            class="w-full py-2.5 px-4 rounded-xl border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 text-sm font-medium transition text-center inline-flex items-center justify-center gap-1">
            Découvrir les cours individuels &rarr;
          </a>
        </div>
      </div>

      <!-- Option C : ATELIERS POUR GROUPES -->
      <div class="bg-white dark:bg-gray-800/90 rounded-2xl p-6 sm:p-7 border border-gray-200/90 dark:border-gray-700/80 shadow-2xs hover:border-amber-200 dark:hover:border-amber-900 transition flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-xs uppercase tracking-wider font-semibold text-amber-800 dark:text-amber-400">
              Structures & Équipes
            </span>
            <span class="text-xs text-gray-500 dark:text-gray-400">Sur site</span>
          </div>

          <h3 class="text-2xl font-serif font-bold text-gray-950 dark:text-gray-100">
            Ateliers pour groupes
          </h3>
          <p class="text-sm font-serif italic text-amber-800 dark:text-amber-300 mt-0.5">
            Écoles, entreprises, associations, etc.
          </p>

          <p class="text-sm text-gray-600 dark:text-gray-300 mt-3 leading-relaxed">
            Interventions culturelles sur mesure de 1 h à 3 h : découverte de l'encre, pictogrammes, initiation au Sumi-e et cohésion d'équipe.
          </p>

          <!-- Spécifications typographiques claires -->
          <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700/70 space-y-2 text-xs text-gray-700 dark:text-gray-300">
            <p>
              <strong class="text-gray-900 dark:text-gray-100 font-medium">Lieu :</strong> Dans votre établissement à Lyon et région
            </p>
            <p>
              <strong class="text-gray-900 dark:text-gray-100 font-medium">Publics :</strong> Écoles, lycées, universités, CSE, EHPAD
            </p>
            <p>
              <strong class="text-gray-900 dark:text-gray-100 font-medium">Tarif :</strong> Dès <span class="font-bold text-gray-900 dark:text-gray-100 text-sm">60 € HT / heure</span> (matériel complet fourni)
            </p>
          </div>

          <!-- Liens éditoriaux vers les formules spécifiques -->
          <div class="mt-3 pt-2 text-[11px] text-gray-500 dark:text-gray-400 flex flex-wrap gap-x-2 gap-y-1">
            {groupAudienceLinks.map((sub, i) => (
              <span>
                <a href={sub.href} class="hover:text-indigo-600 dark:hover:text-indigo-400 underline decoration-gray-300 dark:decoration-gray-600 transition">
                  {sub.title}
                </a>
                {i < groupAudienceLinks.length - 1 && <span class="text-gray-300 dark:text-gray-600 ml-1">·</span>}
              </span>
            ))}
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700/70">
          <a
            href="/atelier-de-groupe"
            class="w-full py-2.5 px-4 rounded-xl border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 text-sm font-medium transition text-center inline-flex items-center justify-center gap-1">
            Organiser un atelier &rarr;
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 2. COURS À LYON : DÉCISION SCANNABLE (DAY → TIME → PLACE → PRICE)  -->
  <!-- ================================================================= -->
  <section id="cours-lyon" aria-labelledby="schedule-section-heading" class="scroll-mt-6 pt-4">
    <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-10">
      <span class="text-indigo-600 dark:text-indigo-400 uppercase tracking-widest text-xs font-semibold">
        Créneaux hebdomadaires à Lyon 4<sup>e</sup>
      </span>
      <h2 id="schedule-section-heading" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-gray-950 dark:text-gray-100 mt-1.5">
        Cours de calligraphie à Lyon : horaires & lieux
      </h2>
      <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base mt-2 leading-relaxed">
        Deux créneaux hebdomadaires réguliers à la Croix-Rousse. Séances de 2 heures en petit groupe (2 à 8 élèves) avec tout le matériel fourni.
      </p>
    </div>

    <!-- 2 Schedule Decision Cards (Pure scan pattern: DAY → TIME → PLACE → PRICE → ACTION) -->
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto">
      
      <!-- Cours 1 : LUNDI SOIR -->
      <article class="bg-white dark:bg-gray-800/90 rounded-2xl p-6 sm:p-8 border border-gray-200/90 dark:border-gray-700/80 shadow-2xs flex flex-col justify-between">
        <div class="space-y-4">
          <!-- DAY & TIME -->
          <div class="flex items-baseline justify-between border-b border-gray-100 dark:border-gray-700/60 pb-3.5">
            <h3 class="text-2xl sm:text-3xl font-serif font-bold text-gray-950 dark:text-gray-100">
              Lundi soir
            </h3>
            <span class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100">
              18&nbsp;h&nbsp;30 – 20&nbsp;h&nbsp;30
            </span>
          </div>

          <!-- LOCATION -->
          <div>
            <p class="font-bold text-base text-gray-950 dark:text-gray-100">
              Dojo Zen de Lyon
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-300 mt-0.5">
              11, rue Dumenge, 69004 Lyon (Plateau Croix-Rousse)
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
              Métro C (Croix-Rousse ou Hénon) • Bus C13, 2, 33, 45
            </p>
          </div>

          <!-- PRICE -->
          <div class="pt-3 border-t border-gray-100 dark:border-gray-700/60 flex items-baseline justify-between">
            <div>
              <span class="text-2xl font-serif font-bold text-indigo-700 dark:text-indigo-400">80 €</span>
              <span class="text-xs text-gray-500 dark:text-gray-400"> / trimestre</span>
            </div>
            <span class="text-xs text-gray-500 dark:text-gray-400">
              Matériel fourni · 2 à 8 élèves
            </span>
          </div>
        </div>

        <!-- ACTION -->
        <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700/60 flex flex-col sm:flex-row gap-3 items-center">
          <a
            href="mailto:christophe.desmur@orange.fr?subject=Demande%20de%20s%C3%A9ance%20d'essai%20-%20Lundi%20Dojo%20Zen"
            class="w-full sm:flex-1 py-3 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm text-center transition shadow-xs">
            Essayer ce cours (lundi)
          </a>
          <a
            href="/cours-collectifs"
            class="text-xs font-medium text-gray-600 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition py-1">
            Détails &rarr;
          </a>
        </div>
      </article>

      <!-- Cours 2 : MERCREDI MATIN -->
      <article class="bg-white dark:bg-gray-800/90 rounded-2xl p-6 sm:p-8 border border-gray-200/90 dark:border-gray-700/80 shadow-2xs flex flex-col justify-between">
        <div class="space-y-4">
          <!-- DAY & TIME -->
          <div class="flex items-baseline justify-between border-b border-gray-100 dark:border-gray-700/60 pb-3.5">
            <h3 class="text-2xl sm:text-3xl font-serif font-bold text-gray-950 dark:text-gray-100">
              Mercredi matin
            </h3>
            <span class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100">
              10&nbsp;h&nbsp;00 – 12&nbsp;h&nbsp;00
            </span>
          </div>

          <!-- LOCATION -->
          <div>
            <p class="font-bold text-base text-gray-950 dark:text-gray-100">
              Boutique Miroirs du Ciel
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-300 mt-0.5">
              9, rue de Belfort, 69004 Lyon (Cœur Croix-Rousse)
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
              Métro C (Croix-Rousse à 3 min à pied)
            </p>
          </div>

          <!-- PRICE -->
          <div class="pt-3 border-t border-gray-100 dark:border-gray-700/60 flex items-baseline justify-between">
            <div>
              <span class="text-2xl font-serif font-bold text-indigo-700 dark:text-indigo-400">80 €</span>
              <span class="text-xs text-gray-500 dark:text-gray-400"> / trimestre</span>
            </div>
            <span class="text-xs text-gray-500 dark:text-gray-400">
              Matériel fourni · 2 à 8 élèves
            </span>
          </div>
        </div>

        <!-- ACTION -->
        <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700/60 flex flex-col sm:flex-row gap-3 items-center">
          <a
            href="mailto:christophe.desmur@orange.fr?subject=Demande%20de%20s%C3%A9ance%20d'essai%20-%20Mercredi%20Miroirs%20du%20Ciel"
            class="w-full sm:flex-1 py-3 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm text-center transition shadow-xs">
            Essayer ce cours (mercredi)
          </a>
          <a
            href="/cours-collectifs"
            class="text-xs font-medium text-gray-600 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition py-1">
            Détails &rarr;
          </a>
        </div>
      </article>

    </div>

    <!-- Reassurance discrète & plan pliable -->
    <div class="max-w-5xl mx-auto mt-6">
      <div class="p-4 rounded-xl bg-gray-50/80 dark:bg-gray-800/50 border border-gray-200/80 dark:border-gray-700/60 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-600 dark:text-gray-300">
        <div class="flex items-center gap-2">
          <span class="text-emerald-600 dark:text-emerald-400 font-bold text-sm">✓</span>
          <span><strong>Séance d'essai sans engagement :</strong> premier cours de découverte pour faire l'expérience du pinceau.</span>
        </div>
        <a href="/tarifs" class="text-indigo-600 dark:text-indigo-400 font-medium hover:underline shrink-0">
          Grille tarifaire complète &rarr;
        </a>
      </div>

      <!-- Carte repliable : ne bloque pas le scroll mobile -->
      <details class="mt-3 group bg-white dark:bg-gray-800 rounded-xl border border-gray-200/80 dark:border-gray-700/60 overflow-hidden">
        <summary class="p-3.5 flex items-center justify-between cursor-pointer font-medium text-xs text-gray-700 dark:text-gray-300 list-none select-none hover:text-indigo-600 dark:hover:text-indigo-400 transition">
          <span class="flex items-center gap-2">
            <span>🗺️</span>
            <span>Afficher le plan d'accès Google Maps (Dojo Zen & Miroirs du Ciel, Lyon Croix-Rousse)</span>
          </span>
          <span class="text-xs text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="h-56 sm:h-72 border-t border-gray-200/80 dark:border-gray-700/60">
          <iframe
            class="w-full h-full border-0"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2782.717423001606!2d4.831558576633833!3d45.7768530710809!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47f4eae2496297a7%3A0xcf33e8e7e6f48d44!2sZen%20Dojo!5e0!3m2!1sfr!2sfr!4v1756472471300!5m2!1sfr!2sfr"
            allowfullscreen=""
            loading="lazy"
            title="Plan des lieux de cours de calligraphie chinoise à Lyon Croix-Rousse"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </details>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 3. LA PRATIQUE : UN ART DU GESTE ET DU SOUFFLE                    -->
  <!-- ================================================================= -->
  <section id="pratique" aria-labelledby="practice-heading" class="max-w-5xl mx-auto pt-4">
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
      <span class="text-indigo-600 dark:text-indigo-400 uppercase tracking-widest text-xs font-semibold">
        Comprendre la démarche
      </span>
      <h2 id="practice-heading" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-gray-950 dark:text-gray-100 mt-1.5">
        La pratique de la calligraphie chinoise
      </h2>
      <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base mt-2 leading-relaxed">
        Loin d'une simple écriture formelle, la calligraphie traditionnelle est un art où le corps, le souffle et le pinceau s'harmonisent sur le papier.
      </p>
    </div>

    <!-- 4 piliers au style typographique calme (sans badges numérotés SaaS) -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-gray-800/90 border border-gray-200/90 dark:border-gray-700/80 shadow-2xs">
        <h3 class="font-serif font-bold text-gray-950 dark:text-gray-100 text-lg mb-2">
          Posture & Souffle
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Une assise stable et un souffle apaisé ouvrent la concentration. L'esprit se pose avant que le pinceau ne touche la feuille.
        </p>
      </div>

      <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-gray-800/90 border border-gray-200/90 dark:border-gray-700/80 shadow-2xs">
        <h3 class="font-serif font-bold text-gray-950 dark:text-gray-100 text-lg mb-2">
          L'encre & la pierre
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Frotter le bâton d'encre de Chine sur la pierre à l'eau est un rituel d'intériorisation pour préparer le noir profond.
        </p>
      </div>

      <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-gray-800/90 border border-gray-200/90 dark:border-gray-700/80 shadow-2xs">
        <h3 class="font-serif font-bold text-gray-950 dark:text-gray-100 text-lg mb-2">
          Le pinceau & les traits
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Tenue verticale du pinceau et tracé des huit traits fondamentaux (le caractère <em>Yong</em> 永) qui composent l'écriture chinoise.
        </p>
      </div>

      <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-gray-800/90 border border-gray-200/90 dark:border-gray-700/80 shadow-2xs">
        <h3 class="font-serif font-bold text-gray-950 dark:text-gray-100 text-lg mb-2">
          Accessible à tous
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Aucun prérequis artistique ni linguistique. Pas besoin de parler chinois : l'apprentissage est sensoriel, visuel et progressif.
        </p>
      </div>

    </div>

    <!-- Lien vers Shodo & Culture -->
    <div class="mt-6 text-center">
      <a href="/shodo-voie-pinceau" class="text-xs sm:text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline inline-flex items-center gap-1">
        En savoir plus sur la voie du pinceau (Shodo) &rarr;
      </a>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 4. L'ENSEIGNANT : CHRISTOPHE DESMUR (Credibilité & Approche)      -->
  <!-- ================================================================= -->
  <section id="enseignant" aria-labelledby="instructor-heading" class="max-w-5xl mx-auto pt-4">
    <div class="p-6 sm:p-8 lg:p-10 rounded-2xl bg-gray-50/80 dark:bg-gray-800/60 border border-gray-200/80 dark:border-gray-700/70">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-4 text-center lg:text-left">
          <img
            src="/assets/christophe-desmur-calligraphie-chinoise.webp"
            alt="Christophe Desmur écrivant au pinceau de calligraphie à Lyon"
            width="400"
            height="400"
            loading="lazy"
            class="w-40 h-40 sm:w-48 sm:h-48 lg:w-full lg:h-auto object-cover rounded-xl shadow-xs mx-auto border border-gray-200 dark:border-gray-700"
          />
        </div>

        <div class="lg:col-span-8">
          <span class="text-indigo-600 dark:text-indigo-400 uppercase tracking-widest text-xs font-semibold">
            L'enseignant
          </span>
          <h2 id="instructor-heading" class="text-2xl sm:text-3xl font-serif font-bold text-gray-950 dark:text-gray-100 mt-1">
            Christophe Desmur : trente ans de transmission à Lyon
          </h2>
          
          <p class="text-sm sm:text-base text-gray-700 dark:text-gray-300 mt-3 leading-relaxed">
            Titulaire d'une maîtrise de langue et civilisation chinoises et d'un master de traduction littéraire chinois-français, <strong>Christophe Desmur</strong> pratique et transmet la calligraphie chinoise depuis plus de trois décennies.
          </p>
          
          <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 mt-2.5 leading-relaxed">
            Son enseignement met l'accent sur la justesse du geste, la respiration apaisée et l'attention individuelle. En petit groupe de 2 à 8 élèves ou en cours particulier, chacun avance à son rythme dans un cadre calme et attentif.
          </p>

          <div class="mt-5 flex flex-wrap gap-4 items-center">
            <a
              href="/le-calligraphe"
              class="px-5 py-2.5 rounded-xl bg-gray-900 hover:bg-gray-800 text-white dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-white font-medium text-xs sm:text-sm transition">
              Découvrir son parcours
            </a>
            <a
              href="/galerie"
              class="text-xs sm:text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline">
              Voir ses calligraphies originales &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 5. APERÇU DE LA GALERIE                                           -->
  <!-- ================================================================= -->
  <section id="galerie-preview" aria-labelledby="gallery-preview-heading" class="max-w-6xl mx-auto pt-4">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6 sm:mb-8">
      <div>
        <span class="text-indigo-600 dark:text-indigo-400 uppercase tracking-widest text-xs font-semibold">
          Authenticité & Savoir-faire
        </span>
        <h2 id="gallery-preview-heading" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-gray-950 dark:text-gray-100 mt-1">
          Aperçu des calligraphies à l'encre
        </h2>
        <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">
          Caractères traditionnels tracés d'un seul souffle à l'encre de Chine sur papier absorbant.
        </p>
      </div>

      <a
        href="/galerie"
        class="text-xs sm:text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline inline-flex items-center gap-1 shrink-0">
        Voir toute la galerie ({galleryArtworks.length}+ pièces) &rarr;
      </a>
    </div>

    <!-- 4 Curated Artwork Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-6">
      {galleryArtworks.map((art) => (
        <a
          href="/galerie"
          class="group bg-white dark:bg-gray-800/90 rounded-2xl overflow-hidden border border-gray-200/90 dark:border-gray-700/80 shadow-2xs hover:shadow-xs transition flex flex-col justify-between">
          <div class="h-40 sm:h-52 overflow-hidden bg-gray-50 dark:bg-gray-900 flex items-center justify-center p-3">
            <img
              src={art.src}
              alt={art.alt}
              width="300"
              height="240"
              loading="lazy"
              class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <div class="p-3.5 sm:p-4 border-t border-gray-100 dark:border-gray-700/60">
            <span class="text-[10px] uppercase font-semibold text-indigo-600 dark:text-indigo-400 tracking-wider">
              {art.category}
            </span>
            <p class="font-serif font-bold text-sm text-gray-950 dark:text-gray-100 mt-0.5 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition">
              {art.title}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>

</div>

