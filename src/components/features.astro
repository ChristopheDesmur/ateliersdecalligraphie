      <div class="lg:col-span-4 text-center lg:text-left">
        <img
          src="/assets/christophe-desmur-calligraphie-chinoise.webp"
          alt="Christophe Desmur en train d'écrire au pinceau de calligraphie à Lyon"
          width="400"
          height="400"
          loading="lazy"
          class="w-44 h-44 sm:w-52 sm:h-52 lg:w-full lg:h-auto object-cover rounded-2xl shadow-md mx-auto"
        />
