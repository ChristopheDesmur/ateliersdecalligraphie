---
// Features.astro - Sections centrales de la page d'accueil réorganisées selon le nouveau parcours utilisateur :
// 1. "Quel format vous convient ?" (Offer selection)
// 2. "Cours à Lyon" (Schedules & Decision cards)
// 3. "La pratique" (Short explanation of the practice)
// 4. "L'enseignant" (Instructor / credibility)
// 5. "Aperçu de la galerie" (Gallery preview)

const groupSubLinks = [
  { title: "Écoles primaires", href: "/ecoles-primaires" },
  { title: "Collèges & Lycées", href: "/colleges" },
  { title: "Universités", href: "/universites-et-grandes-ecoles" },
  { title: "Comités d'entreprise (CSE)", href: "/comites-entreprise" },
  { title: "Maisons de retraite & EHPAD", href: "/maisons-de-retraite" },
];

const galleryArtworks = [
  {
    src: "/assets/FUKU-Bonheur.webp",
    alt: "Calligraphie chinoise du caractère 福 (Fú) signifiant Bonheur",
    title: "福 (Fú) — Bonheur",
    category: "Caractère traditionnel",
  },
  {
    src: "/assets/Shin-1-c2g.webp",
    alt: "Calligraphie du caractère 心 (Xīn), l'Esprit et le Cœur en encre de Chine",
    title: "心 (Xīn) — Cœur / Esprit",
    category: "Philosophie",
  },
  {
    src: "/assets/mushotoku-c2g.webp",
    alt: "Calligraphie zen de l'esprit Mushotoku",
    title: "無所得 (Mushotoku)",
    category: "Calligraphie zen",
  },
  {
    src: "/assets/cours-calligraphie-comites-entreprise.webp",
    alt: "Calligraphie traditionnelle du caractère 平 (Píng) signifiant la Paix",
    title: "平 (Píng) — Paix & Sérénité",
    category: "Harmonie",
  },
];
---

<div class="space-y-20 sm:space-y-24 lg:space-y-28 mt-4 sm:mt-8">

  <!-- ================================================================= -->
  <!-- 1. QUEL FORMAT VOUS CONVIENT ? (Offer Selection)                  -->
  <!-- ================================================================= -->
  <section id="formats" aria-labelledby="formats-heading" class="scroll-mt-8">
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
      <span class="text-indigo-600 dark:text-indigo-400 uppercase tracking-widest text-xs font-semibold">
        Que recherchez-vous ?
      </span>
      <h2 id="formats-heading" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-gray-950 dark:text-gray-100 mt-2">
        Quel format vous convient ?
      </h2>
      <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base mt-3 leading-relaxed">
        Trois manières de pratiquer la calligraphie chinoise selon vos attentes, votre rythme et votre localisation.
      </p>
    </div>

    <!-- 3 Scannable Cards -->
    <div class="grid md:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto">
      
      <!-- Option A : COURS COLLECTIFS -->
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-7 border border-gray-200 dark:border-gray-700 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/40">
              Hebdomadaire
            </span>
            <span class="text-xs font-semibold text-gray-500 dark:text-gray-400">Lyon 4<sup>e</sup></span>
          </div>

          <h3 class="text-xl font-bold text-gray-950 dark:text-gray-100">
            Cours collectifs
          </h3>
          <p class="text-sm font-serif italic text-indigo-700 dark:text-indigo-300 mt-0.5">
            Cours hebdomadaires à Lyon
          </p>

          <p class="text-sm text-gray-600 dark:text-gray-300 mt-3 leading-relaxed">
            Pour progresser chaque semaine au sein d'un petit groupe convivial. Apprentissage guidé du pinceau, des traits et des caractères.
          </p>

          <!-- Détails clés scannables -->
          <ul class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 space-y-2 text-xs text-gray-700 dark:text-gray-300">
            <li class="flex items-start gap-2">
              <span class="text-indigo-600 dark:text-indigo-400 font-bold shrink-0">📍</span>
              <span>Dojo Zen (lundi 18h30) & Miroirs du Ciel (mercredi 10h)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-indigo-600 dark:text-indigo-400 font-bold shrink-0">👥</span>
              <span>2 à 8 élèves · Débutants et initiés</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-indigo-600 dark:text-indigo-400 font-bold shrink-0">💶</span>
              <span><strong>80 € / trimestre</strong> (matériel 100 % fourni)</span>
            </li>
          </ul>
        </div>

        <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700">
          <a
            href="#cours-lyon"
            class="w-full py-2.5 px-4 rounded-xl bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-900 dark:text-gray-100 text-sm font-medium transition text-center inline-flex items-center justify-center gap-1">
            Voir les cours & horaires &darr;
          </a>
        </div>
      </div>

      <!-- Option B : COURS INDIVIDUELS -->
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-7 border border-gray-200 dark:border-gray-700 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/40">
              Crédit d'impôt 50 %
            </span>
            <span class="text-xs font-semibold text-gray-500 dark:text-gray-400">À domicile</span>
          </div>

          <h3 class="text-xl font-bold text-gray-950 dark:text-gray-100">
            Cours individuels
          </h3>
          <p class="text-sm font-serif italic text-emerald-800 dark:text-emerald-300 mt-0.5">
            Un accompagnement personnalisé
          </p>

          <p class="text-sm text-gray-600 dark:text-gray-300 mt-3 leading-relaxed">
            Pour apprendre à votre rythme avec l'attention exclusive de Christophe Desmur, directement chez vous à Lyon et dans son agglomération.
          </p>

          <!-- Détails clés scannables -->
          <ul class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 space-y-2 text-xs text-gray-700 dark:text-gray-300">
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">📍</span>
              <span>À votre domicile (Lyon & métropole)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">👥</span>
              <span>Accompagnement 1-à-1 entièrement sur mesure</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">💶</span>
              <span><strong>40 € TTC/h</strong> (soit 20 € net après crédit d'impôt Coop A Dom)</span>
            </li>
          </ul>
        </div>

        <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700">
          <a
            href="/cours-individuel-a-domicile"
            class="w-full py-2.5 px-4 rounded-xl border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 text-sm font-medium transition text-center inline-flex items-center justify-center gap-1">
            Découvrir les cours individuels &rarr;
          </a>
        </div>
      </div>

      <!-- Option C : ATELIERS POUR GROUPES -->
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-7 border border-gray-200 dark:border-gray-700 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 dark:bg-amber-950/70 text-amber-800 dark:text-amber-300 border border-amber-200/60 dark:border-amber-800/40">
              Structures & Équipes
            </span>
            <span class="text-xs font-semibold text-gray-500 dark:text-gray-400">Sur site</span>
          </div>

          <h3 class="text-xl font-bold text-gray-950 dark:text-gray-100">
            Ateliers pour groupes
          </h3>
          <p class="text-sm font-serif italic text-amber-800 dark:text-amber-300 mt-0.5">
            Écoles, entreprises, associations, etc.
          </p>

          <p class="text-sm text-gray-600 dark:text-gray-300 mt-3 leading-relaxed">
            Séances sur mesure de 1 h à 3 h : découverte culturelle, initiation au Sumi-e, détente et cohésion d'équipe. Matériel inclus.
          </p>

          <!-- Détails clés scannables -->
          <ul class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 space-y-2 text-xs text-gray-700 dark:text-gray-300">
            <li class="flex items-start gap-2">
              <span class="text-amber-600 dark:text-amber-400 font-bold shrink-0">📍</span>
              <span>Déplacement dans votre établissement (Lyon & région)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-600 dark:text-amber-400 font-bold shrink-0">👥</span>
              <span>Classes scolaires, salariés CSE, résidents EHPAD</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-600 dark:text-amber-400 font-bold shrink-0">💶</span>
              <span>Dès <strong>60 € HT / heure</strong> (matériel fourni)</span>
            </li>
          </ul>

          <!-- Liens rapides vers les formules spécifiques -->
          <div class="mt-3 flex flex-wrap gap-1.5 pt-2">
            {groupSubLinks.map((sub) => (
              <a
                href={sub.href}
                class="text-[11px] px-2 py-0.5 rounded-md bg-gray-100 dark:bg-gray-700/80 text-gray-700 dark:text-gray-300 hover:bg-indigo-50 dark:hover:bg-gray-600 hover:text-indigo-600 dark:hover:text-indigo-300 transition">
                {sub.title}
              </a>
            ))}
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700">
          <a
            href="/atelier-de-groupe"
            class="w-full py-2.5 px-4 rounded-xl border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 text-sm font-medium transition text-center inline-flex items-center justify-center gap-1">
            Organiser un atelier &rarr;
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 2. COURS À LYON : HORAIRES & DÉCISION                             -->
  <!-- ================================================================= -->
  <section id="cours-lyon" aria-labelledby="schedule-section-heading" class="scroll-mt-8 bg-gray-50/80 dark:bg-gray-800/50 rounded-3xl p-6 sm:p-10 border border-gray-200 dark:border-gray-700">
    <div class="max-w-3xl mb-8">
      <span class="text-indigo-600 dark:text-indigo-400 uppercase tracking-widest text-xs font-semibold">
        Créneaux hebdomadaires à Lyon 4<sup>e</sup>
      </span>
      <h2 id="schedule-section-heading" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-gray-950 dark:text-gray-100 mt-2">
        Cours de calligraphie à Lyon : horaires & lieux
      </h2>
      <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base mt-2 leading-relaxed">
        Deux créneaux réguliers au choix chaque semaine à la Croix-Rousse. Séances de 2 heures en petit groupe (2 à 8 personnes) avec matériel complet fourni.
      </p>
    </div>

    <!-- 2 Schedule Decision Cards -->
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
      
      <!-- Cours 1 : LUNDI -->
      <article class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-7 border border-gray-200 dark:border-gray-700 shadow-xs flex flex-col justify-between">
        <div>
          <!-- DAY + TIME -->
          <div class="flex items-baseline justify-between border-b border-gray-100 dark:border-gray-700 pb-3 mb-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Jour</span>
              <h3 class="text-2xl font-serif font-bold text-gray-950 dark:text-gray-100">
                Lundi
              </h3>
            </div>
            <div class="text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Horaire</span>
              <p class="text-xl font-bold text-gray-900 dark:text-gray-100">
                18&nbsp;h&nbsp;30 – 20&nbsp;h&nbsp;30
              </p>
            </div>
          </div>

          <!-- LOCATION -->
          <div class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Lieu</span>
            <p class="text-lg font-bold text-gray-900 dark:text-gray-100">
              Dojo Zen de Lyon
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-300">
              📍 11, rue Dumenge, 69004 Lyon (Plateau Croix-Rousse)
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400 pt-0.5">
              Métro C (Croix-Rousse ou Hénon) • Bus C13, 2, 33, 45
            </p>
          </div>

          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 mt-3.5 leading-relaxed bg-gray-50 dark:bg-gray-900/60 p-3 rounded-xl border border-gray-100 dark:border-gray-700/60">
            Cadre sobre et silencieux, propice à l'attitude corporelle, au souffle posé et à la concentration.
          </p>

          <!-- PRICE -->
          <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-700 flex items-baseline justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Tarif</span>
            <div class="text-right">
              <span class="text-xl font-bold text-indigo-700 dark:text-indigo-400">80 €</span>
              <span class="text-xs text-gray-500 dark:text-gray-400"> / trimestre</span>
              <p class="text-[11px] text-gray-500 dark:text-gray-400">matériel 100 % inclus</p>
            </div>
          </div>
        </div>

        <!-- CTA DECISION -->
        <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700 flex flex-col sm:flex-row gap-2.5 items-center">
          <a
            href="mailto:christophe.desmur@orange.fr?subject=Demande%20de%20s%C3%A9ance%20d'essai%20-%20Lundi%20Dojo%20Zen"
            class="w-full sm:flex-1 py-3 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm text-center transition shadow-xs">
            Essayer ce cours (lundi)
          </a>
          <a
            href="/cours-collectifs"
            class="text-xs text-gray-600 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium py-1">
            Détails &rarr;
          </a>
        </div>
      </article>

      <!-- Cours 2 : MERCREDI -->
      <article class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-7 border border-gray-200 dark:border-gray-700 shadow-xs flex flex-col justify-between">
        <div>
          <!-- DAY + TIME -->
          <div class="flex items-baseline justify-between border-b border-gray-100 dark:border-gray-700 pb-3 mb-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Jour</span>
              <h3 class="text-2xl font-serif font-bold text-gray-950 dark:text-gray-100">
                Mercredi
              </h3>
            </div>
            <div class="text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Horaire</span>
              <p class="text-xl font-bold text-gray-900 dark:text-gray-100">
                10&nbsp;h&nbsp;00 – 12&nbsp;h&nbsp;00
              </p>
            </div>
          </div>

          <!-- LOCATION -->
          <div class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Lieu</span>
            <p class="text-lg font-bold text-gray-900 dark:text-gray-100">
              Boutique Miroirs du Ciel
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-300">
              📍 9, rue de Belfort, 69004 Lyon (Cœur Croix-Rousse)
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400 pt-0.5">
              Métro C (Croix-Rousse à 3 min à pied)
            </p>
          </div>

          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 mt-3.5 leading-relaxed bg-gray-50 dark:bg-gray-900/60 p-3 rounded-xl border border-gray-100 dark:border-gray-700/60">
            Atmosphère lumineuse et intimiste au cœur des arts et de la culture asiatique.
          </p>

          <!-- PRICE -->
          <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-700 flex items-baseline justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Tarif</span>
            <div class="text-right">
              <span class="text-xl font-bold text-indigo-700 dark:text-indigo-400">80 €</span>
              <span class="text-xs text-gray-500 dark:text-gray-400"> / trimestre</span>
              <p class="text-[11px] text-gray-500 dark:text-gray-400">matériel 100 % inclus</p>
            </div>
          </div>
        </div>

        <!-- CTA DECISION -->
        <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700 flex flex-col sm:flex-row gap-2.5 items-center">
          <a
            href="mailto:christophe.desmur@orange.fr?subject=Demande%20de%20s%C3%A9ance%20d'essai%20-%20Mercredi%20Miroirs%20du%20Ciel"
            class="w-full sm:flex-1 py-3 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm text-center transition shadow-xs">
            Essayer ce cours (mercredi)
          </a>
          <a
            href="/cours-collectifs"
            class="text-xs text-gray-600 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium py-1">
            Détails &rarr;
          </a>
        </div>
      </article>

    </div>

    <!-- Reassurance Bar : essai sans engagement, matériel, accès -->
    <div class="mt-8 p-4 sm:p-5 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-600 dark:text-gray-300">
      <div class="flex items-center gap-2">
        <span class="text-emerald-600 dark:text-emerald-400 font-bold text-base">✓</span>
        <span><strong>Séance d'essai sans engagement :</strong> venez tester le geste avant de vous inscrire.</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="/tarifs" class="text-indigo-600 dark:text-indigo-400 font-medium hover:underline">
          Consulter tous les tarifs &rarr;
        </a>
      </div>
    </div>

    <!-- Carte intégrée des deux lieux -->
    <div class="mt-6 rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-700 h-56 sm:h-72">
      <iframe
        class="w-full h-full border-0"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2782.717423001606!2d4.831558576633833!3d45.7768530710809!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47f4eae2496297a7%3A0xcf33e8e7e6f48d44!2sZen%20Dojo!5e0!3m2!1sfr!2sfr!4v1756472471300!5m2!1sfr!2sfr"
        allowfullscreen=""
        loading="lazy"
        title="Carte des lieux de cours de calligraphie chinoise à Lyon Croix-Rousse"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 3. LA PRATIQUE : UN ART DU GESTE ET DU SOUFFLE                    -->
  <!-- ================================================================= -->
  <section id="pratique" aria-labelledby="practice-heading" class="max-w-5xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
      <span class="text-indigo-600 dark:text-indigo-400 uppercase tracking-widest text-xs font-semibold">
        Comprendre la démarche
      </span>
      <h2 id="practice-heading" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-gray-950 dark:text-gray-100 mt-2">
        La pratique de la calligraphie chinoise
      </h2>
      <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base mt-2 leading-relaxed">
        Loin d'un simple exercice d'écriture, la calligraphie traditionnelle est un art où le corps, le souffle et le pinceau s'harmonisent sur la feuille.
      </p>
    </div>

    <!-- 4 piliers scannables -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <div class="p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-xs">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-lg mb-3">
          1
        </div>
        <h3 class="font-bold text-gray-950 dark:text-gray-100 text-base mb-2">
          Posture & Respiration
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Une assise stable et un souffle apaisé ouvrent la concentration. L'esprit se pose avant que le pinceau ne touche le papier.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-xs">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-lg mb-3">
          2
        </div>
        <h3 class="font-bold text-gray-950 dark:text-gray-100 text-base mb-2">
          Le rituel de l'encre
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Frotter le bâton d'encre de Chine sur la pierre à l'eau est un moment de recueillement. On prépare son esprit en même temps que le noir profond.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-xs">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-lg mb-3">
          3
        </div>
        <h3 class="font-bold text-gray-950 dark:text-gray-100 text-base mb-2">
          Le pinceau & les 8 traits
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Tenue verticale du pinceau et tracé des huit traits fondamentaux (le caractère <em>Yong</em> 永) qui composent l'ensemble de l'écriture chinoise.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-xs">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-lg mb-3">
          4
        </div>
        <h3 class="font-bold text-gray-950 dark:text-gray-100 text-base mb-2">
          Accessible à tous
        </h3>
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Aucun prérequis artistique ni linguistique. Pas besoin de parler chinois : l'apprentissage est intuitif, visuel et progressif.
        </p>
      </div>

    </div>

    <!-- Lien vers Shodo & Culture -->
    <div class="mt-8 text-center">
      <a href="/shodo-voie-pinceau" class="text-xs sm:text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline inline-flex items-center gap-1">
        En savoir plus sur la voie du pinceau (Shodo) &rarr;
      </a>
    </div>
  </section>

