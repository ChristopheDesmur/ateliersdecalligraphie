---
// Cta.astro - Section de contact direct et conversion sans intermédiaire
import { contact, telHref } from "@/data/contact";
---

<section class="mt-20 mb-12 rounded-3xl bg-gray-900 text-white p-8 sm:p-12 lg:p-16 border border-gray-800" aria-labelledby="cta-heading">
  <div class="max-w-2xl mx-auto text-center">
    <span class="text-indigo-400 uppercase tracking-widest text-xs font-semibold">
      Séance d’essai & Renseignements
    </span>
    <h2 id="cta-heading" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold mt-2 text-white">
      Prêt à vous initier à la calligraphie chinoise ?
    </h2>
    <p class="text-gray-300 text-sm sm:text-base mt-3.5 leading-relaxed">
      Venez faire l’expérience du pinceau lors d’une première séance au Dojo Zen (lundi soir) ou chez Miroirs du Ciel (mercredi matin). Tout le matériel est prêt pour vous sur place.
    </p>

    <!-- Actions de contact : CTA primaire dominant + contacts directs -->
    <div class="mt-8 flex flex-col sm:flex-row justify-center items-center gap-3.5">
      <a
        href={`mailto:${contact.email}?subject=Demande%20de%20s%C3%A9ance%20d’essai%20de%20calligraphie`}
        class="w-full sm:w-auto px-7 py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-xl text-sm sm:text-base transition shadow-md flex items-center justify-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900 focus-visible:ring-indigo-400">
        <span>✉️</span> Réserver une séance d’essai
      </a>
      
      <div class="flex items-center gap-2 w-full sm:w-auto justify-center">
        <a
          href={`tel:${telHref(contact.mobile)}`}
          class="flex-1 sm:flex-none px-4 py-3 bg-white/10 hover:bg-white/20 text-white font-medium rounded-xl text-sm transition border border-white/20 flex items-center justify-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          aria-label={`Appeler Christophe Desmur au ${contact.mobile}`}>
          <span>📱</span> {contact.mobile}
        </a>

        <a
          href={`tel:${telHref(contact.landline)}`}
          class="flex-1 sm:flex-none px-4 py-3 bg-white/10 hover:bg-white/20 text-white font-medium rounded-xl text-sm transition border border-white/20 flex items-center justify-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          aria-label={`Appeler Christophe Desmur au ${contact.landline}`}>
          <span>📞</span> {contact.landline}
        </a>
      </div>
    </div>

    <p class="text-xs text-gray-400 mt-6 leading-relaxed">
      📍 Lieux des cours : Dojo Zen (11, rue Dumenge) & Miroirs du Ciel (9, rue de Belfort), Lyon 4<sup>e</sup> (Croix-Rousse). Cours à domicile sur toute la métropole lyonnaise.
    </p>
  </div>
</section>

