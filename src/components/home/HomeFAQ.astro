---
// HomeFAQ.astro - Teaser FAQ de 4 questions essentielles avec renvoi vers la page FAQ complète
const teaserFaqs = [
  {
    question: "Faut-il parler chinois pour commencer ?",
    answer: "Non. Aucune connaissance préalable du chinois n’est nécessaire.",
  },
  {
    question: "Le matériel est-il fourni ?",
    answer: "Oui, le matériel nécessaire est fourni pendant les ateliers.",
  },
  {
    question: "Les débutants sont-ils acceptés ?",
    answer: "Oui, les ateliers accueillent les débutants comme les pratiquants plus expérimentés.",
  },
  {
    question: "Où ont lieu les ateliers ?",
    answer: "À Lyon, notamment au dojo zen de Lyon et à la boutique Miroirs du Ciel.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": teaserFaqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};
---

<section class="py-14 sm:py-20 border-b border-gray-100 dark:border-gray-800" aria-labelledby="home-faq-heading">
  <div class="text-center max-w-2xl mx-auto mb-10">
    <p class="text-xs font-semibold uppercase tracking-widest text-indigo-700 dark:text-indigo-400">
      Repères pratiques
    </p>
    <h2 id="home-faq-heading" class="text-3xl sm:text-4xl font-serif font-medium text-gray-950 dark:text-gray-100 mt-2">
      Questions fréquentes
    </h2>
  </div>

  <div class="space-y-3.5 max-w-3xl mx-auto">
    {teaserFaqs.map((faq, index) => (
      <details
        open={index === 0}
        class="group rounded-2xl border border-gray-200/90 dark:border-gray-800 bg-white dark:bg-gray-800/80 p-5 transition shadow-2xs hover:border-indigo-200 dark:hover:border-indigo-900 [&_svg]:open:-rotate-180">
        <summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-base sm:text-lg font-medium text-gray-900 dark:text-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg select-none">
          <span>{faq.question}</span>
          <svg class="h-5 w-5 shrink-0 text-gray-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-300 leading-relaxed font-serif pt-3 border-t border-gray-100 dark:border-gray-700/60">
          {faq.answer}
        </p>
      </details>
    ))}
  </div>

  <div class="mt-8 text-center">
    <a
      href="/faq"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-indigo-700 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 transition-colors">
      <span>Voir toutes les questions fréquentes</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
