---
// HomeArtist.astro - Christophe Desmur, ancre de confiance : pratique, enseignement, transmission.
import ImageTextSection from "@/components/editorial/ImageTextSection.astro";
import EditorialLink from "@/components/editorial/EditorialLink.astro";
---

<ImageTextSection
  id="artist"
  reverse
  image={{
    src: "/assets/christophe-desmur-calligraphie-zen-sceau.webp",
    alt: "Portrait de Christophe Desmur, calligraphe et enseignant à Lyon, à sa table de travail",
    width: 1536,
    height: 1024,
    position: "50% 35%",
  }}
  aspect="4 / 5"
  caption="Christophe Desmur à Lyon">
  <p class="eyebrow mb-4">L’enseignant</p>
  <h2 id="artist-heading" class="h-section">Avec Christophe Desmur</h2>

  <blockquote class="mt-8 border-l border-vermilion pl-5 font-serif text-xl sm:text-2xl italic leading-snug text-ink">
    « Mon travail relie l’exigence du geste traditionnel, la compréhension intime des caractères et la transmission vivante de la culture écrite asiatique. »
  </blockquote>

  <p class="body-copy mt-8">
    Christophe Desmur pratique et enseigne la calligraphie chinoise à Lyon depuis plus de trente ans. Son approche associe apprentissage du geste, attention au corps et découverte de la culture des caractères.
  </p>
  <p class="body-copy mt-4">
    Chaque élève est accompagné selon son niveau et son rythme.
  </p>

  <dl class="mt-8 grid grid-cols-1 gap-y-3 border-t border-warm-grey pt-6 sm:grid-cols-3 sm:gap-x-6">
    <div>
      <dt class="eyebrow">Pratique</dt>
      <dd class="mt-1 font-serif text-lg text-ink">30+ ans</dd>
    </div>
    <div>
      <dt class="eyebrow">Formation</dt>
      <dd class="mt-1 font-serif text-lg text-ink">Langue &amp; civilisation chinoises</dd>
    </div>
    <div>
      <dt class="eyebrow">Aussi</dt>
      <dd class="mt-1 font-serif text-lg text-ink">Traducteur littéraire</dd>
    </div>
  </dl>

  <div class="mt-8">
    <EditorialLink href="/le-calligraphe" label="Découvrir Christophe" />
  </div>
</ImageTextSection>
