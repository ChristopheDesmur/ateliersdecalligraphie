---
import { getAllArtworks } from "@/data/artworks";

const all = getAllArtworks();
// 4 œuvres phares représentatives
const previewSlugs = ["fu-bonheur", "xin-coeur-esprit", "mushotoku-sans-esprit-de-profit", "fang-fragrance-vertu"];
const featuredArtworks = previewSlugs
  .map((slug) => all.find((a) => a.slug === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));
---

<section id="galerie-preview" class="mt-20 sm:mt-24 scroll-mt-10" aria-labelledby="gallery-heading">
  <!-- En-tête de section artistique -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 sm:mb-10">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">
        Galerie d'art & Œuvres uniques
      </span>
      <h2 id="gallery-heading" class="text-3xl sm:text-4xl font-serif font-medium text-gray-950 dark:text-gray-100 mt-2">
        Calligraphies chinoises originales
      </h2>
      <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 font-serif mt-2.5 leading-relaxed">
        Des œuvres uniques réalisées au pinceau et à l'encre de Chine par Christophe Desmur, autour de caractères traditionnels, de notions philosophiques et d'expressions porteuses de sens.
      </p>
    </div>

    <a
      href="/galerie"
      class="text-xs sm:text-sm font-medium text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300 inline-flex items-center gap-1.5 shrink-0 py-1 transition-colors">
      <span>Voir toutes les calligraphies originales</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <!-- Grille des 4 œuvres phares -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {featuredArtworks.map((artwork) => (
      <article class="group bg-white dark:bg-gray-800/90 rounded-2xl overflow-hidden border border-gray-200/90 dark:border-gray-800 shadow-2xs hover:shadow-md transition flex flex-col justify-between">
        <a
          href={`/galerie/${artwork.slug}`}
          class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-t-2xl overflow-hidden"
          aria-label={`Découvrir l'œuvre ${artwork.character} — ${artwork.frenchMeaning}`}>
          <div class="h-60 sm:h-64 bg-stone-50 dark:bg-stone-900/50 p-5 flex items-center justify-center border-b border-gray-100 dark:border-gray-800/80">
            <img
              src={artwork.src}
              alt={artwork.alt}
              width={artwork.width}
              height={artwork.height}
              loading="lazy"
              decoding="async"
              class="max-h-full max-w-full object-contain group-hover:scale-103 transition-transform duration-500 drop-shadow-xs"
            />
          </div>
        </a>

        <div class="p-5 flex-1 flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400">
              {artwork.category}
            </span>

            <h3 class="mt-1 text-2xl font-serif font-medium text-gray-950 dark:text-gray-100">
              <a href={`/galerie/${artwork.slug}`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                {artwork.character}
              </a>
            </h3>

            <p class="mt-0.5 text-xs font-serif italic text-gray-600 dark:text-gray-300">
              {artwork.frenchMeaning}
            </p>
          </div>

          <div class="mt-5 pt-3 border-t border-gray-100 dark:border-gray-800 flex items-center justify-between text-xs">
            <span class="text-[11px] font-medium text-emerald-700 dark:text-emerald-400 inline-flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
              {artwork.price} &bull; {artwork.availability}
            </span>

            <a
              href={`/galerie/${artwork.slug}`}
              class="font-medium text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300 inline-flex items-center gap-1 transition-colors"
              aria-label={`Découvrir la calligraphie ${artwork.character}`}>
              <span>Découvrir</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Explication explicite du modèle d'acquisition -->
  <div class="mt-10 rounded-3xl border border-gray-200 dark:border-gray-800 bg-stone-50/70 dark:bg-stone-900/40 p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="max-w-2xl">
      <div class="flex items-center gap-2 mb-1.5">
        <span class="w-2 h-2 rounded-full bg-indigo-600 dark:bg-indigo-400" aria-hidden="true"></span>
        <span class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">
          Acquisition directe
        </span>
      </div>
      <h3 class="text-xl sm:text-2xl font-serif font-medium text-gray-950 dark:text-gray-100">
        Une œuvre vous intéresse ?
      </h3>
      <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 font-serif mt-2 leading-relaxed">
        Les calligraphies originales sont proposées à l'acquisition directement auprès de l'artiste, sans intermédiaire ni paiement automatisé en ligne. Contactez Christophe pour connaître les modalités d'acquisition, de remise en main propre à Lyon ou d'expédition soignée à plat.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0 w-full md:w-auto">
      <a
        href="mailto:christophe.desmur@orange.fr?subject=Demande%20d'information%20calligraphie%20originale"
        class="px-6 py-3 bg-gray-950 hover:bg-gray-800 text-white dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-white text-xs sm:text-sm font-medium rounded-xl transition shadow-xs text-center inline-flex items-center justify-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
        <span>✉️</span>
        <span>Contacter l'artiste</span>
      </a>

      <a
        href="/galerie"
        class="px-5 py-3 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-900 dark:text-gray-100 text-xs sm:text-sm font-medium transition text-center inline-flex items-center justify-center gap-1">
        <span>Toutes les œuvres</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
