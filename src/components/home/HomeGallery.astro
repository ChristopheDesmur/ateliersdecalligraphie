---
// HomeGallery.astro - Vitrine commerciale des calligraphies originales
import { getAllArtworks } from "@/data/artworks";

const all = getAllArtworks();
// 4 œuvres représentatives de styles variés
const previewSlugs = ["fu-bonheur", "xin-coeur-esprit", "mushotoku-sans-esprit-de-profit", "xiang-posture-aspect"];
const featuredArtworks = previewSlugs
  .map((slug) => all.find((a) => a.slug === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));
---

<section id="galerie-preview" class="py-14 sm:py-20 border-b border-gray-100 dark:border-gray-800 scroll-mt-10" aria-labelledby="gallery-heading">
  <!-- En-tête -->
  <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
    <p class="text-xs font-semibold uppercase tracking-widest text-indigo-700 dark:text-indigo-400">
      Œuvres originales · Pièces uniques
    </p>
    <h2 id="gallery-heading" class="text-3xl sm:text-4xl font-serif font-medium text-gray-950 dark:text-gray-100 mt-2">
      Calligraphies disponibles à l’acquisition
    </h2>
    <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 font-serif mt-2.5 leading-relaxed">
      Découvrez une sélection de pièces uniques réalisées à l'encre de Chine par Christophe Desmur, proposées à l’acquisition sur demande.
    </p>
  </div>

  <!-- Grille d'œuvres sélectionnées -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {featuredArtworks.map((artwork) => (
      <article class="group bg-white dark:bg-gray-800/90 rounded-2xl overflow-hidden border border-gray-200/90 dark:border-gray-800 shadow-2xs hover:shadow-md transition flex flex-col justify-between">
        <a
          href={`/galerie/${artwork.slug}`}
          class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-t-2xl overflow-hidden"
          aria-label={`Découvrir l'œuvre ${artwork.character} — ${artwork.frenchMeaning}`}>
          <div class="h-60 sm:h-64 bg-stone-50 dark:bg-stone-900/50 p-5 flex items-center justify-center border-b border-gray-100 dark:border-gray-800/80">
            <img
              src={artwork.src}
              alt={artwork.alt}
              width={artwork.width}
              height={artwork.height}
              loading="lazy"
              decoding="async"
              class="max-h-full max-w-full object-contain group-hover:scale-103 transition-transform duration-500"
            />
          </div>
        </a>

        <div class="p-5 flex-1 flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400">
              {artwork.category}
            </span>

            <h3 class="mt-1 text-2xl font-serif font-medium text-gray-950 dark:text-gray-100">
              <a href={`/galerie/${artwork.slug}`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                {artwork.character}
              </a>
            </h3>

            <p class="mt-0.5 text-xs font-serif italic text-gray-600 dark:text-gray-300">
              {artwork.frenchMeaning}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-800 flex items-center justify-between text-xs">
            <span class="text-[11px] font-medium text-emerald-700 dark:text-emerald-400 inline-flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
              {artwork.availability === "Disponible" ? "Disponible à l’acquisition" : "Vendue"}
            </span>

            <a
              href={`/galerie/${artwork.slug}`}
              class="font-medium text-indigo-700 hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300 inline-flex items-center gap-1 transition-colors"
              aria-label={`Découvrir la calligraphie ${artwork.character}`}>
              <span>Découvrir</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Signal commercial clair & CTAs -->
  <div class="mt-10 rounded-2xl border border-indigo-100 dark:border-indigo-900/60 bg-stone-50/80 dark:bg-stone-900/40 p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="max-w-2xl">
      <h3 class="text-lg sm:text-xl font-serif font-medium text-gray-950 dark:text-gray-100">
        Acquérir une calligraphie originale
      </h3>
      <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 font-serif mt-2 leading-relaxed">
        Chaque œuvre est une pièce unique réalisée sur papier traditionnel à l'encre de Chine. Pour connaître les disponibilités, échanger sur le prix ou organiser la remise en main propre à Lyon ou l'expédition, contactez directement Christophe Desmur.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0 w-full md:w-auto">
      <a
        href="/galerie"
        class="px-5 py-2.5 rounded-xl bg-gray-950 hover:bg-gray-800 text-white dark:bg-gray-100 dark:text-gray-950 dark:hover:bg-white text-xs sm:text-sm font-medium transition text-center focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
        Voir les œuvres disponibles
      </a>

      <a
        href="mailto:christophe.desmur@orange.fr?subject=Demande%20d'information%20calligraphie%20originale"
        class="px-5 py-2.5 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-900 dark:text-gray-100 text-xs sm:text-sm font-medium transition text-center inline-flex items-center justify-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
        <span>✉️</span>
        <span>Contacter Christophe</span>
      </a>
    </div>
  </div>
</section>
