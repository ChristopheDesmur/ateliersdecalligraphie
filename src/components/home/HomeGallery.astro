---
// HomeGallery.astro - Œuvres originales présentées en galerie éditoriale.
// Parcours : voir une œuvre → demander les disponibilités → échanger avec Christophe.
import { getAllArtworks } from "@/data/artworks";
import { contact } from "@/data/contact";
import ArtworkFeature from "@/components/editorial/ArtworkFeature.astro";
import EditorialLink from "@/components/editorial/EditorialLink.astro";

const all = getAllArtworks();
// 4 œuvres représentatives de styles variés
const previewSlugs = ["fu-bonheur", "xin-coeur-esprit", "mushotoku-sans-esprit-de-profit", "xiang-posture-aspect"];
const featuredArtworks = previewSlugs
  .map((slug) => all.find((a) => a.slug === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

// Rythme asymétrique : grande / petite, puis petite / grande (desktop)
const layout = [
  "md:col-span-7",
  "md:col-span-5 md:mt-24",
  "md:col-span-5 md:mt-24",
  "md:col-span-7",
];
const aspects = ["1 / 1", "4 / 5", "4 / 5", "1 / 1"];
---

<section id="galerie-preview" class="section border-t border-warm-grey scroll-mt-24" aria-labelledby="gallery-heading">
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-12 mb-14 sm:mb-20">
    <div data-reveal class="lg:col-span-6">
      <p class="eyebrow mb-4">Œuvres originales · Pièces uniques</p>
      <h2 id="gallery-heading" class="h-section">Calligraphies originales</h2>
    </div>
    <div data-reveal class="lg:col-span-5 lg:col-start-8 lg:pt-10">
      <p class="lede">
        Une sélection de pièces uniques réalisées à l’encre de Chine par Christophe Desmur.
      </p>
      <p class="body-copy mt-4">
        Chaque œuvre est une pièce unique. Les disponibilités et modalités d’acquisition sont communiquées directement par Christophe.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-x-10 gap-y-16 md:grid-cols-12 lg:gap-x-16">
    {featuredArtworks.map((artwork, i) => (
      <ArtworkFeature artwork={artwork} aspect={aspects[i]} class={layout[i]} />
    ))}
  </div>

  <div data-reveal class="mt-16 sm:mt-24 grid gap-8 border-t border-ink/80 pt-8 lg:grid-cols-12 lg:gap-12">
    <ol class="lg:col-span-7 grid gap-4 sm:grid-cols-3 sm:gap-6" aria-label="Acquérir une œuvre">
      <li><span class="numeral">01</span><p class="font-serif text-xl text-ink mt-1">Voir une œuvre</p></li>
      <li><span class="numeral">02</span><p class="font-serif text-xl text-ink mt-1">Demander les disponibilités</p></li>
      <li><span class="numeral">03</span><p class="font-serif text-xl text-ink mt-1">Échanger avec Christophe</p></li>
    </ol>
    <div class="lg:col-span-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center lg:justify-end">
      <a
        href={`mailto:${contact.email}?subject=Demande%20d’information%20calligraphie%20originale`}
        class="btn btn-ink">
        Contacter Christophe
      </a>
      <EditorialLink href="/galerie" label="Voir toutes les œuvres" class="sm:ml-4" />
    </div>
  </div>
  <p class="meta mt-6 max-w-2xl">
    Remise en main propre à Lyon ou expédition, à convenir directement avec Christophe Desmur.
  </p>
</section>
