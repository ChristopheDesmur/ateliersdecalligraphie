---
// HomeLocations.astro - Lieux des ateliers à Lyon et coordonnées directes compactes
---

<section class="pb-12 sm:pb-16" aria-labelledby="locations-heading">
  <div class="rounded-2xl bg-stone-50/80 dark:bg-gray-800/60 border border-stone-200/80 dark:border-gray-700/80 p-6 sm:p-8">
    <div class="text-center max-w-xl mx-auto mb-6">
      <h2 id="locations-heading" class="text-2xl sm:text-3xl font-serif font-medium text-gray-950 dark:text-gray-100">
        Ateliers à Lyon
      </h2>
      <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 font-serif mt-1">
        Deux lieux de pratique hebdomadaire à la Croix-Rousse (Lyon 4<sup>e</sup>).
      </p>
    </div>

    <!-- 2 lieux compacts -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-3xl mx-auto">
      
      <!-- Dojo zen de Lyon -->
      <div class="p-5 rounded-xl bg-white dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700/60 shadow-2xs">
        <h3 class="text-lg font-serif font-medium text-gray-950 dark:text-gray-100">
          Dojo zen de Lyon
        </h3>
        <p class="mt-1 text-xs text-gray-600 dark:text-gray-400 font-sans">
          11 rue Dumenge, 69004 Lyon
        </p>
        <p class="mt-2 text-xs font-semibold text-indigo-700 dark:text-indigo-400">
          Lundi · 18h30–20h30
        </p>
      </div>

      <!-- Miroirs du Ciel -->
      <div class="p-5 rounded-xl bg-white dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700/60 shadow-2xs">
        <h3 class="text-lg font-serif font-medium text-gray-950 dark:text-gray-100">
          Miroirs du Ciel
        </h3>
        <p class="mt-1 text-xs text-gray-600 dark:text-gray-400 font-sans">
          9 rue de Belfort, 69004 Lyon
        </p>
        <p class="mt-2 text-xs font-semibold text-indigo-700 dark:text-indigo-400">
          Mercredi · 10h–12h
        </p>
      </div>

    </div>

    <div class="mt-5 text-center">
      <a
        href="/cours-collectifs"
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-indigo-700 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 transition-colors">
        <span>Voir les horaires et modalités</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- Coordonnées directes compactes (mention unique sur la page) -->
    <div class="mt-8 pt-6 border-t border-stone-200 dark:border-gray-700/60 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-600 dark:text-gray-400 max-w-3xl mx-auto font-sans">
      <div class="flex items-center gap-1.5">
        <span>✉️</span>
        <a href="mailto:christophe.desmur@orange.fr" class="hover:text-indigo-600 dark:hover:text-indigo-400 underline transition-colors">
          christophe.desmur@orange.fr
        </a>
      </div>

      <div class="flex items-center gap-4">
        <a href="tel:+33769941643" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors inline-flex items-center gap-1">
          <span>📱</span> 07 69 94 16 43
        </a>
        <a href="tel:+33472078861" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors inline-flex items-center gap-1">
          <span>📞</span> 04 72 07 88 61
        </a>
      </div>

      <p class="text-stone-500 dark:text-stone-400">
        📍 Lyon 4<sup>e</sup> (Croix-Rousse)
      </p>
    </div>

  </div>
</section>
