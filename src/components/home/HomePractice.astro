---
// HomePractice.astro - La pratique (geste, concentration, expression) puis
// une section courte « accessible à tous ».
import ImageTextSection from "@/components/editorial/ImageTextSection.astro";
import EditorialLink from "@/components/editorial/EditorialLink.astro";

const concepts = [
  { title: "Le geste", text: "Apprendre à maîtriser le pinceau." },
  { title: "La concentration", text: "Trouver son rythme et son attention." },
  { title: "L’expression", text: "Faire vivre le caractère sur le papier." },
];

const points = [
  "Débutants bienvenus",
  "Geste & attention",
  "Créativité & expression",
  "Découverte de la culture chinoise",
];
---

<ImageTextSection
  id="practice"
  image={{
    src: "/assets/un-pinceau-repose-a-cote-d-un-texte-calligraphie-sur-du-papier-blanc.webp",
    alt: "Un pinceau repose à côté de caractères chinois tracés à l’encre sur papier blanc",
    width: 800,
    height: 1200,
    position: "50% 40%",
  }}
  aspect="4 / 5">
  <p class="eyebrow mb-4">L’art du pinceau</p>
  <h2 id="practice-heading" class="h-section">Plus qu’une écriture, une pratique</h2>
  <p class="lede mt-5">
    En calligraphie chinoise, le geste, la respiration et la concentration participent pleinement à l’expression du caractère.
  </p>

  <ol class="mt-10 grid gap-6 border-t border-warm-grey pt-6 sm:grid-cols-3 sm:gap-6 md:grid-cols-1 lg:grid-cols-3">
    {concepts.map((c, i) => (
      <li class="sm:border-l sm:border-warm-grey sm:pl-5 md:border-l-0 md:pl-0 lg:border-l lg:pl-5 first:border-l-0 first:pl-0">
        <span class="numeral text-vermilion" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="font-serif text-[1.35rem] leading-tight text-ink mt-1">{c.title}</h3>
        <p class="meta mt-1.5">{c.text}</p>
      </li>
    ))}
  </ol>

  <blockquote class="mt-10 font-serif text-xl sm:text-2xl italic leading-snug text-ink">
    « Chaque caractère devient un exercice d’équilibre entre mouvement, espace et énergie. »
  </blockquote>

  <div class="mt-8">
    <EditorialLink href="/shodo-voie-pinceau" label="Découvrir la pratique" />
  </div>
</ImageTextSection>

<!-- Note : le geste et l'assise (contenu existant conservé, en aparté discret) -->
<aside class="pb-16 sm:pb-20 -mt-4" aria-labelledby="gesture-note-heading">
  <div data-reveal class="grid gap-4 border-t border-warm-grey pt-6 md:grid-cols-12 md:gap-10">
    <h3 id="gesture-note-heading" class="font-serif text-xl text-ink md:col-span-4">
      Le geste, entre mouvement et immobilité
    </h3>
    <div class="md:col-span-8 lg:col-span-7">
      <p class="meta leading-relaxed">
        Le travail du pinceau engage le corps tout entier : posture, respiration, rythme et attention participent au geste calligraphique. Cette attention au corps et à la posture peut aussi faire écho à d’autres pratiques traditionnelles de l’assise. À Montpellier, Myokan confectionne des zafus selon une méthode transmise dans la tradition du zen Soto, destinés notamment à la pratique du zazen.
      </p>
      <EditorialLink href="https://myokan.fr/" external label="Découvrir les zafus artisanaux de Myokan" class="mt-2 text-sm" />
    </div>
  </div>
</aside>

<!-- Une pratique accessible à tous -->
<section id="accessible" class="section border-t border-warm-grey" aria-labelledby="accessible-heading">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div data-reveal class="lg:col-span-5">
      <p class="eyebrow mb-4">Accessibilité</p>
      <h2 id="accessible-heading" class="h-section">Une pratique accessible à tous</h2>
    </div>
    <div data-reveal class="lg:col-span-7">
      <p class="font-serif text-2xl sm:text-[1.75rem] leading-snug text-ink">
        Pas besoin de parler chinois pour commencer.
      </p>
      <p class="body-copy mt-3">
        La calligraphie s’apprend par le geste, l’observation et la répétition.
      </p>

      <ul class="mt-8 grid grid-cols-1 border-t border-warm-grey sm:grid-cols-2">
        {points.map((p) => (
          <li class="flex items-baseline gap-3 border-b border-warm-grey py-4 sm:odd:pr-6 text-ink">
            <span class="h-px w-4 shrink-0 translate-y-[-0.3em] bg-soft-ink" aria-hidden="true"></span>
            <span>{p}</span>
          </li>
        ))}
      </ul>

      <p class="meta mt-6">
        Enfants · Adolescents · Adultes · Seniors — cours réguliers, découverte, écoles, entreprises et institutions.
      </p>

      <div class="mt-4 flex flex-wrap gap-x-8">
        <EditorialLink href="/cours-collectifs#trial-heading" label="Comment se déroule un atelier ?" />
        <EditorialLink href="/debuter-calligraphie-chinoise" label="Guide pour débuter" />
      </div>
    </div>
  </div>
</section>
