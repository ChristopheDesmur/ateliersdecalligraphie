---
// HomeHero.astro - Hero éditorial : quoi, où, avec qui, comment commencer.
// Contenu éditable depuis l'admin (src/data/hero.yaml).
import { hero as defaultHero, type HeroData } from "@/data/hero";

export interface Props {
  hero?: HeroData;
}

const { hero = defaultHero } = Astro.props;

const eyebrow = hero.eyebrow || "Calligraphie chinoise · Lyon";
const title = hero.title || "Découvrez l’art de la calligraphie chinoise";
const intro = hero.intro || "Christophe Desmur vous accompagne dans la découverte du pinceau, du geste et des caractères chinois, à travers des ateliers collectifs et des cours individuels.";
const primaryCta = hero.primary_cta || { label: "Découvrir les cours", url: "/cours-collectifs" };
const secondaryCta = hero.secondary_cta || { label: "Voir les œuvres", url: "/galerie" };
const image = hero.image;
const hasImage = Boolean(image?.src);
---

<section class:list={["hero pt-6 pb-16 sm:pt-10 sm:pb-24", !hasImage && "hero--text"]} aria-labelledby="hero-title">
  <p class="hero-eyebrow eyebrow eyebrow-mark">{eyebrow}</p>

  <h1 id="hero-title" class="hero-title display">{title}</h1>

  {hasImage && (
    <figure class="hero-media">
      <div class="ink-frame hero-frame">
        <img
          src={image!.src}
          alt={image!.alt || "Christophe Desmur traçant une calligraphie chinoise au pinceau et à l’encre de Chine à Lyon"}
          width={image!.width || 1536}
          height={image!.height || 1024}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      {(image!.caption || image!.location) && (
        <figcaption class="mt-3 flex flex-wrap justify-between gap-x-6 gap-y-1 font-serif italic text-[0.95rem] text-soft-ink">
          {image!.caption && <span>{image!.caption}</span>}
          {image!.location && <span class="not-italic eyebrow">{image!.location}</span>}
        </figcaption>
      )}
    </figure>
  )}

  <div class="hero-body">
    <p class="lede">{intro}</p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
      {primaryCta.label && (
        <a href={primaryCta.url || "/cours-collectifs"} class="btn btn-ink">{primaryCta.label}</a>
      )}
      {secondaryCta.label && (
        <a href={secondaryCta.url || "/galerie"} class="btn btn-line">{secondaryCta.label}</a>
      )}
    </div>

    <ul class="hero-facts meta mt-10 flex flex-wrap gap-x-3 gap-y-1 border-t border-warm-grey pt-5 tracking-wide" aria-label="En bref">
      <li>Débutants bienvenus</li>
      <li>Enfants &amp; adultes</li>
      <li>Lyon</li>
    </ul>
  </div>
</section>

<style>
  /* Mobile : titre, image, puis texte et actions. Desktop : texte à gauche, grande image à droite. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "eyebrow"
      "title"
      "media"
      "body";
    row-gap: 1.5rem;
  }
  .hero-eyebrow { grid-area: eyebrow; }
  .hero-title { grid-area: title; }
  .hero-media { grid-area: media; margin-top: 0.75rem; }
  .hero-body { grid-area: body; margin-top: 0.5rem; }

  .hero-frame { aspect-ratio: 4 / 3; }
  .hero-frame img { object-position: 72% 50%; }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas:
        "eyebrow eyebrow eyebrow eyebrow eyebrow media media media media media media media"
        "title   title   title   title   title   media media media media media media media"
        "body    body    body    body    body    media media media media media media media";
      grid-template-rows: auto auto 1fr;
      column-gap: 3rem;
      row-gap: 2rem;
      align-items: start;
    }
    .hero-eyebrow { align-self: end; padding-top: 2rem; }
    .hero-media { margin-top: 0; }
    .hero-body { margin-top: 0; }
    .hero-frame { aspect-ratio: 1 / 1; }
    .hero-frame img { object-position: 80% 50%; }
  }

  .hero-facts li { white-space: nowrap; }
  .hero-facts li:not(:last-child)::after {
    content: "·";
    margin-left: 0.75rem;
    color: var(--color-warm-grey);
  }

  .hero--text {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "eyebrow" "title" "body";
    max-width: 48rem;
  }
</style>
