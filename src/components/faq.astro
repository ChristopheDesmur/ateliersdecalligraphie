---
// Faq.astro - FAQ catégorisée et balisée Schema.org pour l'optimisation locale et la clarté utilisateur
// Présentation en accordéons accessibles (details/summary) pour réduire la charge cognitive

interface FaqItem {
  question: string;
  answer: string;
  links?: { text: string; href: string }[];
}

interface FaqCategory {
  category: string;
  items: FaqItem[];
}

const faqCategories: FaqCategory[] = [
  {
    category: "Débuter la calligraphie",
    items: [
      {
        question: "Faut-il parler ou comprendre le chinois pour pratiquer la calligraphie ?",
        answer: "Non, aucune connaissance préalable du chinois n'est nécessaire. La calligraphie chinoise est avant tout un art du geste, de la respiration et de l'espace. Vous apprendrez progressivement à reconnaître et tracer les sinogrammes, des pictogrammes archaïques aux caractères complets, sans avoir besoin de parler la langue.",
      },
      {
        question: "Les cours collectifs hebdomadaires sont-ils ouverts aux grands débutants ?",
        answer: "Absolument. Les cours accueillent tous les niveaux, des néophytes complets aux pratiquants confirmés. Chaque élève progresse à son propre rythme grâce à l'accompagnement individualisé de Christophe Desmur au sein du petit groupe (2 à 8 participants).",
      },
      {
        question: "Quel matériel faut-il apporter lors des cours ?",
        answer: "Tout le matériel est mis à votre disposition sur place : pinceaux en poils naturels, bâtons d'encre de Chine traditionnelle, pierres à encre et papiers chinois absorbants. Vous venez simplement dans une tenue confortable, sans aucun achat préalable.",
      },
      {
        question: "Comment se déroule une première séance d'essai ?",
        answer: "Vous pouvez réserver une séance d'essai sans engagement sur le créneau du lundi soir (Dojo Zen) ou du mercredi matin (Miroirs du Ciel). Vous découvrirez la tenue du pinceau, la préparation de l'encre à la pierre et le tracé de vos premiers traits fondamentaux.",
      },
    ],
  },
  {
    category: "Lieux, Horaires & Tarifs à Lyon",
    items: [
      {
        question: "Où et quand ont lieu les cours réguliers de calligraphie à Lyon ?",
        answer: "Les cours se déroulent dans le 4<sup>e</sup> arrondissement de Lyon (Croix-Rousse) sur deux créneaux : les lundis soirs de 18&nbsp;h&nbsp;30 à 20&nbsp;h&nbsp;30 au Dojo Zen de Lyon (11, rue Dumenge) et les mercredis matin de 10&nbsp;h à 12&nbsp;h à la boutique Miroirs du Ciel (9, rue de Belfort).",
      },
      {
        question: "Quels sont les tarifs des cours collectifs et particuliers ?",
        answer: "Les cours collectifs réguliers sont à 80 € par trimestre après réduction d'impôts. Les cours particuliers à domicile sont à 40 € TTC / heure et bénéficient de 50 % de crédit d'impôt (agrément Coop A Dom n° 2006-1-42.10), soit 20 € net de l'heure.",
      },
      {
        question: "Proposez-vous des cours particuliers à domicile à Lyon ?",
        answer: "Oui, Christophe Desmur se déplace à votre domicile sur Lyon et l'ensemble de la métropole lyonnaise avec tout le matériel. Les horaires et la fréquence sont entièrement flexibles selon vos disponibilités.",
      },
    ],
  },
  {
    category: "Styles, Pratique & Culture",
    items: [
      {
        question: "Quelle est la différence entre la calligraphie chinoise et le shodō japonais ?",
        answer: "La calligraphie chinoise (shūfǎ 书法) est la tradition originelle, pratiquée depuis plus de 3 000 ans en Chine. Le shodō japonais en est directement issu et partage les mêmes outils (pinceau, encre de Chine, pierre, papier). À Lyon, Christophe Desmur enseigne la tradition classique chinoise et les styles majeurs des grandes dynasties Tang et Song.",
      },
      {
        question: "Quels styles calligraphiques sont abordés au cours des séances ?",
        answer: "L'apprentissage débute généralement par le style régulier (Kaishu 楷书), qui pose la structure géométrique et l'équilibre des traits. Les pratiquants explorent ensuite le style courant (Xingshu 行书, plus fluide et cursif) et le style cursif (Caoshu 草书), selon leur rythme et leurs affinités.",
      },
    ],
  },
  {
    category: "Interventions pour groupes & collectivités",
    items: [
      {
        question: "À partir de quel âge peut-on pratiquer la calligraphie chinoise ?",
        answer: "La calligraphie s'adresse à tous les âges : enfants dès l'école primaire (à partir de 6 ans, avec initiation au Sumi-e et aux pictogrammes), collégiens et lycéens, adultes de tous âges, et seniors en maisons de retraite et EHPAD.",
      },
      {
        question: "Comment organiser un atelier en école, collège, lycée ou université ?",
        answer: "Christophe Desmur se déplace directement dans votre établissement scolaire à Lyon et dans la région avec tout le matériel pour la classe. Le format varie de 1&nbsp;h à 3&nbsp;h par session (60 € HT/h). Une prise de contact préalable permet de caler le projet pédagogique.",
      },
      {
        question: "Proposez-vous des ateliers pour les comités d'entreprise et les résidences seniors ?",
        answer: "Oui. En entreprise, des ateliers d'1&nbsp;h à 3&nbsp;h (90 € HT/h) sont organisés sur la pause méridienne (12&nbsp;h - 14&nbsp;h) ou lors de séminaires. En maison de retraite et EHPAD (60 € HT/h), des ateliers calmes de 2&nbsp;h stimulent la motricité fine et la créativité des résidents.",
      },
    ],
  },
];

const allQuestions = faqCategories.flatMap((cat) => cat.items);
---

<section class="mt-20 max-w-4xl mx-auto" aria-labelledby="faq-main-heading">
  <div class="text-center mb-10 sm:mb-12">
    <span class="text-indigo-600 dark:text-indigo-400 uppercase tracking-widest text-xs font-semibold">
      Foire aux questions
    </span>
    <h2 id="faq-main-heading" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-gray-950 dark:text-gray-100 mt-2">
      Questions fréquentes sur les cours et ateliers
    </h2>
    <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base mt-2">
      Tout ce qu'il faut savoir avant de venir à votre premier cours ou d'organiser un atelier.
    </p>
  </div>

  <div class="space-y-10 sm:space-y-12">
    {faqCategories.map((group, groupIdx) => (
      <div>
        <div class="mb-4 pb-2.5 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
          <h3 class="text-lg sm:text-xl font-serif font-bold text-gray-950 dark:text-gray-100">
            {group.category}
          </h3>
          <span class="text-xs text-gray-500 dark:text-gray-400 font-sans">
            {group.items.length} questions
          </span>
        </div>

        <div class="space-y-3">
          {group.items.map((faq, itemIdx) => {
            // Ouvrir par défaut la toute première question de la première catégorie
            const isOpen = groupIdx === 0 && itemIdx === 0;
            return (
              <details
                open={isOpen}
                class="group bg-white dark:bg-gray-800/80 rounded-xl border border-gray-200/90 dark:border-gray-700/80 p-4 sm:p-5 transition hover:border-indigo-200 dark:hover:border-indigo-900 shadow-2xs">
                <summary class="flex justify-between items-center cursor-pointer font-medium text-gray-950 dark:text-gray-100 text-sm sm:text-base list-none select-none">
                  <span class="pr-4 leading-snug">{faq.question}</span>
                  <span class="shrink-0 w-6 h-6 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center text-gray-500 dark:text-gray-400 group-open:rotate-180 transition-transform text-xs" aria-hidden="true">
                    ▾
                  </span>
                </summary>
                <div class="mt-3 text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed pt-3 border-t border-gray-100 dark:border-gray-700/60" set:html={faq.answer} />
              </details>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Données structurées FAQPage Schema.org (100 % préservées) -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allQuestions.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer.replace(/<[^>]+>/g, ""),
    },
  })),
})} />
