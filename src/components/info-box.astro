---
// InfoBox.astro - Encadré récapitulatif des cours réguliers à Lyon et contact
import { contact, telHref } from "@/data/contact";
import { venues, formatTimeTypographic } from "@/data/venues";

const dojo = venues["dojo-zen-de-lyon"];
const miroirs = venues["miroirs-du-ciel"];
---

<div class="bg-gray-50 dark:bg-gray-800/80 rounded-2xl p-6 sm:p-7 border border-gray-200 dark:border-gray-700 shadow-sm max-w-full w-full mx-auto text-sm">
  <div>
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">
      Cours collectifs hebdomadaires
    </h2>
    <p class="text-xs font-medium uppercase tracking-wider text-indigo-700 dark:text-indigo-400 mb-3">
      Lyon 4<sup>e</sup> — Croix-Rousse
    </p>

    <div class="space-y-4">
      <div class="border-l-2 border-indigo-600 dark:border-indigo-400 pl-3">
        <h3 class="font-semibold text-gray-900 dark:text-gray-100">{dojo.name}</h3>
        <p class="text-gray-600 dark:text-gray-300">{dojo.address}</p>
        <p class="text-gray-800 dark:text-gray-200 font-medium mt-1">Lundis de {formatTimeTypographic(dojo.time_start)} à {formatTimeTypographic(dojo.time_end)}</p>
        <p class="text-xs text-gray-500 dark:text-gray-400">Métro C — Arrêt Croix-Rousse ou Hénon</p>
      </div>

      <div class="w-full h-44 mt-2 rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700">
        <iframe
          class="w-full h-full border-0"
          src={dojo.map_embed}
          allowfullscreen=""
          loading="lazy"
          title="Plan d’accès Google Maps au Dojo Zen de Lyon, 11 rue Dumenge"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <hr class="my-4 border-gray-200 dark:border-gray-700" />

      <div class="border-l-2 border-indigo-600 dark:border-indigo-400 pl-3">
        <h3 class="font-semibold text-gray-900 dark:text-gray-100">{miroirs.name}</h3>
        <p class="text-gray-600 dark:text-gray-300">{miroirs.address}</p>
        <p class="text-gray-800 dark:text-gray-200 font-medium mt-1">Mercredis de {formatTimeTypographic(miroirs.time_start)} à {formatTimeTypographic(miroirs.time_end)}</p>
        <p class="text-xs text-gray-500 dark:text-gray-400">Plateau de la Croix-Rousse</p>
      </div>
    </div>

    <hr class="my-5 border-gray-200 dark:border-gray-700" />

    <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-2">Contacter Christophe Desmur</h2>
    <p class="text-xs text-gray-600 dark:text-gray-400 mb-3">Réponse directe pour toute question ou pour essayer un cours.</p>

    <a
      href={`mailto:${contact.email}`}
      class="block w-full text-center px-4 py-2.5 bg-gray-900 text-white font-medium rounded-lg hover:bg-gray-800 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-white transition mb-3">
      Envoyer un e-mail
    </a>

    <div class="space-y-1.5 pt-1">
      <a href={`tel:${telHref(contact.mobile)}`} class="flex items-center gap-2 text-gray-700 hover:text-indigo-600 dark:text-gray-300 dark:hover:text-indigo-400 py-1 transition font-medium">
        <span aria-hidden="true">📱</span> {contact.mobile}
      </a>
      <a href={`tel:${telHref(contact.landline)}`} class="flex items-center gap-2 text-gray-700 hover:text-indigo-600 dark:text-gray-300 dark:hover:text-indigo-400 py-1 transition font-medium">
        <span aria-hidden="true">📞</span> {contact.landline}
      </a>
    </div>

    <div class="mt-4 pt-3 border-t border-gray-200 dark:border-gray-700 text-xs text-gray-500 dark:text-gray-400">
      <p>Tous niveaux acceptés • Débutants bienvenus • Matériel complet fourni</p>
    </div>
  </div>
</div>
