---
import Dropdown from "./dropdown.astro";

// Navigation principale par intention. Les pages secondaires (publics
// spécifiques, tarifs, textes) restent accessibles par liens contextuels
// (RelatedPages, pages parentes) et dans le pied de page.
const menuitems = [
  {
    title: "Calligraphie",
    path: "#",
    children: [
      { title: "Ateliers", path: "/cours-collectifs" },
      { title: "Cours individuels", path: "/cours-individuel-a-domicile" },
      { title: "Interventions", path: "/atelier-de-groupe" },
      { title: "Œuvres", path: "/galerie" },
    ],
  },
  {
    title: "Découvrir",
    path: "#",
    children: [
      { title: "La pratique", path: "/shodo-voie-pinceau" },
      { title: "Guide pour débuter", path: "/debuter-calligraphie-chinoise" },
      { title: "Christophe Desmur", path: "/le-calligraphe" },
      { title: "FAQ", path: "/faq" },
    ],
  },
  {
    title: "Contact",
    path: "/contact",
  },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (path: string) =>
  path !== "#" && (current === path || current.startsWith(`${path}/`));
---

<header class="wrap">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between py-4 sm:py-5 border-b border-warm-grey">
    <nav class="w-full flex flex-col lg:flex-row lg:items-center justify-between" aria-label="Navigation principale">
      <div class="flex w-full lg:w-auto items-center justify-between gap-2">
        <a href="/" class="group inline-flex min-h-11 items-baseline gap-2 shrink-0" aria-label="Calligraphie chinoise Lyon — accueil">
          <span class="font-serif text-[1.3rem] min-[360px]:text-[1.45rem] sm:text-[1.6rem] font-medium leading-none text-ink">Calligraphie</span>
          <span class="hidden sm:inline eyebrow text-[0.65rem]">chinoise · Lyon</span>
        </a>
        <div class="flex items-center gap-1 lg:hidden">
          <a href="/cours-collectifs#trial-heading" class="btn btn-ink min-h-11 px-3 py-2 text-[0.8rem] whitespace-nowrap">
            Essayer un cours
          </a>
          <button
            id="mobile-menu-toggle"
            type="button"
            class="inline-flex h-11 w-11 items-center justify-center text-ink cursor-pointer"
            aria-label="Menu"
            aria-controls="site-menu"
            aria-expanded="false">
            <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <line x1="4" y1="8" x2="20" y2="8"></line>
              <line x1="4" y1="16" x2="20" y2="16"></line>
            </svg>
            <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="hidden" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
      <div id="site-menu" class="hidden w-full lg:w-auto mt-2 lg:mt-0 lg:flex lg:items-center">
        <ul class="flex flex-col lg:flex-row lg:items-center lg:gap-2 text-[0.95rem]">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children.map((c) => ({ ...c, active: isActive(c.path) }))}
                    active={item.children.some((c) => isActive(c.path))}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li class="border-b border-warm-grey lg:border-0">
                    <a
                      href={item.path}
                      aria-current={isActive(item.path) ? "page" : undefined}
                      class="nav-link flex min-h-12 lg:min-h-11 items-center lg:px-3 text-ink hover:text-soft-ink transition-colors">
                      <span>{item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <div class="lg:ml-5 mt-5 lg:mt-0 flex items-center gap-2 pb-4 lg:pb-0">
          <a href="/cours-collectifs#trial-heading" class="btn btn-ink hidden lg:inline-flex min-h-11 py-2 px-5 text-sm whitespace-nowrap">
            Essayer un cours
          </a>
          <button
            id="theme-toggle"
            aria-label="Basculer le mode sombre/clair"
            class="inline-flex h-11 w-11 items-center justify-center text-soft-ink hover:text-ink transition-colors">
            <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  function setupNav() {
    const menuBtn = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("site-menu");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");

    if (menuBtn && menu && !menuBtn.dataset.init) {
      menuBtn.dataset.init = "true";
      menuBtn.addEventListener("click", () => {
        const isOpen = !menu.classList.contains("hidden");
        menu.classList.toggle("hidden", isOpen);
        menuBtn.setAttribute("aria-expanded", String(!isOpen));
        hamburgerIcon?.classList.toggle("hidden", !isOpen);
        closeIcon?.classList.toggle("hidden", isOpen);
      });
    }

    const dropdownItems = document.querySelectorAll<HTMLElement>(".dropdown-item");
    dropdownItems.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>(".nav-trigger");
      const dropdownMenu = item.querySelector<HTMLElement>(".dropdown-menu");
      const arrow = item.querySelector<SVGElement>(".dropdown-arrow");
      if (!trigger || !dropdownMenu || trigger.dataset.init === "true") return;
      trigger.dataset.init = "true";

      function openDropdown() {
        dropdownMenu.classList.remove("hidden");
        trigger.setAttribute("aria-expanded", "true");
        arrow?.classList.add("rotate-180");
      }

      function closeDropdown() {
        dropdownMenu.classList.add("hidden");
        trigger.setAttribute("aria-expanded", "false");
        arrow?.classList.remove("rotate-180");
      }

      function toggleDropdown() {
        const isOpen = !dropdownMenu.classList.contains("hidden");
        if (isOpen) {
          closeDropdown();
        } else {
          dropdownItems.forEach((sibling) => {
            if (sibling !== item) {
              sibling.querySelector(".dropdown-menu")?.classList.add("hidden");
              sibling.querySelector(".nav-trigger")?.setAttribute("aria-expanded", "false");
              sibling.querySelector(".dropdown-arrow")?.classList.remove("rotate-180");
            }
          });
          openDropdown();
        }
      }

      trigger.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleDropdown();
      });

      item.addEventListener("mouseenter", () => {
        if (window.innerWidth >= 1024) openDropdown();
      });
      item.addEventListener("mouseleave", () => {
        if (window.innerWidth >= 1024) closeDropdown();
      });
    });

    if (!(window as any).__navGlobalListenersInit) {
      (window as any).__navGlobalListenersInit = true;
      document.addEventListener("click", (e) => {
        const nav = document.querySelector("header.wrap");
        if (nav && !nav.contains(e.target as Node)) {
          document.querySelectorAll(".dropdown-item").forEach((item) => {
            item.querySelector(".dropdown-menu")?.classList.add("hidden");
            item.querySelector(".nav-trigger")?.setAttribute("aria-expanded", "false");
            item.querySelector(".dropdown-arrow")?.classList.remove("rotate-180");
          });
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          document.querySelectorAll(".dropdown-item").forEach((item) => {
            item.querySelector(".dropdown-menu")?.classList.add("hidden");
            item.querySelector(".nav-trigger")?.setAttribute("aria-expanded", "false");
            item.querySelector(".dropdown-arrow")?.classList.remove("rotate-180");
          });
          const m = document.getElementById("site-menu");
          const b = document.getElementById("mobile-menu-toggle");
          if (m && !m.classList.contains("hidden")) {
            m.classList.add("hidden");
            b?.setAttribute("aria-expanded", "false");
            document.getElementById("hamburger-icon")?.classList.remove("hidden");
            document.getElementById("close-icon")?.classList.add("hidden");
            b?.focus();
          }
        }
      });
    }
  }

  setupNav();
  document.addEventListener("astro:page-load", setupNav);
</script>

<style>
  /* Rubrique active : un trait vermillon sous le libellé (pas seulement la couleur) */
  .nav-link[aria-current="page"] span,
  :global(.nav-trigger[data-active] > span:first-child) {
    text-decoration: underline;
    text-decoration-color: var(--color-vermilion);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }
</style>
