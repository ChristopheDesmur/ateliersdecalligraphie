---
import Container from "../container.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems } from "astro-navbar";

const menuitems = [
  {
    title: "Cours",
    path: "#",
    children: [
      { title: "Cours collectifs à Lyon", path: "/cours-collectifs" },
      { title: "Tarifs des cours", path: "/tarifs" },
    ],
  },
  {
    title: "Cours individuels",
    path: "/cours-individuel-a-domicile",
  },
  {
    title: "Interventions",
    path: "#",
    children: [
      { title: "Vue d’ensemble des ateliers", path: "/atelier-de-groupe" },
      { title: "Écoles primaires", path: "/ecoles-primaires" },
      { title: "Collèges", path: "/colleges" },
      { title: "Lycées", path: "/formats-atelier-pour-les-lycees" },
      { title: "Universités et grandes écoles", path: "/universites-et-grandes-ecoles" },
      { title: "Comités d’entreprise (CSE)", path: "/comites-entreprise" },
      { title: "Maisons de retraite & EHPAD", path: "/maisons-de-retraite" },
    ],
  },
  {
    title: "Œuvres à vendre",
    path: "/galerie",
  },
  {
    title: "Découvrir",
    path: "#",
    children: [
      { title: "Guide : débuter la calligraphie", path: "/debuter-calligraphie-chinoise" },
      { title: "La voie du pinceau (Shodo)", path: "/shodo-voie-pinceau" },
      { title: "Calligraphie zen", path: "/calligraphie-zen" },
      { title: "Foire aux questions (FAQ)", path: "/faq" },
      { title: "Cours de langue chinoise", path: "/cours-de-chinois" },
      { title: "Traductions littéraires", path: "/traductions" },
    ],
  },
  {
    title: "À propos",
    path: "/le-calligraphe",
  },
  {
    title: "Contact",
    path: "/contact",
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-3 sm:my-4 border-b border-gray-100 dark:border-gray-800 pb-3 sm:pb-4">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between gap-2">
        <a href="/" class="text-base sm:text-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded py-1 shrink-0">
          <span class="font-serif font-bold text-gray-950 dark:text-gray-100">Calligraphie </span>
          <span class="text-gray-500 dark:text-gray-400 font-sans text-sm sm:text-base">chinoise Lyon</span>
        </a>
        <div class="flex items-center gap-2 lg:hidden">
          <a
            href="/cours-collectifs#trial-heading"
            class="px-3 py-1.5 min-h-[36px] inline-flex items-center justify-center rounded-lg bg-indigo-600 text-white text-xs font-medium hover:bg-indigo-700 active:scale-98 transition shadow-2xs whitespace-nowrap">
            Essayer un cours
          </a>
          <button
            class="astronav-toggle p-2 rounded-lg text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 transition"
            aria-label="Ouvrir le menu"
            aria-expanded="false">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-3 lg:mt-0 lg:flex">
        <ul class="flex flex-col lg:flex-row lg:items-center lg:gap-1 text-sm font-medium">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-2.5 py-2 items-center text-gray-700 hover:text-indigo-600 dark:text-gray-300 dark:hover:text-indigo-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg transition">
                      <span>{item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <div class="lg:ml-3 mt-3 lg:mt-0 flex items-center gap-2 pt-3 lg:pt-0 border-t lg:border-t-0 border-gray-100 dark:border-gray-800">
          <a
            href="/cours-collectifs#trial-heading"
            class="w-full lg:w-auto text-center px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-indigo-500 transition whitespace-nowrap shadow-xs">
            Essayer un cours
          </a>
          <button
            id="theme-toggle"
            aria-label="Basculer le mode sombre/clair"
            class="p-2 rounded-lg text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
            <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </MenuItems>
    </Astronav>
  </header>
</Container>
