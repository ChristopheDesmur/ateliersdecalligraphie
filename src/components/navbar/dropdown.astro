---
interface Item {
  title: string;
  path: string;
  active?: boolean;
}

const { title, lastItem, children, active = false } = Astro.props as {
  title: string;
  lastItem?: boolean;
  children: Item[];
  active?: boolean;
};
---

<li class="relative border-b border-warm-grey lg:border-0 dropdown-item">
  <div class="group">
    <button
      type="button"
      class="nav-trigger flex min-h-12 lg:min-h-11 items-center justify-between gap-1.5 w-full lg:w-auto lg:px-3 text-ink hover:text-soft-ink transition-colors cursor-pointer"
      data-active={active ? "" : undefined}
      aria-haspopup="true"
      aria-expanded="false">
      <span>{title}</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.75"
        stroke="currentColor"
        class="dropdown-arrow w-3 h-3 mt-0.5 transition-transform duration-200"
        aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
      </svg>
    </button>
    <div
      class:list={[
        "dropdown-menu hidden lg:absolute w-full lg:w-60 z-30 lg:pt-2",
        lastItem ? "lg:right-0 origin-top-right" : "lg:left-0 origin-top-left",
      ]}>
      <ul class="pb-3 lg:py-2 lg:bg-paper lg:border lg:border-warm-grey lg:shadow-xl flex flex-col">
        {
          children.map((item) => (
            <li>
              <a
                href={item.path}
                aria-current={item.active ? "page" : undefined}
                class="dropdown-link flex min-h-11 items-center gap-3 pl-4 lg:px-5 font-serif text-lg text-ink hover:text-soft-ink hover:bg-paper-deep transition-colors">
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</li>

<style>
  .dropdown-link[aria-current="page"] {
    box-shadow: inset 2px 0 0 var(--color-vermilion);
  }
</style>
