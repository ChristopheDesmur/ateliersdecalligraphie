---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import RelatedPages from "@/components/related-pages.astro";
import Breadcrumbs from "@/components/gallery/Breadcrumbs.astro";
import ArtworkCard from "@/components/gallery/ArtworkCard.astro";
import AcquisitionProcess from "@/components/gallery/AcquisitionProcess.astro";
import PersonalizedCalligraphyCTA from "@/components/gallery/PersonalizedCalligraphyCTA.astro";
import GalleryFAQ from "@/components/gallery/GalleryFAQ.astro";
import { getAllArtworks } from "@/data/artworks";
import { prices } from "@/data/prices";
import EditorialLink from "@/components/editorial/EditorialLink.astro";

const artworks = getAllArtworks();
const availableCount = artworks.filter((a) => a.availability === "Disponible").length;
const soldCount = artworks.filter((a) => a.availability === "Vendue").length;

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Calligraphies chinoises originales à vendre | Christophe Desmur",
  "description": "Découvrez les calligraphies chinoises originales de Christophe Desmur. Pièces uniques à l’encre de Chine, disponibles à l’acquisition sur demande à Lyon.",
  "url": "https://ateliersdecalligraphie.com/galerie",
  "creator": {
    "@type": "Person",
    "name": "Christophe Desmur",
    "url": "https://ateliersdecalligraphie.com/le-calligraphe"
  },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": artworks.length,
    "itemListElement": artworks.map((artwork, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://ateliersdecalligraphie.com/galerie/${artwork.slug}`,
      "name": `${artwork.character} — ${artwork.frenchMeaning}`
    }))
  }
};
---

<Layout
  title="Calligraphies chinoises originales à vendre | Christophe Desmur"
  description="Découvrez les calligraphies chinoises originales de Christophe Desmur. Pièces uniques à l’encre de Chine, disponibles à l’acquisition sur demande à Lyon.">

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <Container>
    <!-- Fil d’Ariane accessible avec microdonnées -->
    <Breadcrumbs
      items={[
        { label: "Accueil", href: "/" },
        { label: "Œuvres à vendre" },
      ]}
    />

    <!-- ================================================================= -->
    <!-- HERO ÉDITORIAL SOBRE ET COMMERCIAL                                -->
    <!-- ================================================================= -->
    <header class="pb-14 sm:pb-20" aria-labelledby="gallery-heading">
      <div class="max-w-3xl">
        <p class="eyebrow eyebrow-mark mb-5">
          Œuvres originales disponibles à l’acquisition
        </p>

        <h1 id="gallery-heading" class="h-section">
          Calligraphies chinoises originales à vendre
        </h1>

        <p class="lede mt-6">
          Découvrez les calligraphies chinoises originales réalisées à l’encre de Chine par Christophe Desmur. Chaque œuvre est une pièce unique. Les œuvres disponibles sont proposées à l’acquisition directement auprès du calligraphe.
        </p>

        <!-- Actions principales : découverte & création sur mesure -->
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
          <a href="#oeuvres" class="btn btn-ink">Découvrir les œuvres</a>
          <a href="#calligraphie-personnalisee" class="btn btn-line">Commander une calligraphie personnalisée</a>
        </div>

        <!-- Repères d’acquisition -->
        <ol class="mt-10 grid grid-cols-1 gap-x-10 gap-y-5 border-t border-warm-grey pt-6 sm:grid-cols-3">
          <li>
            <span class="numeral" aria-hidden="true">01</span>
            <p class="meta mt-1"><span class="text-ink">Choisissez votre œuvre</span> parmi les pièces originales uniques.</p>
          </li>
          <li>
            <span class="numeral" aria-hidden="true">02</span>
            <p class="meta mt-1"><span class="text-ink">Contactez Christophe Desmur</span> par courriel ou téléphone.</p>
          </li>
          <li>
            <span class="numeral" aria-hidden="true">03</span>
            <p class="meta mt-1"><span class="text-ink">Échangez sur le prix</span>, l’encadrement, la remise à Lyon ou l’envoi.</p>
          </li>
        </ol>

        <p class="meta mt-6">
          Œuvres visibles sur rendez-vous à Lyon (Croix-Rousse). {prices.galerie.sur_demande}, échange direct avec le calligraphe sans intermédiaire ni paiement automatisé.
        </p>
      </div>
    </header>

    <!-- ================================================================= -->
    <!-- GRILLE D’ŒUVRES AVEC FILTRES DISCRETS                             -->
    <!-- ================================================================= -->
    <section id="oeuvres" class="scroll-mt-24" aria-labelledby="collection-heading">
      
      <!-- Barre d’outils / Filtres d’accessibilité légers -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 border-b border-ink/80 pb-5 mb-12">
        <div>
          <h2 id="collection-heading" class="h-item">
            Œuvres originales disponibles à l’acquisition
          </h2>
          <p class="meta mt-2">
            Chaque calligraphie est une pièce originale unique scellée au cinabre, disponible à la vente sur demande.
          </p>
        </div>

        <!-- Filtres par statut -->
        <nav aria-label="Filtrer les œuvres" class="flex flex-wrap items-center gap-x-6 gap-y-1">
          <button type="button" class="filter-btn is-active" data-filter="all" aria-pressed="true">
            Toutes ({artworks.length})
          </button>
          <button type="button" class="filter-btn" data-filter="Disponible" aria-pressed="false">
            Disponibles ({availableCount})
          </button>
          <button type="button" class="filter-btn" data-filter="Vendue" aria-pressed="false">
            Vendues ({soldCount})
          </button>
        </nav>
      </div>

      <!-- Grille d’œuvres -->
      <div id="artworks-grid" class="grid grid-cols-1 gap-x-10 gap-y-16 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-12">
        {artworks.map((artwork, index) => (
          <ArtworkCard artwork={artwork} priority={index < 3} />
        ))}
      </div>

      <!-- Message si aucun résultat -->
      <div id="no-results" class="hidden py-16 font-serif text-xl text-soft-ink">
        Aucune œuvre ne correspond au filtre sélectionné.
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- COMMENT ACQUÉRIR UNE CALLIGRAPHIE                                 -->
    <!-- ================================================================= -->
    <AcquisitionProcess />

    <!-- ================================================================= -->
    <!-- SECTION CALLIGRAPHIE PERSONNALISÉE                                -->
    <!-- ================================================================= -->
    <PersonalizedCalligraphyCTA />

    <!-- ================================================================= -->
    <!-- CONTEXTE CALLIGRAPHE : CHRISTOPHE DESMUR                         -->
    <!-- ================================================================= -->
    <section class="section border-t border-warm-grey" aria-labelledby="artist-context-heading">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-4">
          <figure data-reveal>
            <div class="ink-frame aspect-[4/5]">
              <img
                src="/assets/christophe-desmur-calligraphie-chinoise.webp"
                alt="Christophe Desmur calligraphe chinois et traducteur littéraire à Lyon"
                width="800"
                height="567"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
            <figcaption class="meta mt-3 font-serif italic text-[0.95rem]">
              Christophe Desmur au travail du pinceau à Lyon.
            </figcaption>
          </figure>
        </div>

        <div class="md:col-span-8">
          <p class="eyebrow mb-4">
            Le calligraphe
          </p>
          <h2 id="artist-context-heading" class="h-section">
            Christophe Desmur, plus de 30 ans de pratique de l’encre
          </h2>
          <p class="body-copy mt-6 max-w-none">
            Formé à la pratique traditionnelle de l’encre de Chine et titulaire d’un master de traduction littéraire chinois-français, Christophe Desmur transmet la voie du pinceau à Lyon et réalise des pièces originales nourries par les textes classiques, la philosophie taoïste et la tradition du zen.
          </p>
          <p class="body-copy mt-4 max-w-none">
            Chaque calligraphie est le fruit d’une recherche d’équilibre entre le plein de l’encre noire et la respiration du blanc de la feuille de riz, signée et scellée selon le rituel traditionnel chinois.
          </p>
          <div class="mt-6 flex flex-col items-start gap-1">
            <EditorialLink href="/le-calligraphe" label="Découvrir le parcours et les diplômes de Christophe Desmur" />
            <EditorialLink href="https://lesmotsoiseaux.jimdofree.com/calligraphes/" external label="Expositions collectives (Les Mots Oiseaux)" class="text-sm" />
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- FOIRE AUX QUESTIONS (SEO LONG-TRAÎNE & RÉASSURANCE)                -->
    <!-- ================================================================= -->
    <GalleryFAQ />

    <!-- Navigation transversale interne -->
    <RelatedPages current="/galerie" />
  </Container>

  <!-- Script interactif léger pour les filtres -->
  <script is:inline>
    (function() {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.artwork-card');
      const noResults = document.getElementById('no-results');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          // Mise à jour des styles de boutons
          filterBtns.forEach(b => {
            b.setAttribute('aria-pressed', 'false');
            b.classList.remove('is-active');
          });

          btn.setAttribute('aria-pressed', 'true');
          btn.classList.add('is-active');

          // Filtrage des œuvres
          let visibleCount = 0;
          cards.forEach(card => {
            const availability = card.getAttribute('data-availability');
            if (filter === 'all' || availability === filter) {
              card.style.display = '';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          if (noResults) {
            noResults.classList.toggle('hidden', visibleCount > 0);
          }
        });
      });
    })();
  </script>
  <style>
    .filter-btn {
      min-height: 2.75rem;
      font-size: 0.9rem;
      color: var(--color-soft-ink);
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: color 0.2s, border-color 0.2s;
    }
    .filter-btn:hover {
      color: var(--color-ink);
    }
    .filter-btn.is-active,
    .filter-btn[aria-pressed="true"] {
      color: var(--color-ink);
      border-bottom-color: var(--color-vermilion);
    }
  </style>
</Layout>
