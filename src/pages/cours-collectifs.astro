---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Cta from "@/components/cta.astro";
import RelatedPages from "@/components/related-pages.astro";
import EditorialSection from "@/components/editorial/EditorialSection.astro";
import EditorialLink from "@/components/editorial/EditorialLink.astro";
import FAQAccordion from "@/components/editorial/FAQAccordion.astro";
import { prices } from "@/data/prices";
import { contact, telHref } from "@/data/contact";
import { venues, formatTimeTypographic } from "@/data/venues";

const dojo = venues["dojo-zen-de-lyon"];
const miroirs = venues["miroirs-du-ciel"];

const locations = [
  {
    name: dojo.name,
    address: dojo.address,
    district: "Lyon 4<sup>e</sup> — Plateau de la Croix-Rousse",
    day: "Lundi soir",
    time: `${formatTimeTypographic(dojo.time_start)} – ${formatTimeTypographic(dojo.time_end)}`,
    duration: "2 heures",
    access: "Métro C (stations Croix-Rousse ou Hénon) • Bus C13, 2, 33, 45",
    atmosphere: "Cadre sobre, silencieux et traditionnel, propice au calme et à la concentration.",
    mapQuery: dojo.map_query,
    mapEmbed: dojo.map_embed,
    externalLink: {
      label: "Archive Le Progrès : « Zazen et calligraphie chinoise »",
      url: "https://www.leprogres.fr/loisirs/2013/05/26/zazen-et-calligraphie-chinoise",
    },
  },
  {
    name: miroirs.name,
    address: miroirs.address,
    district: "Lyon 4<sup>e</sup> — Cœur de la Croix-Rousse",
    day: "Mercredi matin",
    time: `${formatTimeTypographic(miroirs.time_start)} – ${formatTimeTypographic(miroirs.time_end)}`,
    duration: "2 heures",
    access: "Métro C (station Croix-Rousse à 3 min à pied)",
    atmosphere: "Atmosphère lumineuse et conviviale au sein d’une boutique dédiée aux arts d’Asie.",
    mapQuery: miroirs.map_query,
    mapEmbed: miroirs.map_embed,
    externalLink: {
      label: "Fiche atelier sur Arts Martiaux Lyon",
      url: "https://arts-martiaux-lyon.fr/calligraphie/",
    },
  },
];
const courseFaqs = [
  {
    question: "Faut-il savoir parler ou lire le chinois pour participer ?",
    answer: "Non, absolument aucun prérequis de langue ou d’écriture n’est nécessaire. La calligraphie chinoise est d’abord un art du geste, de la posture et du souffle. Le sens, l’histoire et l’ordre des traits de chaque caractère sont expliqués pas à pas au fur et à mesure de votre progression.",
  },
  {
    question: "Peut-on intégrer les cours en cours d’année ?",
    answer: "Oui, les inscriptions sont possibles tout au long de l’année selon les places disponibles. Comme les groupes sont restreints (2 à 8 personnes), Christophe Desmur accompagne chaque participant selon son propre niveau, qu’il s’agisse d’une initiation complète ou d’un perfectionnement.",
  },
  {
    question: "Le matériel est-il réellement fourni lors des séances ?",
    answer: "Oui, vous n’avez aucun matériel à acheter pour débuter. Pinceaux traditionnels en poils naturels (loup, chèvre), bâtons d’encre de Chine, pierres à encre et papiers absorbants sont mis à votre disposition à chaque cours. Si vous souhaitez pratiquer chez vous, Christophe pourra vous conseiller sur le choix des outils.",
  },
  {
    question: "Quelle est la différence entre le créneau du Dojo Zen et celui de Miroirs du Ciel ?",
    answer: `Le créneau du lundi soir (${formatTimeTypographic(dojo.time_start)} – ${formatTimeTypographic(dojo.time_end)}) au ${dojo.name} offre un cadre traditionnel, sobre et silencieux particulièrement propice à l’intériorisation après le travail. Le créneau du mercredi matin (${formatTimeTypographic(miroirs.time_start)} – ${formatTimeTypographic(miroirs.time_end)}) à la boutique Miroirs du Ciel propose une atmosphère lumineuse et conviviale. Le programme et la qualité d’enseignement sont identiques.`,
  },
  {
    question: `Comment fonctionne le tarif de ${prices.cours_collectifs.trimestre} € par trimestre ?`,
    answer: `La cotisation trimestrielle de ${prices.cours_collectifs.trimestre} € couvre ${prices.cours_collectifs.seances} cours hebdomadaires avec le matériel inclus. Ce tarif ne bénéficie pas de crédit d’impôt, celui-ci étant réservé aux cours particuliers dispensés à domicile via Coop A Dom. Un tarif adapté et accessible pour une pratique artistique et culturelle de qualité à Lyon.`,
  },
  {
    question: "Quel est l’âge minimum pour participer aux cours collectifs ?",
    answer: "Les cours hebdomadaires adultes accueillent les jeunes dès l’âge de 14 à 15 ans. Pour les enfants plus jeunes (écoles primaires et collèges), des ateliers spécifiques adaptés au rythme scolaire sont organisés tout au long de l’année.",
  },
];

const sessionSteps = [
  {
    title: "La posture corporelle et la concentration",
    text: "Une assise équilibrée favorise l’ouverture de la cage thoracique et la détente des épaules. L’immobilité attentive précède l’élan créatif.",
  },
  {
    title: "La préparation de l’encre de Chine",
    text: "Frotter le bâton d’encre sur la pierre avec un peu d’eau est un rituel d’intériorisation. On observe la texture et la profondeur du noir qui naît sous nos yeux.",
  },
  {
    title: "Le maniement du pinceau et les traits fondamentaux",
    html: "Tenue verticale du pinceau, pression, levée, terminaison : vous apprenez les 8 traits fondamentaux (le caractère <em>Yong</em> 永) qui composent l’ensemble de l’écriture chinoise.",
  },
  {
    title: "L’exploration des styles classiques",
    html: "Du style régulier (<em>Kaishu</em>, clair et structuré) au style courant (<em>Xingshu</em>, fluide et expressif) puis cursif (<em>Caoshu</em>), chacun avance selon sa sensibilité.",
  },
];

const practicalFacts = [
  { label: "Effectif", value: "2 à 8", note: "Participants par séance pour préserver la qualité de l’accompagnement individuel." },
  { label: "Matériel", value: "100 % fourni", note: "Pinceaux, bâtons d’encre de Chine, pierres à encre et papiers chinois mis à disposition." },
  { label: "Niveau requis", value: "Tous niveaux", note: "Aucune notion de langue chinoise ni de pratique artistique préalable n’est nécessaire." },
];
---

<Layout
  title="Cours collectifs de calligraphie chinoise à Lyon"
  description={`Cours hebdomadaires de calligraphie chinoise à Lyon (Croix-Rousse). Dojo Zen (lundi soir) et Miroirs du Ciel (mercredi matin). Débutants bienvenus, matériel fourni. ${prices.cours_collectifs.trimestre} €/trimestre (${prices.cours_collectifs.seances} cours).`}>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "Cours collectifs de calligraphie chinoise à Lyon",
      "description": "Cours réguliers hebdomadaires de calligraphie chinoise au Dojo Zen de Lyon et à la boutique Miroirs du Ciel. Apprentissage du maniement du pinceau, des sinogrammes, de la posture et des styles traditionnels.",
      "url": "https://ateliersdecalligraphie.com/cours-collectifs",
      "provider": {
        "@type": "Person",
        "name": "Christophe Desmur",
        "url": "https://ateliersdecalligraphie.com/le-calligraphe"
      },
      "educationalLevel": "Tous niveaux (débutant à confirmé)",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "200",
        "priceCurrency": "EUR",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "200",
          "priceCurrency": "EUR",
          "unitText": "trimestre"
        }
      },
      "hasCourseInstance": [
        {
          "@type": "CourseInstance",
          "courseMode": "ONSITE",
          "location": {
            "@type": "Place",
            "name": dojo.name,
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "11, rue Dumenge",
              "postalCode": "69004",
              "addressLocality": "Lyon",
              "addressCountry": "FR"
            }
          }
        },
        {
          "@type": "CourseInstance",
          "courseMode": "ONSITE",
          "location": {
            "@type": "Place",
            "name": miroirs.name,
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "9, rue de Belfort",
              "postalCode": "69004",
              "addressLocality": "Lyon",
              "addressCountry": "FR"
            }
          }
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Faut-il savoir parler ou lire le chinois pour participer aux cours ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Non, aucun prérequis de langue ou de calligraphie n’est nécessaire. On apprend le geste, la respiration, la tenue verticale du pinceau et l’équilibre des traits directement lors des séances."
          }
        },
        {
          "@type": "Question",
          "name": "Peut-on intégrer les cours en cours d’année ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oui, les inscriptions restent ouvertes toute l’année selon les places disponibles. Les effectifs réduits (2 à 8 personnes) permettent un accompagnement personnalisé adapté à chacun."
          }
        },
        {
          "@type": "Question",
          "name": "Le matériel est-il réellement fourni lors des séances ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oui, tout le matériel traditionnel est mis à disposition à chaque séance : pinceaux en poils naturels, bâtons d’encre de Chine, pierres à frotter et papier absorbant."
          }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre le créneau du Dojo Zen et celui de Miroirs du Ciel ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Le lundi soir (${dojo.time_start.replace(":", "h")}-${dojo.time_end.replace(":", "h")}) a lieu au ${dojo.name} dans un cadre sobre et silencieux. Le mercredi matin (${miroirs.time_start.replace(":", "h")}-${miroirs.time_end.replace(":", "h")}) se déroule chez ${miroirs.name} dans une ambiance lumineuse. Le programme pédagogique est identique.`
          }
        },
        {
          "@type": "Question",
          "name": `Comment fonctionne le tarif de ${prices.cours_collectifs.trimestre} € par trimestre ?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `La cotisation trimestrielle de ${prices.cours_collectifs.trimestre} € couvre ${prices.cours_collectifs.seances} cours hebdomadaires ainsi que le matériel mis à disposition. Ce tarif n’ouvre pas droit à un crédit d’impôt, celui-ci étant réservé aux cours particuliers à domicile.`
          }
        }
      ]
    }
  ])} />

  <Container>
    <!-- Fil d’Ariane -->
    <nav aria-label="Fil d’Ariane" class="meta text-xs mb-8">
      <ol class="flex items-center gap-2 flex-wrap">
        <li><a href="/" class="underline decoration-warm-grey underline-offset-4 hover:decoration-current">Accueil</a></li>
        <li aria-hidden="true" class="text-warm-grey">/</li>
        <li>Calligraphie chinoise</li>
        <li aria-hidden="true" class="text-warm-grey">/</li>
        <li aria-current="page" class="text-ink">Cours collectifs à Lyon</li>
      </ol>
    </nav>

    <!-- En-tête de page -->
    <header class="max-w-3xl pb-14 sm:pb-20">
      <p class="eyebrow eyebrow-mark mb-5">
        Pratique hebdomadaire à Lyon 4<sup>e</sup>
      </p>
      <h1 class="h-section">
        Cours collectifs de calligraphie chinoise à Lyon
      </h1>
      <p class="lede mt-6">
        Chaque semaine à la Croix-Rousse, Christophe Desmur vous guide dans l’apprentissage du pinceau, du souffle et du tracé des caractères chinois traditionnels. Un atelier à taille humaine, ouvert à tous.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
        <a href="#trial-heading" class="btn btn-ink">Séance d’essai sans engagement</a>
        <a href="#schedule-heading" class="btn btn-line">Voir les créneaux &amp; lieux</a>
      </div>
    </header>

    <!-- Lieux & horaires : entrées éditoriales -->
    <section class="section border-t border-warm-grey scroll-mt-24" aria-labelledby="schedule-heading">
      <h2 id="schedule-heading" class="h-section mb-12">
        Lieux et horaires des séances
      </h2>

      <div class="grid gap-14 md:grid-cols-2 md:gap-10 lg:gap-16">
        {locations.map((loc) => (
          <article data-reveal class="flex flex-col">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-warm-grey pb-3">
              <p class="eyebrow">{loc.day}</p>
              <p class="font-sans text-[0.95rem] font-medium text-ink tabular-nums" set:html={loc.time} />
            </div>

            <h3 class="h-item mt-5">{loc.name}</h3>
            <p class="meta mt-1">{loc.address}</p>
            <p class="meta" set:html={loc.district} />

            <p class="body-copy mt-4">{loc.atmosphere}</p>

            <dl class="meta mt-5 border-t border-warm-grey pt-4">
              <dt class="inline font-medium text-ink">Accès TCL :</dt>
              <dd class="inline"> {loc.access}</dd>
            </dl>
            {loc.externalLink && (
              <p class="mt-1">
                <EditorialLink href={loc.externalLink.url} external label={loc.externalLink.label} class="text-sm" />
              </p>
            )}

            <div class="mt-6 ink-frame h-48">
              <iframe
                class="w-full h-full border-0"
                src={loc.mapEmbed}
                loading="lazy"
                title={`Plan d’accès Google Maps pour ${loc.name}`}
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>

            <div class="mt-5">
              <a
                href={`mailto:${contact.email}?subject=Demande%20d’inscription%20cours%20collectif`}
                class="btn btn-line w-full">
                Réserver une séance ({loc.day.toLowerCase()})
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Tarif & modalités : présentation éditoriale, prix visible -->
    <section class="section border-t border-warm-grey scroll-mt-24" aria-labelledby="practical-heading">
      <h2 id="practical-heading" class="h-section mb-12">
        Informations pratiques &amp; modalités
      </h2>

      <div data-reveal class="grid gap-x-10 gap-y-6 border-t border-ink/80 py-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h3 class="label-caps">Cours collectif hebdomadaire</h3>
          <p class="font-serif text-2xl text-soft-ink mt-1.5">Lyon 4<sup>e</sup> · séance de 2 heures</p>
        </div>
        <div class="lg:col-span-4">
          <p class="font-serif text-5xl leading-none text-ink">{prices.cours_collectifs.trimestre}&nbsp;€</p>
          <p class="meta mt-2">
            Par trimestre, pour {prices.cours_collectifs.seances} cours hebdomadaires (matériel inclus).
          </p>
          <p class="meta mt-1">
            Ce tarif n’ouvre pas droit au crédit d’impôt, réservé aux cours à domicile.
          </p>
        </div>
        <div class="lg:col-span-4 flex flex-col items-start gap-2 lg:items-end">
          <a href="#trial-heading" class="btn btn-ink">Essayer une séance</a>
          <EditorialLink href="/tarifs" label="Voir tous les tarifs" />
        </div>
      </div>

      <dl class="grid border-b border-warm-grey sm:grid-cols-3">
        {practicalFacts.map((fact) => (
          <div class="border-t border-warm-grey py-6 sm:pr-8">
            <dt class="eyebrow">{fact.label}</dt>
            <dd>
              <p class="font-serif text-2xl text-ink mt-1.5">{fact.value}</p>
              <p class="meta mt-1.5">{fact.note}</p>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Déroulement d’une séance -->
    <section class="section border-t border-warm-grey" aria-labelledby="session-heading">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div data-reveal class="lg:col-span-5">
          <h2 id="session-heading" class="h-section">
            Comment se déroule une séance de calligraphie ?
          </h2>
          <p class="lede mt-6">
            La calligraphie chinoise traditionnelle n’est pas un simple exercice d’écriture : c’est un art du geste, de la posture et du souffle. Chaque séance est rythmée de manière progressive pour vous permettre de vous détendre et de canaliser votre attention.
          </p>
        </div>

        <ol class="lg:col-span-7 border-t border-warm-grey">
          {sessionSteps.map((step, i) => (
            <li data-reveal class="grid grid-cols-[2.75rem_1fr] gap-x-4 border-b border-warm-grey py-6">
              <span class="numeral pt-1" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="font-serif text-xl sm:text-2xl leading-snug text-ink">{step.title}</h3>
                {step.html
                  ? <p class="body-copy mt-2" set:html={step.html} />
                  : <p class="body-copy mt-2">{step.text}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- L’enseignant : Christophe Desmur -->
    <section class="section border-t border-warm-grey" aria-labelledby="teacher-heading">
      <div data-reveal class="grid gap-8 sm:grid-cols-12 sm:gap-10 items-start">
        <div class="sm:col-span-4 lg:col-span-3">
          <div class="ink-frame aspect-[4/5] max-w-[220px]">
            <img
              src="/assets/christophe-desmur-calligraphie-chinoise.webp"
              alt="Christophe Desmur, professeur de calligraphie chinoise à Lyon"
              width="800"
              height="567"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
        <div class="sm:col-span-8 lg:col-span-7">
          <p class="eyebrow mb-3">Votre enseignant</p>
          <h2 id="teacher-heading" class="h-item">Christophe Desmur</h2>
          <p class="body-copy mt-4">
            Diplômé en langue et civilisation chinoises et titulaire d’un Master de traduction littéraire chinois-français (Université Jean Moulin Lyon 3), Christophe Desmur enseigne la calligraphie chinoise et le Shodō à Lyon depuis plus de 25 ans. Sa pédagogie allie rigueur du geste traditionnel, bienveillance et attention individualisée.
          </p>
          <div class="mt-4">
            <EditorialLink href="/le-calligraphe" label="Découvrir son parcours complet, ses diplômes et ses expositions" />
          </div>
        </div>
      </div>
    </section>

    <!-- Première séance d’essai -->
    <section class="section border-t border-warm-grey scroll-mt-24" aria-labelledby="trial-heading">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div data-reveal class="lg:col-span-5">
          <p class="eyebrow eyebrow-mark mb-5">Première séance</p>
          <h2 id="trial-heading" class="h-section">
            Comment se passe votre première séance ?
          </h2>
        </div>
        <div data-reveal class="lg:col-span-7">
          <p class="body-copy">
            Il est tout à fait possible de venir participer à un premier cours sans engagement pour faire l’expérience du maniement du pinceau et rencontrer Christophe Desmur.
          </p>
          <ul class="mt-6 border-t border-warm-grey">
            <li class="flex items-baseline gap-3 border-b border-warm-grey py-3.5">
              <span class="h-px w-4 shrink-0 translate-y-[-0.3em] bg-soft-ink" aria-hidden="true"></span>
              <span>Venez simplement dans une tenue confortable.</span>
            </li>
            <li class="flex items-baseline gap-3 border-b border-warm-grey py-3.5">
              <span class="h-px w-4 shrink-0 translate-y-[-0.3em] bg-soft-ink" aria-hidden="true"></span>
              <span>Tout le matériel est prêt sur votre table à votre arrivée.</span>
            </li>
            <li class="flex items-baseline gap-3 border-b border-warm-grey py-3.5">
              <span class="h-px w-4 shrink-0 translate-y-[-0.3em] bg-soft-ink" aria-hidden="true"></span>
              <span>Christophe adapte ses explications dès vos premiers coups de pinceau.</span>
            </li>
          </ul>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
            <a
              href={`mailto:${contact.email}?subject=Demande%20de%20première%20séance%20d’essai`}
              class="btn btn-ink">
              Prendre contact pour une séance d’essai
            </a>
            <a href={`tel:${telHref(contact.mobile)}`} class="btn btn-line tabular-nums" aria-label={`Appeler Christophe Desmur au ${contact.mobile}`}>
              {contact.mobile}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Foire aux questions : cours collectifs -->
    <EditorialSection
      id="faq"
      eyebrow="Questions fréquentes"
      title="Tout savoir avant de rejoindre nos cours"
      layout="split"
      class="border-t border-warm-grey">
      <FAQAccordion items={courseFaqs} openFirst />
    </EditorialSection>

    <RelatedPages current="/cours-collectifs" />

    <Cta />
  </Container>
</Layout>
