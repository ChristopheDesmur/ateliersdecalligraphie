---
import Layout from "@/layouts/Layout.astro";
import { prices, netHeureDomicile } from "@/data/prices";
import { contact, telHref } from "@/data/contact";
import EditorialLink from "@/components/editorial/EditorialLink.astro";

const contactMailHref = `mailto:${contact.email}?subject=Demande%20de%20cours%20individuel%20%C3%A0%20domicile`;
---

<Layout
  title="Cours individuel de calligraphie chinoise à domicile | Lyon — Christophe Desmur"
  description={`Cours particulier de calligraphie chinoise à domicile à Lyon : accompagnement personnalisé à votre rythme, matériel fourni, crédit d’impôt ${prices.cours_individuel_domicile.reduction_impot_pct} % (Coop A Dom). ${prices.cours_individuel_domicile.ttc_heure} € TTC/h.`}>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Cours particulier de calligraphie chinoise à domicile",
      "description": `Cours individuel de calligraphie chinoise à domicile à Lyon et son agglomération, dispensé par Christophe Desmur. Accompagnement personnalisé à votre rythme, matériel fourni. Agrément Coop A Dom n° ${contact.coop_a_dom_agrement} — éligible à la réduction ou au crédit d’impôt de ${prices.cours_individuel_domicile.reduction_impot_pct} % (article 199 sexdecies du CGI, hors soutien scolaire).`,
      "url": "https://ateliersdecalligraphie.com/cours-individuel-a-domicile",
      "provider": {
        "@type": "Person",
        "name": "Christophe Desmur",
        "url": "https://ateliersdecalligraphie.com/le-calligraphe"
      },
      "areaServed": {
        "@type": "City",
        "name": "Lyon"
      },
      "serviceType": "Cours à domicile de calligraphie chinoise",
      "offers": {
        "@type": "Offer",
        "price": `${prices.cours_individuel_domicile.ttc_heure}`,
        "priceCurrency": "EUR",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": `${prices.cours_individuel_domicile.ttc_heure}`,
          "priceCurrency": "EUR",
          "unitText": "heure"
        }
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Services à domicile agréés",
        "description": `Agrément Coop A Dom n° ${contact.coop_a_dom_agrement} — éligible à la réduction d’impôt de ${prices.cours_individuel_domicile.reduction_impot_pct} % (article 199 sexdecies du CGI, hors soutien scolaire)`
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Dans quels secteurs de Lyon intervenez-vous à domicile ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Christophe Desmur intervient dans tous les arrondissements de Lyon (du 1er au 9e) ainsi que dans les communes limitrophes de la métropole lyonnaise (Caluire-et-Cuire, Villeurbanne, Oullins, Écully, Tassin-la-Demi-Lune, etc.)."
          }
        },
        {
          "@type": "Question",
          "name": `Comment fonctionne le crédit d’impôt de ${prices.cours_individuel_domicile.reduction_impot_pct} % pour les cours à domicile ?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Via l’agrément Coop A Dom n° ${contact.coop_a_dom_agrement} (services à la personne), vous bénéficiez de ${prices.cours_individuel_domicile.reduction_impot_pct} % de réduction ou de crédit d’impôt sur le tarif de ${prices.cours_individuel_domicile.ttc_heure} € TTC / heure, soit ${netHeureDomicile} € net de l’heure. Une attestation fiscale annuelle officielle vous est délivrée.`
          }
        },
        {
          "@type": "Question",
          "name": "Quel matériel dois-je prévoir chez moi ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Une simple table et une assise confortable suffisent. L’ensemble du matériel traditionnel (pinceaux, encre de Chine, pierres, papier de riz et feutre protecteur de table) est apporté par l’enseignant."
          }
        }
      ]
    }
  ])} />

  <div class="max-w-4xl mx-auto py-4">

    <!-- Fil d’Ariane -->
    <nav aria-label="Fil d’Ariane" class="meta text-xs mb-8">
      <ol class="flex items-center gap-2 flex-wrap">
        <li><a href="/" class="underline decoration-warm-grey underline-offset-4 hover:decoration-current">Accueil</a></li>
        <li aria-hidden="true" class="text-warm-grey">/</li>
        <li><a href="/cours-collectifs" class="underline decoration-warm-grey underline-offset-4 hover:decoration-current">Cours</a></li>
        <li aria-hidden="true" class="text-warm-grey">/</li>
        <li aria-current="page" class="text-ink">Cours individuels à domicile</li>
      </ol>
    </nav>

    <!-- ================================================================= -->
    <!-- 1. HERO & OFFRE PRINCIPALE                                        -->
    <!-- ================================================================= -->
    <header class="py-4 sm:py-8" aria-labelledby="hero-title">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        
        <!-- Colonne gauche : H1, promesse, tarif & CTA -->
        <div class="lg:col-span-7">
          <p class="eyebrow eyebrow-mark mb-5">
            Cours particulier · Lyon &amp; agglomération
          </p>
          
          <h1 id="hero-title" class="h-section">
            Cours individuel de calligraphie chinoise à domicile
          </h1>

          <p class="lede mt-6">
            Un accompagnement personnalisé, à votre rythme, directement chez vous à Lyon.
          </p>

          <!-- Offre & tarif -->
          <div class="mt-8 border-t border-ink/80 pt-6">
            <p class="flex flex-wrap items-baseline gap-x-3">
              <span class="font-serif text-5xl leading-none text-ink">{netHeureDomicile}&nbsp;€</span>
              <span class="meta">TTC / heure, après crédit d’impôt</span>
            </p>
            <p class="body-copy mt-3">
              {prices.cours_individuel_domicile.ttc_heure}&nbsp;€/h, soit <strong class="font-medium text-ink">{netHeureDomicile}&nbsp;€ net de l’heure</strong> après réduction ou crédit d’impôt (agrément Coop A Dom). Tout le matériel traditionnel est intégralement fourni lors de chaque séance.
            </p>
          </div>

          <!-- CTAs -->
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
            <a href="#contact" class="btn btn-ink">Demander un cours à domicile</a>
            <a href="/tarifs" class="btn btn-line">Voir les tarifs</a>
          </div>
        </div>

        <!-- Colonne droite : Visuel de la pratique à domicile -->
        <div class="lg:col-span-5">
          <figure class="relative mx-auto max-w-md lg:max-w-none">
            <div class="ink-frame aspect-[3/2]">
              <img
                src="/assets/cours-individuel-a-domicile-calligraphie-lyon.webp"
                alt="Cours individuel à domicile de calligraphie chinoise à Lyon"
                width="640"
                height="427"
                loading="eager"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
            <figcaption class="meta mt-3 font-serif italic text-[0.95rem]">
              Apprentissage du tracé au pinceau et à l’encre à domicile
            </figcaption>
          </figure>
        </div>

      </div>
    </header>

    <!-- ================================================================= -->
    <!-- 2. UN ACCOMPAGNEMENT PERSONNALISÉ                                 -->
    <!-- ================================================================= -->
    <section class="section border-t border-warm-grey" aria-labelledby="accompagnement-heading">
      <div class="max-w-2xl mb-8">
        <p class="eyebrow mb-4">
          Sur mesure
        </p>
        <h2 id="accompagnement-heading" class="h-section">
          Un accompagnement personnalisé
        </h2>
        <p class="lede mt-5">
          Le cours individuel concentre l’attention sur votre geste, votre souffle et votre progression, dans l’intimité de votre lieu de vie.
        </p>
      </div>

      <ol class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
        <li data-reveal class="border-t border-warm-grey pt-5 md:pt-6">
          <span class="numeral" aria-hidden="true">01</span>
          <p class="eyebrow mt-1">Précision</p>
          <h3 class="font-serif text-xl sm:text-2xl leading-snug text-ink mt-2">Attention au geste</h3>
          <p class="meta mt-2">Corrections posturales directes, ajustement de la tenue verticale du pinceau et travail attentif sur le broyage de l’encre à la pierre.</p>
        </li>
        <li data-reveal class="border-t border-warm-grey pt-5 md:pt-6">
          <span class="numeral" aria-hidden="true">02</span>
          <p class="eyebrow mt-1">Sérénité</p>
          <h3 class="font-serif text-xl sm:text-2xl leading-snug text-ink mt-2">Matériel apporté chez vous</h3>
          <p class="meta mt-2">Une simple table suffit. Tout le matériel (pinceaux, encre, feutre épais protecteur de table et papier de riz) est apporté par l’enseignant.</p>
        </li>
        <li data-reveal class="border-t border-warm-grey pt-5 md:pt-6">
          <span class="numeral" aria-hidden="true">03</span>
          <p class="eyebrow mt-1">Proximité</p>
          <h3 class="font-serif text-xl sm:text-2xl leading-snug text-ink mt-2">Lyon & agglomération</h3>
          <p class="meta mt-2">Déplacement dans tous les arrondissements de Lyon (1<sup>er</sup> au 9<sup>e</sup>) et communes limitrophes (Caluire, Villeurbanne, Oullins, Écully, etc.).</p>
        </li>
      </ol>
    </section>

    <!-- ================================================================= -->
    <!-- 3. À QUI S’ADRESSENT LES COURS ?                                  -->
    <!-- ================================================================= -->
    <section class="section border-t border-warm-grey" aria-labelledby="public-heading">
      <div class="max-w-2xl mb-8">
        <p class="eyebrow mb-4">
          Profils & Objectifs
        </p>
        <h2 id="public-heading" class="h-section">
          À qui s’adressent les cours ?
        </h2>
      </div>

      <dl class="grid grid-cols-1 border-t border-warm-grey sm:grid-cols-2 sm:gap-x-10">
        <div data-reveal class="border-b border-warm-grey py-6 sm:odd:pr-10">
          <dt class="font-serif text-xl leading-snug text-ink">Débutants bienvenus</dt>
          <dd class="meta mt-2">Aucune notion de langue chinoise ni expérience artistique préalable n’est nécessaire. L’apprentissage commence par l’assise, le souffle et les huit traits fondamentaux du caractère <em>Yong</em> (永).</dd>
        </div>
        <div data-reveal class="border-b border-warm-grey py-6 sm:odd:pr-10">
          <dt class="font-serif text-xl leading-snug text-ink">Progression adaptée à vos objectifs</dt>
          <dd class="meta mt-2">Que vous recherchiez une pratique méditative axée sur le calme intérieur, la maîtrise d’un style historique (régulier Kaishu, cursif Xingshu) ou la calligraphie d’un texte précis.</dd>
        </div>
        <div data-reveal class="border-b border-warm-grey py-6 sm:odd:pr-10">
          <dt class="font-serif text-xl leading-snug text-ink">Rythme et créneaux flexibles</dt>
          <dd class="meta mt-2">Séances planifiées selon vos disponibilités en semaine ou le samedi. Une durée de 1&nbsp;h&nbsp;30 à 2&nbsp;h est recommandée pour pratiquer posément sans précipitation.</dd>
        </div>
        <div data-reveal class="border-b border-warm-grey py-6 sm:odd:pr-10">
          <dt class="font-serif text-xl leading-snug text-ink">Option langue chinoise</dt>
          <dd class="meta mt-2">Possibilité d’associer la pratique du pinceau à l’initiation au chinois oral (pinyin, tons, vocabulaire et étymologie des sinogrammes).</dd>
        </div>
      </dl>
    </section>

    <!-- ================================================================= -->
    <!-- 4. LE PROFESSEUR                                                  -->
    <!-- ================================================================= -->
    <section class="section border-t border-warm-grey" aria-labelledby="professeur-heading">
      <div data-reveal class="max-w-3xl">
        <p class="eyebrow mb-4">
          L’enseignant
        </p>
        <h2 id="professeur-heading" class="h-section">
          Le professeur
        </h2>
        
        <p class="body-copy mt-5 max-w-none">
          Les cours sont dispensés par Christophe Desmur, calligraphe et enseignant à Lyon. Titulaire d’une maîtrise de langue et civilisation chinoises et d’un master de traduction littéraire, il transmet depuis plus de trente ans un art du pinceau fondé sur l’attention au corps, la régularité du tracé et la compréhension sensible des caractères.
        </p>

        <!-- Écho d’artiste & transmission -->
        <figure class="mt-8 border-l border-vermilion pl-5">
          <blockquote class="font-serif italic text-xl leading-snug text-ink">
            « Depuis 2023, je me lance en calligraphie cursive avec Christophe Desmur pour pratiquer la danse du pinceau ! »
          </blockquote>
          <figcaption class="meta mt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
            <span>Pascale France — Artiste peintre et enseignante en Sumi-e</span>
            <a
              href="https://www.encrepaisible.com/parcours-artistique"
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-warm-grey underline-offset-4 hover:decoration-current inline-flex items-center gap-1">
              <span>Encre Paisible</span>
              <span aria-hidden="true">↗</span>
            </a>
          </figcaption>
        </figure>

        <div class="mt-6">
          <EditorialLink href="/le-calligraphe" label="En savoir plus sur Christophe Desmur" />
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 5. CADRE LÉGAL & AVANTAGE FISCAL (CONCIS ET RASSURANT)             -->
    <!-- ================================================================= -->
    <section class="section border-t border-warm-grey" aria-labelledby="fiscal-heading">
      <div data-reveal class="meta max-w-3xl">
        <h2 id="fiscal-heading" class="eyebrow mb-3">
          Cadre administratif & crédit d’impôt
        </h2>
        <p>
          Prestation assurée en tant qu’entrepreneur au sein de la coopérative de services à domicile <strong>Coop A Dom</strong> (agrément n°&nbsp;{contact.coop_a_dom_agrement}). Conformément à l’article 199 sexdecies du Code Général des Impôts (hors soutien scolaire), vous bénéficiez de <strong>{prices.cours_individuel_domicile.reduction_impot_pct}&nbsp;% de réduction ou de crédit d’impôt</strong> sur le tarif horaire de {prices.cours_individuel_domicile.ttc_heure}&nbsp;€ TTC (soit {netHeureDomicile}&nbsp;€ net / heure).
        </p>
        <p class="mt-2">
          Facturation officielle établie par Coop A Dom et attestation fiscale annuelle délivrée pour votre déclaration de revenus.
        </p>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 6. CONTACT / CTA CONVERSION                                       -->
    <!-- ================================================================= -->
    <section id="contact" class="section band my-10 sm:my-14" aria-labelledby="contact-heading">
      <div class="max-w-3xl">
        <p class="eyebrow eyebrow-mark mb-5">
          Premier contact
        </p>

        <h2 id="contact-heading" class="h-section">
          Vous souhaitez apprendre la calligraphie chinoise chez vous à Lyon ?
        </h2>

        <p class="lede mt-6">
          Contactez directement Christophe Desmur pour échanger sur vos souhaits, convenir d’un premier créneau ou poser vos questions sur l’agrément fiscal.
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
          <a href={contactMailHref} class="btn btn-accent">
            Demander un cours à domicile
          </a>

          <a href={`tel:${telHref(contact.mobile)}`} class="btn btn-line tabular-nums" aria-label={`Appeler Christophe Desmur au ${contact.mobile}`}>
            {contact.mobile}
          </a>
        </div>

        <p class="meta mt-6">
          Également joignable au <a href={`tel:${telHref(contact.landline)}`} class="underline underline-offset-4 hover:text-ink">{contact.landline}</a> ou par courriel à <a href={`mailto:${contact.email}`} class="underline underline-offset-4 hover:text-ink">{contact.email}</a>.
        </p>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 7. LIENS CONTEXTUELS PERTINENTS (SANS ENCOMBREMENT)               -->
    <!-- ================================================================= -->
    <nav class="pt-6 pb-4 border-t border-warm-grey" aria-label="Autres formules associées">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 meta text-xs">
        <span class="eyebrow">Voir aussi</span>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <a href="/cours-collectifs" class="underline decoration-warm-grey underline-offset-4 hover:decoration-current">Cours collectifs à Lyon</a>
          <span aria-hidden="true">•</span>
          <a href="/tarifs" class="underline decoration-warm-grey underline-offset-4 hover:decoration-current">Grille des tarifs</a>
          <span aria-hidden="true">•</span>
          <a href="/cours-de-chinois" class="underline decoration-warm-grey underline-offset-4 hover:decoration-current">Cours de langue chinoise</a>
          <span aria-hidden="true">•</span>
          <a href="/le-calligraphe" class="underline decoration-warm-grey underline-offset-4 hover:decoration-current">Christophe Desmur</a>
        </div>
      </div>
    </nav>

  </div>
</Layout>
