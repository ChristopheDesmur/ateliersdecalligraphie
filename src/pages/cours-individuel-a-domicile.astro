---
import Layout from "@/layouts/Layout.astro";

const contactMailHref = "mailto:christophe.desmur@orange.fr?subject=Demande%20de%20cours%20individuel%20%C3%A0%20domicile";
---

<Layout
  title="Cours individuel de calligraphie chinoise à domicile | Lyon — Christophe Desmur"
  description="Cours particulier de calligraphie chinoise à domicile à Lyon : accompagnement personnalisé à votre rythme, matériel fourni, crédit d'impôt 50 % (Coop A Dom). 40 € TTC/h.">

  <script slot="head" type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Cours particulier de calligraphie chinoise à domicile",
      "description": "Cours individuel de calligraphie chinoise à domicile à Lyon et son agglomération, dispensé par Christophe Desmur. Accompagnement personnalisé à votre rythme, matériel fourni. Agrément Coop A Dom n° 2006-1-42.10 — éligible à la réduction ou au crédit d'impôt de 50 % (article 199 sexdecies du CGI, hors soutien scolaire).",
      "url": "https://ateliersdecalligraphie.com/cours-individuel-a-domicile",
      "provider": {
        "@type": "Person",
        "name": "Christophe Desmur",
        "url": "https://ateliersdecalligraphie.com/le-calligraphe"
      },
      "areaServed": {
        "@type": "City",
        "name": "Lyon"
      },
      "serviceType": "Cours à domicile de calligraphie chinoise",
      "offers": {
        "@type": "Offer",
        "price": "40",
        "priceCurrency": "EUR",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "40",
          "priceCurrency": "EUR",
          "unitText": "heure"
        }
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Services à domicile agréés",
        "description": "Agrément Coop A Dom n° 2006-1-42.10 — éligible à la réduction d'impôt de 50 % (article 199 sexdecies du CGI, hors soutien scolaire)"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Dans quels secteurs de Lyon intervenez-vous à domicile ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Christophe Desmur intervient dans tous les arrondissements de Lyon (du 1er au 9e) ainsi que dans les communes limitrophes de la métropole lyonnaise (Caluire-et-Cuire, Villeurbanne, Oullins, Écully, Tassin-la-Demi-Lune, etc.)."
          }
        },
        {
          "@type": "Question",
          "name": "Comment fonctionne le crédit d'impôt de 50 % pour les cours à domicile ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Via l'agrément Coop A Dom n° 2006-1-42.10 (services à la personne), vous bénéficiez de 50 % de réduction ou de crédit d'impôt sur le tarif de 40 € TTC / heure, soit 20 € net de l'heure. Une attestation fiscale annuelle officielle vous est délivrée."
          }
        },
        {
          "@type": "Question",
          "name": "Quel matériel dois-je prévoir chez moi ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Une simple table et une assise confortable suffisent. L'ensemble du matériel traditionnel (pinceaux, encre de Chine, pierres, papier de riz et feutre protecteur de table) est apporté par l'enseignant."
          }
        }
      ]
    }
  ])} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-4">

    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="text-xs text-gray-500 dark:text-gray-400 mb-6 sm:mb-8">
      <ol class="flex items-center gap-1.5 flex-wrap">
        <li><a href="/" class="hover:underline hover:text-gray-900 dark:hover:text-gray-200">Accueil</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/cours-collectifs" class="hover:underline hover:text-gray-900 dark:hover:text-gray-200">Cours</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-gray-900 dark:text-gray-100 font-medium">Cours individuels à domicile</li>
      </ol>
    </nav>

    <!-- ================================================================= -->
    <!-- 1. HERO & OFFRE PRINCIPALE                                        -->
    <!-- ================================================================= -->
    <header class="py-4 sm:py-8 border-b border-gray-100 dark:border-gray-800" aria-labelledby="hero-title">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        
        <!-- Colonne gauche : H1, promesse, tarif & CTA -->
        <div class="lg:col-span-7">
          <p class="text-xs font-semibold tracking-widest uppercase text-indigo-700 dark:text-indigo-400 mb-2.5">
            Cours particulier · Lyon & agglomération
          </p>
          
          <h1 id="hero-title" class="text-3xl sm:text-4xl lg:text-5xl font-serif font-medium text-gray-950 dark:text-gray-100 leading-tight">
            Cours individuel de calligraphie chinoise à domicile
          </h1>

          <p class="mt-4 text-base sm:text-lg text-gray-700 dark:text-gray-300 font-serif leading-relaxed">
            Un accompagnement personnalisé, à votre rythme, directement chez vous à Lyon.
          </p>

          <!-- Bloc Offre & Tarif mis en valeur -->
          <div class="mt-6 p-5 rounded-2xl bg-stone-50/90 dark:bg-gray-800/80 border border-stone-200/80 dark:border-gray-700/80 shadow-2xs">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <div class="flex items-baseline gap-2">
                <span class="text-3xl sm:text-4xl font-serif font-bold text-gray-950 dark:text-gray-100">40&nbsp;€</span>
                <span class="text-sm font-medium text-gray-600 dark:text-gray-400">TTC / heure</span>
              </div>
              <span class="px-2.5 py-1 rounded-md bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 text-xs font-semibold border border-emerald-200/70 dark:border-emerald-800/50">
                Crédit d'impôt 50&nbsp;%
              </span>
            </div>

            <p class="mt-2 text-xs sm:text-sm text-gray-600 dark:text-gray-300 font-serif leading-relaxed">
              Soit <strong>20&nbsp;€ net de l'heure</strong> après réduction ou crédit d'impôt (agrément Coop A Dom). Tout le matériel traditionnel est intégralement fourni lors de chaque séance.
            </p>
          </div>

          <!-- CTAs -->
          <div class="mt-6 flex flex-wrap items-center gap-3.5">
            <a
              href="#contact"
              class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-gray-950 hover:bg-gray-800 text-white dark:bg-gray-100 dark:text-gray-950 dark:hover:bg-white font-medium text-sm transition shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
              Demander un cours à domicile
            </a>

            <a
              href="/tarifs"
              class="inline-flex items-center justify-center px-5 py-3.5 rounded-xl bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-200 hover:bg-stone-50 dark:hover:bg-gray-700 font-medium text-sm border border-gray-300 dark:border-gray-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
              Voir les tarifs
            </a>
          </div>
        </div>

        <!-- Colonne droite : Visuel de la pratique à domicile -->
        <div class="lg:col-span-5">
          <figure class="relative mx-auto max-w-md lg:max-w-none">
            <div class="overflow-hidden rounded-2xl border border-gray-200/80 dark:border-gray-800 shadow-sm bg-stone-50 dark:bg-gray-800">
              <img
                src="/assets/cours-individuel-a-domicile-calligraphie-lyon.webp"
                alt="Cours individuel à domicile de calligraphie chinoise à Lyon"
                width="640"
                height="427"
                loading="eager"
                decoding="async"
                class="w-full h-auto object-cover aspect-3/2"
              />
            </div>
            <figcaption class="mt-2.5 text-xs text-gray-500 dark:text-gray-400 italic text-center font-serif">
              Apprentissage du tracé au pinceau et à l'encre à domicile
            </figcaption>
          </figure>
        </div>

      </div>
    </header>

    <!-- ================================================================= -->
    <!-- 2. UN ACCOMPAGNEMENT PERSONNALISÉ                                 -->
    <!-- ================================================================= -->
    <section class="py-10 sm:py-14 border-b border-gray-100 dark:border-gray-800" aria-labelledby="accompagnement-heading">
      <div class="max-w-2xl mb-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-indigo-700 dark:text-indigo-400 mb-1.5">
          Sur mesure
        </p>
        <h2 id="accompagnement-heading" class="text-2xl sm:text-3xl font-serif font-medium text-gray-950 dark:text-gray-100">
          Un accompagnement personnalisé
        </h2>
        <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 font-serif mt-2 leading-relaxed">
          Le cours individuel concentre l'attention sur votre geste, votre souffle et votre progression, dans l'intimité de votre lieu de vie.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        
        <div class="p-5 rounded-2xl bg-white dark:bg-gray-800/80 border border-gray-200/80 dark:border-gray-700/80 shadow-2xs">
          <span class="text-xs font-semibold uppercase tracking-wider text-indigo-700 dark:text-indigo-400 font-sans">
            01 · Précision
          </span>
          <h3 class="font-serif font-medium text-lg text-gray-950 dark:text-gray-100 mt-1.5 mb-2">
            Attention au geste
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 font-serif leading-relaxed">
            Corrections posturales directes, ajustement de la tenue verticale du pinceau et travail attentif sur le broyage de l'encre à la pierre.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-gray-800/80 border border-gray-200/80 dark:border-gray-700/80 shadow-2xs">
          <span class="text-xs font-semibold uppercase tracking-wider text-indigo-700 dark:text-indigo-400 font-sans">
            02 · Sérénité
          </span>
          <h3 class="font-serif font-medium text-lg text-gray-950 dark:text-gray-100 mt-1.5 mb-2">
            Matériel apporté chez vous
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 font-serif leading-relaxed">
            Une simple table suffit. Tout le matériel (pinceaux, encre, feutre épais protecteur de table et papier de riz) est apporté par l'enseignant.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-gray-800/80 border border-gray-200/80 dark:border-gray-700/80 shadow-2xs">
          <span class="text-xs font-semibold uppercase tracking-wider text-indigo-700 dark:text-indigo-400 font-sans">
            03 · Proximité
          </span>
          <h3 class="font-serif font-medium text-lg text-gray-950 dark:text-gray-100 mt-1.5 mb-2">
            Lyon & agglomération
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 font-serif leading-relaxed">
            Déplacement dans tous les arrondissements de Lyon (1<sup>er</sup> au 9<sup>e</sup>) et communes limitrophes (Caluire, Villeurbanne, Oullins, Écully, etc.).
          </p>
        </div>

      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 3. À QUI S'ADRESSENT LES COURS ?                                  -->
    <!-- ================================================================= -->
    <section class="py-10 sm:py-14 border-b border-gray-100 dark:border-gray-800" aria-labelledby="public-heading">
      <div class="max-w-2xl mb-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-indigo-700 dark:text-indigo-400 mb-1.5">
          Profils & Objectifs
        </p>
        <h2 id="public-heading" class="text-2xl sm:text-3xl font-serif font-medium text-gray-950 dark:text-gray-100">
          À qui s'adressent les cours ?
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm">
        
        <div class="p-5 rounded-2xl bg-stone-50/80 dark:bg-gray-800/60 border border-stone-200/80 dark:border-gray-700/70">
          <h3 class="font-serif font-medium text-base text-gray-950 dark:text-gray-100 mb-1.5">
            Débutants bienvenus
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 font-serif leading-relaxed">
            Aucune notion de langue chinoise ni expérience artistique préalable n'est nécessaire. L'apprentissage commence par l'assise, le souffle et les huit traits fondamentaux du caractère <em>Yong</em> (永).
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-stone-50/80 dark:bg-gray-800/60 border border-stone-200/80 dark:border-gray-700/70">
          <h3 class="font-serif font-medium text-base text-gray-950 dark:text-gray-100 mb-1.5">
            Progression adaptée à vos objectifs
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 font-serif leading-relaxed">
            Que vous recherchiez une pratique méditative axée sur le calme intérieur, la maîtrise d'un style historique (régulier Kaishu, cursif Xingshu) ou la calligraphie d'un texte précis.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-stone-50/80 dark:bg-gray-800/60 border border-stone-200/80 dark:border-gray-700/70">
          <h3 class="font-serif font-medium text-base text-gray-950 dark:text-gray-100 mb-1.5">
            Rythme et créneaux flexibles
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 font-serif leading-relaxed">
            Séances planifiées selon vos disponibilités en semaine ou le samedi. Une durée de 1&nbsp;h&nbsp;30 à 2&nbsp;h est recommandée pour pratiquer posément sans précipitation.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-stone-50/80 dark:bg-gray-800/60 border border-stone-200/80 dark:border-gray-700/70">
          <h3 class="font-serif font-medium text-base text-gray-950 dark:text-gray-100 mb-1.5">
            Option langue chinoise
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 font-serif leading-relaxed">
            Possibilité d'associer la pratique du pinceau à l'initiation au chinois oral (pinyin, tons, vocabulaire et étymologie des sinogrammes).
          </p>
        </div>

      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 4. LE PROFESSEUR                                                  -->
    <!-- ================================================================= -->
    <section class="py-10 sm:py-14 border-b border-gray-100 dark:border-gray-800" aria-labelledby="professeur-heading">
      <div class="rounded-2xl p-6 sm:p-8 bg-white dark:bg-gray-800/90 border border-gray-200/90 dark:border-gray-700/80 shadow-2xs">
        <p class="text-xs font-semibold uppercase tracking-widest text-indigo-700 dark:text-indigo-400 mb-2">
          L'enseignant
        </p>
        <h2 id="professeur-heading" class="text-2xl sm:text-3xl font-serif font-medium text-gray-950 dark:text-gray-100">
          Le professeur
        </h2>
        
        <p class="mt-3 text-base text-gray-700 dark:text-gray-300 font-serif leading-relaxed">
          Les cours sont dispensés par Christophe Desmur, calligraphe et enseignant à Lyon. Titulaire d'une maîtrise de langue et civilisation chinoises et d'un master de traduction littéraire, il transmet depuis plus de trente ans un art du pinceau fondé sur l'attention au corps, la régularité du tracé et la compréhension sensible des caractères.
        </p>

        <div class="mt-5 pt-4 border-t border-gray-100 dark:border-gray-700/60">
          <a
            href="/le-calligraphe"
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-indigo-700 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 transition-colors">
            <span>En savoir plus sur Christophe Desmur</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 5. CADRE LÉGAL & AVANTAGE FISCAL (CONCIS ET RASSURANT)             -->
    <!-- ================================================================= -->
    <section class="py-10 sm:py-14 border-b border-gray-100 dark:border-gray-800" aria-labelledby="fiscal-heading">
      <div class="rounded-2xl p-6 sm:p-7 bg-stone-50/80 dark:bg-gray-800/60 border border-stone-200/80 dark:border-gray-700/70 text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed font-serif">
        <h2 id="fiscal-heading" class="text-base font-serif font-semibold text-gray-950 dark:text-gray-100 mb-2 font-sans">
          Cadre administratif & crédit d'impôt
        </h2>
        <p>
          Prestation assurée en tant qu'entrepreneur au sein de la coopérative de services à domicile <strong>Coop A Dom</strong> (agrément n°&nbsp;2006-1-42.10). Conformément à l'article 199 sexdecies du Code Général des Impôts (hors soutien scolaire), vous bénéficiez de <strong>50&nbsp;% de réduction ou de crédit d'impôt</strong> sur le tarif horaire de 40&nbsp;€ TTC (soit 20&nbsp;€ net / heure).
        </p>
        <p class="mt-2 text-stone-500 dark:text-stone-400">
          Facturation officielle établie par Coop A Dom et attestation fiscale annuelle délivrée pour votre déclaration de revenus.
        </p>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 6. CONTACT / CTA CONVERSION                                       -->
    <!-- ================================================================= -->
    <section id="contact" class="my-10 sm:my-14 rounded-3xl bg-gray-950 text-white p-8 sm:p-12 border border-gray-800 text-center" aria-labelledby="contact-heading">
      <div class="max-w-2xl mx-auto">
        <p class="text-indigo-400 uppercase tracking-widest text-xs font-semibold">
          Premier contact
        </p>

        <h2 id="contact-heading" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-medium text-white mt-2 leading-tight">
          Vous souhaitez apprendre la calligraphie chinoise chez vous à Lyon ?
        </h2>

        <p class="text-stone-300 font-serif text-sm sm:text-base mt-3 leading-relaxed">
          Contactez directement Christophe Desmur pour échanger sur vos souhaits, convenir d'un premier créneau ou poser vos questions sur l'agrément fiscal.
        </p>

        <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3.5">
          <a
            href={contactMailHref}
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium transition shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-white inline-flex items-center justify-center gap-2">
            <span>✉️</span>
            <span>Demander un cours à domicile</span>
          </a>

          <a
            href="tel:+33472078861"
            class="w-full sm:w-auto px-5 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-sm font-medium transition border border-white/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-white inline-flex items-center justify-center gap-2">
            <span>📞</span>
            <span>04 72 07 88 61</span>
          </a>
        </div>

        <p class="text-xs text-stone-400 mt-5 font-sans">
          Également joignable au <a href="tel:+33769941643" class="underline hover:text-white">07 69 94 16 43</a> ou par courriel à <a href="mailto:christophe.desmur@orange.fr" class="underline hover:text-white">christophe.desmur@orange.fr</a>.
        </p>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 7. LIENS CONTEXTUELS PERTINENTS (SANS ENCOMBREMENT)               -->
    <!-- ================================================================= -->
    <nav class="pt-6 pb-4 border-t border-gray-200 dark:border-gray-800" aria-label="Autres formules associées">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-gray-500 dark:text-gray-400 font-sans">
        <span class="font-medium text-gray-700 dark:text-gray-300">Voir aussi :</span>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <a href="/cours-collectifs" class="text-indigo-700 dark:text-indigo-400 hover:underline">Cours collectifs à Lyon</a>
          <span aria-hidden="true">•</span>
          <a href="/tarifs" class="text-indigo-700 dark:text-indigo-400 hover:underline">Grille des tarifs</a>
          <span aria-hidden="true">•</span>
          <a href="/cours-de-chinois" class="text-indigo-700 dark:text-indigo-400 hover:underline">Cours de langue chinoise</a>
          <span aria-hidden="true">•</span>
          <a href="/le-calligraphe" class="text-indigo-700 dark:text-indigo-400 hover:underline">Christophe Desmur</a>
        </div>
      </div>
    </nav>

  </div>
</Layout>
