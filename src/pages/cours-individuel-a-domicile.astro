---
import Layout from "@/layouts/Layout.astro";
import RelatedPages from "@/components/related-pages.astro";

const contactMailHref = "mailto:christophe.desmur@orange.fr?subject=Demande%20d'information%20cours%20individuel%20%C3%A0%20domicile";
---

<Layout
  title="Cours individuels de calligraphie chinoise à domicile | Lyon"
  description="Cours particulier de calligraphie chinoise à domicile à Lyon : accompagnement personnalisé à votre rythme, matériel fourni, agrément Coop A Dom (réduction ou crédit d'impôt de 50 %). 40 € TTC/h.">

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Cours particulier de calligraphie chinoise à domicile",
    "description": "Cours individuel de calligraphie chinoise à domicile à Lyon et son agglomération, dispensé par Christophe Desmur. Accompagnement personnalisé à votre rythme, matériel fourni. Agrément Coop A Dom n° 2006-1-42.10 — éligible à la réduction ou au crédit d'impôt de 50 % (article 199 sexdecies du CGI, hors soutien scolaire).",
    "url": "https://ateliersdecalligraphie.com/cours-individuel-a-domicile",
    "provider": {
      "@type": "Person",
      "name": "Christophe Desmur",
      "url": "https://ateliersdecalligraphie.com/le-calligraphe"
    },
    "areaServed": {
      "@type": "City",
      "name": "Lyon"
    },
    "serviceType": "Cours à domicile de calligraphie chinoise",
    "offers": {
      "@type": "Offer",
      "price": "40",
      "priceCurrency": "EUR",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "40",
        "priceCurrency": "EUR",
        "unitText": "heure"
      }
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Services à domicile agréés",
      "description": "Agrément Coop A Dom n° 2006-1-42.10 — éligible à la réduction d'impôt de 50 % (article 199 sexdecies du CGI, hors soutien scolaire)"
    }
  })} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4">

    <!-- ================================================================= -->
    <!-- FIL D'ARIANE                                                      -->
    <!-- ================================================================= -->
    <nav aria-label="Fil d'Ariane" class="text-xs text-gray-500 dark:text-gray-400 mb-8">
      <ol class="flex items-center gap-1.5 flex-wrap">
        <li><a href="/" class="hover:underline hover:text-gray-900 dark:hover:text-gray-200 transition-colors">Accueil</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/atelier-de-groupe" class="hover:underline hover:text-gray-900 dark:hover:text-gray-200 transition-colors">Cours & Ateliers</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-gray-900 dark:text-gray-100 font-medium">Cours individuels à domicile</li>
      </ol>
    </nav>

    <!-- ================================================================= -->
    <!-- 1. HERO SECTION                                                   -->
    <!-- ================================================================= -->
    <header class="py-6 sm:py-10 border-b border-gray-100 dark:border-gray-800" aria-labelledby="hero-title">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- Left column: Eyebrow, H1, Supporting text, Price & CTAs -->
        <div class="lg:col-span-7">
          <p class="text-xs font-semibold tracking-widest uppercase text-indigo-600 dark:text-indigo-400 mb-3">
            Cours individuels à domicile
          </p>
          
          <h1 id="hero-title" class="text-3xl sm:text-4xl lg:text-5xl font-serif font-medium text-gray-950 dark:text-gray-100 leading-tight">
            Cours individuels de calligraphie chinoise<br class="hidden sm:inline" />
            <span class="text-indigo-700 dark:text-indigo-400">à domicile à Lyon</span>
          </h1>

          <p class="mt-4 text-base sm:text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
            Progressez à votre rythme en calligraphie chinoise grâce à un accompagnement sur mesure directement à votre domicile à Lyon et son agglomération. Christophe Desmur se déplace chez vous avec le matériel nécessaire pour un cours adapté à votre sensibilité et à vos disponibilités.
          </p>

          <!-- Price Highlight Box (Primary UI Element) -->
          <div class="mt-6 p-5 rounded-2xl bg-gray-50/90 dark:bg-gray-800/60 border border-gray-200/80 dark:border-gray-700/80 shadow-xs flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3">
            <div>
              <div class="flex items-baseline gap-2">
                <span class="text-3xl sm:text-4xl font-serif font-semibold text-gray-950 dark:text-gray-100">40&nbsp;€</span>
                <span class="text-sm font-medium text-gray-600 dark:text-gray-400">TTC / heure</span>
              </div>
              <p class="text-xs text-gray-600 dark:text-gray-400 mt-1 font-medium">
                Cours individuel à domicile (matériel fourni)
              </p>
            </div>

            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 text-xs font-semibold border border-emerald-200/70 dark:border-emerald-800/50 sm:self-center">
              <span aria-hidden="true">✓</span>
              <span>Crédit d'impôt 50&nbsp;% possible</span>
            </div>
          </div>

          <!-- CTAs -->
          <div class="mt-6 flex flex-wrap items-center gap-3.5">
            <a
              href="#contact"
              class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm transition shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
              Me contacter &rarr;
            </a>

            <a
              href="/cours-collectifs"
              class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 font-medium text-sm border border-gray-200 dark:border-gray-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
              Voir les cours collectifs
            </a>
          </div>

          <!-- Reassuring details -->
          <p class="mt-4 text-xs text-gray-500 dark:text-gray-400 flex items-center gap-2">
            <span class="text-indigo-600 dark:text-indigo-400 font-bold">ℹ</span>
            <span>Agréé Coop A Dom n°&nbsp;2006-1-42.10 • Lyon et communes limitrophes</span>
          </p>
        </div>

        <!-- Right column: Existing Image -->
        <div class="lg:col-span-5">
          <figure class="relative mx-auto max-w-md lg:max-w-none">
            <div class="overflow-hidden rounded-2xl border border-gray-200/80 dark:border-gray-800 shadow-md bg-gray-50 dark:bg-gray-800">
              <img
                src="/assets/cours-individuel-a-domicile-calligraphie-lyon.webp"
                alt="Cours individuel à domicile de calligraphie chinoise à Lyon"
                width="640"
                height="427"
                loading="eager"
                class="w-full h-auto object-cover aspect-[3/2]"
              />
            </div>
            <figcaption class="mt-3 text-xs text-gray-500 dark:text-gray-400 italic text-center lg:text-left leading-normal">
              Cours individuel de calligraphie chinoise à domicile à Lyon — apprentissage personnalisé du tracé au pinceau.
            </figcaption>
          </figure>
        </div>

      </div>
    </header>

    <!-- ================================================================= -->
    <!-- 2. SCANNABLE VALUE PROPOSITION                                    -->
    <!-- ================================================================= -->
    <section class="py-12 sm:py-16 border-b border-gray-100 dark:border-gray-800" aria-labelledby="valeur-heading">
      <div class="max-w-2xl mb-8 sm:mb-10">
        <p class="text-xs font-semibold tracking-widest uppercase text-indigo-600 dark:text-indigo-400 mb-2">
          Approche pédagogique
        </p>
        <h2 id="valeur-heading" class="text-2xl sm:text-3xl font-serif font-medium text-gray-950 dark:text-gray-100">
          Un cours adapté à votre pratique
        </h2>
        <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 mt-2 leading-relaxed">
          La pratique individuelle à domicile permet un apprentissage sur mesure, au plus près de vos attentes et de votre rythme personnel.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <!-- Point 1 -->
        <div class="p-5 rounded-2xl bg-white dark:bg-gray-800/70 border border-gray-200/80 dark:border-gray-700/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 font-serif font-bold flex items-center justify-center mb-3.5 border border-indigo-100 dark:border-indigo-900/40 text-sm">
              01
            </div>
            <h3 class="font-serif font-medium text-base text-gray-950 dark:text-gray-100 mb-1.5">
              Cours individuel
            </h3>
            <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
              Une attention exclusive portée à votre assise, à la tenue du pinceau et à chaque tracé d'encre tout au long de la séance.
            </p>
          </div>
        </div>

        <!-- Point 2 -->
        <div class="p-5 rounded-2xl bg-white dark:bg-gray-800/70 border border-gray-200/80 dark:border-gray-700/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 font-serif font-bold flex items-center justify-center mb-3.5 border border-indigo-100 dark:border-indigo-900/40 text-sm">
              02
            </div>
            <h3 class="font-serif font-medium text-base text-gray-950 dark:text-gray-100 mb-1.5">
              À votre domicile
            </h3>
            <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
              Le calligraphe se déplace directement chez vous à Lyon et dans sa métropole, avec tout le matériel traditionnel nécessaire.
            </p>
          </div>
        </div>

        <!-- Point 3 -->
        <div class="p-5 rounded-2xl bg-white dark:bg-gray-800/70 border border-gray-200/80 dark:border-gray-700/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 font-serif font-bold flex items-center justify-center mb-3.5 border border-indigo-100 dark:border-indigo-900/40 text-sm">
              03
            </div>
            <h3 class="font-serif font-medium text-base text-gray-950 dark:text-gray-100 mb-1.5">
              Progression à votre rythme
            </h3>
            <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
              Un apprentissage libre de toute contrainte de groupe, pour progresser selon votre temps disponible et votre sensibilité.
            </p>
          </div>
        </div>

        <!-- Point 4 -->
        <div class="p-5 rounded-2xl bg-white dark:bg-gray-800/70 border border-gray-200/80 dark:border-gray-700/80 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 font-serif font-bold flex items-center justify-center mb-3.5 border border-indigo-100 dark:border-indigo-900/40 text-sm">
              04
            </div>
            <h3 class="font-serif font-medium text-base text-gray-950 dark:text-gray-100 mb-1.5">
              Accompagnement personnalisé
            </h3>
            <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
              Un suivi individuel qui éclaire la technique du geste, l'ordre des traits des caractères et le sens profond de l'écrit chinois.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 3. AVANTAGE FISCAL & COOP A DOM (CAREFUL LEGAL NUANCE)            -->
    <!-- ================================================================= -->
    <section class="py-12 sm:py-16 border-b border-gray-100 dark:border-gray-800" aria-labelledby="fiscal-heading">
      <div class="max-w-3xl mb-8">
        <p class="text-xs font-semibold tracking-widest uppercase text-indigo-600 dark:text-indigo-400 mb-2">
          Cadre administratif & Fiscalité
        </p>
        <h2 id="fiscal-heading" class="text-2xl sm:text-3xl font-serif font-medium text-gray-950 dark:text-gray-100">
          Avantage fiscal
        </h2>
        <p class="text-base sm:text-lg text-indigo-900 dark:text-indigo-200 mt-2 font-medium">
          Les cours à domicile peuvent bénéficier d'une réduction ou d'un crédit d'impôt de 50&nbsp;%, conformément à la législation en vigueur.
        </p>
      </div>

      <!-- Legal Qualification Card -->
      <div class="rounded-2xl p-6 sm:p-8 bg-gray-50/90 dark:bg-gray-800/50 border border-gray-200/80 dark:border-gray-700/80">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
          
          <div class="md:col-span-8 space-y-3">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
              Conditions et cadre légal
            </h3>
            
            <p class="text-sm sm:text-base text-gray-700 dark:text-gray-300 leading-relaxed">
              <strong>Cours individuel à domicile</strong> de calligraphie chinoise donné en tant qu'entrepreneur au sein de la société coopérative de services à domicile <a href="http://www.coopadom.coop/" target="_blank" rel="noopener noreferrer" class="text-indigo-600 dark:text-indigo-400 underline underline-offset-2 font-medium hover:text-indigo-800">Coop A Dom</a> (agrément n°&nbsp;2006-1-42.10).
            </p>

            <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
              Conformément à la législation en vigueur, vous bénéficiez d'une réduction ou d'un crédit d'impôt de 50&nbsp;% sur le prix de la prestation que vous payez dans le cadre des cours à domicile en calligraphie chinoise (hors soutien scolaire).
            </p>

            <div class="pt-2">
              <a
                href="http://www.coopadom.coop/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center text-xs font-medium text-indigo-600 dark:text-indigo-400 hover:underline">
                En savoir plus sur la coopérative Coop A Dom &rarr;
              </a>
            </div>
          </div>

          <!-- Price & Summary Column -->
          <div class="md:col-span-4 p-5 rounded-xl bg-white dark:bg-gray-900/60 border border-gray-200/70 dark:border-gray-700/60 flex flex-col justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
              Tarif officiel
            </span>
            <div class="my-3">
              <p class="text-3xl font-serif font-bold text-gray-950 dark:text-gray-100">
                40&nbsp;€
              </p>
              <p class="text-xs text-gray-600 dark:text-gray-400 mt-0.5">
                TTC / heure de cours
              </p>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400 border-t border-gray-100 dark:border-gray-800 pt-2">
              Facturation par Coop A Dom • Attestation fiscale annuelle délivrée pour votre déclaration.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 4. COMMENT SE DÉROULE UN COURS ? (ACCOMPAGNEMENT INDIVIDUEL)       -->
    <!-- ================================================================= -->
    <section class="py-12 sm:py-16 border-b border-gray-100 dark:border-gray-800" aria-labelledby="deroulement-heading">
      <div class="max-w-2xl mb-8 sm:mb-10">
        <p class="text-xs font-semibold tracking-widest uppercase text-indigo-600 dark:text-indigo-400 mb-2">
          Organisation pratique
        </p>
        <h2 id="deroulement-heading" class="text-2xl sm:text-3xl font-serif font-medium text-gray-950 dark:text-gray-100">
          Un accompagnement individuel
        </h2>
        <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 mt-2 leading-relaxed">
          De la première prise de contact au suivi de votre apprentissage, voici les étapes de votre parcours à domicile :
        </p>
      </div>

      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <!-- Step 1 -->
        <li class="p-5 rounded-2xl bg-white dark:bg-gray-800/70 border border-gray-200/80 dark:border-gray-700/80 shadow-xs flex flex-col justify-between">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
              Étape 01
            </span>
            <h3 class="font-serif font-medium text-base text-gray-950 dark:text-gray-100 mt-1 mb-2">
              Premier contact
            </h3>
            <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
              Échange direct par téléphone ou par e-mail avec Christophe Desmur pour faire le point sur vos attentes et vos créneaux souhaités.
            </p>
          </div>
        </li>

        <!-- Step 2 -->
        <li class="p-5 rounded-2xl bg-white dark:bg-gray-800/70 border border-gray-200/80 dark:border-gray-700/80 shadow-xs flex flex-col justify-between">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
              Étape 02
            </span>
            <h3 class="font-serif font-medium text-base text-gray-950 dark:text-gray-100 mt-1 mb-2">
              Définition du besoin
            </h3>
            <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
              Initiation complète, reprise de la pratique ou perfectionnement : le programme s'adapte à votre niveau sans prérequis nécessaire.
            </p>
          </div>
        </li>

        <!-- Step 3 -->
        <li class="p-5 rounded-2xl bg-white dark:bg-gray-800/70 border border-gray-200/80 dark:border-gray-700/80 shadow-xs flex flex-col justify-between">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
              Étape 03
            </span>
            <h3 class="font-serif font-medium text-base text-gray-950 dark:text-gray-100 mt-1 mb-2">
              Séance à domicile
            </h3>
            <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
              Christophe Desmur se déplace à votre domicile avec pinceaux, encre et papier. Vous pratiquez dans le confort de votre lieu de vie.
            </p>
          </div>
        </li>

        <!-- Step 4 -->
        <li class="p-5 rounded-2xl bg-white dark:bg-gray-800/70 border border-gray-200/80 dark:border-gray-700/80 shadow-xs flex flex-col justify-between">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
              Étape 04
            </span>
            <h3 class="font-serif font-medium text-base text-gray-950 dark:text-gray-100 mt-1 mb-2">
              Progression à votre rythme
            </h3>
            <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
              Corrections personnalisées en direct, conseils posturaux et consolidation pas à pas de votre tracé au fil des séances.
            </p>
          </div>
        </li>

      </ol>
    </section>

    <!-- ================================================================= -->
    <!-- 5. CONTACT / NEXT STEP (PROMINENT CTA BLOCK)                      -->
    <!-- ================================================================= -->
    <section id="contact" class="py-12 sm:py-16 border-b border-gray-100 dark:border-gray-800" aria-labelledby="contact-heading">
      <div class="rounded-3xl p-6 sm:p-10 bg-indigo-50/70 dark:bg-indigo-950/40 border border-indigo-100 dark:border-indigo-900/60 shadow-xs">
        <div class="max-w-2xl mb-8">
          <p class="text-xs font-semibold tracking-widest uppercase text-indigo-600 dark:text-indigo-400 mb-2">
            Renseignements & Rendez-vous
          </p>
          <h2 id="contact-heading" class="text-2xl sm:text-3xl font-serif font-medium text-gray-950 dark:text-gray-100">
            Vous souhaitez en savoir plus ?
          </h2>
          <p class="text-sm sm:text-base text-gray-700 dark:text-gray-300 mt-2 leading-relaxed">
            Pour vérifier les disponibilités de créneaux à votre domicile, échanger sur votre projet ou poser vos questions sur l'agrément fiscal, contactez directement Christophe Desmur :
          </p>
        </div>

        <div class="flex flex-col sm:flex-row flex-wrap gap-4 items-stretch sm:items-center">
          <!-- Mail CTA -->
          <a
            href={contactMailHref}
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm transition shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 text-center">
            <span class="mr-2" aria-hidden="true">✉️</span>
            Envoyer un e-mail
          </a>

          <!-- Phone 1 -->
          <a
            href="tel:+33472078861"
            class="inline-flex items-center justify-center px-5 py-3.5 rounded-xl bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-100 hover:text-indigo-600 dark:hover:text-indigo-400 border border-gray-200 dark:border-gray-700 font-medium text-sm transition shadow-2xs focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
            <span class="mr-2" aria-hidden="true">📞</span>
            04 72 07 88 61
          </a>

          <!-- Phone 2 -->
          <a
            href="tel:+33769941643"
            class="inline-flex items-center justify-center px-5 py-3.5 rounded-xl bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-100 hover:text-indigo-600 dark:hover:text-indigo-400 border border-gray-200 dark:border-gray-700 font-medium text-sm transition shadow-2xs focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
            <span class="mr-2" aria-hidden="true">📱</span>
            07 69 94 16 43
          </a>
        </div>

        <p class="text-xs text-gray-500 dark:text-gray-400 mt-6 leading-relaxed">
          Réponse rapide • Déplacements réguliers sur Lyon (tous arrondissements) et agglomération lyonnaise.
        </p>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 6. FORMAT DECISION: PRIVATE VS GROUP                              -->
    <!-- ================================================================= -->
    <section class="py-12 sm:py-16 border-b border-gray-100 dark:border-gray-800" aria-labelledby="decision-heading">
      <div class="max-w-2xl mb-8 sm:mb-10">
        <p class="text-xs font-semibold tracking-widest uppercase text-indigo-600 dark:text-indigo-400 mb-2">
          Choisir votre formule
        </p>
        <h2 id="decision-heading" class="text-2xl sm:text-3xl font-serif font-medium text-gray-950 dark:text-gray-100">
          Quel format vous convient ?
        </h2>
        <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 mt-2 leading-relaxed">
          Selon vos disponibilités, vos objectifs et votre envie de pratiquer seul ou au sein d'un groupe :
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
        
        <!-- Card 1: Private at home (Current format) -->
        <div class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-gray-800/80 border-2 border-indigo-600/80 dark:border-indigo-500/80 shadow-xs flex flex-col justify-between relative">
          <div class="absolute -top-3 right-5 px-2.5 py-0.5 rounded-full bg-indigo-600 text-white text-[10px] font-semibold uppercase tracking-wider">
            Format individuel
          </div>
          
          <div>
            <h3 class="font-serif font-medium text-xl text-gray-950 dark:text-gray-100">
              Cours individuel à domicile
            </h3>
