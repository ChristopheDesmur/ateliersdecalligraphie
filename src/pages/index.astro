---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import HomeExperience from "@/components/home/HomeExperience.astro";
import HomePractice from "@/components/home/HomePractice.astro";
import HomeArtist from "@/components/home/HomeArtist.astro";
import HomeGallery from "@/components/home/HomeGallery.astro";
import HomeFAQ from "@/components/home/HomeFAQ.astro";
import HomeFinalCTA from "@/components/home/HomeFinalCTA.astro";
import HomeLocations from "@/components/home/HomeLocations.astro";
---

<Layout
  title="Calligraphie chinoise Lyon | Cours, ateliers & œuvres originales — Christophe Desmur"
  description="Découvrez l'art de la calligraphie chinoise à Lyon avec Christophe Desmur : cours collectifs et individuels, ateliers d'initiation et calligraphies originales.">
  <Container>
    <!-- 1. Hero -->
    <HomeHero />

    <!-- 2. Choisir votre expérience -->
    <HomeExperience />

    <!-- 3. La pratique (geste, concentration, expression, équilibre, bienfaits, public) -->
    <HomePractice />

    <!-- 4. Christophe / Approche pédagogique -->
    <HomeArtist />

    <!-- 5. Œuvres à vendre : calligraphies originales disponibles à l'acquisition -->
    <HomeGallery />

    <!-- 6. Teaser FAQ -->
    <HomeFAQ />

    <!-- 7. Conversion finale -->
    <HomeFinalCTA />

    <!-- 8. Lieux d'ateliers à Lyon & contact direct -->
    <HomeLocations />
  </Container>
</Layout>
