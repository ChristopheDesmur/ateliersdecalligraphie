---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import HomeExperience from "@/components/home/HomeExperience.astro";
import HomePractice from "@/components/home/HomePractice.astro";
import HomeArtist from "@/components/home/HomeArtist.astro";
import HomeGallery from "@/components/home/HomeGallery.astro";
import HomePractical from "@/components/home/HomePractical.astro";
import HomeFinalCTA from "@/components/home/HomeFinalCTA.astro";
---

<Layout
  title="Calligraphie chinoise Lyon | Cours, ateliers & œuvres originales — Christophe Desmur"
  description="Découvrez l’art de la calligraphie chinoise à Lyon avec Christophe Desmur : cours collectifs et individuels, ateliers d’initiation et calligraphies originales.">
  <Container>
    <!-- 1. Hero : quoi, où, avec qui, comment commencer -->
    <HomeHero />

    <!-- 2. Quatre manières de pratiquer (liste numérotée) -->
    <HomeExperience />

    <!-- 3. La pratique (geste, concentration, expression) & accessibilité -->
    <HomePractice />

    <!-- 4. Christophe Desmur, ancre de confiance -->
    <HomeArtist />

    <!-- 5. Œuvres originales, galerie éditoriale -->
    <HomeGallery />

    <!-- 6. Informations pratiques : FAQ & lieux à Lyon -->
    <HomePractical />

    <!-- 7. Invitation finale -->
    <HomeFinalCTA />
  </Container>
</Layout>
