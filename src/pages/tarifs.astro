---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Cta from "@/components/cta.astro";
import EditorialLink from "@/components/editorial/EditorialLink.astro";
import RelatedPages from "@/components/related-pages.astro";
import { prices, netHeureDomicile } from "@/data/prices";
import { contact } from "@/data/contact";

const rates = [
  {
    title: "Cours collectifs hebdomadaires",
    subtitle: "Dojo Zen & Miroirs du Ciel — Lyon 4<sup>e</sup>",
    badge: "Formule recommandée",
    price: `${prices.cours_collectifs.trimestre} €`,
    period: "par trimestre",
    detail: `${prices.cours_collectifs.seances} cours, matériel inclus (hors crédit d’impôt)`,
    features: [
      "Séances régulières de 1&nbsp;h&nbsp;30 à 2&nbsp;h par semaine",
      "Lundi soir (Dojo Zen) ou mercredi matin (Miroirs du Ciel)",
      "Tout le matériel fourni (pinceaux, encre, papier, pierre)",
      "Petit groupe de 2 à 8 participants pour un suivi personnalisé",
      "Débutants bienvenus : aucun prérequis de chinois ou de dessin",
      "Possibilité d’une séance d’essai sans engagement",
    ],
    ctaText: "Découvrir les cours collectifs",
    ctaLink: "/cours-collectifs",
    featured: true,
  },
  {
    title: "Cours individuels à domicile",
    subtitle: "Lyon et agglomération lyonnaise",
    badge: `${prices.cours_individuel_domicile.reduction_impot_pct} % de crédit d’impôt`,
    price: `${prices.cours_individuel_domicile.ttc_heure} €`,
    period: "TTC / heure",
    detail: `Soit ${netHeureDomicile} € net après crédit d’impôt`,
    features: [
      "Apprentissage entièrement personnalisé à votre rythme",
      `Agrément Coop A Dom (n° ${contact.coop_a_dom_agrement} — services à domicile)`,
      `${prices.cours_individuel_domicile.reduction_impot_pct} % de réduction ou crédit d’impôt (art. 199 sexdecies du CGI)`,
      "Tout le matériel est apporté à votre domicile",
      "Horaires et fréquence flexibles selon vos disponibilités",
      "Possibilité de combiner calligraphie et initiation au chinois",
    ],
    ctaText: "En savoir plus sur les cours à domicile",
    ctaLink: "/cours-individuel-a-domicile",
    featured: false,
  },
  {
    title: "Établissements scolaires & Universités",
    subtitle: "Primaires, collèges, lycées, enseignement supérieur",
    badge: "Sur site",
    price: `${prices.interventions.ht_heure_standard} €`,
    period: "HT / heure",
    detail: "Tout le matériel de calligraphie fourni",
    features: [
      "Interventions sur le temps scolaire ou projets culturels",
      "De 1 à 3 heures d’atelier par classe",
      "De 6 à 30 participants selon le niveau scolaire",
      "Découverte des pictogrammes, idéogrammes et tracé au pinceau",
      "Atelier Sumi-e (dessin à l’encre) pour les plus jeunes",
      "Christophe se déplace dans votre établissement à Lyon et région",
    ],
    ctaText: "Voir les formules scolaires",
    ctaLink: "/ecoles-primaires",
    featured: false,
  },
  {
    title: "Comités d’entreprise & Séminaires",
    subtitle: "CSE, entreprises et collectivités",
    badge: "Cohésion & Bien-être",
    price: `${prices.interventions.ht_heure_entreprises} €`,
    period: "HT / heure",
    detail: "Matériel complet inclus pour tous les salariés",
    features: [
      "Ateliers d'1&nbsp;h à 3&nbsp;h sur votre lieu de travail à Lyon",
      "Format idéal sur la pause méridienne (12&nbsp;h – 14&nbsp;h) ou séminaire",
      "Groupes de 6 à 12 collaborateurs par session",
      "Déconnexion, concentration, détente et éveil artistique",
      "Devis personnalisé selon le nombre de séances",
    ],
    ctaText: "Voir l’offre entreprise",
    ctaLink: "/comites-entreprise",
    featured: false,
  },
  {
    title: "Résidences seniors & EHPAD",
    subtitle: "Maisons de retraite et associations de retraités",
    badge: "Activité apaisante",
    price: `${prices.interventions.ht_heure_standard} €`,
    period: "HT / heure",
    detail: "Ateliers de 2 heures minimum",
    features: [
      "Activité valorisante adaptée au rythme de chacun",
      "Stimulation de la motricité fine, du regard et de la mémoire",
      "Moments de calme, d’échange et de convivialité",
      "Groupes de 6 à 12 personnes",
      "Matériel léger et sécurisant fourni intégralement",
    ],
    ctaText: "Voir l’offre maisons de retraite",
    ctaLink: "/maisons-de-retraite",
    featured: false,
  },
];
---

<Layout
  title="Tarifs des cours et ateliers"
  description={`Tarifs transparents des cours de calligraphie chinoise à Lyon : cours collectifs (${prices.cours_collectifs.trimestre} €/trimestre, ${prices.cours_collectifs.seances} cours), cours particuliers avec crédit d’impôt ${prices.cours_individuel_domicile.reduction_impot_pct} %, ateliers scolaires et entreprises.`}>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "Cours collectif de calligraphie chinoise à Lyon",
      "description": "Cours hebdomadaire de calligraphie chinoise au Dojo Zen et à la boutique Miroirs du Ciel à Lyon. Matériel fourni, tous niveaux.",
      "url": "https://ateliersdecalligraphie.com/tarifs",
      "provider": {
        "@type": "Person",
        "name": "Christophe Desmur",
        "url": "https://ateliersdecalligraphie.com/le-calligraphe"
      },
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": String(prices.cours_collectifs.trimestre),
        "priceCurrency": "EUR",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": String(prices.cours_collectifs.trimestre),
          "priceCurrency": "EUR",
          "unitText": "trimestre"
        }
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "Cours particulier de calligraphie chinoise à domicile",
      "description": `Cours individuel à domicile à Lyon, agréé service à la personne (${prices.cours_individuel_domicile.reduction_impot_pct} % de crédit d’impôt).`,
      "url": "https://ateliersdecalligraphie.com/tarifs",
      "provider": {
        "@type": "Person",
        "name": "Christophe Desmur",
        "url": "https://ateliersdecalligraphie.com/le-calligraphe"
      },
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": String(prices.cours_individuel_domicile.ttc_heure),
        "priceCurrency": "EUR",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": String(prices.cours_individuel_domicile.ttc_heure),
          "priceCurrency": "EUR",
          "unitText": "heure"
        }
      }
    }
  ])} />

  <Container>
    <nav aria-label="Fil d’Ariane" class="meta text-xs mb-8">
      <ol class="flex items-center gap-2 flex-wrap">
        <li><a href="/" class="underline decoration-warm-grey underline-offset-4 hover:decoration-current">Accueil</a></li>
        <li aria-hidden="true" class="text-warm-grey">/</li>
        <li aria-current="page" class="text-ink">Tarifs</li>
      </ol>
    </nav>

    <div class="max-w-3xl">
      <p class="eyebrow eyebrow-mark mb-5">
        Transparence &amp; Simplicité
      </p>
      <h1 class="h-section">
        Tarifs des cours et ateliers de calligraphie
      </h1>
      <p class="lede mt-6">
        Chaque formule est adaptée à votre public. Tout le matériel pédagogique (pinceaux en poils naturels, encre de Chine traditionnelle, pierres à encre et papier de riz) est systématiquement fourni par Christophe Desmur.
      </p>
    </div>

    <!-- Tarifs : liste éditoriale, prix toujours visibles -->
    <ol class="mt-14 border-t border-ink/80">
      {rates.map((rate) => (
        <li data-reveal class="grid gap-x-10 gap-y-5 border-b border-warm-grey py-8 sm:py-10 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <p class="eyebrow">{rate.badge}</p>
            <h2 class="h-item mt-2">{rate.title}</h2>
            <p class="meta mt-1.5" set:html={rate.subtitle} />
          </div>

          <div class="lg:col-span-3">
            <p class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-serif text-4xl sm:text-5xl leading-none text-ink">{rate.price}</span>
              <span class="meta">{rate.period}</span>
            </p>
            <p class="meta mt-2">{rate.detail}</p>
          </div>

          <ul class="lg:col-span-3 meta space-y-1.5">
            {rate.features.map((feature) => (
              <li class="flex items-baseline gap-2.5">
                <span class="h-px w-3 shrink-0 translate-y-[-0.3em] bg-soft-ink" aria-hidden="true"></span>
                <span set:html={feature} />
              </li>
            ))}
          </ul>

          <div class="lg:col-span-2 lg:text-right">
            <a href={rate.ctaLink} class={rate.featured ? "btn btn-ink w-full sm:w-auto" : "link-arrow"}>
              <span>{rate.ctaText}</span>
              {!rate.featured && <span class="arrow" aria-hidden="true">→</span>}
            </a>
          </div>
        </li>
      ))}
    </ol>

    <!-- Note d’information fiscale et légale -->
    <div class="max-w-3xl mt-16 border-t border-warm-grey pt-6 meta">
      <h3 class="eyebrow mb-3">
        Conditions et déductions fiscales
      </h3>
      <p class="leading-relaxed mb-3">
        <strong>Cours particuliers à domicile :</strong> Dispensés dans le cadre de la société coopérative de services à domicile <em>Coop A Dom</em> (agrément n° {contact.coop_a_dom_agrement}). Conformément à l’article 199 sexdecies du Code Général des Impôts, vous bénéficiez d’une réduction ou d’un crédit d’impôt de {prices.cours_individuel_domicile.reduction_impot_pct} % sur les sommes versées pour les cours particuliers à domicile (hors soutien scolaire).
      </p>
      <p class="leading-relaxed mb-3">
        <strong>Cours collectifs :</strong> Cette réduction fiscale s’applique uniquement aux cours particuliers à domicile. Les cours collectifs hebdomadaires (Dojo Zen, Miroirs du Ciel) n’ouvrent pas droit à un crédit d’impôt.
      </p>
      <p class="leading-relaxed">
        <strong>Interventions pour structures et collectivités :</strong> Les tarifs s’entendent hors taxes. Tout le matériel spécifique (papiers spéciaux, encre, pinceaux chinois fins et larges, feutres sous-main) est fourni et transporté par l’intervenant.
      </p>
    </div>

    <RelatedPages current="/tarifs" />

    <Cta />
  </Container>
</Layout>
