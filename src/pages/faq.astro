---
import Layout from "@/layouts/Layout.astro";

const faqCategories = [
  {
    category: "Débuter la calligraphie",
    items: [
      {
        question: "Faut-il parler ou comprendre le chinois pour pratiquer la calligraphie ?",
        answer: "Non, aucune connaissance préalable du chinois n'est nécessaire. La calligraphie chinoise est avant tout un art du geste, de la respiration et de l'espace. Vous apprendrez progressivement à reconnaître et tracer les sinogrammes, des pictogrammes archaïques aux caractères complets, sans avoir besoin de parler la langue.",
      },
      {
        question: "Les cours collectifs hebdomadaires sont-ils ouverts aux grands débutants ?",
        answer: "Absolument. Les cours accueillent tous les niveaux, des néophytes complets aux pratiquants confirmés. Chaque élève progresse à son propre rythme grâce à l'accompagnement individualisé de Christophe Desmur au sein du petit groupe (2 à 8 participants).",
      },
      {
        question: "Quel matériel faut-il apporter lors des cours ?",
        answer: "Tout le matériel nécessaire est intégralement mis à votre disposition sur place : pinceaux en poils naturels, bâtons d'encre de Chine traditionnelle, pierres à encre et papiers de riz absorbants. Vous venez simplement dans une tenue confortable, sans aucun achat préalable.",
      },
      {
        question: "Comment se déroule une première séance d'essai ?",
        answer: "Vous pouvez réserver une séance d'essai sans engagement sur le créneau du lundi soir au Dojo Zen ou du mercredi matin chez Miroirs du Ciel. Vous découvrirez la tenue verticale du pinceau, la préparation de l'encre à la pierre et le tracé de vos premiers traits fondamentaux.",
      },
    ],
  },
  {
    category: "Lieux, Horaires & Tarifs à Lyon",
    items: [
      {
        question: "Où et quand ont lieu les cours réguliers de calligraphie à Lyon ?",
        answer: "Les cours se déroulent dans le 4e arrondissement de Lyon (Croix-Rousse) sur deux créneaux hebdomadaires : les lundis soirs de 18h30 à 20h30 au Dojo Zen de Lyon (11, rue Dumenge) et les mercredis matins de 10h à 12h à la boutique Miroirs du Ciel (9, rue de Belfort).",
      },
      {
        question: "Quels sont les tarifs des cours collectifs et particuliers ?",
        answer: "Les cours collectifs réguliers sont à 80 € par trimestre (matériel inclus). Les cours particuliers à domicile sont à 40 € TTC / heure et bénéficient d'un crédit d'impôt de 50 % (agrément Coop A Dom n° 2006-1-42.10), soit 20 € net de l'heure.",
      },
      {
        question: "Proposez-vous des cours particuliers à domicile à Lyon ?",
        answer: "Oui, Christophe Desmur se déplace à votre domicile sur Lyon et l'ensemble de la métropole lyonnaise avec tout le matériel nécessaire. Les horaires et la fréquence sont entièrement flexibles selon vos disponibilités.",
      },
    ],
  },
  {
    category: "Pratique, Styles & Culture",
    items: [
      {
        question: "Quelle est la différence entre la calligraphie chinoise et le shodō japonais ?",
        answer: "La calligraphie chinoise (shūfǎ 書法) est la tradition originelle, pratiquée depuis plus de 3 000 ans en Chine. Le shodō japonais en est directement issu et partage les mêmes outils (pinceau, encre de Chine, pierre, papier). À Lyon, Christophe Desmur enseigne la tradition classique chinoise et les styles majeurs des grandes dynasties Tang et Song.",
      },
      {
        question: "Quels styles calligraphiques sont abordés au cours des séances ?",
        answer: "L'apprentissage débute généralement par le style régulier (Kaishu 楷书), qui pose la structure géométrique et l'équilibre des traits. Les pratiquants explorent ensuite le style courant (Xingshu 行书, plus fluide) et le style cursif (Caoshu 草书), selon leur rythme et leurs affinités.",
      },
    ],
  },
  {
    category: "Interventions pour groupes & structures",
    items: [
      {
        question: "À partir de quel âge peut-on pratiquer la calligraphie chinoise ?",
        answer: "La calligraphie s'adresse à tous les âges : enfants dès l'école primaire (à partir de 6 ans, avec initiation au Sumi-e et aux pictogrammes), collégiens et lycéens, adultes de tous âges, et seniors en maisons de retraite et EHPAD.",
      },
      {
        question: "Comment organiser un atelier en école, collège, lycée ou université ?",
        answer: "Christophe Desmur se déplace directement dans votre établissement scolaire à Lyon et dans la région avec tout le matériel pour la classe. Le format varie de 1 h à 3 h par session (60 € HT/h). Une prise de contact préalable permet de caler le projet pédagogique.",
      },
      {
        question: "Proposez-vous des ateliers pour les comités d'entreprise et les résidences seniors ?",
        answer: "Oui. En entreprise, des ateliers d'1 h à 3 h sont organisés sur la pause méridienne ou lors de séminaires. En maison de retraite et EHPAD, des ateliers calmes stimulent la motricité fine et la créativité des résidents.",
      },
    ],
  },
  {
    category: "Œuvres à vendre & Acquisition",
    items: [
      {
        question: "Comment acquérir une calligraphie originale ?",
        answer: "Les calligraphies originales proposées à la vente sont des pièces uniques disponibles à l'acquisition. L'acquisition se fait directement auprès du calligraphe, sans intermédiaire ni paiement automatisé en ligne : contactez simplement Christophe Desmur pour échanger sur l'œuvre, connaître le prix, convenir d'une remise en main propre à Lyon ou d'une expédition soignée.",
      },
      {
        question: "Peut-on demander une calligraphie personnalisée sur mesure ?",
        answer: "Tout à fait. Christophe Desmur réalise régulièrement des commandes personnalisées : caractère symbolique, prénom transcrit phonétiquement, poème chinois classique ou devise philosophique.",
      },
    ],
  },
];

const allQuestions = faqCategories.flatMap((cat) => cat.items);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allQuestions.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};
---

<Layout
  title="Foire aux questions (FAQ) | Calligraphie chinoise à Lyon"
  description="Toutes les réponses à vos questions sur les cours collectifs, cours individuels, ateliers scolaires et d'entreprises, et l'acquisition d'œuvres originales à Lyon.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto py-4">
    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="text-xs text-gray-500 dark:text-gray-400 mb-6">
      <ol class="flex items-center gap-1.5 flex-wrap">
        <li><a href="/" class="hover:underline">Accueil</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-gray-900 dark:text-gray-100 font-medium">Questions fréquentes</li>
      </ol>
    </nav>

    <header class="py-6 sm:py-8 border-b border-gray-100 dark:border-gray-800 mb-10">
      <p class="text-xs font-semibold uppercase tracking-widest text-indigo-700 dark:text-indigo-400">
        Foire aux questions
      </p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-medium text-gray-950 dark:text-gray-100 mt-2">
        Questions fréquentes sur les cours, ateliers et œuvres
      </h1>
      <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 font-serif mt-3 leading-relaxed max-w-2xl">
        Retrouvez ici toutes les informations pratiques relatives à l'apprentissage de la calligraphie chinoise à Lyon, aux interventions en structures et à l'acquisition d'œuvres.
      </p>
    </header>

    <div class="space-y-12">
      {faqCategories.map((group) => (
        <section aria-labelledby={`faq-cat-${group.category.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>
          <div class="mb-4 pb-2 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
            <h2
              id={`faq-cat-${group.category.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
              class="text-xl sm:text-2xl font-serif font-medium text-gray-950 dark:text-gray-100">
              {group.category}
            </h2>
            <span class="text-xs text-gray-500 dark:text-gray-400 font-sans">
              {group.items.length} questions
            </span>
          </div>

          <div class="space-y-3">
            {group.items.map((faq) => (
              <details class="group rounded-2xl border border-gray-200/90 dark:border-gray-800 bg-white dark:bg-gray-800/80 p-5 transition shadow-2xs hover:border-indigo-200 dark:hover:border-indigo-900 [&_svg]:open:-rotate-180">
                <summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-base sm:text-lg font-medium text-gray-900 dark:text-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg select-none">
                  <span>{faq.question}</span>
                  <svg class="h-5 w-5 shrink-0 text-gray-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <p class="mt-3 text-sm text-gray-600 dark:text-gray-300 leading-relaxed font-serif pt-3 border-t border-gray-100 dark:border-gray-700/60">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Contact direct si question supplémentaire -->
    <div class="mt-14 p-8 rounded-3xl bg-stone-50 dark:bg-gray-800 border border-stone-200 dark:border-gray-700 text-center">
      <h3 class="text-xl font-serif font-medium text-gray-950 dark:text-gray-100">
        Une question particulière ?
      </h3>
      <p class="text-sm text-gray-600 dark:text-gray-300 font-serif mt-2 max-w-md mx-auto">
        Christophe Desmur est à votre écoute pour vous renseigner sur les cours, préparer un atelier sur mesure ou échanger sur une œuvre.
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a
          href="mailto:christophe.desmur@orange.fr?subject=Question%20calligraphie%20chinoise"
          class="px-5 py-2.5 rounded-xl bg-gray-950 hover:bg-gray-800 text-white dark:bg-gray-100 dark:text-gray-950 dark:hover:bg-white text-xs sm:text-sm font-medium transition">
          Écrire à Christophe
        </a>
        <a
          href="tel:+33769941643"
          class="px-5 py-2.5 rounded-xl border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 text-xs sm:text-sm font-medium hover:bg-white dark:hover:bg-gray-700 transition">
          07 69 94 16 43
        </a>
      </div>
    </div>
  </div>
</Layout>
