---
import Layout from "@/layouts/Layout.astro";
import { contact, telHref } from "@/data/contact";
import { faqCategories, faqSchema } from "@/data/faq";
import FAQAccordion from "@/components/editorial/FAQAccordion.astro";
---

<Layout
  title="Foire aux questions (FAQ) | Calligraphie chinoise à Lyon"
  description="Toutes les réponses à vos questions sur les cours collectifs, cours individuels, ateliers scolaires et d’entreprises, et l’acquisition d’œuvres originales à Lyon.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto py-4">
    <!-- Fil d’Ariane -->
    <nav aria-label="Fil d’Ariane" class="meta text-xs mb-8">
      <ol class="flex items-center gap-2 flex-wrap">
        <li><a href="/" class="underline decoration-warm-grey underline-offset-4 hover:decoration-current">Accueil</a></li>
        <li aria-hidden="true" class="text-warm-grey">/</li>
        <li aria-current="page" class="text-ink">Questions fréquentes</li>
      </ol>
    </nav>

    <header class="pb-12 sm:pb-16 mb-4">
      <p class="eyebrow eyebrow-mark mb-5">
        Foire aux questions
      </p>
      <h1 class="h-section">
        Questions fréquentes sur les cours, ateliers et œuvres
      </h1>
      <p class="lede mt-6">
        Retrouvez ici toutes les informations pratiques relatives à l’apprentissage de la calligraphie chinoise à Lyon, aux interventions en structures et à l’acquisition d’œuvres.
      </p>
    </header>

    <div class="space-y-16">
      {faqCategories.map((group) => (
        <section aria-labelledby={`faq-cat-${group.category.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>
          <div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h2
              id={`faq-cat-${group.category.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
              class="h-item">
              {group.category}
            </h2>
            <span class="meta text-xs">
              {group.items.length} questions
            </span>
          </div>

          <FAQAccordion items={group.items} />
        </section>
      ))}
    </div>

    <!-- Contact direct si question supplémentaire -->
    <div class="mt-16 border-t border-ink/80 pt-8 max-w-3xl">
      <h2 class="h-item">
        Une question particulière ?
      </h2>
      <p class="body-copy mt-3">
        Christophe Desmur est à votre écoute pour vous renseigner sur les cours, préparer un atelier sur mesure ou échanger sur une œuvre.
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
        <a
          href={`mailto:${contact.email}?subject=Question%20calligraphie%20chinoise`}
          class="btn btn-ink">
          Écrire à Christophe
        </a>
        <a
          href={`tel:${telHref(contact.mobile)}`}
          class="btn btn-line tabular-nums" aria-label={`Appeler Christophe Desmur au ${contact.mobile}`}>
          {contact.mobile}
        </a>
      </div>
    </div>
  </div>
</Layout>
