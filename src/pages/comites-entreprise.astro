---
import Base from "../layouts/Layout.astro";
import RelatedPages from "../components/related-pages.astro";
import fs from "fs";
import yaml from "js-yaml";

// Load YAML
const ateliers = yaml.load(fs.readFileSync("./src/content/ateliers.yaml", "utf8"));

// Date formatting helpers
const frMonthYear = new Intl.DateTimeFormat("fr-FR", { month: "long", year: "numeric" });
const frMonthOnly = new Intl.DateTimeFormat("fr-FR", { month: "long" });

function sameDay(d1, d2) {
  return (
    d1.getFullYear() === d2.getFullYear() &&
    d1.getMonth() === d2.getMonth() &&
    d1.getDate() === d2.getDate()
  );
}

function formatDayFR(dayNum) {
  return dayNum === 1 ? "1<sup>er</sup>" : String(dayNum);
}

function formatDateFR(date) {
  const day = formatDayFR(date.getDate());
  const monthYear = frMonthYear.format(date);
  return `${day} ${monthYear}`;
}

function formatDateFRNoYear(date) {
  const day = formatDayFR(date.getDate());
  const month = frMonthOnly.format(date);
  return `${day} ${month}`;
}

// Flatten, filter and compute clean human-readable date metadata
const comitesEvents = Object.values(ateliers)
  .flat()
  .filter((event) => event.href === "/comites-entreprise")
  .map((event) => {
    const fromDate = new Date(event.from);
    const toDate = event.to ? new Date(event.to) : fromDate;

    const isJan1 = fromDate.getMonth() === 0 && fromDate.getDate() === 1;
    const isDec31 = toDate.getMonth() === 11 && toDate.getDate() === 31;
    const isFullYearSpan = isJan1 && isDec31;

    let formattedDate = "";
    if (isFullYearSpan) {
      if (fromDate.getFullYear() !== toDate.getFullYear()) {
        formattedDate = `${fromDate.getFullYear()} – ${toDate.getFullYear()}`;
      } else {
        formattedDate = "";
      }
    } else if (sameDay(fromDate, toDate)) {
      formattedDate = formatDateFR(fromDate);
    } else if (
      fromDate.getFullYear() === toDate.getFullYear() &&
      fromDate.getMonth() === toDate.getMonth()
    ) {
      formattedDate = `${formatDayFR(fromDate.getDate())} → ${formatDayFR(
        toDate.getDate()
      )} ${frMonthOnly.format(toDate)} ${toDate.getFullYear()}`;
    } else if (fromDate.getFullYear() === toDate.getFullYear()) {
      formattedDate = `${formatDateFRNoYear(fromDate)} → ${formatDateFR(toDate)}`;
    } else {
      formattedDate = `${formatDateFR(fromDate)} → ${formatDateFR(toDate)}`;
    }

    const multiYear = fromDate.getFullYear() !== toDate.getFullYear();

    return {
      ...event,
      fromDate,
      toDate,
      formattedDate,
      multiYear,
      key: event.from + event.titre + event.lieu,
    };
  });

// Group by year
const grouped = comitesEvents.reduce((acc, event) => {
  const startYear = event.fromDate.getFullYear();
  const endYear = event.toDate.getFullYear();

  for (let year = startYear; year <= endYear; year++) {
    acc[year] = acc[year] || [];
    acc[year].push(event);
  }
  return acc;
}, {});

// Sort events within each year
for (const year in grouped) {
  grouped[year].sort((a, b) => {
    if (a.fromDate.getTime() !== b.fromDate.getTime()) {
      return b.fromDate - a.fromDate;
    }
    return b.toDate - a.toDate;
  });
}

const eventsByYear = Object.entries(grouped).sort(
  ([yearA], [yearB]) => Number(yearB) - Number(yearA)
);

// Split into prominent recent years (last 5) and older years
const recentYears = eventsByYear.slice(0, 5);
const olderYears = eventsByYear.slice(5);

const contactMailHref = "mailto:christophe.desmur@orange.fr?subject=Organisation%20d'un%20atelier%20calligraphie%20en%20entreprise";
---

<Base
  title="Ateliers de calligraphie chinoise pour comités d'entreprise (CSE) à Lyon"
  description="Ateliers de calligraphie chinoise pour comités d'entreprise (CSE) et équipes à Lyon. Déconnexion, créativité et cohésion d'équipe sur la pause déjeuner ou en séminaire.">

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "Atelier de calligraphie chinoise pour comités d'entreprise (CSE)",
    "description": "Atelier de calligraphie chinoise en entreprise à Lyon : déconnexion, cohésion et initiation culturelle. De 6 à 12 collaborateurs, pause méridienne ou séminaire.",
    "url": "https://ateliersdecalligraphie.com/comites-entreprise",
    "provider": {
      "@type": "Person",
      "name": "Christophe Desmur",
      "url": "https://ateliersdecalligraphie.com/le-calligraphe"
    },
    "audience": {
      "@type": "Audience",
      "audienceType": "Salariés et équipes d'entreprise"
    },
    "inLanguage": "fr",
    "offers": {
      "@type": "Offer",
      "price": "90",
      "priceCurrency": "EUR",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "90",
        "priceCurrency": "EUR",
        "unitText": "heure"
      }
    }
  })} />

  <div class="max-w-5xl mx-auto">
    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="text-xs text-gray-500 dark:text-gray-400 mb-6 sm:mb-8">
      <ol class="flex items-center gap-1.5 flex-wrap">
        <li><a href="/" class="hover:underline">Accueil</a></li>
        <li aria-hidden="true">/</li>
        <li><span class="text-gray-500">Pour les groupes</span></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-gray-800 dark:text-gray-200 font-medium">Comités d'entreprise (CSE)</li>
      </ol>
    </nav>

    <!-- Hero Section : Two-column desktop, natural stack on mobile -->
    <header class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start" aria-labelledby="hero-title">
      
      <!-- Colonne Gauche (Desktop : 48%) -->
      <div class="lg:col-span-6 flex flex-col">
        <h1
          id="hero-title"
          class="text-3xl sm:text-4xl lg:text-4xl xl:text-5xl font-bold tracking-tight text-gray-900 dark:text-gray-100 leading-tight">
          Ateliers de calligraphie chinoise pour comités d'entreprise et équipes
        </h1>

        <p class="text-lg sm:text-xl font-serif italic text-indigo-800 dark:text-indigo-300 mt-3">
          Mes formats d'atelier pour les comités d'entreprise et séminaires à Lyon
        </p>

        <!-- Image mobile uniquement (sous le sous-titre) -->
        <div class="mt-6 lg:hidden">
          <img
            src="/assets/cours-calligraphie-comites-entreprise.webp"
            alt="Atelier de calligraphie chinoise pour collaborateurs d'entreprise"
            width="576"
            height="384"
            loading="eager"
            class="w-full h-auto rounded-xl shadow-xs border border-gray-200 dark:border-gray-800 object-cover"
           decoding="async"/>
        </div>

        <p class="text-base text-gray-600 dark:text-gray-300 mt-5 leading-relaxed">
          Christophe Desmur se déplace directement dans vos locaux à Lyon et dans sa région avec tout le matériel nécessaire pour initier vos collaborateurs à la pratique apaisante et créative de la calligraphie chinoise, sur la pause déjeuner ou lors d'un séminaire d'équipe.
        </p>

        <!-- CTA Principal (visible sur desktop) -->
        <div class="mt-8 hidden lg:flex flex-wrap items-center gap-4">
          <a
            href={contactMailHref}
            class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-medium text-sm text-white bg-indigo-600 hover:bg-indigo-700 transition shadow-xs">
            Organiser un atelier
          </a>
          <a
            href="tel:+33769941643"
            class="inline-flex items-center text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition"
            aria-label="Contacter Christophe Desmur au 07 69 94 16 43">
            📱 07 69 94 16 43
          </a>
        </div>
      </div>

      <!-- Colonne Droite (Desktop : 52%) -->
      <div class="hidden lg:block lg:col-span-6">
        <img
          src="/assets/cours-calligraphie-comites-entreprise.webp"
          alt="Atelier de calligraphie chinoise pour collaborateurs d'entreprise"
          width="576"
          height="384"
          loading="eager"
          class="w-full h-auto rounded-xl shadow-xs border border-gray-200 dark:border-gray-800 object-cover"
         decoding="async"/>
      </div>

    </header>

    <!-- Informations clés (Grille sobre, scannable et non-SaaS) -->
    <section class="mt-10 sm:mt-14 py-6 border-y border-gray-200 dark:border-gray-800" aria-label="Informations pratiques">
      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-8">
        <div>
          <dt class="text-xs uppercase tracking-wider font-semibold text-gray-500 dark:text-gray-400">
            Horaires
          </dt>
          <dd class="mt-1 text-sm sm:text-base font-medium text-gray-900 dark:text-gray-100">
            Entre 12 et 14&nbsp;h
          </dd>
        </div>

        <div>
          <dt class="text-xs uppercase tracking-wider font-semibold text-gray-500 dark:text-gray-400">
            Durée
          </dt>
          <dd class="mt-1 text-sm sm:text-base font-medium text-gray-900 dark:text-gray-100">
            Ateliers d'une heure
          </dd>
        </div>

        <div>
          <dt class="text-xs uppercase tracking-wider font-semibold text-gray-500 dark:text-gray-400">
            Participants
          </dt>
          <dd class="mt-1 text-sm sm:text-base font-medium text-gray-900 dark:text-gray-100">
            De 6 à 12 collaborateurs
          </dd>
        </div>

        <div>
          <dt class="text-xs uppercase tracking-wider font-semibold text-gray-500 dark:text-gray-400">
            Tarif
          </dt>
          <dd class="mt-1 text-sm sm:text-base font-medium text-gray-900 dark:text-gray-100">
            90 euros HT de l'heure
          </dd>
        </div>
      </dl>

      <!-- CTA Principal mobile (après les informations clés) -->
      <div class="mt-6 pt-6 border-t border-gray-100 dark:border-gray-800 lg:hidden flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
        <a
          href={contactMailHref}
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-medium text-sm text-white bg-indigo-600 hover:bg-indigo-700 transition shadow-xs text-center">
          Organiser un atelier
        </a>
        <a
          href="tel:+33769941643"
          class="inline-flex items-center justify-center text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition py-2 text-center">
          📱 07 69 94 16 43
        </a>
      </div>
    </section>

    <!-- Programme de l'atelier -->
    <section class="mt-12 sm:mt-16" aria-labelledby="programme-heading">
      <h2 id="programme-heading" class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">
        Au programme
      </h2>

      <ol class="grid sm:grid-cols-3 gap-6 sm:gap-8 border-b border-gray-200 dark:border-gray-800 pb-12">
        <li class="flex flex-col">
          <span class="font-serif text-2xl sm:text-3xl text-indigo-700 dark:text-indigo-400 font-bold mb-2 select-none" aria-hidden="true">
            01
          </span>
          <p class="text-sm sm:text-base text-gray-800 dark:text-gray-200 font-medium leading-snug">
            Posture corporelle, respiration et déconnexion par la préparation de l'encre
          </p>
        </li>

        <li class="flex flex-col">
          <span class="font-serif text-2xl sm:text-3xl text-indigo-700 dark:text-indigo-400 font-bold mb-2 select-none" aria-hidden="true">
            02
          </span>
          <p class="text-sm sm:text-base text-gray-800 dark:text-gray-200 font-medium leading-snug">
            Découverte des Quatre Trésors du Lettré et maîtrise du geste au pinceau
          </p>
        </li>

        <li class="flex flex-col">
          <span class="font-serif text-2xl sm:text-3xl text-indigo-700 dark:text-indigo-400 font-bold mb-2 select-none" aria-hidden="true">
            03
          </span>
          <p class="text-sm sm:text-base text-gray-800 dark:text-gray-200 font-medium leading-snug">
            Réalisation de sinogrammes porteurs de sens (harmonie, souffle, sérénité)
          </p>
        </li>
      </ol>
    </section>

    <!-- Interventions passées (Présentation sobre et scannable) -->
    <section class="mt-12 sm:mt-16" aria-labelledby="past-interventions-heading">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-6">
        <h2 id="past-interventions-heading" class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100">
          Interventions passées
        </h2>
        <span class="text-xs text-gray-500 dark:text-gray-400">
          Historique des projets en entreprise et institutions
        </span>
      </div>

      <!-- Navigation compacte des années avec divulgation progressive -->
      <nav aria-label="Sélection de l'année" class="mb-8">
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
          {recentYears.map(([year], idx) => (
            <button
              type="button"
              class={`year-btn px-3 py-1.5 rounded-md text-xs font-medium transition cursor-pointer
                ${idx === 0
                  ? "bg-gray-900 text-white dark:bg-gray-100 dark:text-gray-900 shadow-xs"
                  : "bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700"}`}
              data-year={year}
              aria-pressed={idx === 0 ? "true" : "false"}
            >
              {year}
            </button>
          ))}

          {olderYears.length > 0 && (
            <details id="older-years-details" class="relative inline-block">
              <summary class="px-3 py-1.5 rounded-md text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 cursor-pointer list-none inline-flex items-center gap-1 select-none">
                <span>Voir les années précédentes</span>
                <span class="text-[10px] text-gray-500 dark:text-gray-400" aria-hidden="true">▼</span>
              </summary>
              <div class="absolute left-0 top-full mt-1.5 z-20 p-2.5 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 flex flex-wrap gap-1.5 max-w-xs sm:max-w-md">
                {olderYears.map(([year]) => (
                  <button
                    type="button"
                    class="year-btn px-2.5 py-1 rounded text-xs font-medium bg-gray-50 text-gray-700 hover:bg-gray-200 dark:bg-gray-700/60 dark:text-gray-300 dark:hover:bg-gray-600 transition cursor-pointer"
                    data-year={year}
                    aria-pressed="false"
                  >
                    {year}
                  </button>
                ))}
              </div>
            </details>
          )}
        </div>
      </nav>

      <!-- Liste compacte des événements par année -->
      {eventsByYear.map(([year, events], idx) => (
        <div
          key={year}
          class={`year-section ${idx === 0 ? "" : "hidden"}`}
          data-year={year}
        >
          <div class="border-b border-gray-200 dark:border-gray-800 pb-2 mb-4 flex items-center justify-between">
            <h3 class="font-bold text-gray-900 dark:text-gray-100 text-base">
              Année {year}
            </h3>
            <span class="text-xs text-gray-500 dark:text-gray-400">
              {events.length} structure{events.length > 1 ? "s" : ""}
            </span>
          </div>

          <ul class="divide-y divide-gray-100 dark:divide-gray-800">
            {events.map((event) => (
              <li class="py-3.5 first:pt-0 last:pb-0">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                  <h4 class="font-semibold text-gray-900 dark:text-gray-100 text-sm sm:text-base" set:html={event.lieu} />
                  {event.formattedDate && (
                    <span
                      class="text-xs text-gray-500 dark:text-gray-400 sm:text-right shrink-0 font-medium"
                      set:html={event.formattedDate}
                    />
                  )}
                </div>
                <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 mt-0.5">
                  {event.titre}
                </p>
                {event.details && (
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 italic" set:html={event.details} />
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <!-- Navigation contextuelle groupée -->
    <RelatedPages current="/comites-entreprise" />
  </div>

  <script>
    const yearButtons = document.querySelectorAll(".year-btn");
    const yearSections = document.querySelectorAll(".year-section");
    const olderDetails = document.getElementById("older-years-details") as HTMLDetailsElement | null;

    yearButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const year = btn.getAttribute("data-year");
        if (!year) return;

        // Bascule de la section active
        yearSections.forEach((sec) => {
          const isMatch = sec.getAttribute("data-year") === year;
          sec.classList.toggle("hidden", !isMatch);
        });

        // Mise à jour de l'apparence des boutons et de aria-pressed
        yearButtons.forEach((b) => {
          const isSelected = b.getAttribute("data-year") === year;
          b.setAttribute("aria-pressed", isSelected ? "true" : "false");
          if (isSelected) {
            b.classList.add("bg-gray-900", "text-white", "dark:bg-gray-100", "dark:text-gray-900", "shadow-xs");
            b.classList.remove("bg-gray-100", "text-gray-700", "bg-gray-50", "dark:bg-gray-800", "dark:text-gray-300", "dark:bg-gray-700/60");
          } else {
            b.classList.remove("bg-gray-900", "text-white", "dark:bg-gray-100", "dark:text-gray-900", "shadow-xs");
            b.classList.add("bg-gray-100", "text-gray-700", "dark:bg-gray-800", "dark:text-gray-300");
          }
        });

        // Fermeture automatique du menu déroulant si un bouton interne a été cliqué
        if (olderDetails && olderDetails.contains(btn)) {
          olderDetails.removeAttribute("open");
        }
      });
    });
  </script>
</Base>
