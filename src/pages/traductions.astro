---
import Base from "../layouts/Layout.astro";
import RelatedPages from "../components/related-pages.astro";

const luYinChapters = [
  { slug: "pere-nouvelle", title: "15 septembre (Prologue)", desc: "L'amour interdit, le livre de Tagore et la maison familiale" },
  { slug: "le-19-septembre", title: "19 septembre", desc: "Les tourments intimes et l'annonce de l'arrivée de la belle-mère" },
  { slug: "le-20-septembre", title: "20 septembre", desc: "La confrontation familiale et le poids des traditions" },
  { slug: "le-22-septembre", title: "22 septembre", desc: "La maladie, le silence et les larmes partagées" },
  { slug: "le-28-septembre", title: "28 septembre", desc: "La musique, les déchirements affectifs et l'introspection" },
  { slug: "le-5-octobre", title: "5 octobre", desc: "Solitude, mélancolie et révolte de la jeunesse" },
  { slug: "le-6-octobre", title: "6 octobre (Épilogue)", desc: "Le dénouement dramatique et la fin du journal" },
];

const luYinStudies = [
  { href: "/presentation-de-lauteur", title: "Présentation de Lu Yin (1899–1934)", desc: "Biographie et engagement d'une figure féminine majeure du 4 mai 1919." },
  { href: "/etude-de-vie-de-lu-yin-de-oeuvre", title: "Étude de la vie et de l'œuvre", desc: "Analyse des thèmes récurrents : émancipation, mélancolie et liberté." },
  { href: "/lu-yin-conception-de-creation-litteraire", title: "Conception de la création littéraire", desc: "La recherche d'un style personnel et l'expression des sentiments vrais." },
  { href: "/lu-yin-monde-litteraire-chinois-annees-1920-1930", title: "Le monde littéraire des années 1920-1930", desc: "Le bouillonnement d'idées de la République de Chine naissante." },
  { href: "/influences-litteraires-etrangeres-loeuvre-de-lu-yin", title: "Les influences littéraires étrangères", desc: "Ouverture aux littératures européennes et dialogues interculturels." },
];

const zengChapters = [
  { slug: "zeng-jixin-la-guerre-entre-les-rats-et-les-hommes-nouvelle", title: "1. Les rats des jarres de riz", desc: "Premier contact d'enfance avec les rongeurs et le quotidien rural" },
  { slug: "instinct-animal", title: "2. Instinct animal", desc: "Observation fascinée des réflexes et de la survie animale" },
  { slug: "lengeance-de-rat-se-dechaine", title: "3. L'engeance de rat se déchaîne", desc: "L'invasion des greniers et les stratagèmes des villageois" },
  { slug: "les-manes-des-morts", title: "4. Les mânes des morts", desc: "Croyances populaires, peurs ancestrales et mystères campagnards" },
  { slug: "un-repaire-pour-les-rats-et-les-serpents", title: "5. Un repaire pour les rats et les serpents", desc: "Dénouement et réflexion allégorique sur la nature humaine" },
];
---

<Base
  title="Traductions littéraires du chinois — Nouvelles de Lu Yin et Zeng Jixin"
  description="Traductions intégrales de nouvelles chinoises par Christophe Desmur : 'Père' de Lu Yin (1924) et 'La Guerre entre les rats et les hommes' de Zeng Jixin.">

  <div class="max-w-5xl mx-auto">
    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="text-xs text-gray-500 dark:text-gray-400 mb-6 sm:mb-8">
      <ol class="flex items-center gap-1.5 flex-wrap">
        <li><a href="/" class="hover:underline">Accueil</a></li>
        <li aria-hidden="true">/</li>
        <li><span class="text-gray-500">Culture & Chinois</span></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-gray-800 dark:text-gray-200 font-medium">Traductions littéraires</li>
      </ol>
    </nav>

    <!-- En-tête éditorial -->
    <header class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start" aria-labelledby="traductions-heading">
      <div class="lg:col-span-8 flex flex-col">
        <h1
          id="traductions-heading"
          class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-gray-900 dark:text-gray-100 leading-tight">
          Traductions littéraires du chinois
        </h1>

        <p class="text-lg sm:text-xl font-serif italic text-indigo-800 dark:text-indigo-300 mt-3">
          Nouvelles et textes d'auteurs chinois traduits et commentés par Christophe Desmur
        </p>

        <p class="text-base text-gray-600 dark:text-gray-300 mt-5 leading-relaxed">
          Titulaire d'un <strong>Master de traduction littéraire chinois-français</strong> et d'une maîtrise en langue et civilisation chinoises, Christophe Desmur propose ici ses traductions intégrales de deux œuvres emblématiques de la modernité littéraire chinoise, accompagnées d'appareils critiques et biographiques.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="#lu-yin-section"
            class="inline-flex items-center px-4 py-2 rounded-lg bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 text-xs sm:text-sm font-medium hover:bg-gray-800 transition">
            Nouvelle « Père » (Lu Yin) &darr;
          </a>
          <a
            href="#zeng-jixin-section"
            class="inline-flex items-center px-4 py-2 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 text-xs sm:text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700 transition">
            Nouvelle « La Guerre des rats » (Zeng Jixin) &darr;
          </a>
        </div>
      </div>

      <div class="hidden lg:block lg:col-span-4">
        <div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-800/40 border border-gray-200 dark:border-gray-700">
          <span class="text-xs uppercase tracking-wider font-semibold text-gray-500 dark:text-gray-400">
            Le traducteur
          </span>
          <h3 class="font-bold text-gray-900 dark:text-gray-100 text-base mt-1">
            Christophe Desmur
          </h3>
          <p class="text-xs text-gray-600 dark:text-gray-300 mt-2 leading-relaxed">
            Calligraphe et traducteur littéraire. Formé à l'Université Jean Moulin Lyon 3 et à l'Institut des langues orientales, il consacre ses travaux à la transmission des textes et à la philosophie du geste en Chine.
          </p>
          <a href="/le-calligraphe" class="mt-3 inline-block text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">
            Découvrir son parcours &rarr;
          </a>
        </div>
      </div>
    </header>

    <!-- ŒUVRE 1 : PÈRE DE LU YIN -->
    <section id="lu-yin-section" class="mt-16 pt-12 border-t border-gray-200 dark:border-gray-800" aria-labelledby="lu-yin-heading">
      <div class="grid lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-4">
          <img
            src="/assets/lu-yin.webp"
            alt="Photographie de l'écrivaine chinoise Lu Yin (1899-1934)"
            width="240"
            height="300"
            loading="lazy"
            class="w-44 h-auto rounded-xl shadow-xs border border-gray-200 dark:border-gray-700 object-cover mb-4"
          />
          <span class="text-xs uppercase tracking-wider font-semibold text-indigo-600 dark:text-indigo-400">
            Mouvement du 4 mai 1919
          </span>
          <h2 id="lu-yin-heading" class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1">
            « Père » (Fuqin — 父亲)
          </h2>
          <p class="text-sm font-serif italic text-gray-600 dark:text-gray-300 mt-1">
            Nouvelle de Lu Yin (1899–1934)
          </p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-3 leading-relaxed">
            Écrite en 1924, cette nouvelle intime sous forme de journal relate les sentiments tourmentés d'un jeune homme face à son père opiomane et sa jeune belle-mère. Un témoignage poignant sur les tensions familiales et l'émancipation dans la Chine des années 1920.
          </p>

          <a
            href="/pere-nouvelle"
            class="mt-6 inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm transition shadow-xs">
            Lire la nouvelle (début) &rarr;
          </a>
        </div>

        <!-- Chapitres de la nouvelle -->
        <div class="lg:col-span-8">
          <h3 class="text-base font-bold text-gray-900 dark:text-gray-100 mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
            Sommaire des chapitres de la nouvelle
          </h3>
          <ol class="space-y-3">
            {luYinChapters.map((chap, idx) => (
              <li>
                <a
                  href={`/${chap.slug}`}
                  class="group p-3.5 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-indigo-400 dark:hover:border-indigo-500 transition flex items-start justify-between gap-4 bg-white dark:bg-gray-800/40">
                  <div class="flex items-start gap-3">
                    <span class="font-serif text-lg text-indigo-700 dark:text-indigo-400 font-bold select-none shrink-0 mt-0.5">
                      0{idx + 1}
                    </span>
                    <div>
                      <h4 class="font-semibold text-gray-900 dark:text-gray-100 text-sm group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition">
                        {chap.title}
                      </h4>
                      <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                        {chap.desc}
                      </p>
                    </div>
                  </div>
                  <span class="text-xs font-semibold text-gray-400 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-transform shrink-0 mt-1">
                    Lire &rarr;
                  </span>
                </a>
              </li>
            ))}
          </ol>

          <!-- Études littéraires sur Lu Yin -->
          <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
            <h4 class="text-xs uppercase tracking-wider font-semibold text-gray-500 dark:text-gray-400 mb-3">
              Études critiques et biographie de Lu Yin
            </h4>
            <div class="grid sm:grid-cols-2 gap-2.5">
              {luYinStudies.map((study) => (
                <a
                  href={study.href}
                  class="p-3 rounded-lg border border-gray-100 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-800/60 transition">
                  <span class="font-medium text-xs text-gray-900 dark:text-gray-100 block">
                    {study.title}
                  </span>
                  <span class="text-[11px] text-gray-500 dark:text-gray-400 block mt-0.5">
                    {study.desc}
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ŒUVRE 2 : LA GUERRE ENTRE LES RATS ET LES HOMMES DE ZENG JIXIN -->
    <section id="zeng-jixin-section" class="mt-16 pt-12 border-t border-gray-200 dark:border-gray-800" aria-labelledby="zeng-heading">
      <div class="grid lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-4">
          <span class="text-xs uppercase tracking-wider font-semibold text-indigo-600 dark:text-indigo-400">
            Littérature chinoise contemporaine
          </span>
          <h2 id="zeng-heading" class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1">
            « La Guerre entre les rats et les hommes »
          </h2>
          <p class="text-sm font-serif italic text-gray-600 dark:text-gray-300 mt-1">
            Nouvelle de Zeng Jixin (曾纪鑫, né en 1963)
          </p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-3 leading-relaxed">
            Récit puissant et insolite puisé dans les souvenirs d'enfance d'un village rural enneigé. La confrontation tragi-comique entre les hommes et les rongeurs devient le miroir des mœurs et des luttes pour la subsistance dans la Chine rurale.
          </p>

          <div class="mt-6 flex flex-col gap-2">
            <a
              href="/zeng-jixin-la-guerre-entre-les-rats-et-les-hommes-nouvelle"
              class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm transition shadow-xs text-center">
              Lire la nouvelle (chapitre 1) &rarr;
            </a>
            <a
              href="/zeng-jixin"
              class="text-xs text-gray-600 dark:text-gray-400 hover:underline text-center mt-1">
              Biographie de Zeng Jixin (曾纪鑫) &rarr;
            </a>
          </div>
        </div>

        <!-- Sommaire des 5 chapitres -->
        <div class="lg:col-span-8">
          <h3 class="text-base font-bold text-gray-900 dark:text-gray-100 mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
            Sommaire des 5 chapitres de la nouvelle
          </h3>
          <ol class="space-y-3">
            {zengChapters.map((chap, idx) => (
              <li>
                <a
                  href={`/${chap.slug}`}
                  class="group p-3.5 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-indigo-400 dark:hover:border-indigo-500 transition flex items-start justify-between gap-4 bg-white dark:bg-gray-800/40">
                  <div class="flex items-start gap-3">
                    <span class="font-serif text-lg text-indigo-700 dark:text-indigo-400 font-bold select-none shrink-0 mt-0.5">
                      0{idx + 1}
                    </span>
                    <div>
                      <h4 class="font-semibold text-gray-900 dark:text-gray-100 text-sm group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition">
                        {chap.title}
                      </h4>
                      <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                        {chap.desc}
                      </p>
                    </div>
                  </div>
                  <span class="text-xs font-semibold text-gray-400 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-transform shrink-0 mt-1">
                    Lire &rarr;
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Navigation contextuelle -->
    <RelatedPages current="/traductions" />
  </div>
</Base>
