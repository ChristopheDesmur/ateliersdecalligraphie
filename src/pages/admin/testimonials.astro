---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminNav from "@/components/admin/AdminNav.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";

const { session } = authenticateRequest(Astro.request);
---
<Layout title="Administration — Témoignages" noindex={true}>
  <div class="max-w-4xl">
    {session ? (
      <div>
        <AdminNav active="testimonials" />
        <div class="flex items-center justify-between mb-6">
          <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Témoignages</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
              Section « Témoignages & retours d'expérience » de /le-calligraphe.
            </p>
          </div>
          <button
            id="add-testimonial-btn"
            type="button"
            class="px-3 py-1.5 rounded-md bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-xs transition cursor-pointer shrink-0"
          >
            + Ajouter
          </button>
        </div>

        <div id="testimonials-status" class="hidden mb-4 p-3 rounded-md text-xs font-medium"></div>

        <div id="testimonials-list" class="space-y-3 mb-10">
          <p class="text-sm text-gray-400">Chargement…</p>
        </div>

        <!-- Formulaire d'ajout / modification -->
        <div id="testimonial-form-container" class="hidden bg-white dark:bg-[#1e2327] border border-gray-300 dark:border-gray-700 rounded-md p-5 sm:p-6 shadow-xs">
          <h2 id="testimonial-form-title" class="font-bold text-gray-900 dark:text-white mb-4 text-base">Ajouter un témoignage</h2>
          <form id="testimonial-form">
            <input type="hidden" name="originalId" value="" />
            <input type="hidden" name="photo" value="" />

            <div class="grid sm:grid-cols-2 gap-4">
              <div class="sm:col-span-2">
                <label class="field-label">Citation</label>
                <textarea name="quote" required rows="3" class="field-input" placeholder="Christophe Desmur anime chaque vendredi matin l'atelier de calligraphie…"></textarea>
              </div>
              <div class="sm:col-span-2">
                <label class="field-label">Photo (facultative)</label>
                <div class="flex items-start gap-3">
                  <div id="photo-preview-wrap" class="hidden shrink-0 w-16 h-16 rounded-full overflow-hidden border border-gray-200 dark:border-gray-700 bg-stone-50 dark:bg-gray-900">
                    <img id="photo-preview" class="w-full h-full object-cover" alt="" />
                  </div>
                  <div class="flex-1 min-w-0">
                    <input type="file" id="photo-upload-input" accept="image/*" class="text-xs text-gray-600 dark:text-gray-300 file:mr-3 file:px-3 file:py-1.5 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 dark:file:bg-indigo-950 dark:file:text-indigo-300 hover:file:bg-indigo-100 dark:hover:file:bg-indigo-900 cursor-pointer" />
                    <p id="photo-upload-status" class="text-xs text-gray-500 dark:text-gray-400 mt-1"></p>
                  </div>
                </div>
              </div>
              <div class="sm:col-span-2">
                <label class="field-label">Auteur</label>
                <select id="author-select" class="field-input mb-2">
                  <option value="">Autre (personne, média… saisie libre ci-dessous)</option>
                </select>
                <input name="author" id="author-input" required class="field-input" placeholder="OVPAR Villeurbanne" />
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                  Choisir une institution ci-dessus remplit le champ ci-dessous ; il reste modifiable pour une personne ou un média absent d'<a href="/admin/institutions" class="text-indigo-600 dark:text-indigo-400 hover:underline">Institutions</a>.
                </p>
              </div>
              <div>
                <label class="field-label">Fonction / rôle</label>
                <input name="role" required class="field-input" placeholder="Office villeurbannais des personnes âgées et des retraités" />
              </div>
              <div>
                <label class="field-label">Badge affiché</label>
                <input name="badge" required class="field-input" placeholder="Partenaire depuis 2012" />
              </div>
              <div>
                <label class="field-label">Source</label>
                <input name="source" required class="field-input" placeholder="Programme annuel" />
              </div>
              <div>
                <label class="field-label">Lien (facultatif)</label>
                <input name="href" class="field-input" placeholder="https://…" />
              </div>
              <div>
                <label class="field-label">Texte du lien (facultatif)</label>
                <input name="linkText" class="field-input" placeholder="Voir la publication" />
              </div>
              <div>
                <label class="field-label">Date (facultative)</label>
                <input name="date" type="date" class="field-input" />
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                  À ne renseigner que si la date exacte du témoignage ou de l'événement est connue avec certitude.
                </p>
              </div>
            </div>

            <div class="mt-6 pt-5 border-t border-gray-100 dark:border-gray-800 flex items-center gap-3">
              <button type="submit" id="testimonial-save-btn" class="px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-xs transition cursor-pointer disabled:opacity-60">
                Enregistrer
              </button>
              <button type="button" id="testimonial-cancel-btn" class="px-4 py-2 rounded-md border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 text-xs font-medium hover:bg-gray-100 dark:hover:bg-gray-700 transition cursor-pointer">
                Annuler
              </button>
            </div>
          </form>
        </div>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>
</Layout>

<script>
  import { INSTITUTION_CATEGORIES, institutionCategoryFor } from "@/lib/admin/institution-categories";

  let csrfToken = "";
  let testimonials: Record<string, any> = {};
  let institutionNames: string[] = [];

  const listEl = document.getElementById("testimonials-list");
  const statusEl = document.getElementById("testimonials-status");
  const formContainer = document.getElementById("testimonial-form-container");
  const form = document.getElementById("testimonial-form") as HTMLFormElement | null;
  const formTitle = document.getElementById("testimonial-form-title");
  const saveBtn = document.getElementById("testimonial-save-btn") as HTMLButtonElement | null;
  const authorSelect = document.getElementById("author-select") as HTMLSelectElement | null;
  const authorInput = document.getElementById("author-input") as HTMLInputElement | null;

  // Simple aide au remplissage : choisir une institution recopie son nom
  // dans le champ Auteur, qui reste le seul champ réellement soumis — pas
  // de référence stockée, contrairement au Lieu des événements. Les
  // témoignages d'une personne ou d'un média (sans entrée institutions.yaml)
  // continuent de se saisir librement dans ce même champ.
  function populateAuthorSelect(institutions: Record<string, any>) {
    if (!authorSelect) return;
    const byCategory = new Map<string, string[]>();
    for (const id of Object.keys(institutions)) {
      // Certains noms embarquent du HTML (ex. "Lyon 4<sup>e</sup>") destiné à
      // un rendu set:html ailleurs sur le site — Auteur est un champ texte
      // brut, où ces balises apparaîtraient telles quelles si on ne les
      // retirait pas.
      const name = institutions[id].name.replace(/<[^>]+>/g, "");
      const label = institutionCategoryFor(name);
      if (!byCategory.has(label)) byCategory.set(label, []);
      byCategory.get(label)!.push(name);
    }
    institutionNames = Array.from(byCategory.values()).flat();
    for (const names of byCategory.values()) names.sort((a, b) => a.localeCompare(b, "fr"));

    const placeholder = `<option value="">Autre (personne, média… saisie libre ci-dessous)</option>`;
    authorSelect.innerHTML =
      placeholder +
      INSTITUTION_CATEGORIES.map((c) => c.label)
        .filter((label) => byCategory.has(label))
        .map((label) => {
          const options = byCategory
            .get(label)!
            .map((name) => `<option value="${name}">${name}</option>`)
            .join("");
          return `<optgroup label="${label}">${options}</optgroup>`;
        })
        .join("");
  }

  authorSelect?.addEventListener("change", () => {
    if (authorSelect.value && authorInput) authorInput.value = authorSelect.value;
  });
  const photoUploadInput = document.getElementById("photo-upload-input") as HTMLInputElement | null;
  const photoUploadStatus = document.getElementById("photo-upload-status");
  const photoPreviewWrap = document.getElementById("photo-preview-wrap");
  const photoPreview = document.getElementById("photo-preview") as HTMLImageElement | null;

  function showPhotoPreview(src: string) {
    if (!photoPreview || !photoPreviewWrap) return;
    photoPreview.src = src;
    photoPreviewWrap.classList.remove("hidden");
  }

  photoUploadInput?.addEventListener("change", async () => {
    const file = photoUploadInput.files?.[0];
    if (!file || !form || !photoUploadStatus) return;

    photoUploadStatus.textContent = "Téléversement…";
    photoUploadStatus.className = "text-xs text-gray-500 dark:text-gray-400 mt-1";

    const nameHint = (form.elements.namedItem("author") as HTMLInputElement)?.value || file.name.replace(/\.[^.]+$/, "");
    const fd = new FormData();
    fd.append("file", file);
    fd.append("nameHint", nameHint);

    try {
      const res = await fetch("/api/admin/upload-image", {
        method: "POST",
        headers: { "x-csrf-token": csrfToken },
        body: fd,
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);

      (form.elements.namedItem("photo") as HTMLInputElement).value = data.path;
      showPhotoPreview(data.path);
      photoUploadStatus.textContent = "Photo téléversée et publiée ✓";
    } catch (err: any) {
      photoUploadStatus.textContent = err.message || "Échec du téléversement.";
      photoUploadStatus.className = "text-xs text-rose-500 mt-1";
    } finally {
      photoUploadInput.value = "";
    }
  });

  function showStatus(message: string, kind: "success" | "error") {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden");
    statusEl.className =
      "mb-4 p-3 rounded-md text-xs font-medium " +
      (kind === "success"
        ? "bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800"
        : "bg-rose-50 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800");
  }

  function renderList() {
    if (!listEl) return;
    const ids = Object.keys(testimonials);
    if (ids.length === 0) {
      listEl.innerHTML = `<p class="text-sm text-gray-400">Aucun témoignage.</p>`;
      return;
    }
    listEl.innerHTML = ids
      .map((id) => {
        const t = testimonials[id];
        return `
      <div class="p-4 flex items-start justify-between gap-4 border border-gray-300 dark:border-gray-700 rounded-md bg-white dark:bg-[#1e2327] shadow-xs">
        <div class="flex items-start gap-3 min-w-0">
          ${
            t.photo
              ? `<img src="${t.photo}" alt="" class="w-10 h-10 rounded-full object-cover shrink-0 border border-gray-200 dark:border-gray-700" />`
              : ""
          }
          <div class="min-w-0">
            <p class="text-sm text-gray-700 dark:text-gray-300 italic truncate">« ${t.quote} »</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><span class="font-semibold text-gray-700 dark:text-gray-300">${t.author}</span> · ${t.badge}${t.date ? ` · ${t.date}` : ""}</p>
          </div>
        </div>
        <div class="flex gap-2 shrink-0">
          <button data-edit="${id}" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline cursor-pointer">Modifier</button>
          <button data-delete="${id}" class="text-xs font-semibold text-rose-600 dark:text-rose-400 hover:underline cursor-pointer">Supprimer</button>
        </div>
      </div>`;
      })
      .join("");

    listEl.querySelectorAll<HTMLButtonElement>("[data-edit]").forEach((btn) =>
      btn.addEventListener("click", () => openForm(btn.dataset.edit!, testimonials[btn.dataset.edit!]))
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((btn) =>
      btn.addEventListener("click", () => deleteTestimonial(btn.dataset.delete!, testimonials[btn.dataset.delete!]))
    );
  }

  function openForm(id: string | null, t: any | null) {
    if (!form || !formContainer || !formTitle) return;
    form.reset();
    (form.elements.namedItem("originalId") as HTMLInputElement).value = id ?? "";
    formTitle.textContent = t ? `Modifier le témoignage de « ${t.author} »` : "Ajouter un témoignage";
    if (photoUploadStatus) photoUploadStatus.textContent = "";
    photoPreviewWrap?.classList.add("hidden");
    if (t?.photo) showPhotoPreview(t.photo);

    if (t) {
      const set = (name: string, value: any) => {
        const el = form.elements.namedItem(name) as HTMLInputElement | null;
        if (el) el.value = value ?? "";
      };
      set("quote", t.quote);
      set("author", t.author);
      set("role", t.role);
      set("badge", t.badge);
      set("source", t.source);
      set("href", t.href);
      set("linkText", t.linkText);
      set("date", t.date);
      set("photo", t.photo);
      if (authorSelect) authorSelect.value = institutionNames.includes(t.author) ? t.author : "";
    }

    formContainer.classList.remove("hidden");
    formContainer.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function closeForm() {
    formContainer?.classList.add("hidden");
  }

  async function deleteTestimonial(id: string, t: any) {
    if (!confirm(`Supprimer définitivement le témoignage de « ${t.author} » ?`)) return;
    try {
      const res = await fetch("/api/admin/testimonials", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify({ action: "delete", id }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Témoignage supprimé et site republié.", "success");
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    }
  }

  async function load() {
    const [testimonialsRes, institutionsRes, authRes] = await Promise.all([
      fetch("/api/admin/testimonials"),
      fetch("/api/admin/institutions"),
      fetch("/api/admin/auth"),
    ]);
    const data = await testimonialsRes.json();
    const institutionsData = await institutionsRes.json().catch(() => ({ institutions: {} }));
    const authData = await authRes.json();
    csrfToken = authData.csrfToken || "";

    if (!testimonialsRes.ok) {
      if (listEl) listEl.innerHTML = `<p class="text-sm text-rose-500">${data.error}</p>`;
      return;
    }

    populateAuthorSelect(institutionsData.institutions || {});
    testimonials = data.testimonials;
    renderList();
  }

  document.getElementById("add-testimonial-btn")?.addEventListener("click", () => openForm(null, null));
  document.getElementById("testimonial-cancel-btn")?.addEventListener("click", closeForm);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!saveBtn || !form) return;
    saveBtn.disabled = true;
    saveBtn.textContent = "Enregistrement…";

    const fd = new FormData(form);
    const originalId = String(fd.get("originalId") || "");
    const testimonial = {
      quote: fd.get("quote"),
      author: fd.get("author"),
      role: fd.get("role"),
      badge: fd.get("badge"),
      source: fd.get("source"),
      href: fd.get("href"),
      linkText: fd.get("linkText"),
      date: fd.get("date"),
      photo: fd.get("photo"),
    };

    try {
      const res = await fetch("/api/admin/testimonials", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify(originalId ? { action: "update", originalId, testimonial } : { action: "create", testimonial }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Témoignage enregistré et site republié.", "success");
      closeForm();
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Enregistrer";
    }
  });

  load();
</script>
