---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminNav from "@/components/admin/AdminNav.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";

const { session } = authenticateRequest(Astro.request);
---
<Layout title="Administration — Formats d'ateliers" noindex={true}>
  <div class="max-w-4xl">
    {session ? (
      <div>
        <AdminNav active="interventions" />
        <div class="flex flex-wrap items-center justify-between mb-4 gap-3">
          <div>
            <h1 class="text-xl sm:text-2xl font-serif font-bold text-gray-900 dark:text-white">Formats d'ateliers</h1>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
              Les cartes « Choisissez votre format d'atelier selon votre public » affichées sur /atelier-de-groupe.
            </p>
          </div>
          <button
            id="add-intervention-btn"
            type="button"
            class="px-3 py-1.5 rounded-md bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-2xs transition cursor-pointer shrink-0"
          >
            + Ajouter un format
          </button>
        </div>

        <div id="interventions-status" class="hidden mb-4 p-2.5 rounded-md text-xs font-medium"></div>

        <div id="interventions-list" class="space-y-3 mb-10">
          <p class="text-sm text-gray-400">Chargement…</p>
        </div>

        <!-- Formulaire d'ajout / modification -->
        <div id="intervention-form-container" class="hidden bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-md p-4 sm:p-6 shadow-2xs mb-10">
          <h2 id="intervention-form-title" class="font-serif font-bold text-lg text-gray-900 dark:text-white mb-4">Ajouter un format</h2>
          <form id="intervention-form">
            <input type="hidden" name="originalId" value="" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
              <div>
                <label class="field-label">Sur-titre</label>
                <input name="eyebrow" required class="field-input" placeholder="Secondaire" />
              </div>
              <div>
                <label class="field-label">Titre</label>
                <input name="title" required class="field-input" placeholder="Collèges" />
              </div>
              <div class="sm:col-span-2">
                <label class="field-label">Description</label>
                <textarea name="description" required rows="2" class="field-input"></textarea>
              </div>
              <div>
                <label class="field-label">Page liée</label>
                <input name="href" required class="field-input" placeholder="/colleges" />
              </div>
              <div>
                <label class="field-label">Référence de prix (prices.yaml)</label>
                <input name="price_ref" required list="price-refs" class="field-input" placeholder="interventions.ht_heure_standard" />
                <datalist id="price-refs"></datalist>
              </div>
            </div>

            <div class="mt-6 pt-5 border-t border-gray-100 dark:border-gray-800 flex items-center gap-3">
              <button type="submit" id="intervention-save-btn" class="px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-xs transition cursor-pointer disabled:opacity-60">
                Enregistrer
              </button>
              <button type="button" id="intervention-cancel-btn" class="px-4 py-2 rounded-md border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 text-xs font-medium hover:bg-gray-100 dark:hover:bg-gray-700 transition cursor-pointer">
                Annuler
              </button>
            </div>
          </form>
        </div>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>
</Layout>

<script>
  let csrfToken = "";
  let interventions: Record<string, any> = {};

  const listEl = document.getElementById("interventions-list");
  const statusEl = document.getElementById("interventions-status");
  const formContainer = document.getElementById("intervention-form-container");
  const form = document.getElementById("intervention-form") as HTMLFormElement | null;
  const formTitle = document.getElementById("intervention-form-title");
  const saveBtn = document.getElementById("intervention-save-btn") as HTMLButtonElement | null;

  function showStatus(message: string, kind: "success" | "error") {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden");
    statusEl.className =
      "mb-4 p-2.5 rounded-md text-xs font-medium " +
      (kind === "success"
        ? "bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800"
        : "bg-rose-50 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800");
  }

  function renderList() {
    if (!listEl) return;
    const ids = Object.keys(interventions);
    if (ids.length === 0) {
      listEl.innerHTML = `<p class="text-sm text-gray-400">Aucun format.</p>`;
      return;
    }
    listEl.innerHTML = ids
      .map((id) => {
        const item = interventions[id];
        return `
      <div class="p-3 sm:p-4 flex flex-col sm:flex-row sm:items-start justify-between gap-2 sm:gap-4 border border-gray-200 dark:border-gray-700 rounded-md bg-white dark:bg-gray-800">
        <div class="min-w-0">
          <p class="text-[11px] uppercase tracking-wider font-semibold text-indigo-600 dark:text-indigo-400">${item.eyebrow}</p>
          <p class="font-semibold text-sm text-gray-900 dark:text-white">${item.title}</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 break-all sm:break-normal">${item.href} · ${item.price_ref}</p>
        </div>
        <div class="flex items-center gap-3 shrink-0 pt-1 sm:pt-0">
          <button data-edit="${id}" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline cursor-pointer">Modifier</button>
          <button data-delete="${id}" class="text-xs font-semibold text-rose-600 dark:text-rose-400 hover:underline cursor-pointer">Supprimer</button>
        </div>
      </div>`;
      })
      .join("");

    listEl.querySelectorAll<HTMLButtonElement>("[data-edit]").forEach((btn) =>
      btn.addEventListener("click", () => openForm(btn.dataset.edit!, interventions[btn.dataset.edit!]))
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((btn) =>
      btn.addEventListener("click", () => deleteIntervention(btn.dataset.delete!, interventions[btn.dataset.delete!]))
    );
  }

  function openForm(id: string | null, item: any | null) {
    if (!form || !formContainer || !formTitle) return;
    form.reset();
    (form.elements.namedItem("originalId") as HTMLInputElement).value = id ?? "";
    formTitle.textContent = item ? `Modifier « ${item.title} »` : "Ajouter un format";

    if (item) {
      const set = (name: string, value: any) => {
        const el = form.elements.namedItem(name) as HTMLInputElement | null;
        if (el) el.value = value ?? "";
      };
      set("eyebrow", item.eyebrow);
      set("title", item.title);
      set("description", item.description);
      set("href", item.href);
      set("price_ref", item.price_ref);
    }

    formContainer.classList.remove("hidden");
    formContainer.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function closeForm() {
    formContainer?.classList.add("hidden");
  }

  async function deleteIntervention(id: string, item: any) {
    if (!confirm(`Supprimer définitivement « ${item.title} » ?`)) return;
    try {
      const res = await fetch("/api/admin/interventions", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify({ action: "delete", id }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Format supprimé et site republié.", "success");
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    }
  }

  async function load() {
    const [interventionsRes, authRes] = await Promise.all([fetch("/api/admin/interventions"), fetch("/api/admin/auth")]);
    const data = await interventionsRes.json();
    const authData = await authRes.json();
    csrfToken = authData.csrfToken || "";

    if (!interventionsRes.ok) {
      if (listEl) listEl.innerHTML = `<p class="text-sm text-rose-500">${data.error}</p>`;
      return;
    }

    interventions = data.interventions;
    const datalist = document.getElementById("price-refs");
    if (datalist) datalist.innerHTML = (data.priceRefs || []).map((r: string) => `<option value="${r}"></option>`).join("");

    renderList();
  }

  document.getElementById("add-intervention-btn")?.addEventListener("click", () => openForm(null, null));
  document.getElementById("intervention-cancel-btn")?.addEventListener("click", closeForm);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!saveBtn || !form) return;
    saveBtn.disabled = true;
    saveBtn.textContent = "Enregistrement…";

    const fd = new FormData(form);
    const originalId = String(fd.get("originalId") || "");
    const intervention = {
      eyebrow: fd.get("eyebrow"),
      title: fd.get("title"),
      description: fd.get("description"),
      href: fd.get("href"),
      price_ref: fd.get("price_ref"),
    };

    try {
      const res = await fetch("/api/admin/interventions", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify(originalId ? { action: "update", originalId, intervention } : { action: "create", intervention }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Format enregistré et site republié.", "success");
      closeForm();
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Enregistrer";
    }
  });

  load();
</script>
