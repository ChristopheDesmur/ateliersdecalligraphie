---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";

const { session } = authenticateRequest(Astro.request);
---
<Layout title="Administration — Formats" noindex={true}>
  <div>
    {session ? (
      <div>
        <AdminPageHeader
          title="Formats"
          description="Les cartes « Choisissez votre format d'atelier selon votre public » affichées sur /atelier-de-groupe."
          active="interventions"
        >
          <div slot="actions">
            <button
              id="add-intervention-btn"
              type="button"
              class="astro-btn astro-btn-primary text-xs"
            >
              + Ajouter un format
            </button>
          </div>
        </AdminPageHeader>

        <div id="interventions-status" class="hidden mb-4 astro-notice" role="alert"></div>

        <!-- Table Astro des formats -->
        <div class="astro-panel mb-8 overflow-hidden">
          <div class="astro-panel-header flex items-center justify-between">
            <h2 class="astro-panel-title">Tous les formats</h2>
            <span id="interventions-count" class="text-xs text-gray-500 dark:text-gray-400"></span>
          </div>
          <div class="astro-table-wrap border-0">
            <table class="astro-table">
              <thead>
                <tr>
                  <th class="w-28">Public</th>
                  <th>Titre & Description</th>
                  <th class="w-36">Page liée</th>
                  <th class="w-52">Réf. Prix</th>
                  <th class="w-24 text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="interventions-list">
                <tr>
                  <td colspan="5" class="p-6 text-center text-xs text-gray-500 dark:text-gray-400">Chargement…</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Formulaire d'ajout / modification (Panel Astro) -->
        <div id="intervention-form-container" class="hidden astro-panel mb-8">
          <div class="astro-panel-header">
            <h2 id="intervention-form-title" class="astro-panel-title">Ajouter un format</h2>
          </div>
          <div class="astro-panel-body">
            <form id="intervention-form">
              <input type="hidden" name="originalId" value="" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                <div>
                  <label class="field-label">Sur-titre (public visé)</label>
                  <input name="eyebrow" required class="field-input" placeholder="Secondaire" />
                </div>
                <div>
                  <label class="field-label">Titre</label>
                  <input name="title" required class="field-input" placeholder="Collèges" />
                </div>
                <div class="sm:col-span-2">
                  <label class="field-label">Description</label>
                  <textarea name="description" required rows="2" class="field-input"></textarea>
                </div>
                <div>
                  <label class="field-label">Page liée (URL relative)</label>
                  <input name="href" required class="field-input" placeholder="/colleges" />
                </div>
                <div>
                  <label class="field-label">Référence de prix (prices.yaml)</label>
                  <input name="price_ref" required list="price-refs" class="field-input" placeholder="interventions.ht_heure_standard" />
                  <datalist id="price-refs"></datalist>
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-gray-200 dark:border-gray-700 flex items-center gap-2">
                <button type="submit" id="intervention-save-btn" class="astro-btn astro-btn-primary">
                  Enregistrer
                </button>
                <button type="button" id="intervention-cancel-btn" class="astro-btn astro-btn-secondary">
                  Annuler
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>
</Layout>

<script>
  let csrfToken = "";
  let interventions: Record<string, any> = {};

  const listEl = document.getElementById("interventions-list");
  const statusEl = document.getElementById("interventions-status");
  const formContainer = document.getElementById("intervention-form-container");
  const form = document.getElementById("intervention-form") as HTMLFormElement | null;
  let formDirty = false;
  form?.addEventListener("input", () => { formDirty = true; });
  window.addEventListener("beforeunload", (e) => {
    if (!formDirty || formContainer?.classList.contains("hidden")) return;
    e.preventDefault();
    e.returnValue = "";
  });
  const formTitle = document.getElementById("intervention-form-title");
  const saveBtn = document.getElementById("intervention-save-btn") as HTMLButtonElement | null;

  function showStatus(message: string, kind: "success" | "error") {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden");
    statusEl.className =
      "astro-notice mb-4 " +
      (kind === "success" ? "astro-notice-success" : "astro-notice-error");
  }

  function renderList() {
    if (!listEl) return;
    const ids = Object.keys(interventions);
    const countEl = document.getElementById("interventions-count");
    if (countEl) countEl.textContent = `${ids.length} format${ids.length > 1 ? "s" : ""}`;

    if (ids.length === 0) {
      listEl.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-xs text-gray-500 dark:text-gray-400">Aucun format.</td></tr>`;
      return;
    }
    listEl.innerHTML = ids
      .map((id) => {
        const item = interventions[id];
        return `
      <tr class="hover:bg-gray-50/60 dark:hover:bg-gray-800/40 transition-colors">
        <td class="text-xs">
          <span class="astro-badge astro-badge-gray uppercase tracking-wider text-[10px] font-semibold">${item.eyebrow}</span>
        </td>
        <td>
          <div class="font-medium text-gray-900 dark:text-gray-100 text-xs">${item.title}</div>
          <div class="text-[11px] text-gray-500 dark:text-gray-400 line-clamp-1 mt-0.5">${item.description}</div>
          <div class="row-actions text-xs mt-1">
            <button type="button" data-edit="${id}" class="text-[#2271b1] hover:underline cursor-pointer">Modifier</button>
            <span class="text-gray-300 dark:text-gray-600">|</span>
            <button type="button" data-delete="${id}" class="text-rose-600 hover:underline cursor-pointer">Supprimer</button>
          </div>
        </td>
        <td class="text-xs font-mono text-gray-600 dark:text-gray-400">
          <a href="${item.href}" target="_blank" class="hover:underline text-[#2271b1]">${item.href}</a>
        </td>
        <td class="text-xs font-mono text-gray-500 dark:text-gray-400">
          ${item.price_ref}
        </td>
        <td class="text-right">
          <button type="button" data-edit="${id}" class="astro-btn astro-btn-secondary text-xs py-0.5 px-2">
            Modifier
          </button>
        </td>
      </tr>`;
      })
      .join("");

    listEl.querySelectorAll<HTMLButtonElement>("[data-edit]").forEach((btn) =>
      btn.addEventListener("click", () => openForm(btn.dataset.edit!, interventions[btn.dataset.edit!]))
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((btn) =>
      btn.addEventListener("click", () => deleteIntervention(btn.dataset.delete!, interventions[btn.dataset.delete!]))
    );
  }

  function openForm(id: string | null, item: any | null) {
    if (!form || !formContainer || !formTitle) return;
    formDirty = false;
    form.reset();
    (form.elements.namedItem("originalId") as HTMLInputElement).value = id ?? "";
    formTitle.textContent = item ? `Modifier « ${item.title} »` : "Ajouter un format";

    if (item) {
      const set = (name: string, value: any) => {
        const el = form.elements.namedItem(name) as HTMLInputElement | null;
        if (el) el.value = value ?? "";
      };
      set("eyebrow", item.eyebrow);
      set("title", item.title);
      set("description", item.description);
      set("href", item.href);
      set("price_ref", item.price_ref);
    }

    formContainer.classList.remove("hidden");
    formContainer.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function closeForm() {
    formDirty = false;
    formContainer?.classList.add("hidden");
  }

  async function deleteIntervention(id: string, item: any) {
    if (!confirm(`Supprimer définitivement « ${item.title} » ?`)) return;
    try {
      const res = await fetch("/api/admin/interventions", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify({ action: "delete", id }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Format supprimé et site republié.", "success");
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    }
  }

  async function load() {
    const [interventionsRes, authRes] = await Promise.all([fetch("/api/admin/interventions"), fetch("/api/admin/auth")]);
    const data = await interventionsRes.json();
    const authData = await authRes.json();
    csrfToken = authData.csrfToken || "";

    if (!interventionsRes.ok) {
      if (listEl) listEl.innerHTML = `<tr><td colspan="5" class="p-4 text-sm text-rose-500">${data.error}</td></tr>`;
      return;
    }

    interventions = data.interventions;
    const datalist = document.getElementById("price-refs");
    if (datalist) datalist.innerHTML = (data.priceRefs || []).map((r: string) => `<option value="${r}"></option>`).join("");

    renderList();
  }

  document.getElementById("add-intervention-btn")?.addEventListener("click", () => openForm(null, null));
  document.getElementById("intervention-cancel-btn")?.addEventListener("click", closeForm);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!saveBtn || !form) return;
    saveBtn.disabled = true;
    saveBtn.textContent = "Enregistrement…";

    const fd = new FormData(form);
    const originalId = String(fd.get("originalId") || "");
    const intervention = {
      eyebrow: fd.get("eyebrow"),
      title: fd.get("title"),
      description: fd.get("description"),
      href: fd.get("href"),
      price_ref: fd.get("price_ref"),
    };

    try {
      const res = await fetch("/api/admin/interventions", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify(originalId ? { action: "update", originalId, intervention } : { action: "create", intervention }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Format enregistré et site republié.", "success");
      closeForm();
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Enregistrer";
    }
  });

  load();
</script>
