---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminNav from "@/components/admin/AdminNav.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";

const { session } = authenticateRequest(Astro.request);
---
<Layout title="Administration — Contact" noindex={true}>
  <div class="max-w-2xl">
    {session ? (
      <div>
        <AdminNav active="contact" />
        <div class="mb-4">
          <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">Contact</h1>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
            Ces coordonnées sont affichées sur l'ensemble du site (menus de contact, pied de page, mentions légales).
          </p>
        </div>

        <div id="contact-error" class="hidden mb-4 p-2.5 rounded-md text-xs font-medium bg-rose-50 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800" role="alert"></div>

        <form id="contact-form" class="bg-white dark:bg-[#1e2327] border border-gray-300 dark:border-gray-700 rounded-md p-4 sm:p-6 shadow-xs">
          <div id="contact-fields" class="space-y-4">
            <p class="text-sm text-gray-400">Chargement…</p>
          </div>

          <div class="mt-6 pt-5 border-t border-gray-100 dark:border-gray-800 flex items-center gap-3">
            <button
              type="submit"
              id="contact-save-btn"
              disabled
              class="px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-xs transition cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-indigo-600"
            >
              Enregistrer
            </button>
            <button
              type="button"
              id="contact-cancel-btn"
              disabled
              class="px-4 py-2 rounded-md border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 text-xs font-medium hover:bg-gray-100 dark:hover:bg-gray-700 transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent"
            >
              Annuler
            </button>
            <p id="contact-save-status" class="text-xs text-gray-500 dark:text-gray-400" aria-live="polite"></p>
          </div>
        </form>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>
</Layout>

<script>
  const fieldsContainer = document.getElementById("contact-fields");
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const saveBtn = document.getElementById("contact-save-btn") as HTMLButtonElement | null;
  const cancelBtn = document.getElementById("contact-cancel-btn") as HTMLButtonElement | null;
  const saveStatus = document.getElementById("contact-save-status");
  const errorEl = document.getElementById("contact-error");

  let csrfToken = "";
  let isDirty = false;
  let savedSnapshot = "";

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove("hidden");
  }
  function clearError() {
    errorEl?.classList.add("hidden");
  }

  function formSnapshot(): string {
    if (!form) return "";
    const values: Record<string, string> = {};
    for (const input of Array.from(form.querySelectorAll("input"))) values[input.name] = input.value;
    return JSON.stringify(values);
  }

  function markDirty() {
    isDirty = formSnapshot() !== savedSnapshot;
    if (saveBtn) saveBtn.disabled = !isDirty;
    if (cancelBtn) cancelBtn.disabled = !isDirty;
    if (!saveStatus) return;
    if (isDirty && saveStatus.dataset.state !== "saving") {
      saveStatus.textContent = "Modifications non enregistrées";
      saveStatus.dataset.state = "dirty";
    } else if (!isDirty) {
      saveStatus.textContent = "";
      saveStatus.dataset.state = "";
    }
  }

  // Restaure les champs à leur dernière valeur enregistrée, sans requête réseau.
  function restoreSavedSnapshot() {
    if (!form || !savedSnapshot) return;
    const values = JSON.parse(savedSnapshot) as Record<string, string>;
    for (const input of Array.from(form.querySelectorAll("input"))) {
      if (input.name in values) input.value = values[input.name];
    }
    clearError();
    markDirty();
  }

  cancelBtn?.addEventListener("click", restoreSavedSnapshot);

  window.addEventListener("beforeunload", (e) => {
    if (!isDirty) return;
    e.preventDefault();
    e.returnValue = "";
  });

  async function loadFields() {
    const [contactRes, authRes] = await Promise.all([fetch("/api/admin/contact"), fetch("/api/admin/auth")]);
    const contactData = await contactRes.json();
    const authData = await authRes.json();
    csrfToken = authData.csrfToken || "";

    if (!contactRes.ok) {
      if (fieldsContainer) fieldsContainer.innerHTML = `<p class="text-sm text-rose-500">${contactData.error}</p>`;
      return;
    }
    if (!fieldsContainer) return;

    fieldsContainer.innerHTML = contactData.fields
      .map((f: any) => {
        const value = contactData.values[f.key];
        const type = f.key === "email" ? "email" : "text";
        return `
          <div>
            <label class="field-label">${f.label}</label>
            <input type="${type}" class="field-input" name="${f.key}" value="${String(value ?? "")}" aria-label="${f.label}" />
          </div>
        `;
      })
      .join("");

    savedSnapshot = formSnapshot();
    isDirty = false;
    if (saveBtn) saveBtn.disabled = true;
    fieldsContainer.addEventListener("input", markDirty);
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!saveBtn || !form || !saveStatus) return;
    saveBtn.disabled = true;
    saveStatus.dataset.state = "saving";
    saveStatus.textContent = "Enregistrement…";
    clearError();

    const values: Record<string, string> = {};
    for (const input of Array.from(form.querySelectorAll("input"))) values[input.name] = input.value;

    try {
      const res = await fetch("/api/admin/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify({ values }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Erreur lors de l'enregistrement.");
      savedSnapshot = formSnapshot();
      isDirty = false;
      saveStatus.dataset.state = "saved";
      saveStatus.textContent = "Enregistré ✓";
      window.setTimeout(() => {
        if (saveStatus.dataset.state === "saved") {
          saveStatus.textContent = "";
          saveStatus.dataset.state = "";
        }
      }, 3000);
    } catch (err: any) {
      saveStatus.textContent = "";
      saveStatus.dataset.state = "";
      saveBtn.disabled = false;
      showError(err.message);
    }
  });

  loadFields();
</script>
