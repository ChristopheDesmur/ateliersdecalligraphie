---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminNav from "@/components/admin/AdminNav.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";

const { session } = authenticateRequest(Astro.request);
---
<Layout title="Administration — Tarifs" noindex={true}>
  <div class="max-w-3xl">
    {session ? (
      <div>
        <AdminNav active="prices" />
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-5">Tarifs</h1>

        <div id="prices-error" class="hidden mb-4 p-3 rounded-md text-xs font-medium bg-rose-50 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800" role="alert"></div>

        <form id="prices-form" class="bg-white dark:bg-[#1e2327] border border-gray-300 dark:border-gray-700 rounded-md p-5 sm:p-6 shadow-xs">
          <div id="prices-fields" class="space-y-6">
            <p class="text-sm text-gray-400">Chargement…</p>
          </div>

          <div class="mt-6 pt-5 border-t border-gray-100 dark:border-gray-800 flex items-center gap-3">
            <button
              type="submit"
              id="prices-save-btn"
              disabled
              class="px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-xs transition cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-indigo-600"
            >
              Enregistrer
            </button>
            <button
              type="button"
              id="prices-cancel-btn"
              disabled
              class="px-4 py-2 rounded-md border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 text-xs font-medium hover:bg-gray-100 dark:hover:bg-gray-700 transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent"
            >
              Annuler
            </button>
            <p id="prices-save-status" class="text-xs text-gray-500 dark:text-gray-400" aria-live="polite"></p>
          </div>
        </form>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>
</Layout>

<style>
  :global(.myk-num) {
    width: 100%;
    padding: 0.4rem 0.65rem;
    border-radius: 0.375rem;
    border: 1px solid #c3c4c7;
    background: white;
    color: #2c3338;
    font-size: 0.875rem;
  }
  :global(.dark .myk-num) {
    border-color: #3f444e;
    background: #1a1d21;
    color: #f0f0f1;
  }
  :global(.myk-num:focus) {
    outline: none;
    box-shadow: 0 0 0 1px #4f46e5;
    border-color: #4f46e5;
  }
  :global(.dark .myk-num:focus) {
    box-shadow: 0 0 0 1px #6366f1;
    border-color: #6366f1;
  }
</style>

<script>
  const fieldsContainer = document.getElementById("prices-fields");
  const form = document.getElementById("prices-form") as HTMLFormElement | null;
  const saveBtn = document.getElementById("prices-save-btn") as HTMLButtonElement | null;
  const cancelBtn = document.getElementById("prices-cancel-btn") as HTMLButtonElement | null;
  const saveStatus = document.getElementById("prices-save-status");
  const errorEl = document.getElementById("prices-error");

  let csrfToken = "";
  let isDirty = false;
  let savedSnapshot = "";

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove("hidden");
  }

  function clearError() {
    errorEl?.classList.add("hidden");
  }

  function formSnapshot(): string {
    if (!form) return "";
    const values: Record<string, string> = {};
    for (const input of Array.from(form.querySelectorAll("input"))) {
      values[input.name] = input.value;
    }
    return JSON.stringify(values);
  }

  function markDirty() {
    isDirty = formSnapshot() !== savedSnapshot;
    if (saveBtn) saveBtn.disabled = !isDirty;
    if (cancelBtn) cancelBtn.disabled = !isDirty;
    if (!saveStatus) return;
    if (isDirty && saveStatus.dataset.state !== "saving") {
      saveStatus.textContent = "Modifications non enregistrées";
      saveStatus.dataset.state = "dirty";
    } else if (!isDirty) {
      saveStatus.textContent = "";
      saveStatus.dataset.state = "";
    }
  }

  // Restaure les champs à leur dernière valeur enregistrée, sans requête réseau.
  // Déclenche un événement "input" (plutôt que markDirty() en direct) pour que
  // l'aperçu du prix net à domicile, mis à jour via le même événement délégué
  // sur fieldsContainer, se recalcule aussi.
  function restoreSavedSnapshot() {
    if (!form || !savedSnapshot) return;
    const values = JSON.parse(savedSnapshot) as Record<string, string>;
    for (const input of Array.from(form.querySelectorAll("input"))) {
      if (input.name in values) input.value = values[input.name];
      input.dispatchEvent(new Event("input", { bubbles: true }));
    }
    clearError();
  }

  cancelBtn?.addEventListener("click", restoreSavedSnapshot);

  window.addEventListener("beforeunload", (e) => {
    if (!isDirty) return;
    e.preventDefault();
    e.returnValue = "";
  });

  function numberField(nameKey: string, value: unknown, ariaLabel: string, unit?: string, disabled = false) {
    const disabledAttr = disabled ? "disabled" : "";
    const unitHtml = unit ? `<span class="text-xs text-gray-500 dark:text-gray-400 shrink-0" aria-hidden="true">${unit}</span>` : "";
    return `<div class="flex items-center gap-1.5"><input type="number" step="1" inputmode="numeric" class="myk-num" name="${nameKey}" value="${String(value ?? "")}" aria-label="${ariaLabel}" ${disabledAttr} />${unitHtml}</div>`;
  }

  async function loadFields() {
    const [pricesRes, authRes] = await Promise.all([fetch("/api/admin/prices"), fetch("/api/admin/auth")]);
    const pricesData = await pricesRes.json();
    const authData = await authRes.json();
    csrfToken = authData.csrfToken || "";

    if (!pricesRes.ok) {
      if (fieldsContainer) fieldsContainer.innerHTML = `<p class="text-sm text-rose-500">${pricesData.error}</p>`;
      return;
    }
    if (!fieldsContainer) return;

    const values = pricesData.values as Record<string, unknown>;
    const byGroup: Record<string, any[]> = {};
    const groupOrder: string[] = [];
    for (const field of pricesData.fields) {
      const group = field.group || "Général";
      if (!byGroup[group]) {
        byGroup[group] = [];
        groupOrder.push(group);
      }
      byGroup[group].push(field);
    }

    const sectionHeader = (title: string) =>
      `<h2 class="text-xs font-bold uppercase tracking-wider text-indigo-700 dark:text-indigo-400 mb-2.5">${title}</h2>`;

    // "Cours collectifs" et "Interventions" sont deux paires de champs
    // associés : affichés côte à côte sur desktop, empilés sur mobile.
    function pairedGrid(fields: any[]) {
      const cells = fields
        .map((f) => {
          const key = f.path.join(".");
          return `<div><label class="field-label">${f.label}</label>${numberField(key, values[key], f.label, f.unit)}</div>`;
        })
        .join("");
      return `<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">${cells}</div>`;
    }

    const coursCollectifsSection = byGroup["Cours collectifs"]
      ? `<div>${sectionHeader("Cours collectifs")}${pairedGrid(byGroup["Cours collectifs"])}</div>`
      : "";

    const interventionsSection = byGroup["Interventions"]
      ? `<div class="pt-5 border-t border-gray-100 dark:border-gray-800">${sectionHeader("Interventions")}${pairedGrid(byGroup["Interventions"])}</div>`
      : "";

    // "Cours individuel à domicile" : le prix réel s'édite, la réduction
    // d'impôt est un fait fixe affiché en simple texte (pas un champ
    // désactivé qui ressemblerait à un contrôle cassé), et le prix net
    // affiché au public est mis en avant, clairement calculé.
    const domicileFields = byGroup["Cours individuel à domicile"] || [];
    const ttcField = domicileFields.find((f) => f.path[1] === "ttc_heure");
    const pctField = domicileFields.find((f) => f.path[1] === "reduction_impot_pct");
    const ttcKey = ttcField?.path.join(".");
    const pctValue = pctField ? Number(values[pctField.path.join(".")]) : 50;

    const domicileSection = ttcField
      ? `
      <div class="pt-5 border-t border-gray-100 dark:border-gray-800">
        ${sectionHeader("Cours individuel à domicile")}
        <div class="max-w-[12rem]">
          <label class="field-label">${ttcField.label}</label>
          ${numberField(ttcKey!, values[ttcKey!], ttcField.label, ttcField.unit)}
        </div>
        <div class="mt-3 flex items-center justify-between text-sm">
          <span class="text-gray-500 dark:text-gray-400">Réduction d'impôt</span>
          <span class="text-gray-700 dark:text-gray-300">${pctValue}&nbsp;% <span class="text-xs text-gray-400 dark:text-gray-500">(fixe)</span></span>
        </div>
        <div class="mt-3 pt-3 border-t border-dashed border-gray-200 dark:border-gray-700">
          <p class="text-xs text-gray-500 dark:text-gray-400">Prix affiché au public après réduction d'impôt</p>
          <p class="text-lg font-serif font-bold text-gray-900 dark:text-white"><span id="net-price-preview"></span> / heure</p>
        </div>
      </div>
    `
      : "";

    const galerieFields = byGroup["Galerie"] || [];
    const galerieSection = galerieFields.length
      ? `
      <div class="pt-5 border-t border-gray-100 dark:border-gray-800">
        ${sectionHeader("Galerie")}
        ${galerieFields
          .map((f) => {
            const key = f.path.join(".");
            return `<div><label class="field-label">${f.label}</label><input type="text" class="myk-num" name="${key}" value="${String(values[key] ?? "")}" aria-label="${f.label}" /></div>`;
          })
          .join("")}
      </div>
    `
      : "";

    fieldsContainer.innerHTML = coursCollectifsSection + domicileSection + interventionsSection + galerieSection;

    function updateNetPricePreview() {
      const ttcInput = form?.querySelector<HTMLInputElement>(`input[name="${ttcKey}"]`);
      const preview = document.getElementById("net-price-preview");
      if (!ttcInput || !preview) return;
      const ttc = Number(ttcInput.value);
      preview.textContent = Number.isFinite(ttc) ? `${Math.round(ttc * (1 - pctValue / 100))} €` : "—";
    }

    form?.querySelector(`input[name="${ttcKey}"]`)?.addEventListener("input", updateNetPricePreview);
    updateNetPricePreview();

    savedSnapshot = formSnapshot();
    isDirty = false;
    if (saveBtn) saveBtn.disabled = true;
    fieldsContainer.addEventListener("input", () => {
      updateNetPricePreview();
      markDirty();
    });
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!saveBtn || !form || !saveStatus) return;
    saveBtn.disabled = true;
    saveStatus.dataset.state = "saving";
    saveStatus.textContent = "Enregistrement…";
    clearError();

    const values: Record<string, string> = {};
    for (const input of Array.from(form.querySelectorAll("input"))) {
      values[input.name] = input.value;
    }

    try {
      const res = await fetch("/api/admin/prices", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify({ values }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Erreur lors de l'enregistrement.");
      savedSnapshot = formSnapshot();
      isDirty = false;
      saveStatus.dataset.state = "saved";
      saveStatus.textContent = "Enregistré ✓";
      window.setTimeout(() => {
        if (saveStatus.dataset.state === "saved") {
          saveStatus.textContent = "";
          saveStatus.dataset.state = "";
        }
      }, 3000);
    } catch (err: any) {
      saveStatus.textContent = "";
      saveStatus.dataset.state = "";
      saveBtn.disabled = false;
      showError(err.message);
    }
  });

  loadFields();
</script>
