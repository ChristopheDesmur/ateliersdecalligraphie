---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import AdminPanel from "@/components/admin/AdminPanel.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";
import { getDashboardData } from "@/lib/admin/dashboard";

const { session } = authenticateRequest(Astro.request);

const dashboard = getDashboardData();

---
<Layout title="Tableau de bord — Administration" noindex={true}>
  <div>
    {session ? (
      <div class="space-y-4">
        <AdminPageHeader
          title="Tableau de bord"
          description="Vue d'ensemble et état opérationnel du site."
          active="dashboard"
          breadcrumbs={false}
        >
          <div slot="actions" class="flex items-center gap-2">
            <button
              id="astro-toggle-welcome-btn"
              type="button"
              class="astro-btn text-xs hidden sm:inline-flex"
              title="Afficher ou masquer le panneau de bienvenue"
            >
              Panneau de bienvenue
            </button>
            <a href="/admin/analytics" class="astro-btn text-xs">
              <span>Audience</span>
              <span class="font-mono text-[10px]" aria-hidden="true">↗</span>
            </a>
            <a href="/" target="_blank" rel="noopener noreferrer" class="astro-btn astro-btn-primary text-xs">
              <span>Voir le site</span>
              <span class="font-mono text-[10px]" aria-hidden="true">↗</span>
            </a>
          </div>
        </AdminPageHeader>

        <!-- 1. Astro Welcome Panel (Collapsible / Dismissible) -->
        <div
          id="astro-welcome-panel"
          class="astro-panel p-4 sm:p-5 bg-white dark:bg-[#1a1e22] border-l-4 border-l-[#2271b1] relative transition-all"
        >
          <button
            id="astro-dismiss-welcome-btn"
            type="button"
            class="absolute top-3 right-3 text-[#646970] hover:text-[#1d2327] dark:text-[#8c8f94] dark:hover:text-white p-1 text-xs transition cursor-pointer"
            aria-label="Fermer le panneau de bienvenue"
            title="Masquer ce panneau"
          >
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <div class="max-w-5xl">
            <h2 class="text-base font-semibold text-[#1d2327] dark:text-white mb-1">
              Bienvenue dans votre tableau de bord Astro
            </h2>
            <p class="text-xs text-[#646970] dark:text-[#8c8f94] mb-4 leading-relaxed">
              Nous avons rassemblé les métriques clés, les contenus à traiter et les raccourcis prioritaires pour administrer facilement le site.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-t border-[#f0f0f1] dark:border-[#242a2f] text-xs">
              <!-- Colonne 1 : Pour commencer -->
              <div class="space-y-2">
                <h3 class="font-semibold text-[#1d2327] dark:text-white text-xs uppercase tracking-wider text-[11px]">
                  Pour commencer
                </h3>
                <p class="text-[11px] text-[#646970] dark:text-[#8c8f94]">
                  Mettez à jour la vitrine principale ou vérifiez l'affichage public.
                </p>
                <div class="pt-1 flex flex-col gap-1.5 items-start">
                  <a href="/admin/hero" class="astro-btn astro-btn-primary text-xs">
                    Modifier le Hero d'accueil
                  </a>
                  <a href="/" target="_blank" rel="noopener noreferrer" class="text-[#2271b1] dark:text-[#72aee6] hover:underline text-xs flex items-center gap-1">
                    <span>Visiter le site en direct</span>
                    <span aria-hidden="true" class="text-[10px]">↗</span>
                  </a>
                </div>
              </div>

              <!-- Colonne 2 : Prochaines étapes -->
              <div class="space-y-2">
                <h3 class="font-semibold text-[#1d2327] dark:text-white text-xs uppercase tracking-wider text-[11px]">
                  Prochaines étapes
                </h3>
                <ul class="space-y-1.5 text-xs">
                  <li>
                    <a href="/admin/events" class="text-[#2271b1] dark:text-[#72aee6] hover:underline flex items-center gap-1.5">
                      <span class="text-[#2271b1] dark:text-[#72aee6] font-bold">+</span>
                      <span>Planifier un événement ou stage</span>
                    </a>
                  </li>
                  <li>
                    <a href="/admin/products" class="text-[#2271b1] dark:text-[#72aee6] hover:underline flex items-center gap-1.5">
                      <span class="text-[#2271b1] dark:text-[#72aee6] font-bold">+</span>
                      <span>Ajouter une œuvre dans la galerie</span>
                    </a>
                  </li>
                  <li>
                    <a href="/admin/prices" class="text-[#2271b1] dark:text-[#72aee6] hover:underline flex items-center gap-1.5">
                      <span class="text-[#8c8f94] dark:text-[#646970]">✎</span>
                      <span>Ajuster les tarifs des cours</span>
                    </a>
                  </li>
                </ul>
              </div>

              <!-- Colonne 3 : Plus d'actions -->
              <div class="space-y-2">
                <h3 class="font-semibold text-[#1d2327] dark:text-white text-xs uppercase tracking-wider text-[11px]">
                  Plus d'actions
                </h3>
                <ul class="space-y-1.5 text-xs">
                  <li>
                    <a href="/admin/faq" class="text-[#2271b1] dark:text-[#72aee6] hover:underline">
                      Gérer la foire aux questions (FAQ)
                    </a>
                  </li>
                  <li>
                    <a href="/admin/institutions" class="text-[#2271b1] dark:text-[#72aee6] hover:underline">
                      Administrer les institutions partenaires
                    </a>
                  </li>
                  <li>
                    <a href="/admin/contact" class="text-[#2271b1] dark:text-[#72aee6] hover:underline">
                      Vérifier les coordonnées de contact
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Vue d'ensemble : Cartes de statistiques clés (4 à 8 métriques réelles) -->
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-[#646970] dark:text-[#8c8f94] mb-2 select-none">
            Vue d'ensemble
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 sm:gap-3">
            {dashboard.summaryMetrics.map((metric) => (
              <a
                href={metric.href}
                class="astro-panel p-3 bg-white dark:bg-[#1a1e22] hover:border-[#2271b1] dark:hover:border-[#72aee6] transition flex flex-col justify-between group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#2271b1] cursor-pointer"
              >
                <div>
                  <div class="flex items-baseline justify-between gap-1">
                    <span class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#1d2327] dark:text-white group-hover:text-[#2271b1] dark:group-hover:text-[#72aee6] transition font-sans">
                      {metric.count}
                    </span>
                    {metric.badge && (
                      <span class={`astro-badge ${
                        metric.badge.variant === "success"
                          ? "astro-badge-success"
                          : metric.badge.variant === "warning"
                            ? "bg-[#fcf0db] text-[#996800] border-[#996800]/20"
                            : "astro-badge-info"
                      } text-[10px] scale-90 origin-right`}>
                        {metric.badge.text}
                      </span>
                    )}
                  </div>
                  <div class="text-xs font-medium text-[#2c3338] dark:text-[#dcdcde] mt-1 group-hover:text-[#2271b1] dark:group-hover:text-[#72aee6] transition truncate">
                    {metric.label}
                  </div>
                </div>
                {metric.hint && (
                  <div class="text-[11px] text-[#646970] dark:text-[#8c8f94] mt-2 pt-1.5 border-t border-[#f0f0f1] dark:border-[#242a2f] truncate flex items-center justify-between">
                    <span>{metric.hint}</span>
                    <span class="opacity-0 group-hover:opacity-100 transition text-[#2271b1] dark:text-[#72aee6] text-[10px]" aria-hidden="true">→</span>
                  </div>
                )}
              </a>
            ))}
          </div>
        </div>

        <!-- 3. Grille responsive des widgets opérationnels -->
        <!-- Desktop : 3 colonnes (2 colonnes gauche / 1 colonne droite) -->
        <!-- Mobile : Ordre : Vue d'ensemble -> Trafic -> À traiter -> Actions rapides -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

          <!-- Widget 0 : ÉVOLUTION DU TRAFIC (30 JOURS) -->
          <div class="lg:col-span-3">
            <AdminPanel
              id="widget-traffic-chart"
              title="Évolution du trafic (visiteurs et pages vues)"
              description="Audience des 30 derniers jours (Vercel Web Analytics)."
              collapsible={true}
            >
              <div slot="header-actions" class="flex items-center gap-3 text-xs">
                <div class="hidden sm:flex items-center gap-3">
                  <span class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-xs bg-[#2271b1] dark:bg-[#72aee6]"></span>
                    <span class="text-[#646970] dark:text-[#8c8f94]">Pages vues</span>
                  </span>
                  <span class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-xs bg-[#c3c4c7] dark:bg-[#50575e]"></span>
                    <span class="text-[#646970] dark:text-[#8c8f94]">Visiteurs</span>
                  </span>
                </div>
                <a href="/admin/analytics" class="text-xs text-[#2271b1] dark:text-[#72aee6] hover:underline font-medium flex items-center gap-1">
                  <span>Rapport détaillé</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>

              <!-- Notice si non configuré / erreur -->
              <div id="dash-analytics-notice" class="hidden p-2.5 mb-3 rounded-xs text-xs font-medium" role="alert"></div>

              <!-- Résumé 4 métriques 30 jours -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4 pb-3 border-b border-[#f0f0f1] dark:border-[#242a2f] text-xs">
                <div>
                  <span class="text-[11px] text-[#646970] dark:text-[#8c8f94] uppercase tracking-wider block font-medium">Visiteurs (30j)</span>
                  <span id="dash-analytics-visitors" class="text-lg font-bold text-[#1d2327] dark:text-white font-mono">—</span>
                </div>
                <div>
                  <span class="text-[11px] text-[#646970] dark:text-[#8c8f94] uppercase tracking-wider block font-medium">Pages vues (30j)</span>
                  <span id="dash-analytics-views" class="text-lg font-bold text-[#2271b1] dark:text-[#72aee6] font-mono">—</span>
                </div>
                <div>
                  <span class="text-[11px] text-[#646970] dark:text-[#8c8f94] uppercase tracking-wider block font-medium">Pages / Visiteur</span>
                  <span id="dash-analytics-ratio" class="text-lg font-bold text-[#1d2327] dark:text-white font-mono">—</span>
                </div>
                <div>
                  <span class="text-[11px] text-[#646970] dark:text-[#8c8f94] uppercase tracking-wider block font-medium">Moyenne / jour</span>
                  <span id="dash-analytics-daily" class="text-lg font-bold text-[#1d2327] dark:text-white font-mono">—</span>
                </div>
              </div>

              <!-- Graphique des 30 jours -->
              <div id="dash-chart-container" class="h-36 sm:h-44 w-full flex items-end gap-1 sm:gap-1.5 pt-4 pb-1 relative">
                <div class="text-xs text-[#8c8f94] text-center w-full my-auto">Chargement du trafic…</div>
              </div>
              <div id="dash-chart-dates" class="flex justify-between text-[10px] text-[#8c8f94] font-mono pt-2 border-t border-[#f0f0f1] dark:border-[#242a2f]"></div>
            </AdminPanel>
          </div>

          <!-- Widget A : À TRAITER (Items needing attention) -->
          <!-- Desktop: col 1-2, row 1 | Mobile: ordre 2 -->
          <div class="lg:col-span-2 lg:col-start-1">
            <AdminPanel
              id="widget-pending"
              title="À traiter"
              description="Points d'attention et éléments nécessitant une action ou vérification."
              collapsible={true}
            >
              <div slot="header-actions">
                {dashboard.pendingItems.length > 0 ? (
                  <span class="astro-badge bg-[#fcf0db] text-[#996800] border-[#996800]/20 text-[11px]">
                    {dashboard.pendingItems.length} élément{dashboard.pendingItems.length > 1 ? "s" : ""}
                  </span>
                ) : (
                  <span class="astro-badge astro-badge-success text-[11px]">À jour</span>
                )}
              </div>

              {dashboard.pendingItems.length > 0 ? (
                <ul class="divide-y divide-[#f0f0f1] dark:divide-[#242a2f] text-xs">
                  {dashboard.pendingItems.map((item) => (
                    <li class="py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                      <div class="min-w-0">
                        <div class="flex items-center gap-2">
                          <span class="font-medium text-[#1d2327] dark:text-white">
                            {item.title}
                          </span>
                          <span class={`astro-badge ${
                            item.severity === "warning"
                              ? "bg-[#fcf0db] text-[#996800] border-[#996800]/20"
                              : item.severity === "info"
                                ? "astro-badge-info"
                                : "astro-badge-muted"
                          } text-[10px]`}>
                            {item.count}
                          </span>
                        </div>
                        <p class="text-xs text-[#646970] dark:text-[#8c8f94] mt-0.5">
                          {item.description}
                        </p>
                      </div>
                      <div class="shrink-0 self-start sm:self-center">
                        <a href={item.href} class="astro-btn text-xs py-1">
                          {item.actionLabel}
                        </a>
                      </div>
                    </li>
                  ))}
                </ul>
              ) : (
                <div class="py-4 text-center text-xs text-[#646970] dark:text-[#8c8f94] space-y-1">
                  <div class="text-[#00a32a] text-base" aria-hidden="true">✓</div>
                  <p class="font-medium text-[#1d2327] dark:text-white">
                    Tous les contenus sont à jour
                  </p>
                  <p class="text-[11px]">
                    Aucune action en attente ou élément incomplet détecté.
                  </p>
                </div>
              )}
            </AdminPanel>
          </div>

          <!-- Widget B : ACTIONS RAPIDES -->
          <div class="lg:col-span-1">
            <AdminPanel
              id="widget-quickactions"
              title="Actions rapides"
              description="Raccourcis de création et d'édition fréquents."
              collapsible={true}
            >
              <div class="space-y-2">
                {dashboard.quickActions.map((action) => (
                  <a
                    href={action.href}
                    class={`block p-2 border transition rounded-none text-xs group ${
                      action.isPrimary
                        ? "border-[#2271b1] bg-[#f0f6fc] dark:bg-[#162a3e] hover:bg-[#e7f1fb]"
                        : "border-[#dcdcde] dark:border-[#242a2f] bg-white dark:bg-[#1a1e22] hover:bg-[#f6f7f7] dark:hover:bg-[#20252a]"
                    }`}
                  >
                    <div class="font-medium text-[#1d2327] dark:text-white group-hover:text-[#2271b1] dark:group-hover:text-[#72aee6] flex items-center justify-between">
                      <span>{action.label}</span>
                      <span class="text-[#2271b1] dark:text-[#72aee6] text-[11px]" aria-hidden="true">→</span>
                    </div>
                    <p class="text-[11px] text-[#646970] dark:text-[#8c8f94] mt-0.5 leading-snug">
                      {action.description}
                    </p>
                  </a>
                ))}
              </div>
            </AdminPanel>
          </div>


        </div>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>

  <script is:inline>
    // Gestion du panneau de bienvenue Astro (masquer / afficher / persistance)
    (function () {
      const welcomePanel = document.getElementById("astro-welcome-panel");
      const dismissBtn = document.getElementById("astro-dismiss-welcome-btn");
      const toggleBtn = document.getElementById("astro-toggle-welcome-btn");

      if (!welcomePanel) return;

      const STORAGE_KEY = "wp_dashboard_welcome_dismissed";

      function updateVisibility(hidden) {
        if (hidden) {
          welcomePanel.classList.add("hidden");
          if (toggleBtn) toggleBtn.classList.remove("astro-btn-primary");
        } else {
          welcomePanel.classList.remove("hidden");
          if (toggleBtn) toggleBtn.classList.add("astro-btn-primary");
        }
      }

      const isDismissed = localStorage.getItem(STORAGE_KEY) === "1";
      if (isDismissed) {
        updateVisibility(true);
      }

      if (dismissBtn) {
        dismissBtn.addEventListener("click", () => {
          localStorage.setItem(STORAGE_KEY, "1");
          updateVisibility(true);
        });
      }

      if (toggleBtn) {
        toggleBtn.addEventListener("click", () => {
          const currentlyHidden = welcomePanel.classList.contains("hidden");
          const willHide = !currentlyHidden;
          if (willHide) {
            localStorage.setItem(STORAGE_KEY, "1");
          } else {
            localStorage.removeItem(STORAGE_KEY);
          }
          updateVisibility(willHide);
        });
      }

      // Gestion des panneaux repliables (collapsible widgets)
      const COLLAPSED_STORAGE_KEY = "wp_dashboard_collapsed_panels";
      let collapsedPanels = [];
      try {
        collapsedPanels = JSON.parse(localStorage.getItem(COLLAPSED_STORAGE_KEY) || "[]");
      } catch (e) {
        collapsedPanels = [];
      }

      const panels = document.querySelectorAll(".astro-panel.is-collapsible");
      panels.forEach((panel) => {
        const panelId = panel.id;
        const toggle = panel.querySelector(".astro-panel-toggle");
        const body = panel.querySelector(".astro-panel-body");
        const footer = panel.querySelector(".astro-panel-footer");
        const svg = toggle?.querySelector("svg");

        if (!toggle || !body) return;

        function setCollapsed(collapsed) {
          if (collapsed) {
            body.classList.add("hidden");
            if (footer) footer.classList.add("hidden");
            toggle.setAttribute("aria-expanded", "false");
            if (svg) svg.classList.remove("rotate-180");
          } else {
            body.classList.remove("hidden");
            if (footer) footer.classList.remove("hidden");
            toggle.setAttribute("aria-expanded", "true");
            if (svg) svg.classList.add("rotate-180");
          }
        }

        // Restaurer l'état sauvegardé
        if (panelId && collapsedPanels.includes(panelId)) {
          setCollapsed(true);
        }

        toggle.addEventListener("click", (e) => {
          e.stopPropagation();
          const isCurrentlyCollapsed = body.classList.contains("hidden");
          const willCollapse = !isCurrentlyCollapsed;
          setCollapsed(willCollapse);

          if (panelId) {
            if (willCollapse) {
              if (!collapsedPanels.includes(panelId)) collapsedPanels.push(panelId);
            } else {
              collapsedPanels = collapsedPanels.filter((id) => id !== panelId);
            }
            try {
              localStorage.setItem(COLLAPSED_STORAGE_KEY, JSON.stringify(collapsedPanels));
            } catch (err) {}
          }
        });
      });
    })();
  </script>

  <script is:inline>
    (function () {
      const noticeEl = document.getElementById("dash-analytics-notice");
      const visitorsEl = document.getElementById("dash-analytics-visitors");
      const viewsEl = document.getElementById("dash-analytics-views");
      const ratioEl = document.getElementById("dash-analytics-ratio");
      const dailyEl = document.getElementById("dash-analytics-daily");
      const chartContainer = document.getElementById("dash-chart-container");
      const chartDates = document.getElementById("dash-chart-dates");

      if (!chartContainer) return;

      function formatNumber(n) {
        return new Intl.NumberFormat("fr-FR").format(n || 0);
      }

      function formatDateLabel(isoDate) {
        const d = new Date(isoDate);
        if (isNaN(d.getTime())) return isoDate;
        return d.toLocaleDateString("fr-FR", { day: "2-digit", month: "short" });
      }

      function setNotice(message, type) {
        if (!noticeEl) return;
        if (!message) {
          noticeEl.classList.add("hidden");
          return;
        }
        noticeEl.className =
          "p-2.5 mb-3 rounded-xs text-xs font-medium border " +
          (type === "error"
            ? "bg-rose-50 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border-rose-200 dark:border-rose-800"
            : "bg-amber-50 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border-amber-200 dark:border-amber-800");
        noticeEl.textContent = message;
        noticeEl.classList.remove("hidden");
      }

      function renderTimeseries(timeseries) {
        if (!chartContainer) return;
        if (!timeseries || timeseries.length === 0) {
          chartContainer.innerHTML =
            '<div class="text-xs text-[#8c8f94] text-center w-full my-auto">Aucune donnée de trafic sur les 30 derniers jours.</div>';
          if (chartDates) chartDates.innerHTML = "";
          return;
        }

        const maxViews = Math.max(...timeseries.map((item) => Number(item.pageviews || 0)), 1);

        chartContainer.innerHTML = "";
        timeseries.forEach((item) => {
          const views = Number(item.pageviews || 0);
          const visitors = Number(item.visitors || 0);
          const viewsHeightPercent = Math.max((views / maxViews) * 100, 4);
          const visitorsHeightPercent = Math.max((visitors / maxViews) * 100, 2);
          const dateStr = formatDateLabel(item.key);

          const col = document.createElement("div");
          col.className = "flex-1 flex flex-col justify-end items-center h-full group relative cursor-pointer";

          col.innerHTML = `
            <div class="w-full flex items-end justify-center gap-0.5 h-full">
              <div style="height: ${visitorsHeightPercent}%;" class="w-full max-w-[8px] bg-[#c3c4c7] dark:bg-[#50575e] group-hover:bg-gray-400 dark:group-hover:bg-gray-300 rounded-t-xs transition-all"></div>
              <div style="height: ${viewsHeightPercent}%;" class="w-full max-w-[8px] bg-[#2271b1] dark:bg-[#72aee6] group-hover:bg-[#135e96] dark:group-hover:bg-[#9ec5f0] rounded-t-xs transition-all"></div>
            </div>
            <div class="hidden group-hover:block absolute bottom-full mb-2 z-20 px-2 py-1 rounded-xs bg-[#1d2327] text-white text-[11px] font-mono whitespace-nowrap shadow-lg pointer-events-none">
              <div class="font-semibold text-gray-200">${dateStr}</div>
              <div class="text-[#72aee6] font-medium">${formatNumber(views)} vues</div>
              <div class="text-gray-300">${formatNumber(visitors)} visiteurs</div>
            </div>
          `;
          chartContainer.appendChild(col);
        });

        if (chartDates) {
          const firstDate = formatDateLabel(timeseries[0].key);
          const lastDate = formatDateLabel(timeseries[timeseries.length - 1].key);
          chartDates.innerHTML = `<span>${firstDate}</span><span>${lastDate}</span>`;
        }
      }

      fetch("/api/admin/analytics?range=30d", { cache: "no-store" })
        .then((r) => r.json())
        .then((data) => {
          if (data.configured === false) {
            setNotice(data.error || "Configuration Vercel Analytics requise.", "warning");
            if (chartContainer) {
              chartContainer.innerHTML =
                '<div class="text-xs text-[#8c8f94] text-center w-full my-auto">Vercel Analytics non configuré (VERCEL_TOKEN manquant).</div>';
            }
            return;
          }
          if (data.error) {
            setNotice(data.error, "error");
            if (chartContainer) {
              chartContainer.innerHTML =
                '<div class="text-xs text-[#8c8f94] text-center w-full my-auto">Erreur lors de la récupération des données d’audience.</div>';
            }
            return;
          }

          const visitors = data.summary?.visitors || 0;
          const pageviews = data.summary?.pageviews || 0;
          const ratio = visitors > 0 ? (pageviews / visitors).toFixed(1) : "0";
          const dailyAvg = (pageviews / 30).toFixed(0);

          if (visitorsEl) visitorsEl.textContent = formatNumber(visitors);
          if (viewsEl) viewsEl.textContent = formatNumber(pageviews);
          if (ratioEl) ratioEl.textContent = ratio;
          if (dailyEl) dailyEl.textContent = formatNumber(dailyAvg);

          renderTimeseries(data.timeseries || []);
        })
        .catch(() => {
          if (chartContainer) {
            chartContainer.innerHTML =
              '<div class="text-xs text-[#8c8f94] text-center w-full my-auto">Impossible de joindre le serveur d’analytics.</div>';
          }
        });
    })();
  </script>
</Layout>
