---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";

const { session } = authenticateRequest(Astro.request);
---
<Layout title="Administration — Institutions" noindex={true}>
  <div>
    {session ? (
      <div>
        <AdminPageHeader
          title="Institutions"
          description="Organismes, institutions et partenaires référencés depuis les événements et pages du site."
          active="institutions"
        >
          <div slot="actions">
            <button
              id="add-institution-btn"
              type="button"
              class="astro-btn astro-btn-primary text-xs"
            >
              + Ajouter une institution
            </button>
          </div>
        </AdminPageHeader>

        <div id="institutions-status" class="hidden mb-4 astro-notice" role="alert"></div>

        <!-- Toolbar / Recherche -->
        <div class="astro-panel p-2.5 mb-3 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 text-xs">
          <div class="flex items-center gap-2 flex-1 min-w-0">
            <label for="institutions-search" class="sr-only">Rechercher une institution</label>
            <input
              type="search"
              id="institutions-search"
              class="field-input max-w-sm text-xs"
              placeholder="Rechercher une institution…"
              autocomplete="off"
            />
          </div>
          <!-- Sélecteur de catégorie compact (mobile uniquement) -->
          <div class="md:hidden">
            <label for="category-select" class="sr-only">Catégorie</label>
            <select id="category-select" class="field-input text-xs"></select>
          </div>
        </div>

        <div class="grid md:grid-cols-[14rem_1fr] gap-4 mb-8 items-start">
          <!-- Navigation par catégorie (desktop uniquement) -->
          <div class="astro-panel p-2">
            <div class="px-2 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700 mb-1">
              Catégories
            </div>
            <nav id="category-nav" class="space-y-0.5 text-xs" aria-label="Catégories d'institutions"></nav>
          </div>

          <!-- Liste des institutions sous forme de tableau Astro -->
          <div class="astro-panel overflow-hidden">
            <div id="panel-header" class="astro-panel-header flex items-center justify-between gap-3 text-xs"></div>
            <div class="astro-table-wrap border-0">
              <table class="astro-table">
                <thead>
                  <tr>
                    <th>Organisme</th>
                    <th class="w-32">Nom court</th>
                    <th class="w-28">Documents</th>
                    <th class="w-24 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="institutions-list">
                  <tr>
                    <td colspan="4" class="p-6 text-center text-xs text-gray-500 dark:text-gray-400">Chargement…</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Formulaire d'ajout / modification (Panel Astro) -->
        <div id="institution-form-container" class="hidden astro-panel mb-8">
          <div class="astro-panel-header">
            <h2 id="institution-form-title" class="astro-panel-title">Ajouter une institution</h2>
          </div>
          <div class="astro-panel-body">
            <form id="institution-form">
              <input type="hidden" name="originalId" value="" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                <div class="sm:col-span-2">
                  <label class="field-label">Nom complet</label>
                  <input name="name" required class="field-input" placeholder="Office villeurbannais des personnes âgées et des retraités" />
                </div>
                <div>
                  <label class="field-label">Nom court affiché dans les liens (facultatif)</label>
                  <input name="short_name" class="field-input" placeholder="OVPAR" />
                </div>
              </div>

              <div class="mt-5 pt-4 border-t border-gray-200 dark:border-gray-700">
                <div class="flex items-center justify-between mb-1.5">
                  <label class="field-label mb-0">Documents associés (brochures, programmes, liens externes)</label>
                  <button type="button" id="add-document-row-btn" class="astro-btn astro-btn-secondary text-xs py-1 px-2.5">
                    + Ajouter un document
                  </button>
                </div>
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">
                  Document référencé depuis un événement en lien avec cette institution.
                </p>
                <div id="documents-rows" class="space-y-2"></div>
              </div>

              <div class="mt-6 pt-4 border-t border-gray-200 dark:border-gray-700 flex items-center gap-2">
                <button type="submit" id="institution-save-btn" class="astro-btn astro-btn-primary">
                  Enregistrer
                </button>
                <button type="button" id="institution-cancel-btn" class="astro-btn astro-btn-secondary">
                  Annuler
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>
</Layout>

<script>
  import { INSTITUTION_CATEGORIES, institutionCategoryFor } from "@/lib/admin/institution-categories";

  let csrfToken = "";
  let institutions: Record<string, any> = {};
  let activeCategory: string = INSTITUTION_CATEGORIES[0].label;
  let confirmingDeleteId: string | null = null;

  const ACTIVE_CATEGORY_KEY = "admin-institutions-active-category";
  const stored = sessionStorage.getItem(ACTIVE_CATEGORY_KEY);
  if (stored && INSTITUTION_CATEGORIES.some((c) => c.label === stored)) activeCategory = stored;

  const listEl = document.getElementById("institutions-list");
  const panelHeaderEl = document.getElementById("panel-header");
  const categoryNavEl = document.getElementById("category-nav");
  const categorySelectEl = document.getElementById("category-select") as HTMLSelectElement | null;
  const statusEl = document.getElementById("institutions-status");
  const searchInput = document.getElementById("institutions-search") as HTMLInputElement | null;
  const formContainer = document.getElementById("institution-form-container");
  const form = document.getElementById("institution-form") as HTMLFormElement | null;
  const formTitle = document.getElementById("institution-form-title");
  const saveBtn = document.getElementById("institution-save-btn") as HTMLButtonElement | null;
  const documentsRows = document.getElementById("documents-rows");

  function normalize(s: string): string {
    return s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  }

  function showStatus(message: string, kind: "success" | "error") {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden");
    statusEl.className =
      "astro-notice mb-4 " +
      (kind === "success" ? "astro-notice-success" : "astro-notice-error");
  }

  function addDocumentRow(key = "", url = "") {
    if (!documentsRows) return;
    const row = document.createElement("div");
    row.className = "flex flex-col sm:flex-row items-stretch sm:items-center gap-2 p-2.5 rounded bg-gray-50 dark:bg-[#1d2327]/60 border border-gray-200 dark:border-gray-700";
    row.innerHTML = `
      <input type="text" class="field-input doc-key sm:w-1/3 text-xs" placeholder="clé (ex. animation_2022)" value="${key}" />
      <input type="text" class="field-input doc-url flex-1 text-xs" placeholder="https://…" value="${url}" />
      <button type="button" class="remove-document-row astro-btn astro-btn-danger text-xs py-1 px-2 shrink-0">Retirer</button>
    `;
    row.querySelector(".remove-document-row")?.addEventListener("click", () => row.remove());
    documentsRows.appendChild(row);
  }

  document.getElementById("add-document-row-btn")?.addEventListener("click", () => addDocumentRow());

  function categoryCounts(): Map<string, number> {
    const counts = new Map<string, number>();
    for (const id of Object.keys(institutions)) {
      const label = institutionCategoryFor(institutions[id].name);
      counts.set(label, (counts.get(label) ?? 0) + 1);
    }
    return counts;
  }

  function renderSidebar() {
    const counts = categoryCounts();
    const searching = Boolean(searchInput?.value.trim());

    if (categoryNavEl) {
      categoryNavEl.innerHTML = INSTITUTION_CATEGORIES.map((c) => {
        const count = counts.get(c.label) ?? 0;
        const active = !searching && c.label === activeCategory;
        return `
          <button
            type="button"
            data-category="${c.label}"
            aria-current="${active ? "true" : "false"}"
            class="w-full text-left px-2.5 py-1.5 rounded text-xs transition cursor-pointer flex items-center justify-between gap-2 ${
              active
                ? "bg-[#2271b1] text-white font-medium shadow-xs"
                : "text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800"
            }"
          >
            <span class="truncate">${c.label}</span>
            <span class="text-[11px] ${active ? "text-white/80" : "text-gray-400 dark:text-gray-500"} shrink-0">${count}</span>
          </button>`;
      }).join("");

      categoryNavEl.querySelectorAll<HTMLButtonElement>("[data-category]").forEach((btn) =>
        btn.addEventListener("click", () => selectCategory(btn.dataset.category!))
      );
    }

    if (categorySelectEl) {
      categorySelectEl.innerHTML = INSTITUTION_CATEGORIES.map((c) => {
        const count = counts.get(c.label) ?? 0;
        return `<option value="${c.label}" ${c.label === activeCategory ? "selected" : ""}>${c.label} (${count})</option>`;
      }).join("");
    }
  }

  function selectCategory(label: string) {
    activeCategory = label;
    sessionStorage.setItem(ACTIVE_CATEGORY_KEY, label);
    if (searchInput) searchInput.value = "";
    confirmingDeleteId = null;
    renderSidebar();
    renderPanel();
  }

  categorySelectEl?.addEventListener("change", () => selectCategory(categorySelectEl.value));

  function institutionRow(id: string, opts: { showCategory?: boolean } = {}): string {
    const inst = institutions[id];
    const docCount = inst.documents ? Object.keys(inst.documents).length : 0;
    const category = opts.showCategory ? institutionCategoryFor(inst.name) : null;

    if (confirmingDeleteId === id) {
      return `
      <tr class="bg-rose-50/70 dark:bg-rose-950/30">
        <td colspan="4" class="p-3">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="text-xs font-semibold text-rose-800 dark:text-rose-200">Supprimer définitivement « ${inst.name} » ?</span>
            <div class="flex items-center gap-2">
              <button type="button" data-cancel-delete="${id}" class="astro-btn astro-btn-secondary text-xs py-1 px-2.5">Annuler</button>
              <button type="button" data-confirm-delete="${id}" class="astro-btn astro-btn-danger text-xs py-1 px-2.5">Confirmer</button>
            </div>
          </div>
        </td>
      </tr>`;
    }

    return `
      <tr class="hover:bg-gray-50/60 dark:hover:bg-gray-800/40 transition-colors">
        <td>
          <div class="font-medium text-gray-900 dark:text-gray-100 text-xs">${inst.name}</div>
          ${category ? `<div class="text-[11px] text-gray-400 dark:text-gray-500 mt-0.5">${category}</div>` : ""}
          <div class="row-actions text-xs mt-1">
            <button type="button" data-edit="${id}" class="text-[#2271b1] hover:underline cursor-pointer">Modifier</button>
            <span class="text-gray-300 dark:text-gray-600">|</span>
            <button type="button" data-delete="${id}" class="text-rose-600 hover:underline cursor-pointer">Supprimer</button>
          </div>
        </td>
        <td class="text-xs text-gray-600 dark:text-gray-400">
          ${inst.short_name ? `<span class="font-mono text-[11px] px-1.5 py-0.5 bg-gray-100 dark:bg-gray-800 rounded border border-gray-200 dark:border-gray-700">${inst.short_name}</span>` : '<span class="text-gray-300 dark:text-gray-600">—</span>'}
        </td>
        <td class="text-xs">
          ${docCount > 0 
            ? `<span class="astro-badge astro-badge-info">${docCount} doc${docCount > 1 ? "s" : ""}</span>` 
            : '<span class="text-gray-400 dark:text-gray-500 text-xs">0</span>'}
        </td>
        <td class="text-right">
          <button type="button" data-edit="${id}" class="astro-btn astro-btn-secondary text-xs py-0.5 px-2">
            Modifier
          </button>
        </td>
      </tr>`;
  }

  function wireRowActions() {
    if (!listEl) return;
    listEl.querySelectorAll<HTMLButtonElement>("[data-edit]").forEach((btn) =>
      btn.addEventListener("click", () => openForm(btn.dataset.edit!, institutions[btn.dataset.edit!]))
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((btn) =>
      btn.addEventListener("click", () => {
        confirmingDeleteId = btn.dataset.delete!;
        renderPanel();
      })
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-cancel-delete]").forEach((btn) =>
      btn.addEventListener("click", () => {
        confirmingDeleteId = null;
        renderPanel();
      })
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-confirm-delete]").forEach((btn) =>
      btn.addEventListener("click", () => deleteInstitution(btn.dataset.confirmDelete!))
    );
  }

  function renderPanel() {
    if (!listEl || !panelHeaderEl) return;
    const query = normalize(searchInput?.value.trim() ?? "");

    if (query) {
      const matchingIds = Object.keys(institutions)
        .filter((id) => {
          const inst = institutions[id];
          return normalize(inst.name).includes(query) || (inst.short_name && normalize(inst.short_name).includes(query));
        })
        .sort((a, b) => institutions[a].name.localeCompare(institutions[b].name, "fr"));

      panelHeaderEl.innerHTML = `
        <span class="font-semibold text-gray-900 dark:text-white">${matchingIds.length} résultat${matchingIds.length === 1 ? "" : "s"} pour « ${searchInput?.value ?? ""} »</span>
        <button id="clear-search-btn" type="button" class="text-xs font-medium text-[#2271b1] hover:underline cursor-pointer">Effacer la recherche</button>
      `;
      document.getElementById("clear-search-btn")?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        renderSidebar();
        renderPanel();
      });

      if (matchingIds.length === 0) {
        listEl.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-xs text-gray-500 dark:text-gray-400">Aucune institution trouvée pour « ${searchInput?.value ?? ""} ».</td></tr>`;
        return;
      }
      listEl.innerHTML = matchingIds.map((id) => institutionRow(id, { showCategory: true })).join("");
      wireRowActions();
      return;
    }

    const ids = Object.keys(institutions)
      .filter((id) => institutionCategoryFor(institutions[id].name) === activeCategory)
      .sort((a, b) => institutions[a].name.localeCompare(institutions[b].name, "fr"));

    panelHeaderEl.innerHTML = `
      <span class="font-semibold text-gray-900 dark:text-white">${activeCategory}</span>
      <span class="text-xs text-gray-500 dark:text-gray-400 font-normal">${ids.length} organisme${ids.length > 1 ? "s" : ""}</span>
    `;

    if (ids.length === 0) {
      listEl.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-xs text-gray-500 dark:text-gray-400">Aucun organisme dans cette catégorie.</td></tr>`;
      return;
    }
    listEl.innerHTML = ids.map((id) => institutionRow(id)).join("");
    wireRowActions();
  }

  searchInput?.addEventListener("input", () => {
    confirmingDeleteId = null;
    renderSidebar();
    renderPanel();
  });

  function openForm(id: string | null, inst: any | null) {
    if (!form || !formContainer || !formTitle || !documentsRows) return;
    form.reset();
    documentsRows.innerHTML = "";
    (form.elements.namedItem("originalId") as HTMLInputElement).value = id ?? "";
    formTitle.textContent = inst ? `Modifier « ${inst.name} »` : "Ajouter une institution";

    if (inst) {
      const set = (name: string, value: any) => {
        const el = form.elements.namedItem(name) as HTMLInputElement | null;
        if (el) el.value = value ?? "";
      };
      set("name", inst.name);
      set("short_name", inst.short_name);
      for (const [key, url] of Object.entries(inst.documents || {})) {
        addDocumentRow(key, url as string);
      }
    }

    formContainer.classList.remove("hidden");
    formContainer.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function closeForm() {
    formContainer?.classList.add("hidden");
  }

  async function deleteInstitution(id: string) {
    const inst = institutions[id];
    try {
      const res = await fetch("/api/admin/institutions", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify({ action: "delete", id }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      confirmingDeleteId = null;
      showStatus(`« ${inst.name} » supprimée et site republié.`, "success");
      await load();
    } catch (err: any) {
      confirmingDeleteId = null;
      showStatus(err.message, "error");
      renderPanel();
    }
  }

  async function load() {
    const [instRes, authRes] = await Promise.all([fetch("/api/admin/institutions"), fetch("/api/admin/auth")]);
    const data = await instRes.json();
    const authData = await authRes.json();
    csrfToken = authData.csrfToken || "";

    if (!instRes.ok) {
      if (listEl) listEl.innerHTML = `<tr><td colspan="4" class="p-4 text-sm text-rose-500">${data.error}</td></tr>`;
      return;
    }

    institutions = data.institutions;
    renderSidebar();
    renderPanel();
  }

  document.getElementById("add-institution-btn")?.addEventListener("click", () => openForm(null, null));
  document.getElementById("institution-cancel-btn")?.addEventListener("click", closeForm);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!saveBtn || !form || !documentsRows) return;
    saveBtn.disabled = true;
    saveBtn.textContent = "Enregistrement…";

    const fd = new FormData(form);
    const originalId = String(fd.get("originalId") || "");
    const documents = Array.from(documentsRows.querySelectorAll(".doc-key")).map((keyInput, i) => ({
      key: (keyInput as HTMLInputElement).value,
      url: (documentsRows.querySelectorAll(".doc-url")[i] as HTMLInputElement).value,
    }));
    const institution = {
      name: fd.get("name"),
      short_name: fd.get("short_name"),
      documents,
    };

    try {
      const res = await fetch("/api/admin/institutions", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify(originalId ? { action: "update", originalId, institution } : { action: "create", institution }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      // Une institution nouvellement créée peut tomber dans une catégorie
      // différente de celle actuellement affichée : on s'y place directement
      // plutôt que de laisser l'administrateur la chercher.
      if (!originalId) activeCategory = institutionCategoryFor(String(institution.name));
      showStatus("Institution enregistrée et site republié.", "success");
      closeForm();
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Enregistrer";
    }
  });

  load();
</script>
