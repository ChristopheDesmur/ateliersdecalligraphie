---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminNav from "@/components/admin/AdminNav.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";

const { session } = authenticateRequest(Astro.request);
---
<Layout title="Administration — Institutions" noindex={true}>
  <div class="max-w-4xl mx-auto">
    {session ? (
      <div>
        <AdminNav active="institutions" />
        <div class="flex items-center justify-between mb-6">
          <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Institutions</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
              Organismes et lieux référencés depuis les événements et certaines pages.
            </p>
          </div>
          <button
            id="add-institution-btn"
            type="button"
            class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold shadow-xs transition cursor-pointer shrink-0"
          >
            + Ajouter
          </button>
        </div>

        <div id="institutions-status" class="hidden mb-4 p-3 rounded-xl text-xs font-medium"></div>

        <div class="mb-4">
          <label for="institutions-search" class="sr-only">Rechercher une institution</label>
          <input
            type="search"
            id="institutions-search"
            class="field-input"
            placeholder="Rechercher une institution…"
            autocomplete="off"
          />
        </div>

        <!-- Sélecteur de catégorie compact (mobile uniquement) -->
        <div class="md:hidden mb-4">
          <label for="category-select" class="sr-only">Catégorie</label>
          <select id="category-select" class="field-input"></select>
        </div>

        <div class="grid md:grid-cols-[13rem_1fr] gap-6 mb-10">
          <!-- Navigation par catégorie (desktop uniquement) -->
          <nav id="category-nav" class="hidden md:block space-y-0.5" aria-label="Catégories d'institutions"></nav>

          <div class="min-w-0">
            <div id="panel-header" class="mb-2 flex items-center justify-between gap-3"></div>
            <div id="institutions-list" class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800/60 divide-y divide-gray-100 dark:divide-gray-800 overflow-hidden">
              <p class="p-4 text-sm text-gray-400">Chargement…</p>
            </div>
          </div>
        </div>

        <!-- Formulaire d'ajout / modification -->
        <div id="institution-form-container" class="hidden bg-white dark:bg-gray-800/60 border border-gray-200 dark:border-gray-700 rounded-2xl p-6">
          <h2 id="institution-form-title" class="font-bold text-gray-900 dark:text-white mb-4">Ajouter une institution</h2>
          <form id="institution-form">
            <input type="hidden" name="originalId" value="" />

            <div class="grid sm:grid-cols-2 gap-4">
              <div class="sm:col-span-2">
                <label class="field-label">Nom complet</label>
                <input name="name" required class="field-input" placeholder="Office villeurbannais des personnes âgées et des retraités" />
              </div>
              <div>
                <label class="field-label">Nom court affiché dans les liens (facultatif)</label>
                <input name="short_name" class="field-input" placeholder="OVPAR" />
              </div>
            </div>

            <div class="mt-5 pt-5 border-t border-gray-100 dark:border-gray-800">
              <div class="flex items-center justify-between mb-2">
                <label class="field-label mb-0">Documents (liens externes, facultatifs)</label>
                <button type="button" id="add-document-row-btn" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline cursor-pointer">+ Ajouter un document</button>
              </div>
              <p class="text-xs text-gray-500 dark:text-gray-400 mb-2">
                Un document (brochure, programme…) référencé depuis un événement en lien avec cette institution.
              </p>
              <div id="documents-rows" class="space-y-2"></div>
            </div>

            <div class="mt-6 pt-5 border-t border-gray-100 dark:border-gray-800 flex items-center gap-3">
              <button type="submit" id="institution-save-btn" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold shadow-xs transition cursor-pointer disabled:opacity-60">
                Enregistrer
              </button>
              <button type="button" id="institution-cancel-btn" class="px-5 py-2.5 rounded-xl text-gray-600 dark:text-gray-300 text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-700 transition cursor-pointer">
                Annuler
              </button>
            </div>
          </form>
        </div>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>
</Layout>

<style>
  :global(.field-label) { display: block; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: rgb(75 85 99); margin-bottom: 0.35rem; }
  :global(.dark .field-label) { color: rgb(209 213 219); }
  :global(.field-input) { width: 100%; padding: 0.5rem 0.9rem; border-radius: 0.75rem; border: 1px solid rgb(209 213 219); background: white; color: rgb(17 24 39); font-size: 0.875rem; }
  :global(.dark .field-input) { border-color: rgb(75 85 99); background: rgb(55 65 81); color: white; }
</style>

<script>
  import { INSTITUTION_CATEGORIES, institutionCategoryFor } from "@/lib/admin/institution-categories";

  let csrfToken = "";
  let institutions: Record<string, any> = {};
  let activeCategory: string = INSTITUTION_CATEGORIES[0].label;
  let confirmingDeleteId: string | null = null;

  const ACTIVE_CATEGORY_KEY = "admin-institutions-active-category";
  const stored = sessionStorage.getItem(ACTIVE_CATEGORY_KEY);
  if (stored && INSTITUTION_CATEGORIES.some((c) => c.label === stored)) activeCategory = stored;

  const listEl = document.getElementById("institutions-list");
  const panelHeaderEl = document.getElementById("panel-header");
  const categoryNavEl = document.getElementById("category-nav");
  const categorySelectEl = document.getElementById("category-select") as HTMLSelectElement | null;
  const statusEl = document.getElementById("institutions-status");
  const searchInput = document.getElementById("institutions-search") as HTMLInputElement | null;
  const formContainer = document.getElementById("institution-form-container");
  const form = document.getElementById("institution-form") as HTMLFormElement | null;
  const formTitle = document.getElementById("institution-form-title");
  const saveBtn = document.getElementById("institution-save-btn") as HTMLButtonElement | null;
  const documentsRows = document.getElementById("documents-rows");

  function normalize(s: string): string {
    return s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  }

  function showStatus(message: string, kind: "success" | "error") {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden");
    statusEl.className =
      "mb-4 p-3 rounded-xl text-xs font-medium " +
      (kind === "success"
        ? "bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800"
        : "bg-rose-50 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800");
  }

  function addDocumentRow(key = "", url = "") {
    if (!documentsRows) return;
    const row = document.createElement("div");
    row.className = "flex items-center gap-2";
    row.innerHTML = `
      <input type="text" class="field-input doc-key" placeholder="clé (ex. animation_2022)" value="${key}" />
      <input type="text" class="field-input doc-url flex-1" placeholder="https://…" value="${url}" />
      <button type="button" class="remove-document-row shrink-0 text-xs font-semibold text-rose-600 dark:text-rose-400 hover:underline cursor-pointer">Retirer</button>
    `;
    row.querySelector(".remove-document-row")?.addEventListener("click", () => row.remove());
    documentsRows.appendChild(row);
  }

  document.getElementById("add-document-row-btn")?.addEventListener("click", () => addDocumentRow());

  function categoryCounts(): Map<string, number> {
    const counts = new Map<string, number>();
    for (const id of Object.keys(institutions)) {
      const label = institutionCategoryFor(institutions[id].name);
      counts.set(label, (counts.get(label) ?? 0) + 1);
    }
    return counts;
  }

  function renderSidebar() {
    const counts = categoryCounts();
    // Pendant une recherche, les résultats traversent toutes les catégories :
    // n'en surligner aucune évite de laisser croire qu'on est encore filtré
    // sur la dernière catégorie sélectionnée.
    const searching = Boolean(searchInput?.value.trim());

    if (categoryNavEl) {
      categoryNavEl.innerHTML = INSTITUTION_CATEGORIES.map((c) => {
        const count = counts.get(c.label) ?? 0;
        const active = !searching && c.label === activeCategory;
        return `
          <button
            type="button"
            data-category="${c.label}"
            aria-current="${active ? "true" : "false"}"
            class="w-full text-left px-3 py-2 rounded-lg text-sm transition cursor-pointer flex items-center justify-between gap-2 ${
              active
                ? "bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 font-semibold"
                : "text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800"
            }"
          >
            <span>${c.label}</span>
            <span class="text-xs text-gray-400 dark:text-gray-500 shrink-0">${count}</span>
          </button>`;
      }).join("");

      categoryNavEl.querySelectorAll<HTMLButtonElement>("[data-category]").forEach((btn) =>
        btn.addEventListener("click", () => selectCategory(btn.dataset.category!))
      );
    }

    if (categorySelectEl) {
      categorySelectEl.innerHTML = INSTITUTION_CATEGORIES.map((c) => {
        const count = counts.get(c.label) ?? 0;
        return `<option value="${c.label}" ${c.label === activeCategory ? "selected" : ""}>${c.label} (${count})</option>`;
      }).join("");
    }
  }

  function selectCategory(label: string) {
    activeCategory = label;
    sessionStorage.setItem(ACTIVE_CATEGORY_KEY, label);
    if (searchInput) searchInput.value = "";
    confirmingDeleteId = null;
    renderSidebar();
    renderPanel();
  }

  categorySelectEl?.addEventListener("change", () => selectCategory(categorySelectEl.value));

  function institutionRow(id: string, opts: { showCategory?: boolean } = {}): string {
    const inst = institutions[id];
    const docCount = inst.documents ? Object.keys(inst.documents).length : 0;
    const category = opts.showCategory ? institutionCategoryFor(inst.name) : null;

    if (confirmingDeleteId === id) {
      return `
      <div class="p-3.5 flex items-center justify-between gap-4">
        <p class="text-sm text-gray-700 dark:text-gray-300">Supprimer « ${inst.name} » ?</p>
        <div class="flex gap-3 shrink-0">
          <button data-cancel-delete="${id}" class="text-xs font-semibold text-gray-600 dark:text-gray-300 hover:underline cursor-pointer">Annuler</button>
          <button data-confirm-delete="${id}" class="text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 px-2.5 py-1 rounded-lg cursor-pointer">Supprimer</button>
        </div>
      </div>`;
    }

    return `
      <div class="p-3.5 flex items-center justify-between gap-4">
        <div class="min-w-0">
          <p class="text-sm text-gray-900 dark:text-white truncate">${inst.name}${inst.short_name ? ` <span class="text-gray-400 dark:text-gray-500 font-normal">(${inst.short_name})</span>` : ""}</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
            ${category ? `${category} · ` : ""}${docCount} document${docCount === 1 ? "" : "s"}
          </p>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <button data-edit="${id}" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline cursor-pointer">Modifier</button>
          <button data-delete="${id}" class="text-xs text-gray-400 dark:text-gray-500 hover:text-rose-600 dark:hover:text-rose-400 hover:underline cursor-pointer transition">Supprimer</button>
        </div>
      </div>`;
  }

  function wireRowActions() {
    if (!listEl) return;
    listEl.querySelectorAll<HTMLButtonElement>("[data-edit]").forEach((btn) =>
      btn.addEventListener("click", () => openForm(btn.dataset.edit!, institutions[btn.dataset.edit!]))
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((btn) =>
      btn.addEventListener("click", () => {
        confirmingDeleteId = btn.dataset.delete!;
        renderPanel();
      })
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-cancel-delete]").forEach((btn) =>
      btn.addEventListener("click", () => {
        confirmingDeleteId = null;
        renderPanel();
      })
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-confirm-delete]").forEach((btn) =>
      btn.addEventListener("click", () => deleteInstitution(btn.dataset.confirmDelete!))
    );
  }

  function renderPanel() {
    if (!listEl || !panelHeaderEl) return;
    const query = normalize(searchInput?.value.trim() ?? "");

    if (query) {
      const matchingIds = Object.keys(institutions)
        .filter((id) => {
          const inst = institutions[id];
          return normalize(inst.name).includes(query) || (inst.short_name && normalize(inst.short_name).includes(query));
        })
        .sort((a, b) => institutions[a].name.localeCompare(institutions[b].name, "fr"));

      panelHeaderEl.innerHTML = `
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white">${matchingIds.length} résultat${matchingIds.length === 1 ? "" : "s"} pour « ${searchInput?.value ?? ""} »</h2>
        <button id="clear-search-btn" type="button" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline cursor-pointer shrink-0">Effacer la recherche</button>
      `;
      document.getElementById("clear-search-btn")?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        renderSidebar();
        renderPanel();
      });

      if (matchingIds.length === 0) {
        listEl.innerHTML = `<p class="p-4 text-sm text-gray-400">Aucune institution trouvée pour « ${searchInput?.value ?? ""} ».</p>`;
        return;
      }
      listEl.innerHTML = matchingIds.map((id) => institutionRow(id, { showCategory: true })).join("");
      wireRowActions();
      return;
    }

    const ids = Object.keys(institutions)
      .filter((id) => institutionCategoryFor(institutions[id].name) === activeCategory)
      .sort((a, b) => institutions[a].name.localeCompare(institutions[b].name, "fr"));

    panelHeaderEl.innerHTML = `<h2 class="text-sm font-semibold text-gray-900 dark:text-white">${activeCategory} · ${ids.length}</h2>`;

    if (ids.length === 0) {
      listEl.innerHTML = `<p class="p-4 text-sm text-gray-400">Aucun organisme dans cette catégorie.</p>`;
      return;
    }
    listEl.innerHTML = ids.map((id) => institutionRow(id)).join("");
    wireRowActions();
  }

  searchInput?.addEventListener("input", () => {
    confirmingDeleteId = null;
    renderSidebar();
    renderPanel();
  });

  function openForm(id: string | null, inst: any | null) {
    if (!form || !formContainer || !formTitle || !documentsRows) return;
    form.reset();
    documentsRows.innerHTML = "";
    (form.elements.namedItem("originalId") as HTMLInputElement).value = id ?? "";
    formTitle.textContent = inst ? `Modifier « ${inst.name} »` : "Ajouter une institution";

    if (inst) {
      const set = (name: string, value: any) => {
        const el = form.elements.namedItem(name) as HTMLInputElement | null;
        if (el) el.value = value ?? "";
      };
      set("name", inst.name);
      set("short_name", inst.short_name);
      for (const [key, url] of Object.entries(inst.documents || {})) {
        addDocumentRow(key, url as string);
      }
    }

    formContainer.classList.remove("hidden");
    formContainer.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function closeForm() {
    formContainer?.classList.add("hidden");
  }

  async function deleteInstitution(id: string) {
    const inst = institutions[id];
    try {
      const res = await fetch("/api/admin/institutions", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify({ action: "delete", id }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      confirmingDeleteId = null;
      showStatus(`« ${inst.name} » supprimée et site republié.`, "success");
      await load();
    } catch (err: any) {
      confirmingDeleteId = null;
      showStatus(err.message, "error");
      renderPanel();
    }
  }

  async function load() {
    const [instRes, authRes] = await Promise.all([fetch("/api/admin/institutions"), fetch("/api/admin/auth")]);
    const data = await instRes.json();
    const authData = await authRes.json();
    csrfToken = authData.csrfToken || "";

    if (!instRes.ok) {
      if (listEl) listEl.innerHTML = `<p class="p-4 text-sm text-rose-500">${data.error}</p>`;
      return;
    }

    institutions = data.institutions;
    renderSidebar();
    renderPanel();
  }

  document.getElementById("add-institution-btn")?.addEventListener("click", () => openForm(null, null));
  document.getElementById("institution-cancel-btn")?.addEventListener("click", closeForm);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!saveBtn || !form || !documentsRows) return;
    saveBtn.disabled = true;
    saveBtn.textContent = "Enregistrement…";

    const fd = new FormData(form);
    const originalId = String(fd.get("originalId") || "");
    const documents = Array.from(documentsRows.querySelectorAll(".doc-key")).map((keyInput, i) => ({
      key: (keyInput as HTMLInputElement).value,
      url: (documentsRows.querySelectorAll(".doc-url")[i] as HTMLInputElement).value,
    }));
    const institution = {
      name: fd.get("name"),
      short_name: fd.get("short_name"),
      documents,
    };

    try {
      const res = await fetch("/api/admin/institutions", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify(originalId ? { action: "update", originalId, institution } : { action: "create", institution }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      // Une institution nouvellement créée peut tomber dans une catégorie
      // différente de celle actuellement affichée : on s'y place directement
      // plutôt que de laisser l'administrateur la chercher.
      if (!originalId) activeCategory = institutionCategoryFor(String(institution.name));
      showStatus("Institution enregistrée et site republié.", "success");
      closeForm();
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Enregistrer";
    }
  });

  load();
</script>
