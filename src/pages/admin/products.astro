---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";

const { session } = authenticateRequest(Astro.request);
---
<Layout title="Administration — Galerie" noindex={true}>
  <div>
    {session ? (
      <div>
        <AdminPageHeader
          title="Galerie"
          description="Catalogue des calligraphies et œuvres originales exposées sur la galerie publique."
          active="products"
        >
          <div slot="actions">
            <button
              id="add-product-btn"
              type="button"
              class="astro-btn astro-btn-primary text-xs"
            >
              + Ajouter une œuvre
            </button>
          </div>
        </AdminPageHeader>

        <div id="products-status" class="hidden mb-4 astro-notice" role="alert"></div>

        <!-- Toolbar / Recherche et filtres -->
        <div class="astro-panel p-2 sm:p-2.5 mb-3 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 text-xs">
          <div class="flex items-center gap-2 flex-1 min-w-0">
            <input
              type="search"
              id="product-search"
              placeholder="Rechercher par titre, caractère ou signification…"
              class="field-input max-w-sm text-xs"
            />
            <select id="product-filter-availability" class="field-input max-w-[170px] text-xs">
              <option value="">Toutes les disponibilités</option>
              <option value="Disponible">Disponible</option>
              <option value="Vendue">Vendue</option>
            </select>
          </div>
          <div id="product-count" class="text-xs text-[#646970] dark:text-[#8c8f94] shrink-0 text-right">
            Chargement…
          </div>
        </div>

        <!-- Table des œuvres -->
        <div class="astro-table-wrap mb-8">
          <table class="astro-table">
            <thead>
              <tr>
                <th style="width: 48px;">Photo</th>
                <th>Titre</th>
                <th>Caractère</th>
                <th class="hidden md:table-cell">Signification</th>
                <th class="hidden sm:table-cell">Catégorie</th>
                <th>Disponibilité</th>
                <th class="hidden lg:table-cell">Réf. prix</th>
              </tr>
            </thead>
            <tbody id="products-table-body">
              <tr>
                <td colspan="7" class="p-4 text-sm text-gray-400">Chargement des œuvres…</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Formulaire d'ajout / modification -->
        <div id="product-form-container" class="hidden astro-panel mb-10">
          <div class="astro-panel-header">
            <h2 id="product-form-title" class="astro-panel-title">Ajouter une œuvre</h2>
            <button
              type="button"
              id="product-form-close-btn"
              class="text-xs text-[#646970] hover:text-[#2c3338] dark:hover:text-white cursor-pointer"
            >
              Fermer
            </button>
          </div>
          <div class="astro-panel-body">
            <form id="product-form" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <input type="hidden" name="originalId" value="" />

              <div class="sm:col-span-2">
                <label class="field-label">Titre</label>
                <input name="title" required class="field-input" placeholder="福 — Bonheur & Prospérité" />
              </div>
              <div>
                <label class="field-label">Caractère</label>
                <input name="character" required class="field-input font-serif text-base" placeholder="福" />
              </div>
              <div>
                <label class="field-label">Pinyin (facultatif)</label>
                <input name="pinyin" class="field-input" placeholder="Fú" />
              </div>
              <div class="sm:col-span-2">
                <label class="field-label">Signification française</label>
                <input name="frenchMeaning" required class="field-input" placeholder="Bonheur · Fortune & Prospérité" />
              </div>
              <div>
                <label class="field-label">Catégorie</label>
                <input name="category" required class="field-input" placeholder="Caractère traditionnel" />
              </div>
              <div>
                <label class="field-label">Style (facultatif)</label>
                <input name="style" class="field-input" placeholder="Écriture régulière (Kaishu)" />
              </div>

              <div class="sm:col-span-2">
                <label class="field-label">Photo</label>
                <div class="flex items-start gap-3">
                  <div id="photo-preview-wrap" class="hidden shrink-0 w-16 h-16 rounded-[3px] overflow-hidden border border-[#c3c4c7] dark:border-[#2c3338] bg-stone-50 dark:bg-gray-900">
                    <img id="photo-preview" class="w-full h-full object-contain" alt="" />
                  </div>
                  <div class="flex-1 min-w-0">
                    <input type="file" id="photo-upload-input" accept="image/*" class="text-xs text-[#646970] dark:text-[#8c8f94] file:mr-2 file:px-2.5 file:py-1 file:rounded-[3px] file:border file:border-[#c3c4c7] dark:file:border-[#384148] file:text-xs file:font-medium file:bg-[#f6f7f7] file:text-[#2c3338] dark:file:bg-[#21262b] dark:file:text-[#dcdcde] hover:file:bg-[#f0f0f1] cursor-pointer" />
                    <p id="photo-upload-status" class="text-xs text-[#646970] dark:text-[#8c8f94] mt-1"></p>
                  </div>
                </div>
              </div>
              <div>
                <label class="field-label">Photo — chemin</label>
                <input name="photoSrc" required class="field-input font-mono text-xs" placeholder="/assets/FUKU-Bonheur.webp" />
              </div>
              <div>
                <label class="field-label">Photo — texte alternatif</label>
                <input name="photoAlt" required class="field-input" placeholder="Calligraphie chinoise 福…" />
              </div>
              <div>
                <label class="field-label">Photo — largeur (px)</label>
                <input name="photoWidth" type="number" required class="field-input font-mono text-xs" />
              </div>
              <div>
                <label class="field-label">Photo — hauteur (px)</label>
                <input name="photoHeight" type="number" required class="field-input font-mono text-xs" />
              </div>

              <div class="sm:col-span-2">
                <label class="field-label">Description</label>
                <textarea name="description" required rows="2" class="field-input"></textarea>
              </div>
              <div class="sm:col-span-2">
                <label class="field-label">Description étendue (facultatif)</label>
                <textarea name="extendedDescription" rows="3" class="field-input"></textarea>
              </div>

              <div>
                <label class="field-label">Référence de prix (prices.yaml)</label>
                <input name="price_ref" required list="price-refs" class="field-input font-mono text-xs" placeholder="galerie.sur_demande" />
                <datalist id="price-refs"></datalist>
              </div>
              <div>
                <label class="field-label">Disponibilité</label>
                <select name="availability" class="field-input">
                  <option value="Disponible">Disponible</option>
                  <option value="Vendue">Vendue</option>
                </select>
              </div>
              <div>
                <label class="field-label">Technique</label>
                <input name="technique" required class="field-input" />
              </div>
              <div>
                <label class="field-label">Support</label>
                <input name="medium" required class="field-input" />
              </div>
              <div>
                <label class="field-label">Artiste</label>
                <input name="artist" required class="field-input" value="Christophe Desmur" />
              </div>

              <div class="sm:col-span-2 flex items-center gap-2 pt-3 border-t border-[#dcdcde] dark:border-[#2c3338]">
                <button type="submit" id="product-save-btn" class="astro-btn astro-btn-primary text-xs cursor-pointer disabled:opacity-60">
                  Enregistrer l'œuvre
                </button>
                <button type="button" id="product-cancel-btn" class="astro-btn text-xs cursor-pointer">
                  Annuler
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>
</Layout>

<script>
  let csrfToken = "";
  let products: any[] = [];
  let priceRefs: string[] = [];

  const tableBody = document.getElementById("products-table-body");
  const countEl = document.getElementById("product-count");
  const searchInput = document.getElementById("product-search") as HTMLInputElement | null;
  const filterAvailability = document.getElementById("product-filter-availability") as HTMLSelectElement | null;
  const statusEl = document.getElementById("products-status");
  const formContainer = document.getElementById("product-form-container");
  const form = document.getElementById("product-form") as HTMLFormElement | null;
  let formDirty = false;
  form?.addEventListener("input", () => { formDirty = true; });
  window.addEventListener("beforeunload", (e) => {
    if (!formDirty || formContainer?.classList.contains("hidden")) return;
    e.preventDefault();
    e.returnValue = "";
  });
  const formTitle = document.getElementById("product-form-title");
  const saveBtn = document.getElementById("product-save-btn") as HTMLButtonElement | null;
  const photoUploadInput = document.getElementById("photo-upload-input") as HTMLInputElement | null;
  const photoUploadStatus = document.getElementById("photo-upload-status");
  const photoPreviewWrap = document.getElementById("photo-preview-wrap");
  const photoPreview = document.getElementById("photo-preview") as HTMLImageElement | null;

  function showPhotoPreview(src: string) {
    if (!photoPreview || !photoPreviewWrap) return;
    photoPreview.src = src;
    photoPreviewWrap.classList.remove("hidden");
  }

  photoUploadInput?.addEventListener("change", async () => {
    const file = photoUploadInput.files?.[0];
    if (!file || !form || !photoUploadStatus) return;

    photoUploadStatus.textContent = "Téléversement…";
    photoUploadStatus.className = "text-xs text-gray-500 dark:text-gray-400 mt-1";

    const originalIdVal = (form.elements.namedItem("originalId") as HTMLInputElement)?.value;
    const pinyinVal = (form.elements.namedItem("pinyin") as HTMLInputElement)?.value;
    const titleVal = (form.elements.namedItem("title") as HTMLInputElement)?.value;
    const nameHint = originalIdVal || pinyinVal || titleVal || file.name.replace(/\.[^.]+$/, "");
    const fd = new FormData();
    fd.append("file", file);
    fd.append("nameHint", nameHint);

    try {
      const res = await fetch("/api/admin/upload-image", {
        method: "POST",
        headers: { "x-csrf-token": csrfToken },
        body: fd,
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);

      (form.elements.namedItem("photoSrc") as HTMLInputElement).value = data.path;
      (form.elements.namedItem("photoWidth") as HTMLInputElement).value = String(data.width);
      (form.elements.namedItem("photoHeight") as HTMLInputElement).value = String(data.height);
      showPhotoPreview(data.path);
      photoUploadStatus.textContent = "Photo téléversée et publiée ✓";
    } catch (err: any) {
      photoUploadStatus.textContent = err.message || "Échec du téléversement.";
      photoUploadStatus.className = "text-xs text-rose-500 mt-1";
    } finally {
      photoUploadInput.value = "";
    }
  });

  function showStatus(message: string, kind: "success" | "error") {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden");
    statusEl.className =
      "mb-4 astro-notice " +
      (kind === "success"
        ? "astro-notice-success text-[#00a32a] dark:text-[#4ac26b]"
        : "astro-notice-error text-[#d63638] dark:text-[#ff8585]");
  }

  function normalize(s: string): string {
    return s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  }

  function renderList() {
    if (!tableBody) return;
    const query = normalize(searchInput?.value.trim() || "");
    const filterAvail = filterAvailability?.value || "";

    const filtered = products.filter((p) => {
      if (filterAvail && p.availability !== filterAvail) return false;
      if (!query) return true;
      const hay = normalize(`${p.title || ""} ${p.character || ""} ${p.pinyin || ""} ${p.frenchMeaning || ""} ${p.id || ""}`);
      return hay.includes(query);
    });

    if (countEl) {
      countEl.textContent = `${filtered.length} œuvre${filtered.length > 1 ? "s" : ""}${filtered.length !== products.length ? ` (sur ${products.length})` : ""}`;
    }

    if (filtered.length === 0) {
      tableBody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-xs text-[#646970] dark:text-[#8c8f94]">Aucune œuvre trouvée.</td></tr>`;
      return;
    }

    tableBody.innerHTML = filtered
      .map((p) => {
        const originalIndex = products.indexOf(p);
        const isAvail = p.availability === "Disponible";
        return `
        <tr>
          <td class="w-12">
            <img src="${p.photo?.src || ''}" alt="" class="w-9 h-9 object-cover rounded-[2px] border border-[#dcdcde] dark:border-[#2c3338] bg-stone-50 dark:bg-gray-900" />
          </td>
          <td>
            <div class="font-medium text-[#1d2327] dark:text-white leading-snug">${p.title || 'Sans titre'}</div>
            <div class="row-actions">
              <button type="button" data-edit="${originalIndex}">Modifier</button>
              <span class="text-[#8c8f94]">|</span>
              <button type="button" data-delete="${originalIndex}" class="delete-action">Supprimer</button>
              <span class="text-[#8c8f94]">|</span>
              <a href="/galerie/${p.id}" target="_blank" rel="noopener noreferrer">Voir ↗</a>
            </div>
          </td>
          <td class="font-serif text-base text-[#1d2327] dark:text-white whitespace-nowrap">
            ${p.character || "—"}
            ${p.pinyin ? `<span class="font-sans text-xs text-[#646970] dark:text-[#8c8f94]">(${p.pinyin})</span>` : ""}
          </td>
          <td class="text-xs text-[#646970] dark:text-[#8c8f94] max-w-xs truncate hidden md:table-cell">
            ${p.frenchMeaning || "—"}
          </td>
          <td class="text-xs text-[#646970] dark:text-[#8c8f94] whitespace-nowrap hidden sm:table-cell">
            ${p.category || "—"}
          </td>
          <td class="whitespace-nowrap">
            <span class="astro-badge ${isAvail ? "astro-badge-success" : "astro-badge-muted"}">
              ${p.availability || "—"}
            </span>
          </td>
          <td class="font-mono text-xs text-[#646970] dark:text-[#8c8f94] whitespace-nowrap hidden lg:table-cell">
            ${p.price_ref || "—"}
          </td>
        </tr>`;
      })
      .join("");

    tableBody.querySelectorAll<HTMLButtonElement>("[data-edit]").forEach((btn) =>
      btn.addEventListener("click", () => openForm(products[Number(btn.dataset.edit)]))
    );
    tableBody.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((btn) =>
      btn.addEventListener("click", () => deleteProduct(products[Number(btn.dataset.delete)]))
    );
  }

  searchInput?.addEventListener("input", renderList);
  filterAvailability?.addEventListener("change", renderList);
  document.getElementById("product-form-close-btn")?.addEventListener("click", closeForm);

  function openForm(product: any | null) {
    if (!form || !formContainer || !formTitle) return;
    formDirty = false;
    form.reset();
    (form.elements.namedItem("originalId") as HTMLInputElement).value = product?.id || "";
    formTitle.textContent = product ? `Modifier « ${product.title} »` : "Ajouter une œuvre";
    if (photoUploadStatus) photoUploadStatus.textContent = "";
    photoPreviewWrap?.classList.add("hidden");
    if (product?.photo?.src) showPhotoPreview(product.photo.src);

    if (product) {
      const set = (name: string, value: any) => {
        const el = form.elements.namedItem(name) as HTMLInputElement | null;
        if (el) el.value = value ?? "";
      };
      set("title", product.title);
      set("character", product.character);
      set("pinyin", product.pinyin);
      set("frenchMeaning", product.frenchMeaning);
      set("category", product.category);
      set("style", product.style);
      set("photoSrc", product.photo?.src);
      set("photoAlt", product.photo?.alt);
      set("photoWidth", product.photo?.width);
      set("photoHeight", product.photo?.height);
      set("description", product.description);
      set("extendedDescription", product.extendedDescription);
      set("price_ref", product.price_ref);
      set("availability", product.availability);
      set("technique", product.technique);
      set("medium", product.medium);
      set("artist", product.artist);
    } else {
      (form.elements.namedItem("artist") as HTMLInputElement).value = "Christophe Desmur";
    }

    formContainer.classList.remove("hidden");
    formContainer.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function closeForm() {
    formDirty = false;
    formContainer?.classList.add("hidden");
  }

  async function deleteProduct(product: any) {
    if (!confirm(`Supprimer définitivement « ${product.title} » ?`)) return;
    try {
      const res = await fetch("/api/admin/products", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify({ action: "delete", id: product.id }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Œuvre supprimée et site republié.", "success");
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    }
  }

  async function load() {
    const [productsRes, authRes] = await Promise.all([fetch("/api/admin/products"), fetch("/api/admin/auth")]);
    const data = await productsRes.json();
    const authData = await authRes.json();
    csrfToken = authData.csrfToken || "";

    if (!productsRes.ok) {
      if (listEl) listEl.innerHTML = `<p class="text-sm text-rose-500">${data.error}</p>`;
      return;
    }

    products = data.products;
    priceRefs = data.priceRefs;
    const datalist = document.getElementById("price-refs");
    if (datalist) datalist.innerHTML = priceRefs.map((r) => `<option value="${r}"></option>`).join("");

    renderList();
  }

  document.getElementById("add-product-btn")?.addEventListener("click", () => openForm(null));
  document.getElementById("product-cancel-btn")?.addEventListener("click", closeForm);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!saveBtn || !form) return;
    saveBtn.disabled = true;
    saveBtn.textContent = "Enregistrement…";

    const fd = new FormData(form);
    const originalId = String(fd.get("originalId") || "");
    const product = {
      ...(originalId ? { id: originalId } : {}),
      title: fd.get("title"),
      character: fd.get("character"),
      pinyin: fd.get("pinyin"),
      frenchMeaning: fd.get("frenchMeaning"),
      category: fd.get("category"),
      style: fd.get("style"),
      photo: { src: fd.get("photoSrc"), alt: fd.get("photoAlt"), width: fd.get("photoWidth"), height: fd.get("photoHeight") },
      description: fd.get("description"),
      extendedDescription: fd.get("extendedDescription"),
      price_ref: fd.get("price_ref"),
      availability: fd.get("availability"),
      technique: fd.get("technique"),
      medium: fd.get("medium"),
      artist: fd.get("artist"),
    };

    try {
      const res = await fetch("/api/admin/products", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify(originalId ? { action: "update", originalId, product } : { action: "create", product }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Œuvre enregistrée et site republié.", "success");
      closeForm();
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Enregistrer";
    }
  });

  load();
</script>
