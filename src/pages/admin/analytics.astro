---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";

const { session } = authenticateRequest(Astro.request);
---
<Layout title="Administration — Analytics" noindex={true}>
  <div>
    {session ? (
      <div>
        <AdminPageHeader
          title="Analytics"
          description="Statistiques réelles d'audience et de trafic fournies par Vercel Web Analytics."
          active="analytics"
        >
          <div slot="actions" class="flex items-center gap-2">
            <button
              id="analytics-refresh-btn"
              type="button"
              class="wp-btn wp-btn-secondary text-xs flex items-center gap-1.5"
              title="Actualiser les statistiques"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
              </svg>
              <span>Actualiser</span>
            </button>
          </div>
        </AdminPageHeader>

        <!-- Message de statut / configuration -->
        <div id="analytics-notice" class="hidden mb-4 wp-notice" role="alert"></div>

        <!-- Barre d'outils des périodes (WordPress Toolbar) -->
        <div class="wp-panel p-2.5 mb-5 flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between text-xs">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="font-medium text-gray-700 dark:text-gray-300">Période d'analyse :</span>
            <div id="range-selector" class="inline-flex rounded border border-[#c3c4c7] dark:border-[#50575e] overflow-hidden bg-white dark:bg-[#1d2327]">
              <button type="button" data-range="24h" class="range-tab px-3 py-1 text-xs border-r border-[#c3c4c7] dark:border-[#50575e] hover:bg-gray-100 dark:hover:bg-gray-800 transition cursor-pointer">24h</button>
              <button type="button" data-range="7d" class="range-tab px-3 py-1 text-xs border-r border-[#c3c4c7] dark:border-[#50575e] hover:bg-gray-100 dark:hover:bg-gray-800 transition cursor-pointer">7 jours</button>
              <button type="button" data-range="30d" class="range-tab active px-3 py-1 text-xs border-r border-[#c3c4c7] dark:border-[#50575e] bg-[#2271b1] text-white font-medium transition cursor-pointer">30 jours</button>
              <button type="button" data-range="90d" class="range-tab px-3 py-1 text-xs hover:bg-gray-100 dark:hover:bg-gray-800 transition cursor-pointer">90 jours</button>
            </div>
          </div>
          <div id="range-dates-label" class="text-xs text-gray-500 dark:text-gray-400 font-mono">
            Chargement de la période…
          </div>
        </div>

        <!-- Conteneur principal des statistiques -->
        <div id="analytics-content" class="space-y-6 mb-10">
          <!-- Cartes récapitulatives (D'un coup d'œil) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="wp-panel p-4">
              <div class="text-[11px] uppercase tracking-wider text-gray-500 dark:text-gray-400 font-semibold mb-1">
                Visiteurs uniques
              </div>
              <div id="stat-visitors" class="text-2xl font-bold text-gray-900 dark:text-white font-mono">—</div>
              <p class="text-[11px] text-gray-400 dark:text-gray-500 mt-1">Nombre d'individus distincts</p>
            </div>

            <div class="wp-panel p-4">
              <div class="text-[11px] uppercase tracking-wider text-gray-500 dark:text-gray-400 font-semibold mb-1">
                Pages vues
              </div>
              <div id="stat-pageviews" class="text-2xl font-bold text-[#2271b1] dark:text-[#72aee6] font-mono">—</div>
              <p class="text-[11px] text-gray-400 dark:text-gray-500 mt-1">Consultations totales de pages</p>
            </div>

            <div class="wp-panel p-4">
              <div class="text-[11px] uppercase tracking-wider text-gray-500 dark:text-gray-400 font-semibold mb-1">
                Pages / Visiteur
              </div>
              <div id="stat-ratio" class="text-2xl font-bold text-gray-900 dark:text-white font-mono">—</div>
              <p class="text-[11px] text-gray-400 dark:text-gray-500 mt-1">Moyenne de pages par visite</p>
            </div>

            <div class="wp-panel p-4">
              <div class="text-[11px] uppercase tracking-wider text-gray-500 dark:text-gray-400 font-semibold mb-1">
                Moyenne par jour
              </div>
              <div id="stat-daily-avg" class="text-2xl font-bold text-gray-900 dark:text-white font-mono">—</div>
              <p class="text-[11px] text-gray-400 dark:text-gray-500 mt-1">Pages vues par jour</p>
            </div>
          </div>

          <!-- Évolution du trafic dans le temps -->
          <div class="wp-panel overflow-hidden">
            <div class="wp-panel-header flex items-center justify-between">
              <h2 class="wp-panel-title flex items-center gap-2">
                <span>Évolution du trafic</span>
                <span class="text-xs font-normal text-gray-500 dark:text-gray-400">(visiteurs et pages vues)</span>
              </h2>
              <div class="flex items-center gap-4 text-xs">
                <span class="flex items-center gap-1.5">
                  <span class="w-3 h-3 rounded bg-[#2271b1]"></span>
                  <span class="text-gray-600 dark:text-gray-300">Pages vues</span>
                </span>
                <span class="flex items-center gap-1.5">
                  <span class="w-3 h-3 rounded bg-[#72aee6]"></span>
                  <span class="text-gray-600 dark:text-gray-300">Visiteurs</span>
                </span>
              </div>
            </div>
            <div class="p-4">
              <div id="chart-container" class="w-full h-56 flex items-end">
                <div class="w-full text-center text-xs text-gray-400 self-center">Chargement du graphique…</div>
              </div>
            </div>
          </div>

          <!-- Grille 1 : Pages les plus vues & Référents -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Pages les plus vues -->
            <div class="wp-panel overflow-hidden">
              <div class="wp-panel-header flex items-center justify-between">
                <h2 class="wp-panel-title">Pages les plus consultées</h2>
                <span id="pages-count" class="text-xs text-gray-500 dark:text-gray-400"></span>
              </div>
              <div class="wp-table-wrap border-0">
                <table class="wp-table">
                  <thead>
                    <tr>
                      <th>Chemin URL</th>
                      <th class="w-24 text-right">Vues</th>
                      <th class="w-24 text-right">Visiteurs</th>
                    </tr>
                  </thead>
                  <tbody id="pages-table-body">
                    <tr><td colspan="3" class="p-4 text-center text-xs text-gray-400">Chargement…</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Référents / Sources de trafic -->
            <div class="wp-panel overflow-hidden">
              <div class="wp-panel-header flex items-center justify-between">
                <h2 class="wp-panel-title">Sources de trafic (Référents)</h2>
                <span id="referrers-count" class="text-xs text-gray-500 dark:text-gray-400"></span>
              </div>
              <div class="wp-table-wrap border-0">
                <table class="wp-table">
                  <thead>
                    <tr>
                      <th>Source / Domaine</th>
                      <th class="w-24 text-right">Vues</th>
                      <th class="w-24 text-right">Visiteurs</th>
                    </tr>
                  </thead>
                  <tbody id="referrers-table-body">
                    <tr><td colspan="3" class="p-4 text-center text-xs text-gray-400">Chargement…</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Grille 2 : Pays & Appareils -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Pays -->
            <div class="wp-panel overflow-hidden">
              <div class="wp-panel-header flex items-center justify-between">
                <h2 class="wp-panel-title">Origine géographique (Pays)</h2>
                <span id="countries-count" class="text-xs text-gray-500 dark:text-gray-400"></span>
              </div>
              <div class="wp-table-wrap border-0">
                <table class="wp-table">
                  <thead>
                    <tr>
                      <th>Pays</th>
                      <th class="w-24 text-right">Vues</th>
                      <th class="w-24 text-right">Visiteurs</th>
                    </tr>
                  </thead>
                  <tbody id="countries-table-body">
                    <tr><td colspan="3" class="p-4 text-center text-xs text-gray-400">Chargement…</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Appareils -->
            <div class="wp-panel overflow-hidden">
              <div class="wp-panel-header flex items-center justify-between">
                <h2 class="wp-panel-title">Appareils utilisés</h2>
                <span id="devices-count" class="text-xs text-gray-500 dark:text-gray-400"></span>
              </div>
              <div class="wp-table-wrap border-0">
                <table class="wp-table">
                  <thead>
                    <tr>
                      <th>Appareil</th>
                      <th class="w-24 text-right">Vues</th>
                      <th class="w-24 text-right">Visiteurs</th>
                    </tr>
                  </thead>
                  <tbody id="devices-table-body">
                    <tr><td colspan="3" class="p-4 text-center text-xs text-gray-400">Chargement…</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>
</Layout>

<script>
  let currentRange = "30d";
  let isLoading = false;

  const noticeEl = document.getElementById("analytics-notice");
  const refreshBtn = document.getElementById("analytics-refresh-btn");
  const rangeButtons = document.querySelectorAll<HTMLButtonElement>(".range-tab");
  const rangeDatesLabel = document.getElementById("range-dates-label");

  const statVisitors = document.getElementById("stat-visitors");
  const statPageviews = document.getElementById("stat-pageviews");
  const statRatio = document.getElementById("stat-ratio");
  const statDailyAvg = document.getElementById("stat-daily-avg");

  const chartContainer = document.getElementById("chart-container");
  const pagesBody = document.getElementById("pages-table-body");
  const pagesCount = document.getElementById("pages-count");
  const referrersBody = document.getElementById("referrers-table-body");
  const referrersCount = document.getElementById("referrers-count");
  const countriesBody = document.getElementById("countries-table-body");
  const countriesCount = document.getElementById("countries-count");
  const devicesBody = document.getElementById("devices-table-body");
  const devicesCount = document.getElementById("devices-count");

  const COUNTRY_NAMES: Record<string, string> = {
    FR: "France",
    US: "États-Unis",
    BE: "Belgique",
    CH: "Suisse",
    CA: "Canada",
    DE: "Allemagne",
    GB: "Royaume-Uni",
    ES: "Espagne",
    IT: "Italie",
    JP: "Japon",
    CN: "Chine",
    NL: "Pays-Bas",
    MA: "Maroc",
    DZ: "Algérie",
    TN: "Tunisie",
    SN: "Sénégal",
    CI: "Côte d'Ivoire",
    MG: "Madagascar",
    LU: "Luxembourg",
    PT: "Portugal",
    BR: "Brésil",
    AU: "Australie",
    RU: "Russie",
    IN: "Inde",
    SG: "Singapour",
    TW: "Taïwan",
    KR: "Corée du Sud",
    HK: "Hong Kong",
  };

  function getCountryFlag(code: string): string {
    if (!code || code.length !== 2 || code === "??") return "🌐";
    const upper = code.toUpperCase();
    const c1 = 127397 + upper.charCodeAt(0);
    const c2 = 127397 + upper.charCodeAt(1);
    return String.fromCodePoint(c1, c2);
  }

  function getCountryName(code: string): string {
    if (!code || code === "??") return "Origine indéterminée";
    return COUNTRY_NAMES[code.toUpperCase()] || code.toUpperCase();
  }

  function formatDevice(type: string): { label: string; badgeClass: string } {
    const t = (type || "").toLowerCase();
    if (t === "desktop") return { label: "Ordinateur (Desktop)", badgeClass: "wp-badge-info" };
    if (t === "mobile") return { label: "Téléphone portable (Mobile)", badgeClass: "wp-badge-success" };
    if (t === "tablet") return { label: "Tablette", badgeClass: "wp-badge-warning" };
    return { label: type || "Inconnu", badgeClass: "wp-badge-gray" };
  }

  function formatDateRange(sinceStr: string, untilStr: string): string {
    try {
      const d1 = new Date(sinceStr);
      const d2 = new Date(untilStr);
      const opt: Intl.DateTimeFormatOptions = { day: "numeric", month: "short", year: "numeric" };
      return `${d1.toLocaleDateString("fr-FR", opt)} — ${d2.toLocaleDateString("fr-FR", opt)}`;
    } catch {
      return "";
    }
  }

  function showNotice(msg: string, kind: "error" | "warning" | "success" = "warning") {
    if (!noticeEl) return;
    noticeEl.innerHTML = msg;
    noticeEl.classList.remove("hidden", "wp-notice-error", "wp-notice-warning", "wp-notice-success");
    noticeEl.classList.add(
      kind === "error" ? "wp-notice-error" : kind === "success" ? "wp-notice-success" : "wp-notice-warning"
    );
  }

  function hideNotice() {
    if (!noticeEl) return;
    noticeEl.classList.add("hidden");
    noticeEl.innerHTML = "";
  }

  async function loadAnalytics() {
    if (isLoading) return;
    isLoading = true;
    hideNotice();

    if (refreshBtn) {
      refreshBtn.classList.add("opacity-50", "pointer-events-none");
    }

    try {
      const res = await fetch(`/api/admin/analytics?range=${currentRange}`);
      const data = await res.json();

      if (!res.ok) {
        showNotice(data.error || "Erreur lors du chargement des statistiques.", "error");
        return;
      }

      if (data.configured === false) {
        showNotice(
          `<div>
            <p class="font-semibold mb-1">Configuration Vercel Analytics requise :</p>
            <p class="mb-2 text-xs">${data.error}</p>
            <p class="text-xs text-gray-600 dark:text-gray-300">
              1. Créez un jeton d'accès sur <a href="https://vercel.com/account/tokens" target="_blank" class="text-[#2271b1] underline font-medium">vercel.com/account/tokens</a>.<br />
              2. Définissez la variable <strong>VERCEL_TOKEN</strong> dans les paramètres de votre projet Vercel (ou dans votre fichier <code>.env</code> en local).<br />
              3. Si votre projet est associé à une équipe, vous pouvez également définir <strong>VERCEL_TEAM_ID</strong>.
            </p>
          </div>`,
          "warning"
        );
      } else if (data.error) {
        showNotice(`Erreur Vercel Analytics : ${data.error}`, "error");
      }

      renderSummary(data);
      renderChart(data.timeseries || [], data.granularity || "day");
      renderPages(data.pages || [], data.summary?.pageviews || 0);
      renderReferrers(data.referrers || [], data.summary?.pageviews || 0);
      renderCountries(data.countries || [], data.summary?.pageviews || 0);
      renderDevices(data.devices || [], data.summary?.pageviews || 0);

      if (rangeDatesLabel && data.since && data.until) {
        rangeDatesLabel.textContent = formatDateRange(data.since, data.until);
      }
    } catch (err: any) {
      showNotice(`Erreur de communication avec l'API : ${err?.message}`, "error");
    } finally {
      isLoading = false;
      if (refreshBtn) {
        refreshBtn.classList.remove("opacity-50", "pointer-events-none");
      }
    }
  }

  function renderSummary(data: any) {
    const pageviews = Number(data.summary?.pageviews || 0);
    const visitors = Number(data.summary?.visitors || 0);

    if (statPageviews) statPageviews.textContent = pageviews.toLocaleString("fr-FR");
    if (statVisitors) statVisitors.textContent = visitors.toLocaleString("fr-FR");

    if (statRatio) {
      const ratio = visitors > 0 ? (pageviews / visitors).toFixed(1) : "0";
      statRatio.textContent = ratio;
    }

    if (statDailyAvg) {
      let days = currentRange === "24h" ? 1 : currentRange === "7d" ? 7 : currentRange === "90d" ? 90 : 30;
      const avg = Math.round(pageviews / days);
      statDailyAvg.textContent = avg.toLocaleString("fr-FR");
    }
  }

  function renderChart(items: any[], granularity: string) {
    if (!chartContainer) return;

    if (!items || items.length === 0) {
      chartContainer.innerHTML = `<div class="w-full text-center text-xs text-gray-400 self-center">Aucune donnée de trafic disponible sur cette période.</div>`;
      return;
    }

    const maxPageviews = Math.max(...items.map((i) => Number(i.pageviews || 0)), 1);

    const barsHtml = items
      .map((item) => {
        const pv = Number(item.pageviews || 0);
        const vis = Number(item.visitors || 0);
        const pvHeight = Math.max(Math.round((pv / maxPageviews) * 100), 4);
        const visHeight = Math.max(Math.round((vis / maxPageviews) * 100), 2);

        const d = new Date(item.timestamp);
        const dateLabel =
          granularity === "hour"
            ? `${d.getHours()}h`
            : d.toLocaleDateString("fr-FR", { day: "numeric", month: "short" });

        return `
          <div class="flex-1 flex flex-col items-center justify-end h-full group relative min-w-[12px] px-0.5">
            <!-- Tooltip -->
            <div class="absolute bottom-full mb-2 hidden group-hover:flex flex-col items-center z-20 pointer-events-none whitespace-nowrap">
              <div class="bg-[#1d2327] text-white text-[11px] rounded py-1 px-2 shadow-lg border border-gray-700">
                <div class="font-medium text-gray-300 pb-0.5 border-b border-gray-700 mb-1">${dateLabel}</div>
                <div class="text-[#72aee6] font-semibold">${pv} page${pv > 1 ? "s" : ""} vue${pv > 1 ? "s" : ""}</div>
                <div class="text-white">${vis} visiteur${vis > 1 ? "s" : ""}</div>
              </div>
              <div class="w-2 h-2 bg-[#1d2327] rotate-45 -mt-1 border-r border-b border-gray-700"></div>
            </div>

            <!-- Double bar -->
            <div class="w-full flex items-end justify-center gap-0.5 h-full">
              <div class="w-1.5 sm:w-2.5 rounded-t bg-[#2271b1] group-hover:bg-[#135e96] transition-all" style="height: ${pvHeight}%;"></div>
              <div class="w-1.5 sm:w-2.5 rounded-t bg-[#72aee6] group-hover:bg-[#3858e9] transition-all" style="height: ${visHeight}%;"></div>
            </div>

            <!-- Date label -->
            <div class="text-[9px] sm:text-[10px] text-gray-400 dark:text-gray-500 mt-1 truncate max-w-full">
              ${dateLabel}
            </div>
          </div>
        `;
      })
      .join("");

    chartContainer.innerHTML = `
      <div class="w-full h-full flex items-end gap-0.5 sm:gap-1 pt-4 pb-1 border-b border-gray-200 dark:border-gray-700">
        ${barsHtml}
      </div>
    `;
  }

  function renderPages(pages: any[], totalViews: number) {
    if (!pagesBody) return;
    if (pagesCount) pagesCount.textContent = `${pages.length} page${pages.length > 1 ? "s" : ""}`;

    if (!pages || pages.length === 0) {
      pagesBody.innerHTML = `<tr><td colspan="3" class="p-4 text-center text-xs text-gray-400">Aucune donnée disponible.</td></tr>`;
      return;
    }

    pagesBody.innerHTML = pages
      .map((p) => {
        const pv = Number(p.pageviews || 0);
        const vis = Number(p.visitors || 0);
        const path = p.requestPath || "/";
        const pct = totalViews > 0 ? Math.round((pv / totalViews) * 100) : 0;

        return `
          <tr class="hover:bg-gray-50/60 dark:hover:bg-gray-800/40 transition-colors">
            <td>
              <div class="font-mono text-xs text-gray-900 dark:text-gray-100 font-medium">
                <a href="${path}" target="_blank" class="hover:underline text-[#2271b1]">${path}</a>
              </div>
              <div class="w-full bg-gray-100 dark:bg-gray-800 h-1 rounded-full mt-1.5 overflow-hidden">
                <div class="bg-[#2271b1] h-full rounded-full" style="width: ${pct}%"></div>
              </div>
            </td>
            <td class="text-right font-mono text-xs font-semibold text-gray-900 dark:text-gray-100">${pv.toLocaleString("fr-FR")}</td>
            <td class="text-right font-mono text-xs text-gray-500 dark:text-gray-400">${vis.toLocaleString("fr-FR")}</td>
          </tr>
        `;
      })
      .join("");
  }

  function renderReferrers(referrers: any[], totalViews: number) {
    if (!referrersBody) return;
    if (referrersCount) referrersCount.textContent = `${referrers.length} source${referrers.length > 1 ? "s" : ""}`;

    if (!referrers || referrers.length === 0) {
      referrersBody.innerHTML = `<tr><td colspan="3" class="p-4 text-center text-xs text-gray-400">Aucune donnée disponible.</td></tr>`;
      return;
    }

    referrersBody.innerHTML = referrers
      .map((r) => {
        const pv = Number(r.pageviews || 0);
        const vis = Number(r.visitors || 0);
        const host = r.referrerHostname || "Trafic direct / Aucun";
        const pct = totalViews > 0 ? Math.round((pv / totalViews) * 100) : 0;

        return `
          <tr class="hover:bg-gray-50/60 dark:hover:bg-gray-800/40 transition-colors">
            <td>
              <div class="text-xs text-gray-900 dark:text-gray-100 font-medium">
                ${host}
              </div>
              <div class="w-full bg-gray-100 dark:bg-gray-800 h-1 rounded-full mt-1.5 overflow-hidden">
                <div class="bg-[#2271b1] h-full rounded-full" style="width: ${pct}%"></div>
              </div>
            </td>
            <td class="text-right font-mono text-xs font-semibold text-gray-900 dark:text-gray-100">${pv.toLocaleString("fr-FR")}</td>
            <td class="text-right font-mono text-xs text-gray-500 dark:text-gray-400">${vis.toLocaleString("fr-FR")}</td>
          </tr>
        `;
      })
      .join("");
  }

  function renderCountries(countries: any[], totalViews: number) {
    if (!countriesBody) return;
    if (countriesCount) countriesCount.textContent = `${countries.length} pays`;

    if (!countries || countries.length === 0) {
      countriesBody.innerHTML = `<tr><td colspan="3" class="p-4 text-center text-xs text-gray-400">Aucune donnée disponible.</td></tr>`;
      return;
    }

    countriesBody.innerHTML = countries
      .map((c) => {
        const pv = Number(c.pageviews || 0);
        const vis = Number(c.visitors || 0);
        const code = c.country || "??";
        const name = getCountryName(code);
        const flag = getCountryFlag(code);
        const pct = totalViews > 0 ? Math.round((pv / totalViews) * 100) : 0;

        return `
          <tr class="hover:bg-gray-50/60 dark:hover:bg-gray-800/40 transition-colors">
            <td>
              <div class="flex items-center gap-2 text-xs text-gray-900 dark:text-gray-100 font-medium">
                <span class="text-base leading-none">${flag}</span>
                <span>${name}</span>
                <span class="text-[10px] text-gray-400 font-mono">(${code})</span>
              </div>
              <div class="w-full bg-gray-100 dark:bg-gray-800 h-1 rounded-full mt-1.5 overflow-hidden">
                <div class="bg-[#2271b1] h-full rounded-full" style="width: ${pct}%"></div>
              </div>
            </td>
            <td class="text-right font-mono text-xs font-semibold text-gray-900 dark:text-gray-100">${pv.toLocaleString("fr-FR")}</td>
            <td class="text-right font-mono text-xs text-gray-500 dark:text-gray-400">${vis.toLocaleString("fr-FR")}</td>
          </tr>
        `;
      })
      .join("");
  }

  function renderDevices(devices: any[], totalViews: number) {
    if (!devicesBody) return;
    if (devicesCount) devicesCount.textContent = `${devices.length} type${devices.length > 1 ? "s" : ""}`;

    if (!devices || devices.length === 0) {
      devicesBody.innerHTML = `<tr><td colspan="3" class="p-4 text-center text-xs text-gray-400">Aucune donnée disponible.</td></tr>`;
      return;
    }

    devicesBody.innerHTML = devices
      .map((d) => {
        const pv = Number(d.pageviews || 0);
        const vis = Number(d.visitors || 0);
        const { label, badgeClass } = formatDevice(d.deviceType);
        const pct = totalViews > 0 ? Math.round((pv / totalViews) * 100) : 0;

        return `
          <tr class="hover:bg-gray-50/60 dark:hover:bg-gray-800/40 transition-colors">
            <td>
              <div class="flex items-center gap-2">
                <span class="wp-badge ${badgeClass}">${label}</span>
                <span class="text-[11px] text-gray-400 font-mono">${pct}%</span>
              </div>
              <div class="w-full bg-gray-100 dark:bg-gray-800 h-1 rounded-full mt-1.5 overflow-hidden">
                <div class="bg-[#2271b1] h-full rounded-full" style="width: ${pct}%"></div>
              </div>
            </td>
            <td class="text-right font-mono text-xs font-semibold text-gray-900 dark:text-gray-100">${pv.toLocaleString("fr-FR")}</td>
            <td class="text-right font-mono text-xs text-gray-500 dark:text-gray-400">${vis.toLocaleString("fr-FR")}</td>
          </tr>
        `;
      })
      .join("");
  }

  // Événements sur les filtres de période
  rangeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const range = btn.dataset.range;
      if (!range || range === currentRange) return;

      currentRange = range;
      rangeButtons.forEach((b) => {
        b.classList.remove("active", "bg-[#2271b1]", "text-white", "font-medium");
      });
      btn.classList.add("active", "bg-[#2271b1]", "text-white", "font-medium");

      loadAnalytics();
    });
  });

  refreshBtn?.addEventListener("click", () => loadAnalytics());

  // Premier chargement
  loadAnalytics();
</script>
