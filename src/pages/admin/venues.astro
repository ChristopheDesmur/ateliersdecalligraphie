---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";

const { session } = authenticateRequest(Astro.request);
---
<Layout title="Administration — Lieux" noindex={true}>
  <div>
    {session ? (
      <div>
        <AdminPageHeader
          title="Lieux des cours"
          description="Adresse et créneau des cours collectifs hebdomadaires, affichés sur plusieurs pages du site."
          active="venues"
        >
          <div slot="actions">
            <button
              id="add-venue-btn"
              type="button"
              class="astro-btn astro-btn-primary text-xs"
            >
              + Ajouter un lieu
            </button>
          </div>
        </AdminPageHeader>

        <div id="venues-status" class="hidden mb-4 astro-notice" role="alert"></div>

        <!-- Table des lieux -->
        <div class="astro-table-wrap mb-8">
          <table class="astro-table">
            <thead>
              <tr>
                <th>Lieu</th>
                <th>Quartier</th>
                <th>Adresse</th>
                <th>Créneau</th>
                <th class="hidden sm:table-cell">Plan</th>
              </tr>
            </thead>
            <tbody id="venues-table-body">
              <tr>
                <td colspan="5" class="p-4 text-xs text-gray-400">Chargement des lieux…</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Formulaire d'ajout / modification -->
        <div id="venue-form-container" class="hidden astro-panel mb-10">
          <div class="astro-panel-header">
            <h2 id="venue-form-title" class="astro-panel-title">Ajouter un lieu</h2>
            <button type="button" id="venue-form-close-btn" class="text-xs text-[#646970] hover:text-[#2c3338] dark:hover:text-white cursor-pointer">
              Fermer
            </button>
          </div>
          <div class="astro-panel-body">
            <form id="venue-form">
              <input type="hidden" name="originalId" value="" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                  <label class="field-label">Nom</label>
                  <input name="name" required class="field-input" placeholder="Dojo Zen de Lyon" />
                </div>
                <div>
                  <label class="field-label">Quartier (facultatif)</label>
                  <input name="district" class="field-input" placeholder="Croix-Rousse" />
                </div>
                <div class="sm:col-span-2">
                  <label class="field-label">Adresse</label>
                  <input name="address" required class="field-input" placeholder="11, rue Dumenge, 69004 Lyon" />
                </div>
                <div>
                  <label class="field-label">Jour</label>
                  <input name="day" required class="field-input" placeholder="lundi" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="field-label">Heure de début</label>
                    <input name="time_start" type="time" required class="field-input" />
                  </div>
                  <div>
                    <label class="field-label">Heure de fin</label>
                    <input name="time_end" type="time" required class="field-input" />
                  </div>
                </div>
                <div>
                  <label class="field-label">Requête plan (facultative)</label>
                  <input name="map_query" class="field-input font-mono text-xs" placeholder="Zen+Dojo+11+rue+Dumenge+Lyon" />
                  <p class="field-help">Utilisée pour un lien Google Maps externe.</p>
                </div>
                <div>
                  <label class="field-label">URL de plan intégré (facultative)</label>
                  <input name="map_embed" class="field-input font-mono text-xs" placeholder="https://www.google.com/maps/embed?…" />
                  <p class="field-help">Carte interactive affichée directement sur la page.</p>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-[#dcdcde] dark:border-[#2c3338] flex items-center gap-2">
                <button type="submit" id="venue-save-btn" class="astro-btn astro-btn-primary text-xs cursor-pointer disabled:opacity-60">
                  Enregistrer le lieu
                </button>
                <button type="button" id="venue-cancel-btn" class="astro-btn text-xs cursor-pointer">
                  Annuler
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>
</Layout>

<script>
  let csrfToken = "";
  let venues: Record<string, any> = {};

  const tableBody = document.getElementById("venues-table-body");
  const statusEl = document.getElementById("venues-status");
  const formContainer = document.getElementById("venue-form-container");
  const form = document.getElementById("venue-form") as HTMLFormElement | null;
  const formTitle = document.getElementById("venue-form-title");
  const saveBtn = document.getElementById("venue-save-btn") as HTMLButtonElement | null;

  function showStatus(message: string, kind: "success" | "error") {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden");
    statusEl.className =
      "mb-4 astro-notice " +
      (kind === "success"
        ? "astro-notice-success text-[#00a32a] dark:text-[#4ac26b]"
        : "astro-notice-error text-[#d63638] dark:text-[#ff8585]");
  }

  function renderList() {
    if (!tableBody) return;
    const ids = Object.keys(venues);
    if (ids.length === 0) {
      tableBody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-xs text-[#646970] dark:text-[#8c8f94]">Aucun lieu configuré.</td></tr>`;
      return;
    }
    tableBody.innerHTML = ids
      .map((id) => {
        const v = venues[id];
        return `
        <tr>
          <td>
            <div class="font-medium text-[#1d2327] dark:text-white leading-snug">${v.name}</div>
            <div class="row-actions">
              <button type="button" data-edit="${id}">Modifier</button>
              <span class="text-[#8c8f94]">|</span>
              <button type="button" data-delete="${id}" class="delete-action">Supprimer</button>
            </div>
          </td>
          <td class="text-xs text-[#646970] dark:text-[#8c8f94]">${v.district || "—"}</td>
          <td class="text-xs text-[#646970] dark:text-[#8c8f94]">${v.address}</td>
          <td class="text-xs text-[#2c3338] dark:text-[#dcdcde] whitespace-nowrap font-medium">
            <span class="capitalize">${v.day}</span> ${v.time_start}–${v.time_end}
          </td>
          <td class="text-xs text-[#646970] dark:text-[#8c8f94] whitespace-nowrap hidden sm:table-cell">
            ${
              v.map_query
                ? `<a href="https://maps.google.com/?q=${v.map_query}" target="_blank" rel="noopener noreferrer" class="text-[#2271b1] dark:text-[#72aee6] hover:underline">Google Maps ↗</a>`
                : "—"
            }
          </td>
        </tr>`;
      })
      .join("");

    tableBody.querySelectorAll<HTMLButtonElement>("[data-edit]").forEach((btn) =>
      btn.addEventListener("click", () => openForm(btn.dataset.edit!, venues[btn.dataset.edit!]))
    );
    tableBody.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((btn) =>
      btn.addEventListener("click", () => deleteVenue(btn.dataset.delete!, venues[btn.dataset.delete!]))
    );
  }

  document.getElementById("venue-form-close-btn")?.addEventListener("click", closeForm);

  function openForm(id: string | null, v: any | null) {
    if (!form || !formContainer || !formTitle) return;
    form.reset();
    (form.elements.namedItem("originalId") as HTMLInputElement).value = id ?? "";
    formTitle.textContent = v ? `Modifier « ${v.name} »` : "Ajouter un lieu";

    if (v) {
      const set = (name: string, value: any) => {
        const el = form.elements.namedItem(name) as HTMLInputElement | null;
        if (el) el.value = value ?? "";
      };
      set("name", v.name);
      set("district", v.district);
      set("address", v.address);
      set("day", v.day);
      set("time_start", v.time_start);
      set("time_end", v.time_end);
      set("map_query", v.map_query);
      set("map_embed", v.map_embed);
    }

    formContainer.classList.remove("hidden");
    formContainer.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function closeForm() {
    formContainer?.classList.add("hidden");
  }

  async function deleteVenue(id: string, v: any) {
    if (!confirm(`Supprimer définitivement « ${v.name} » ?`)) return;
    try {
      const res = await fetch("/api/admin/venues", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify({ action: "delete", id }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Lieu supprimé et site republié.", "success");
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    }
  }

  async function load() {
    const [venuesRes, authRes] = await Promise.all([fetch("/api/admin/venues"), fetch("/api/admin/auth")]);
    const data = await venuesRes.json();
    const authData = await authRes.json();
    csrfToken = authData.csrfToken || "";

    if (!venuesRes.ok) {
      if (listEl) listEl.innerHTML = `<p class="text-sm text-rose-500">${data.error}</p>`;
      return;
    }

    venues = data.venues;
    renderList();
  }

  document.getElementById("add-venue-btn")?.addEventListener("click", () => openForm(null, null));
  document.getElementById("venue-cancel-btn")?.addEventListener("click", closeForm);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!saveBtn || !form) return;
    saveBtn.disabled = true;
    saveBtn.textContent = "Enregistrement…";

    const fd = new FormData(form);
    const originalId = String(fd.get("originalId") || "");
    const venue = {
      name: fd.get("name"),
      district: fd.get("district"),
      address: fd.get("address"),
      day: fd.get("day"),
      time_start: fd.get("time_start"),
      time_end: fd.get("time_end"),
      map_query: fd.get("map_query"),
      map_embed: fd.get("map_embed"),
    };

    try {
      const res = await fetch("/api/admin/venues", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify(originalId ? { action: "update", originalId, venue } : { action: "create", venue }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Lieu enregistré et site republié.", "success");
      closeForm();
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Enregistrer";
    }
  });

  load();
</script>
