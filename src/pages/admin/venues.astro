---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminNav from "@/components/admin/AdminNav.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";

const { session } = authenticateRequest(Astro.request);
---
<Layout title="Administration — Lieux" noindex={true}>
  <div class="max-w-4xl">
    {session ? (
      <div>
        <AdminNav active="venues" />
        <div class="flex flex-wrap items-center justify-between mb-4 gap-3">
          <div>
            <h1 class="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-white">Lieux des cours</h1>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
              Adresse et créneau des cours collectifs hebdomadaires, affichés sur plusieurs pages du site.
            </p>
          </div>
          <button
            id="add-venue-btn"
            type="button"
            class="px-3 py-1.5 rounded-md bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-xs transition cursor-pointer shrink-0"
          >
            + Ajouter
          </button>
        </div>

        <div id="venues-status" class="hidden mb-4 p-2.5 rounded-md text-xs font-medium"></div>

        <div id="venues-list" class="space-y-3 mb-10">
          <p class="text-sm text-gray-400">Chargement…</p>
        </div>

        <!-- Formulaire d'ajout / modification -->
        <div id="venue-form-container" class="hidden bg-white dark:bg-[#1e2327] border border-gray-300 dark:border-gray-700 rounded-md p-4 sm:p-6 shadow-xs mb-10">
          <h2 id="venue-form-title" class="font-semibold text-gray-900 dark:text-white mb-4 text-base">Ajouter un lieu</h2>
          <form id="venue-form">
            <input type="hidden" name="originalId" value="" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
              <div>
                <label class="field-label">Nom</label>
                <input name="name" required class="field-input" placeholder="Dojo Zen de Lyon" />
              </div>
              <div>
                <label class="field-label">Quartier (facultatif)</label>
                <input name="district" class="field-input" placeholder="Croix-Rousse" />
              </div>
              <div class="sm:col-span-2">
                <label class="field-label">Adresse</label>
                <input name="address" required class="field-input" placeholder="11, rue Dumenge, 69004 Lyon" />
              </div>
              <div>
                <label class="field-label">Jour</label>
                <input name="day" required class="field-input" placeholder="lundi" />
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="field-label">Heure de début</label>
                  <input name="time_start" type="time" required class="field-input" />
                </div>
                <div>
                  <label class="field-label">Heure de fin</label>
                  <input name="time_end" type="time" required class="field-input" />
                </div>
              </div>
              <div>
                <label class="field-label">Requête plan (facultative)</label>
                <input name="map_query" class="field-input" placeholder="Zen+Dojo+11+rue+Dumenge+Lyon" />
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Utilisée pour un lien Google Maps.</p>
              </div>
              <div>
                <label class="field-label">URL de plan intégré (facultative)</label>
                <input name="map_embed" class="field-input" placeholder="https://www.google.com/maps/embed?…" />
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Utilisée pour une carte affichée directement sur la page.</p>
              </div>
            </div>

            <div class="mt-6 pt-5 border-t border-gray-100 dark:border-gray-800 flex items-center gap-3">
              <button type="submit" id="venue-save-btn" class="px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-xs transition cursor-pointer disabled:opacity-60">
                Enregistrer
              </button>
              <button type="button" id="venue-cancel-btn" class="px-4 py-2 rounded-md border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 text-xs font-medium hover:bg-gray-100 dark:hover:bg-gray-700 transition cursor-pointer">
                Annuler
              </button>
            </div>
          </form>
        </div>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>
</Layout>

<script>
  let csrfToken = "";
  let venues: Record<string, any> = {};

  const listEl = document.getElementById("venues-list");
  const statusEl = document.getElementById("venues-status");
  const formContainer = document.getElementById("venue-form-container");
  const form = document.getElementById("venue-form") as HTMLFormElement | null;
  const formTitle = document.getElementById("venue-form-title");
  const saveBtn = document.getElementById("venue-save-btn") as HTMLButtonElement | null;

  function showStatus(message: string, kind: "success" | "error") {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden");
    statusEl.className =
      "mb-4 p-3 rounded-md text-xs font-medium " +
      (kind === "success"
        ? "bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800"
        : "bg-rose-50 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800");
  }

  function renderList() {
    if (!listEl) return;
    const ids = Object.keys(venues);
    if (ids.length === 0) {
      listEl.innerHTML = `<p class="text-sm text-gray-400">Aucun lieu.</p>`;
      return;
    }
    listEl.innerHTML = ids
      .map((id) => {
        const v = venues[id];
        return `
      <div class="p-3 sm:p-4 flex flex-col sm:flex-row sm:items-start justify-between gap-2 sm:gap-4 border border-gray-300 dark:border-gray-700 rounded-md bg-white dark:bg-[#1e2327] shadow-xs">
        <div class="min-w-0">
          <p class="font-semibold text-sm text-gray-900 dark:text-white">${v.name}</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">${v.address} · ${v.day} ${v.time_start}–${v.time_end}</p>
        </div>
        <div class="flex items-center gap-3 shrink-0 pt-1 sm:pt-0">
          <button data-edit="${id}" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline cursor-pointer">Modifier</button>
          <button data-delete="${id}" class="text-xs font-semibold text-rose-600 dark:text-rose-400 hover:underline cursor-pointer">Supprimer</button>
        </div>
      </div>`;
      })
      .join("");

    listEl.querySelectorAll<HTMLButtonElement>("[data-edit]").forEach((btn) =>
      btn.addEventListener("click", () => openForm(btn.dataset.edit!, venues[btn.dataset.edit!]))
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((btn) =>
      btn.addEventListener("click", () => deleteVenue(btn.dataset.delete!, venues[btn.dataset.delete!]))
    );
  }

  function openForm(id: string | null, v: any | null) {
    if (!form || !formContainer || !formTitle) return;
    form.reset();
    (form.elements.namedItem("originalId") as HTMLInputElement).value = id ?? "";
    formTitle.textContent = v ? `Modifier « ${v.name} »` : "Ajouter un lieu";

    if (v) {
      const set = (name: string, value: any) => {
        const el = form.elements.namedItem(name) as HTMLInputElement | null;
        if (el) el.value = value ?? "";
      };
      set("name", v.name);
      set("district", v.district);
      set("address", v.address);
      set("day", v.day);
      set("time_start", v.time_start);
      set("time_end", v.time_end);
      set("map_query", v.map_query);
      set("map_embed", v.map_embed);
    }

    formContainer.classList.remove("hidden");
    formContainer.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function closeForm() {
    formContainer?.classList.add("hidden");
  }

  async function deleteVenue(id: string, v: any) {
    if (!confirm(`Supprimer définitivement « ${v.name} » ?`)) return;
    try {
      const res = await fetch("/api/admin/venues", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify({ action: "delete", id }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Lieu supprimé et site republié.", "success");
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    }
  }

  async function load() {
    const [venuesRes, authRes] = await Promise.all([fetch("/api/admin/venues"), fetch("/api/admin/auth")]);
    const data = await venuesRes.json();
    const authData = await authRes.json();
    csrfToken = authData.csrfToken || "";

    if (!venuesRes.ok) {
      if (listEl) listEl.innerHTML = `<p class="text-sm text-rose-500">${data.error}</p>`;
      return;
    }

    venues = data.venues;
    renderList();
  }

  document.getElementById("add-venue-btn")?.addEventListener("click", () => openForm(null, null));
  document.getElementById("venue-cancel-btn")?.addEventListener("click", closeForm);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!saveBtn || !form) return;
    saveBtn.disabled = true;
    saveBtn.textContent = "Enregistrement…";

    const fd = new FormData(form);
    const originalId = String(fd.get("originalId") || "");
    const venue = {
      name: fd.get("name"),
      district: fd.get("district"),
      address: fd.get("address"),
      day: fd.get("day"),
      time_start: fd.get("time_start"),
      time_end: fd.get("time_end"),
      map_query: fd.get("map_query"),
      map_embed: fd.get("map_embed"),
    };

    try {
      const res = await fetch("/api/admin/venues", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify(originalId ? { action: "update", originalId, venue } : { action: "create", venue }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Lieu enregistré et site republié.", "success");
      closeForm();
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Enregistrer";
    }
  });

  load();
</script>
