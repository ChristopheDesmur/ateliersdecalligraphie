---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";

const { session } = authenticateRequest(Astro.request);
---
<Layout title="Administration — Événements" noindex={true}>
  <div>
    {session ? (
      <div>
        <AdminPageHeader
          title="Événements"
          description="Calendrier des cours, stages et interventions passés et à venir."
          active="events"
        >
          <div slot="actions">
            <button
              id="add-event-btn"
              type="button"
              class="wp-btn wp-btn-primary text-xs"
            >
              + Ajouter un événement
            </button>
          </div>
        </AdminPageHeader>

        <div id="events-status" class="hidden mb-4 wp-notice" role="alert"></div>

        <div class="wp-panel p-2 sm:p-2.5 mb-3 flex items-center justify-between gap-3 text-xs">
          <div class="w-full max-w-sm">
            <label for="events-search" class="sr-only">Rechercher un événement</label>
            <input
              type="search"
              id="events-search"
              class="field-input text-xs"
              placeholder="Rechercher un événement (titre ou lieu)…"
              autocomplete="off"
            />
          </div>
        </div>

        <div id="events-list" class="space-y-3 mb-8">
          <p class="text-sm text-gray-400">Chargement des événements…</p>
        </div>

        <!-- Formulaire d'ajout / modification -->
        <div id="event-form-container" class="hidden wp-panel mb-10">
          <div class="wp-panel-header">
            <h2 id="event-form-title" class="wp-panel-title">Ajouter un événement</h2>
            <button type="button" id="event-form-close-btn" class="text-xs text-[#646970] hover:text-[#2c3338] dark:hover:text-white cursor-pointer">
              Fermer
            </button>
          </div>
          <div class="wp-panel-body">
            <form id="event-form" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <input type="hidden" name="originalYear" value="" />
              <input type="hidden" name="originalIndex" value="" />

              <div>
                <label class="field-label">Début (AAAA-MM-JJ HH:mm)</label>
                <input name="from" required class="field-input font-mono text-xs" placeholder="2026-01-20 00:00" />
              </div>
              <div>
                <label class="field-label">Fin (AAAA-MM-JJ HH:mm)</label>
                <input name="to" required class="field-input font-mono text-xs" placeholder="2026-01-20 23:59" />
              </div>
              <div class="sm:col-span-2">
                <label class="field-label">Titre</label>
                <input name="titre" required class="field-input" placeholder="Ateliers de calligraphie chinoise" />
              </div>
              <div class="sm:col-span-2">
                <label class="field-label">Lieu</label>
                <select name="lieu" id="lieu-select" required class="field-input">
                  <option value="" disabled selected>— Sélectionner un lieu —</option>
                </select>
                <p class="field-help">
                  Lieu introuvable ? Ajoutez-le d'abord dans <a href="/admin/institutions" class="text-[#2271b1] dark:text-[#72aee6] hover:underline">Institutions</a>.
                </p>
              </div>
              <div class="sm:col-span-2">
                <label class="field-label">Détails (facultatif)</label>
                <textarea name="details" rows="2" class="field-input"></textarea>
              </div>
              <div class="sm:col-span-2">
                <label class="field-label">Lien externe (facultatif)</label>
                <input name="href" class="field-input font-mono text-xs" placeholder="https://…" />
              </div>

              <div class="sm:col-span-2 flex items-center gap-2 pt-3 border-t border-[#dcdcde] dark:border-[#2c3338]">
                <button type="submit" id="event-save-btn" class="wp-btn wp-btn-primary text-xs cursor-pointer disabled:opacity-60">
                  Enregistrer l'événement
                </button>
                <button type="button" id="event-cancel-btn" class="wp-btn text-xs cursor-pointer">
                  Annuler
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>
</Layout>

<script>
  import { INSTITUTION_CATEGORIES, institutionCategoryFor } from "@/lib/admin/institution-categories";

  let csrfToken = "";
  let years: Record<string, any[]> = {};
  let institutions: Record<string, any> = {};

  const listEl = document.getElementById("events-list");
  const statusEl = document.getElementById("events-status");
  const searchInput = document.getElementById("events-search") as HTMLInputElement | null;
  const formContainer = document.getElementById("event-form-container");
  const form = document.getElementById("event-form") as HTMLFormElement | null;
  const formTitle = document.getElementById("event-form-title");
  const saveBtn = document.getElementById("event-save-btn") as HTMLButtonElement | null;
  const lieuSelect = document.getElementById("lieu-select") as HTMLSelectElement | null;

  function normalize(s: string): string {
    return s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  }

  // Résout "@institution:id[:document]" en nom lisible pour l'affichage de la
  // liste (le formulaire d'édition, lui, montre déjà des libellés via le
  // <select> peuplé par populateLieuSelect) — la variante de document
  // éventuelle n'a pas besoin d'être distinguée dans ce résumé compact.
  function resolveLieuDisplay(lieu: string): string {
    const m = /^@institution:([\w-]+)(?::([\w-]+))?$/.exec(lieu || "");
    if (!m) return lieu || "—";
    return institutions[m[1]]?.name ?? lieu;
  }

  const COLLAPSE_KEY_PREFIX = "admin-events-collapsed:";
  function isCollapsed(year: string): boolean {
    const stored = sessionStorage.getItem(COLLAPSE_KEY_PREFIX + year);
    if (stored) return stored === "closed";
    // Par défaut, seule l'année en cours est dépliée : c'est celle où se
    // trouvent les événements encore actifs et les plus susceptibles d'être
    // modifiés ; les autres années sont un registre consultable au besoin.
    return year !== String(new Date().getFullYear());
  }
  function setCollapsed(year: string, collapsed: boolean) {
    sessionStorage.setItem(COLLAPSE_KEY_PREFIX + year, collapsed ? "closed" : "open");
  }

  // Une option par institution, plus une option par document quand elle en a
  // (ex. OVPAR : une option "sans document" et une par brochure), regroupées
  // par catégorie comme sur /admin/institutions.
  function populateLieuSelect(institutions: Record<string, any>) {
    if (!lieuSelect) return;
    const byCategory = new Map<string, { value: string; label: string }[]>();
    for (const id of Object.keys(institutions)) {
      const inst = institutions[id];
      const label = institutionCategoryFor(inst.name);
      if (!byCategory.has(label)) byCategory.set(label, []);
      const options = byCategory.get(label)!;
      const documents = inst.documents ? Object.keys(inst.documents) : [];
      const shortOrFull = inst.short_name ?? inst.name;
      if (documents.length === 0) {
        options.push({ value: `@institution:${id}`, label: inst.name });
      } else {
        options.push({ value: `@institution:${id}`, label: `${inst.name} (sans document)` });
        for (const key of documents) {
          options.push({ value: `@institution:${id}:${key}`, label: `${shortOrFull} — ${key}` });
        }
      }
    }
    for (const options of byCategory.values()) {
      options.sort((a, b) => a.label.localeCompare(b.label, "fr"));
    }

    const placeholder = `<option value="" disabled selected>— Sélectionner un lieu —</option>`;
    lieuSelect.innerHTML =
      placeholder +
      INSTITUTION_CATEGORIES.map((c) => c.label)
        .filter((label) => byCategory.has(label))
        .map((label) => {
          const options = byCategory
            .get(label)!
            .map((o) => `<option value="${o.value}">${o.label}</option>`)
            .join("");
          return `<optgroup label="${label}">${options}</optgroup>`;
        })
        .join("");
  }

  function showStatus(message: string, kind: "success" | "error") {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden");
    statusEl.className =
      "mb-4 wp-notice " +
      (kind === "success"
        ? "wp-notice-success text-[#00a32a] dark:text-[#4ac26b]"
        : "wp-notice-error text-[#d63638] dark:text-[#ff8585]");
  }

  function parseEventDate(dateStr: string): number {
    const parsed = new Date(String(dateStr).trim().replace(" ", "T"));
    return Number.isNaN(parsed.getTime()) ? 0 : parsed.getTime();
  }

  // Un événement dont la date de fin est dépassée devient un registre
  // historique : lecture seule, quelle que soit son année — cf. la même
  // règle appliquée côté serveur.
  function isLockedPastEvent(ev: any): boolean {
    const to = parseEventDate(ev.to);
    return to !== 0 && to < Date.now();
  }

  function eventRow(year: string, i: number, ev: any): string {
    const past = isLockedPastEvent(ev);
    return `
      <tr class="${past ? "opacity-75 bg-[#fafafa] dark:bg-[#181d21]" : ""}">
        <td>
          <div class="font-medium text-[#1d2327] dark:text-white leading-snug">${ev.titre}</div>
          ${ev.details ? `<div class="text-[11px] text-[#646970] dark:text-[#8c8f94] mt-0.5">${ev.details}</div>` : ""}
          <div class="row-actions">
            ${
              past
                ? `<span class="text-[11px] text-[#8c8f94]">Événement passé (archivé)</span>`
                : `<button type="button" data-edit-year="${year}" data-edit-index="${i}">Modifier</button>
                   <span class="text-[#8c8f94]">|</span>
                   <button type="button" data-delete-year="${year}" data-delete-index="${i}" class="delete-action">Supprimer</button>`
            }
            ${
              ev.href
                ? `<span class="text-[#8c8f94]">|</span>
                   <a href="${ev.href}" target="_blank" rel="noopener noreferrer">Lien ↗</a>`
                : ""
            }
          </div>
        </td>
        <td class="text-xs whitespace-nowrap text-[#2c3338] dark:text-[#dcdcde]">
          <div>${ev.from}</div>
          <div class="text-[11px] text-[#646970] dark:text-[#8c8f94]">→ ${ev.to}</div>
        </td>
        <td class="text-xs text-[#646970] dark:text-[#8c8f94] whitespace-nowrap">
          ${resolveLieuDisplay(ev.lieu)}
        </td>
        <td class="whitespace-nowrap">
          <span class="wp-badge ${past ? "wp-badge-muted" : "wp-badge-success"}">
            ${past ? "Passé" : "À venir"}
          </span>
        </td>
      </tr>`;
  }

  function renderList() {
    if (!listEl) return;
    const query = normalize(searchInput?.value.trim() ?? "");
    const sortedYears = Object.keys(years).sort((a, b) => Number(b) - Number(a));
    if (sortedYears.length === 0) {
      listEl.innerHTML = `<p class="text-xs text-gray-400">Aucun événement.</p>`;
      return;
    }

    // Indices originaux conservés (nécessaires à Modifier/Supprimer) même
    // lorsqu'une recherche ne montre qu'un sous-ensemble des événements.
    const matches: Record<string, number[]> = {};
    let totalMatches = 0;
    for (const year of sortedYears) {
      const indices = (years[year] || [])
        .map((ev, i) => i)
        .filter((i) => {
          if (!query) return true;
          const ev = years[year][i];
          return normalize(ev.titre).includes(query) || normalize(resolveLieuDisplay(ev.lieu)).includes(query);
        })
        .sort((a, b) => parseEventDate(years[year][b].from) - parseEventDate(years[year][a].from));
      if (indices.length) matches[year] = indices;
      totalMatches += indices.length;
    }

    if (totalMatches === 0) {
      listEl.innerHTML = `<div class="wp-panel p-4 text-center text-xs text-[#646970] dark:text-[#8c8f94]">Aucun résultat pour « ${searchInput?.value ?? ""} ».</div>`;
      return;
    }

    // Object.keys(matches) ne peut pas être utilisé ici : des clés qui
    // ressemblent à des indices de tableau (toute année, "2007".."2026")
    // sont TOUJOURS énumérées par ordre numérique croissant par le moteur
    // JS, quel que soit l'ordre d'insertion — cela écraserait silencieusement
    // le tri décroissant déjà calculé dans sortedYears.
    listEl.innerHTML = sortedYears
      .filter((year) => matches[year])
      .map((year) => {
        const indices = matches[year];
        const rows = indices.map((i) => eventRow(year, i, years[year][i])).join("");
        const collapsed = query ? false : isCollapsed(year);
        return `
          <div class="wp-panel mb-3">
            <button
              type="button"
              class="year-toggle wp-panel-header w-full flex items-center justify-between text-left cursor-pointer hover:bg-[#f0f0f1] dark:hover:bg-[#21272c] transition"
              data-year="${year}"
              aria-expanded="${!collapsed}"
              aria-controls="year-${year}"
            >
              <span class="wp-panel-title font-semibold text-xs text-[#1d2327] dark:text-white">Année ${year}</span>
              <span class="flex items-center gap-2 shrink-0">
                <span class="text-xs text-[#646970] dark:text-[#8c8f94]">${indices.length} événement${indices.length > 1 ? "s" : ""}</span>
                <span class="text-xs text-[#8c8f94]" aria-hidden="true">${collapsed ? "▸" : "▾"}</span>
              </span>
            </button>
            <div id="year-${year}" class="overflow-x-auto" ${collapsed ? "hidden" : ""}>
              <table class="wp-table">
                <thead>
                  <tr>
                    <th>Titre &amp; Actions</th>
                    <th style="width: 170px;">Dates</th>
                    <th style="width: 200px;">Lieu</th>
                    <th style="width: 90px;">Statut</th>
                  </tr>
                </thead>
                <tbody>
                  ${rows}
                </tbody>
              </table>
            </div>
          </div>`;
      })
      .join("");

    listEl.querySelectorAll<HTMLButtonElement>(".year-toggle").forEach((btn) =>
      btn.addEventListener("click", () => {
        const year = btn.dataset.year!;
        const content = document.getElementById(`year-${year}`);
        if (!content) return;
        const nowCollapsed = !content.hasAttribute("hidden");
        content.toggleAttribute("hidden", nowCollapsed);
        btn.setAttribute("aria-expanded", String(!nowCollapsed));
        const arrow = btn.querySelector('[aria-hidden="true"]');
        if (arrow) arrow.textContent = nowCollapsed ? "▸" : "▾";
        setCollapsed(year, nowCollapsed);
      })
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-edit-year]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const year = btn.dataset.editYear!;
        const index = Number(btn.dataset.editIndex);
        openForm(year, index, years[year][index]);
      })
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-delete-year]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const year = btn.dataset.deleteYear!;
        const index = Number(btn.dataset.deleteIndex);
        deleteEvent(year, index, years[year][index]);
      })
    );
  }

  document.getElementById("event-form-close-btn")?.addEventListener("click", closeForm);

  searchInput?.addEventListener("input", renderList);

  function openForm(year: string | null, index: number | null, event: any | null) {
    if (!form || !formContainer || !formTitle) return;
    form.reset();
    (form.elements.namedItem("originalYear") as HTMLInputElement).value = year ?? "";
    (form.elements.namedItem("originalIndex") as HTMLInputElement).value = index === null ? "" : String(index);
    formTitle.textContent = event ? `Modifier « ${event.titre} »` : "Ajouter un événement";

    if (event) {
      const set = (name: string, value: any) => {
        const el = form.elements.namedItem(name) as HTMLInputElement | null;
        if (el) el.value = value ?? "";
      };
      set("from", event.from);
      set("to", event.to);
      set("titre", event.titre);
      set("lieu", event.lieu);
      set("details", event.details);
      set("href", event.href);
    }

    formContainer.classList.remove("hidden");
    formContainer.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function closeForm() {
    formContainer?.classList.add("hidden");
  }

  async function deleteEvent(year: string, index: number, event: any) {
    if (!confirm(`Supprimer définitivement « ${event.titre} » ?`)) return;
    try {
      const res = await fetch("/api/admin/events", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify({ action: "delete", year, index }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Événement supprimé et site republié.", "success");
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    }
  }

  async function load() {
    const [eventsRes, institutionsRes, authRes] = await Promise.all([
      fetch("/api/admin/events"),
      fetch("/api/admin/institutions"),
      fetch("/api/admin/auth"),
    ]);
    const data = await eventsRes.json();
    const institutionsData = await institutionsRes.json().catch(() => ({ institutions: {} }));
    const authData = await authRes.json();
    csrfToken = authData.csrfToken || "";

    if (!eventsRes.ok) {
      if (listEl) listEl.innerHTML = `<p class="text-sm text-rose-500">${data.error}</p>`;
      return;
    }

    institutions = institutionsData.institutions || {};
    populateLieuSelect(institutions);
    years = data.years;
    renderList();
  }

  document.getElementById("add-event-btn")?.addEventListener("click", () => openForm(null, null, null));
  document.getElementById("event-cancel-btn")?.addEventListener("click", closeForm);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!saveBtn || !form) return;
    saveBtn.disabled = true;
    saveBtn.textContent = "Enregistrement…";

    const fd = new FormData(form);
    const originalYear = String(fd.get("originalYear") || "");
    const originalIndex = fd.get("originalIndex");
    const event = {
      from: fd.get("from"),
      to: fd.get("to"),
      titre: fd.get("titre"),
      lieu: fd.get("lieu"),
      details: fd.get("details"),
      href: fd.get("href"),
    };

    try {
      const res = await fetch("/api/admin/events", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify(
          originalYear && originalIndex !== ""
            ? { action: "update", originalYear, originalIndex: Number(originalIndex), event }
            : { action: "create", event }
        ),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Événement enregistré et site republié.", "success");
      closeForm();
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Enregistrer";
    }
  });

  load();
</script>
