---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AdminPageHeader from "@/components/admin/AdminPageHeader.astro";
import LoginGate from "@/components/admin/LoginGate.astro";
import { authenticateRequest } from "@/lib/admin/auth";

const { session } = authenticateRequest(Astro.request);
---
<Layout title="Administration — FAQ" noindex={true}>
  <div>
    {session ? (
      <div>
        <AdminPageHeader
          title="Foire aux questions (FAQ)"
          description="Gérez les questions fréquentes affichées sur /faq et le teaser de la page d'accueil."
          active="faq"
        >
          <div slot="actions">
            <button
              id="add-faq-btn"
              type="button"
              class="astro-btn astro-btn-primary text-xs"
            >
              + Ajouter une question
            </button>
          </div>
        </AdminPageHeader>

        <div id="faq-status" class="hidden mb-4 astro-notice" role="alert"></div>

        <!-- Filtres et recherche (Panel Astro Toolbar) -->
        <div class="astro-panel p-2.5 mb-4 flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center justify-between text-xs">
          <div class="w-full sm:w-72">
            <input
              type="search"
              id="faq-search-input"
              placeholder="Rechercher une question ou mot-clé…"
              class="field-input text-xs"
            />
          </div>
          <div id="faq-category-filters" class="flex items-center gap-1.5 flex-wrap w-full sm:w-auto">
            <!-- Rempli dynamiquement -->
          </div>
        </div>

        <!-- Liste des FAQ groupées par catégories -->
        <div id="faq-list" class="space-y-4 mb-8">
          <div class="astro-panel p-4 text-xs text-gray-500 dark:text-gray-400">Chargement des questions…</div>
        </div>

        <!-- Formulaire d'ajout / modification (Panel Astro) -->
        <div id="faq-form-container" class="hidden astro-panel mb-10">
          <div class="astro-panel-header">
            <h2 id="faq-form-title" class="astro-panel-title">Ajouter une question</h2>
          </div>
          <div class="astro-panel-body">
            <form id="faq-form">
              <input type="hidden" name="originalId" value="" />

              <div class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
                  <div class="sm:col-span-2">
                    <label class="field-label" for="faq-category-select">Catégorie</label>
                    <div class="space-y-2">
                      <select id="faq-category-select" class="field-input text-xs" required>
                        <option value="">-- Choisir une catégorie existante --</option>
                        <option value="__new__">+ Créer une nouvelle catégorie…</option>
                      </select>
                      <div id="faq-new-category-wrapper" class="hidden">
                        <input
                          type="text"
                          id="faq-category-new-input"
                          class="field-input text-xs sm:text-sm"
                          placeholder="Nom de la nouvelle catégorie"
                        />
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                          Saisissez le nom de la nouvelle catégorie à créer.
                        </p>
                      </div>
                    </div>
                  </div>
                  <div>
                    <label class="field-label">Ordre d'affichage</label>
                    <input
                      name="order"
                      type="number"
                      min="1"
                      class="field-input text-xs"
                      placeholder="Auto (1, 2, 3…)"
                    />
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                      Position relative dans la catégorie.
                    </p>
                  </div>
                </div>

                <div>
                  <label class="field-label">Question</label>
                  <textarea
                    name="question"
                    id="faq-question-input"
                    required
                    rows="2"
                    class="field-input text-xs"
                    placeholder="ex. Faut-il parler ou comprendre le chinois pour pratiquer la calligraphie ?"
                  ></textarea>
                </div>

                <div>
                  <div class="flex items-center justify-between mb-1">
                    <label class="field-label mb-0">Réponse</label>
                    <button
                      type="button"
                      id="toggle-variables-btn"
                      class="text-xs text-[#2271b1] hover:underline cursor-pointer font-medium"
                    >
                      + Insérer une variable de prix/contact
                    </button>
                  </div>

                  <!-- Tiroir des variables disponibles -->
                  <div id="variables-palette" class="hidden mb-2.5 p-3 rounded bg-gray-50 dark:bg-[#1d2327] border border-gray-200 dark:border-gray-700 text-xs">
                    <p class="font-semibold text-gray-900 dark:text-gray-200 mb-2">
                      Variables dynamiques (remplacées automatiquement à l'affichage) :
                    </p>
                    <div class="flex flex-wrap gap-1.5">
                      <button type="button" data-insert="{{prices.cours_collectifs.trimestre}}" class="var-btn" title="Tarif trimestre cours collectifs">trimestre (cours)</button>
                      <button type="button" data-insert="{{prices.cours_collectifs.seances}}" class="var-btn" title="Nombre de séances par trimestre">séances (trimestre)</button>
                      <button type="button" data-insert="{{prices.cours_individuel_domicile.ttc_heure}}" class="var-btn" title="Tarif horaire TTC domicile">tarif TTC domicile</button>
                      <button type="button" data-insert="{{prices.cours_individuel_domicile.reduction_impot_pct}}" class="var-btn" title="Taux de réduction d'impôt">taux crédit d'impôt (%)</button>
                      <button type="button" data-insert="{{prices.cours_individuel_domicile.net_heure}}" class="var-btn" title="Tarif horaire net après crédit d'impôt">tarif net domicile</button>
                      <button type="button" data-insert="{{prices.interventions.ht_heure_standard}}" class="var-btn" title="Tarif horaire standard interventions scolaires">tarif scolaire HT/h</button>
                      <button type="button" data-insert="{{prices.interventions.ht_heure_entreprises}}" class="var-btn" title="Tarif horaire entreprises">tarif entreprise HT/h</button>
                      <button type="button" data-insert="{{contact.coop_a_dom_agrement}}" class="var-btn" title="Numéro d'agrément Coop A Dom">agrément Coop A Dom</button>
                      <button type="button" data-insert="{{contact.mobile}}" class="var-btn" title="Téléphone portable">mobile</button>
                      <button type="button" data-insert="{{contact.email}}" class="var-btn" title="E-mail">e-mail</button>
                    </div>
                  </div>

                  <textarea
                    name="answer"
                    id="faq-answer-input"
                    required
                    rows="5"
                    class="field-input text-xs leading-relaxed"
                    placeholder="Saisissez la réponse complète. Les balises comme {{prices.cours_collectifs.trimestre}} seront remplacées lors de l'affichage."
                  ></textarea>
                </div>

                <!-- Option Page d'accueil -->
                <div class="p-3.5 rounded border border-gray-200 dark:border-gray-700 bg-gray-50/60 dark:bg-[#1d2327]/60">
                  <label class="flex items-center gap-2.5 cursor-pointer select-none">
                    <input
                      type="checkbox"
                      name="show_on_home"
                      id="faq-show-on-home"
                      class="w-4 h-4 rounded text-[#2271b1] focus:ring-[#2271b1] border-gray-300 dark:border-gray-600"
                    />
                    <span class="text-xs font-semibold text-gray-900 dark:text-white">
                      Afficher aussi cette question sur la page d'accueil (Teaser FAQ)
                    </span>
                  </label>

                  <div id="home-options" class="hidden mt-3 pt-3 border-t border-gray-200 dark:border-gray-700 space-y-3">
                    <div>
                      <label class="field-label">Question courte pour l'accueil (facultatif)</label>
                      <input
                        name="home_question"
                        class="field-input text-xs"
                        placeholder="Laisser vide pour utiliser la question standard"
                      />
                    </div>
                    <div>
                      <label class="field-label">Réponse courte pour l'accueil (facultatif)</label>
                      <textarea
                        name="home_answer"
                        rows="2"
                        class="field-input text-xs"
                        placeholder="Laisser vide pour utiliser la réponse standard"
                      ></textarea>
                    </div>
                  </div>
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-gray-200 dark:border-gray-700 flex items-center gap-2">
                <button
                  type="submit"
                  id="faq-save-btn"
                  class="astro-btn astro-btn-primary"
                >
                  Enregistrer
                </button>
                <button
                  type="button"
                  id="faq-cancel-btn"
                  class="astro-btn astro-btn-secondary"
                >
                  Annuler
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    ) : (
      <LoginGate />
    )}
  </div>
</Layout>

<style>
  :global(.var-btn) {
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    background: #f0f0f1;
    border: 1px solid #c3c4c7;
    color: #2271b1;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.15s;
  }
  :global(.dark .var-btn) {
    background: #2c3338;
    border-color: #50575e;
    color: #72aee6;
  }
  :global(.var-btn:hover) {
    background: #e0e0e0;
    border-color: #2271b1;
  }
  :global(.dark .var-btn:hover) {
    background: #3c434a;
    border-color: #72aee6;
  }
</style>

<script>
  let csrfToken = "";
  let faqs: Record<string, any> = {};
  let categories: string[] = [];
  let selectedCategoryFilter = "all";
  let searchQuery = "";

  const listEl = document.getElementById("faq-list");
  const statusEl = document.getElementById("faq-status");
  const filtersEl = document.getElementById("faq-category-filters");
  const searchInput = document.getElementById("faq-search-input") as HTMLInputElement | null;
  const categorySelect = document.getElementById("faq-category-select") as HTMLSelectElement | null;
  const newCategoryWrapper = document.getElementById("faq-new-category-wrapper");
  const newCategoryInput = document.getElementById("faq-category-new-input") as HTMLInputElement | null;
  const formContainer = document.getElementById("faq-form-container");
  const form = document.getElementById("faq-form") as HTMLFormElement | null;
  const formTitle = document.getElementById("faq-form-title");
  const saveBtn = document.getElementById("faq-save-btn") as HTMLButtonElement | null;
  const showOnHomeCheckbox = document.getElementById("faq-show-on-home") as HTMLInputElement | null;
  const homeOptions = document.getElementById("home-options");
  const toggleVarsBtn = document.getElementById("toggle-variables-btn");
  const varsPalette = document.getElementById("variables-palette");
  const answerTextarea = document.getElementById("faq-answer-input") as HTMLTextAreaElement | null;

  showOnHomeCheckbox?.addEventListener("change", () => {
    if (showOnHomeCheckbox.checked) {
      homeOptions?.classList.remove("hidden");
    } else {
      homeOptions?.classList.add("hidden");
    }
  });

  toggleVarsBtn?.addEventListener("click", () => {
    varsPalette?.classList.toggle("hidden");
  });

  document.querySelectorAll<HTMLButtonElement>("[data-insert]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const code = btn.dataset.insert;
      if (!code || !answerTextarea) return;
      const start = answerTextarea.selectionStart;
      const end = answerTextarea.selectionEnd;
      const val = answerTextarea.value;
      answerTextarea.value = val.substring(0, start) + code + val.substring(end);
      answerTextarea.focus();
      answerTextarea.selectionStart = answerTextarea.selectionEnd = start + code.length;
    });
  });

  categorySelect?.addEventListener("change", () => {
    if (categorySelect.value === "__new__") {
      newCategoryWrapper?.classList.remove("hidden");
      if (newCategoryInput) {
        newCategoryInput.required = true;
        newCategoryInput.focus();
      }
    } else {
      newCategoryWrapper?.classList.add("hidden");
      if (newCategoryInput) {
        newCategoryInput.required = false;
        newCategoryInput.value = "";
      }
    }
  });

  function populateCategorySelect(selected?: string) {
    if (!categorySelect) return;
    const current = selected ?? categorySelect.value;
    let html = `<option value="">-- Choisir une catégorie existante --</option>`;
    for (const cat of categories) {
      html += `<option value="${cat}">${cat}</option>`;
    }
    html += `<option value="__new__">+ Créer une nouvelle catégorie…</option>`;
    categorySelect.innerHTML = html;

    if (current && (categories.includes(current) || current === "__new__")) {
      categorySelect.value = current;
    } else if (current) {
      const opt = document.createElement("option");
      opt.value = current;
      opt.textContent = current;
      categorySelect.insertBefore(opt, categorySelect.lastElementChild);
      categorySelect.value = current;
    } else {
      categorySelect.value = "";
    }

    if (categorySelect.value === "__new__") {
      newCategoryWrapper?.classList.remove("hidden");
      if (newCategoryInput) newCategoryInput.required = true;
    } else {
      newCategoryWrapper?.classList.add("hidden");
      if (newCategoryInput) {
        newCategoryInput.required = false;
        newCategoryInput.value = "";
      }
    }
  }

  function showStatus(message: string, kind: "success" | "error") {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden");
    statusEl.className =
      "astro-notice mb-4 " +
      (kind === "success" ? "astro-notice-success" : "astro-notice-error");
  }

  function renderCategoryFilters() {
    if (!filtersEl) return;
    const catCounts: Record<string, number> = {};
    for (const f of Object.values(faqs)) {
      const c = f.category || "Autre";
      catCounts[c] = (catCounts[c] || 0) + 1;
    }
    const allTotal = Object.keys(faqs).length;

    let html = `
      <button
        type="button"
        data-filter="all"
        class="astro-btn text-xs py-0.5 px-2.5 ${
          selectedCategoryFilter === "all" ? "astro-btn-primary" : "astro-btn-secondary"
        }">
        Toutes (${allTotal})
      </button>
    `;

    for (const cat of categories) {
      const count = catCounts[cat] || 0;
      html += `
        <button
          type="button"
          data-filter="${cat}"
          class="astro-btn text-xs py-0.5 px-2.5 ${
            selectedCategoryFilter === cat ? "astro-btn-primary" : "astro-btn-secondary"
          }">
          ${cat} (${count})
        </button>
      `;
    }

    filtersEl.innerHTML = html;

    filtersEl.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((btn) => {
      btn.addEventListener("click", () => {
        selectedCategoryFilter = btn.dataset.filter || "all";
        renderCategoryFilters();
        renderList();
      });
    });

    populateCategorySelect();
  }

  function renderList() {
    if (!listEl) return;
    const allIds = Object.keys(faqs);
    if (allIds.length === 0) {
      listEl.innerHTML = `<div class="astro-panel p-6 text-center text-xs text-gray-500 dark:text-gray-400">Aucune question dans la FAQ.</div>`;
      return;
    }

    // Filter by category
    let filteredIds = allIds;
    if (selectedCategoryFilter !== "all") {
      filteredIds = filteredIds.filter((id) => faqs[id].category === selectedCategoryFilter);
    }

    // Filter by search
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      filteredIds = filteredIds.filter((id) => {
        const f = faqs[id];
        return (
          f.question?.toLowerCase().includes(q) ||
          f.answer?.toLowerCase().includes(q) ||
          f.category?.toLowerCase().includes(q)
        );
      });
    }

    if (filteredIds.length === 0) {
      listEl.innerHTML = `<div class="astro-panel p-6 text-center text-xs text-gray-500 dark:text-gray-400">Aucune question ne correspond à votre recherche.</div>`;
      return;
    }

    // Group filtered items by category
    const groups: Record<string, string[]> = {};
    const groupOrder: string[] = [];

    for (const id of filteredIds) {
      const cat = faqs[id].category || "Sans catégorie";
      if (!groups[cat]) {
        groups[cat] = [];
        groupOrder.push(cat);
      }
      groups[cat].push(id);
    }

    // Sort within each group by order
    for (const cat of groupOrder) {
      groups[cat].sort((a, b) => (Number(faqs[a].order) || 999) - (Number(faqs[b].order) || 999));
    }

    let html = "";
    for (const cat of groupOrder) {
      const idsInCat = groups[cat];
      html += `
        <div class="astro-panel overflow-hidden">
          <div class="astro-panel-header flex items-center justify-between">
            <h2 class="astro-panel-title flex items-center gap-2">
              <span>${cat}</span>
              <span class="text-xs font-normal text-gray-500 dark:text-gray-400">(${idsInCat.length})</span>
            </h2>
          </div>
          <div class="astro-table-wrap border-0">
            <table class="astro-table">
              <thead>
                <tr>
                  <th class="w-12 text-center">Ordre</th>
                  <th>Question & Réponse</th>
                  <th class="w-24 text-center">Accueil</th>
                  <th class="w-36 text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
      `;

      idsInCat.forEach((id, idx) => {
        const f = faqs[id];
        const isFirst = idx === 0;
        const isLast = idx === idsInCat.length - 1;

        html += `
          <tr class="hover:bg-gray-50/60 dark:hover:bg-gray-800/40 transition-colors">
            <td class="text-center font-mono text-xs text-gray-500 dark:text-gray-400">
              ${f.order ?? idx + 1}
            </td>
            <td>
              <div class="font-medium text-gray-900 dark:text-gray-100 text-xs">${f.question}</div>
              <div class="text-[11px] text-gray-500 dark:text-gray-400 line-clamp-2 mt-0.5">${f.answer}</div>
              <div class="row-actions text-xs mt-1">
                <button type="button" data-edit="${id}" class="text-[#2271b1] hover:underline cursor-pointer">Modifier</button>
                <span class="text-gray-300 dark:text-gray-600">|</span>
                <button type="button" data-delete="${id}" class="text-rose-600 hover:underline cursor-pointer">Supprimer</button>
              </div>
            </td>
            <td class="text-center">
              ${
                f.show_on_home
                  ? `<span class="astro-badge astro-badge-success">Accueil</span>`
                  : '<span class="text-gray-400 dark:text-gray-500 text-xs">—</span>'
              }
            </td>
            <td class="text-right">
              <div class="inline-flex items-center gap-1">
                <button
                  type="button"
                  data-move-up="${id}"
                  ${isFirst ? "disabled" : ""}
                  class="astro-btn astro-btn-secondary px-1.5 py-0.5 text-xs disabled:opacity-30 cursor-pointer disabled:cursor-not-allowed"
                  title="Monter"
                >
                  ▲
                </button>
                <button
                  type="button"
                  data-move-down="${id}"
                  ${isLast ? "disabled" : ""}
                  class="astro-btn astro-btn-secondary px-1.5 py-0.5 text-xs disabled:opacity-30 cursor-pointer disabled:cursor-not-allowed"
                  title="Descendre"
                >
                  ▼
                </button>
                <button
                  type="button"
                  data-edit="${id}"
                  class="astro-btn astro-btn-secondary px-2 py-0.5 text-xs"
                >
                  Modifier
                </button>
              </div>
            </td>
          </tr>
        `;
      });

      html += `
              </tbody>
            </table>
          </div>
        </div>
      `;
    }

    listEl.innerHTML = html;

    listEl.querySelectorAll<HTMLButtonElement>("[data-edit]").forEach((btn) =>
      btn.addEventListener("click", () => openForm(btn.dataset.edit!, faqs[btn.dataset.edit!]))
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((btn) =>
      btn.addEventListener("click", () => deleteFaq(btn.dataset.delete!, faqs[btn.dataset.delete!]))
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-move-up]").forEach((btn) =>
      btn.addEventListener("click", () => moveItem(btn.dataset.moveUp!, -1))
    );
    listEl.querySelectorAll<HTMLButtonElement>("[data-move-down]").forEach((btn) =>
      btn.addEventListener("click", () => moveItem(btn.dataset.moveDown!, 1))
    );
  }

  async function moveItem(id: string, delta: number) {
    const item = faqs[id];
    if (!item) return;
    const cat = item.category;
    const itemsInCat = Object.entries(faqs)
      .filter(([_, f]) => f.category === cat)
      .map(([k, f]) => ({ id: k, order: Number(f.order) || 999 }))
      .sort((a, b) => a.order - b.order);

    const index = itemsInCat.findIndex((i) => i.id === id);
    if (index === -1) return;
    const targetIndex = index + delta;
    if (targetIndex < 0 || targetIndex >= itemsInCat.length) return;

    // Swap orders
    const currentOrder = itemsInCat[index].order;
    const targetOrder = itemsInCat[targetIndex].order;
    const newOrder = currentOrder === targetOrder ? (delta > 0 ? targetOrder + 1 : targetOrder - 1) : targetOrder;

    const updates = [
      { id: itemsInCat[index].id, order: newOrder },
      { id: itemsInCat[targetIndex].id, order: currentOrder },
    ];

    try {
      const res = await fetch("/api/admin/faq", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify({ action: "reorder", items: updates }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    }
  }

  function openForm(id: string | null, f: any | null) {
    if (!form || !formContainer || !formTitle) return;
    form.reset();
    (form.elements.namedItem("originalId") as HTMLInputElement).value = id ?? "";
    formTitle.textContent = f ? `Modifier la question` : "Ajouter une question";
    varsPalette?.classList.add("hidden");

    if (f) {
      const set = (name: string, value: any) => {
        const el = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
        if (el) el.value = value ?? "";
      };
      populateCategorySelect(f.category);
      set("question", f.question);
      set("answer", f.answer);
      set("order", f.order);
      set("home_question", f.home_question);
      set("home_answer", f.home_answer);

      if (showOnHomeCheckbox) {
        showOnHomeCheckbox.checked = Boolean(f.show_on_home);
        if (f.show_on_home) {
          homeOptions?.classList.remove("hidden");
        } else {
          homeOptions?.classList.add("hidden");
        }
      }
    } else {
      const defaultCat = selectedCategoryFilter !== "all" ? selectedCategoryFilter : "";
      populateCategorySelect(defaultCat);
      homeOptions?.classList.add("hidden");
    }

    formContainer.classList.remove("hidden");
    formContainer.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function closeForm() {
    formContainer?.classList.add("hidden");
  }

  async function deleteFaq(id: string, f: any) {
    if (!confirm(`Supprimer définitivement la question :\n« ${f.question} » ?`)) return;
    try {
      const res = await fetch("/api/admin/faq", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify({ action: "delete", id }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Question supprimée et site republié.", "success");
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    }
  }

  async function load() {
    const [faqRes, authRes] = await Promise.all([
      fetch("/api/admin/faq"),
      fetch("/api/admin/auth"),
    ]);
    const data = await faqRes.json();
    const authData = await authRes.json();
    csrfToken = authData.csrfToken || "";

    if (!faqRes.ok) {
      if (listEl) listEl.innerHTML = `<div class="astro-panel p-4 text-xs text-rose-500">${data.error}</div>`;
      return;
    }

    faqs = data.faqs || {};
    categories = data.categories || [];
    renderCategoryFilters();
    renderList();
  }

  document.getElementById("add-faq-btn")?.addEventListener("click", () => openForm(null, null));
  document.getElementById("faq-cancel-btn")?.addEventListener("click", closeForm);

  searchInput?.addEventListener("input", (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim();
    renderList();
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!saveBtn || !form) return;
    saveBtn.disabled = true;
    saveBtn.textContent = "Enregistrement…";

    const fd = new FormData(form);
    const originalId = String(fd.get("originalId") || "");
    const selectVal = categorySelect?.value || "";
    let category = selectVal;
    if (selectVal === "__new__") {
      category = (newCategoryInput?.value || "").trim();
      if (!category) {
        showStatus("Veuillez saisir le nom de la nouvelle catégorie.", "error");
        newCategoryInput?.focus();
        saveBtn.disabled = false;
        saveBtn.textContent = originalId ? "Enregistrer" : "Ajouter la question";
        return;
      }
    } else if (!category) {
      showStatus("Veuillez sélectionner une catégorie dans la liste.", "error");
      categorySelect?.focus();
      saveBtn.disabled = false;
      saveBtn.textContent = originalId ? "Enregistrer" : "Ajouter la question";
      return;
    }

    const faq = {
      category,
      question: fd.get("question"),
      answer: fd.get("answer"),
      order: fd.get("order"),
      show_on_home: fd.get("show_on_home") === "on",
      home_question: fd.get("home_question"),
      home_answer: fd.get("home_answer"),
    };

    try {
      const res = await fetch("/api/admin/faq", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": csrfToken },
        body: JSON.stringify(originalId ? { action: "update", originalId, faq } : { action: "create", faq }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      showStatus("Question enregistrée et site republié.", "success");
      closeForm();
      await load();
    } catch (err: any) {
      showStatus(err.message, "error");
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Enregistrer";
    }
  });

  load();
</script>
