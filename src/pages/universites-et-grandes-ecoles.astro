---
import Base from "../layouts/Layout.astro";
import RelatedPages from "../components/related-pages.astro";
import { prices } from "../data/prices";
import { contact, telHref } from "../data/contact";

const contactMailHref = `mailto:${contact.email}?subject=Organisation%20d’un%20atelier%20calligraphie%20universitaire`;
---

<Base
  title="Ateliers de calligraphie chinoise pour universités et grandes écoles à Lyon"
  description={`Ateliers de calligraphie chinoise pour universités et grandes écoles à Lyon : modules de 2 à 3 h pour cursus LEA/LLCER, écoles d’ingénieurs et associations étudiantes. ${prices.interventions.ht_heure_standard} € HT/h.`}>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "Atelier de calligraphie chinoise pour universités et grandes écoles",
    "description": "Atelier immersif et modulaire de calligraphie chinoise pour l’enseignement supérieur à Lyon : LEA, LLCER, grandes écoles et associations. 2 à 3 h, 6 à 12 étudiants.",
    "url": "https://ateliersdecalligraphie.com/universites-et-grandes-ecoles",
    "provider": {
      "@type": "Person",
      "name": "Christophe Desmur",
      "url": "https://ateliersdecalligraphie.com/le-calligraphe"
    },
    "audience": {
      "@type": "Audience",
      "audienceType": "Étudiants de l’enseignement supérieur"
    },
    "inLanguage": "fr",
    "offers": {
      "@type": "Offer",
      "price": "60",
      "priceCurrency": "EUR",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "60",
        "priceCurrency": "EUR",
        "unitText": "heure"
      }
    }
  })} />

  <div class="max-w-5xl mx-auto">
    <!-- Fil d’Ariane -->
    <nav aria-label="Fil d’Ariane" class="text-xs text-gray-500 dark:text-gray-400 mb-6 sm:mb-8">
      <ol class="flex items-center gap-1.5 flex-wrap">
        <li><a href="/" class="hover:underline">Accueil</a></li>
        <li aria-hidden="true">/</li>
        <li><span class="text-gray-500">Pour les groupes</span></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-gray-800 dark:text-gray-200 font-medium">Universités & Grandes écoles</li>
      </ol>
    </nav>

    <!-- Hero Section : Two-column desktop, natural stack on mobile -->
    <header class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start" aria-labelledby="hero-title">
      
      <!-- Colonne Gauche (Desktop : 48%) -->
      <div class="lg:col-span-6 flex flex-col">
        <h1
          id="hero-title"
          class="h-section">
          Ateliers de calligraphie chinoise pour l’enseignement supérieur
        </h1>

        <p class="lede italic mt-5">
          Modules immersifs et ateliers pratiques pour universités et grandes écoles à Lyon
        </p>

        <!-- Image mobile uniquement (sous le sous-titre) -->
        <div class="mt-6 lg:hidden">
          <img
            src="/assets/cours-calligraphie-universites-grandes-ecoles.webp"
            alt="Calligraphie chinoise traditionnelle 智慧 (Sagesse / Connaissance) pour universités"
            width="398"
            height="541"
            loading="eager"
            class="w-full h-auto object-contain max-h-80 bg-white dark:bg-gray-800"
           decoding="async"/>
        </div>

        <p class="body-copy mt-6">
          Christophe Desmur apporte sa double compétence de calligraphe confirmé (plus de trente ans de pratique) et d’universitaire titulaire d’une maîtrise de langue et civilisation chinoises et d’un master de traduction littéraire du chinois pour animer des ateliers exigeants et stimulants sur votre campus.
        </p>

        <!-- CTA Principal (visible sur desktop) -->
        <div class="mt-8 hidden lg:flex flex-wrap items-center gap-4">
          <a
            href={contactMailHref}
            class="btn btn-ink">
            Organiser un atelier
          </a>
          <a
            href={`tel:${telHref(contact.mobile)}`}
            class="btn btn-line tabular-nums"
            aria-label={`Contacter Christophe Desmur au ${contact.mobile}`}>
            {contact.mobile}
          </a>
        </div>
      </div>

      <!-- Colonne Droite (Desktop : 52%) -->
      <div class="hidden lg:block lg:col-span-6">
        <img
          src="/assets/cours-calligraphie-universites-grandes-ecoles.webp"
          alt="Calligraphie chinoise traditionnelle 智慧 (Sagesse / Connaissance) pour universités"
          width="398"
          height="541"
          loading="eager"
          class="w-full h-auto object-contain max-h-[420px] mx-auto bg-white dark:bg-gray-800"
         decoding="async"/>
      </div>

    </header>

    <!-- Informations clés (Grille sobre, scannable et non-SaaS) -->
    <section class="mt-10 sm:mt-14 py-8 border-y border-warm-grey" aria-label="Informations pratiques">
      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-8">
        <div>
          <dt class="eyebrow">
            Format
          </dt>
          <dd class="mt-2 font-serif text-xl leading-snug text-ink">
            2 à 3 heures (ou modules)
          </dd>
        </div>

        <div>
          <dt class="eyebrow">
            Participants
          </dt>
          <dd class="mt-2 font-serif text-xl leading-snug text-ink">
            De 6 à 12 étudiants
          </dd>
        </div>

        <div>
          <dt class="eyebrow">
            Tarif
          </dt>
          <dd class="mt-2 font-serif text-xl leading-snug text-ink">
            60 euros HT par heure
          </dd>
        </div>

        <div>
          <dt class="eyebrow">
            Matériel
          </dt>
          <dd class="mt-2 font-serif text-xl leading-snug text-ink">
            Intégralement fourni
          </dd>
        </div>
      </dl>

      <!-- CTA Principal mobile (après les informations clés) -->
      <div class="mt-6 pt-6 border-t border-warm-grey lg:hidden flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
        <a
          href={contactMailHref}
          class="btn btn-ink">
          Organiser un atelier
        </a>
        <a
          href={`tel:${telHref(contact.mobile)}`}
          class="btn btn-line tabular-nums">
          {contact.mobile}
        </a>
      </div>
    </section>

    <!-- Programme de l’atelier -->
    <section class="mt-12 sm:mt-16" aria-labelledby="programme-heading">
      <h2 id="programme-heading" class="h-item mb-8">
        Au programme
      </h2>

      <ol class="grid sm:grid-cols-3 gap-6 sm:gap-8 border-b border-warm-grey pb-12">
        <li class="flex flex-col">
          <span class="numeral text-2xl mb-3 select-none" aria-hidden="true">
            01
          </span>
          <p class="text-sm sm:text-base text-gray-800 dark:text-gray-200 font-medium leading-snug">
            Philosophie du geste, notions de souffle (qi), plein et vide, et assise posturale
          </p>
        </li>

        <li class="flex flex-col">
          <span class="numeral text-2xl mb-3 select-none" aria-hidden="true">
            02
          </span>
          <p class="text-sm sm:text-base text-gray-800 dark:text-gray-200 font-medium leading-snug">
            Pratique des Quatre Trésors et étude comparée des styles : Kaishu (régulier), Xingshu (courant) et Caoshu (cursif)
          </p>
        </li>

        <li class="flex flex-col">
          <span class="numeral text-2xl mb-3 select-none" aria-hidden="true">
            03
          </span>
          <p class="text-sm sm:text-base text-gray-800 dark:text-gray-200 font-medium leading-snug">
            Tracé de textes classiques ou de maximes philosophiques et réalisation d’une calligraphie finale signée
          </p>
        </li>
      </ol>
    </section>

    <!-- Cursus universitaires et publics cibles -->
    <section class="mt-12 sm:mt-16" aria-labelledby="publics-heading">
      <h2 id="publics-heading" class="h-item mb-8">
        Cursus universitaires et publics cibles
      </h2>

      <div class="grid sm:grid-cols-3 gap-6 text-sm">
        <div class="border-t border-warm-grey pt-5">
          <h3 class="font-serif text-xl leading-snug text-ink mb-2">
            Filières LEA & LLCER Chinois
          </h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-sm">
            Approfondissement de l’ordre des traits, étymologie des caractères, déchiffrage d’extraits classiques (poèmes des Tang et Song, traités classiques) et analyse comparée des styles calligraphiques.
          </p>
        </div>

        <div class="border-t border-warm-grey pt-5">
          <h3 class="font-serif text-xl leading-snug text-ink mb-2">
            Écoles d’ingénieurs & Management
          </h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-sm">
            Comme à l’ISTIL (Université Lyon 1) : ouverture interculturelle, précision millimétrée du geste, concentration et sensibilisation aux modes de pensée traditionnels d’Asie.
          </p>
        </div>

        <div class="border-t border-warm-grey pt-5">
          <h3 class="font-serif text-xl leading-snug text-ink mb-2">
            Services culturels & Associations
          </h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-sm">
            Ateliers d’initiation et de pratique lors des festivals universitaires, semaines internationales et événements culturels de campus.
          </p>
        </div>
      </div>
    </section>

    <!-- Navigation contextuelle groupée -->
    <RelatedPages current="/universites-et-grandes-ecoles" />
  </div>
</Base>
