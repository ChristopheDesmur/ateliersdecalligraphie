---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Cta from "@/components/cta.astro";

const artworks = [
  {
    src: "/assets/FUKU-Bonheur.webp",
    alt: "Calligraphie chinoise du caractère 福 (fú) signifiant Bonheur et Prospérité",
    title: "福 (Fú) — Le Bonheur",
    category: "Caractère traditionnel",
    description: "Tracé à l'encre de Chine dense sur papier absorbant. Caractère traditionnellement affiché pour attirer les auspices favorables.",
  },
  {
    src: "/assets/Shin-1-c2g.webp",
    alt: "Calligraphie du caractère 心 (xīn), l'Esprit et le Cœur en encre de Chine",
    title: "心 (Xīn) — Le Cœur / L'Esprit",
    category: "Philosophie & Zen",
    description: "Le caractère symbolise à la fois l'organe du cœur et l'esprit pensant, notion centrale dans les traditions chinoise et zen.",
  },
  {
    src: "/assets/xingshu.webp",
    alt: "Exemple d'écriture en style courant (Xingshu) fluide et continu",
    title: "Style Courant (Xingshu 行书)",
    category: "Style classique",
    description: "Style semi-cursif privilégiant la liaison naturelle entre les traits, l'élan et la continuité du mouvement.",
  },
  {
    src: "/assets/mushotoku-c2g.webp",
    alt: "Calligraphie zen de l'esprit Mushotoku (agir sans esprit de profit personnel)",
    title: "Mushotoku — Sans esprit de profit",
    category: "Philosophie & Zen",
    description: "L'attitude intérieure de pure présence, où l'acte calligraphique s'accomplit sans recherche d'artifice ou de vanité.",
  },
  {
    src: "/assets/equilibre-calligraphie-lyon.webp",
    alt: "Calligraphie à l'encre illustrant l'harmonie des proportions et le travail du souffle",
    title: "Harmonie & Équilibre",
    category: "Composition",
    description: "Recherche d'harmonie entre force du noir d'encre et respiration du blanc de la feuille.",
  },
];

const workshopPhotos = [
  {
    src: "/assets/atelier-de-groupe-calligraphie-lyon.webp",
    alt: "Participants réunis autour d'une grande table lors d'un atelier collectif de calligraphie à Lyon",
    title: "Atelier collectif au Dojo Zen de Lyon",
    category: "Cours adultes",
    description: "Ambiance studieuse et détendue lors d'un cours hebdomadaire à la Croix-Rousse.",
  },
  {
    src: "/assets/cours-calligraphie-ecoles-primaires.webp",
    alt: "Enfants en classe d'école primaire s'initiant au pinceau et à l'encre de Chine",
    title: "Intervention en école élémentaire",
    category: "Scolaires",
    description: "Découverte des pictogrammes chinois et dessin d'animaux au pinceau (Sumi-e).",
  },
  {
    src: "/assets/cours-calligraphie-lycees.webp",
    alt: "Lycéens en atelier de calligraphie sur la pause de midi",
    title: "Atelier en lycée",
    category: "Lycées",
    description: "Pause méridienne culturelle et concentrée pour des lycéens à Lyon.",
  },
  {
    src: "/assets/cours-calligraphie-universites-grandes-ecoles.webp",
    alt: "Étudiants universitaires pratiquant le tracé des sinogrammes",
    title: "Atelier pour étudiants universitaires",
    category: "Enseignement supérieur",
    description: "Étude des styles classiques et approfondissement pour étudiants en langues orientales.",
  },
  {
    src: "/assets/cours-calligraphie-comites-entreprise.webp",
    alt: "Salariés en entreprise lors d'une séance de calligraphie chinoise",
    title: "Atelier pour comité d'entreprise (CSE)",
    category: "Entreprises",
    description: "Séance de recentrage, de déconnexion et de cohésion d'équipe sur le lieu de travail.",
  },
  {
    src: "/assets/cours-individuel-a-domicile-calligraphie-lyon.webp",
    alt: "Cours particulier de calligraphie chinoise au domicile d'un élève à Lyon",
    title: "Cours individuel à domicile",
    category: "Particuliers",
    description: "Accompagnement individualisé sur mesure avec tout le matériel mis à disposition.",
  },
];

const allGallery = [...artworks, ...workshopPhotos];
---

<Layout
  title="Galerie de calligraphies chinoises & ateliers à Lyon"
  description="Découvrez les œuvres originales de Christophe Desmur à l'encre de Chine et les photographies des ateliers de calligraphie à Lyon (adultes, écoles, entreprises).">

  <Container>
    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="text-xs text-gray-500 dark:text-gray-400 mb-6">
      <ol class="flex items-center gap-1.5 flex-wrap">
        <li><a href="/" class="hover:underline">Accueil</a></li>
        <li aria-hidden="true">/</li>
        <li><span class="text-gray-500">Découvrir</span></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-gray-800 dark:text-gray-200 font-medium">Galerie</li>
      </ol>
    </nav>

    <!-- En-tête de la galerie -->
    <header class="max-w-3xl">
      <span class="text-indigo-600 dark:text-indigo-400 uppercase tracking-widest text-xs font-semibold">
        Œuvres & Moments de pratique
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-2 text-gray-900 dark:text-gray-100">
        Galerie de calligraphies chinoises
      </h1>
      <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 mt-4 leading-relaxed">
        Découvrez un aperçu des caractères traditionnels tracés à l'encre de Chine par Christophe Desmur, ainsi que des photographies témoignant de la vie des cours et ateliers menés à Lyon.
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
        Toutes les œuvres originales peuvent être acquises ou commandées sur mesure (caractère personnalisé, devise, poème). Pour toute demande : <a href="mailto:christophe.desmur@orange.fr" class="text-indigo-600 dark:text-indigo-400 underline font-medium">christophe.desmur@orange.fr</a>.
      </p>
    </header>

    <!-- Section 1 : Calligraphies & Styles -->
    <section class="mt-14" aria-labelledby="artworks-heading">
      <div class="flex items-baseline justify-between border-b border-gray-200 dark:border-gray-700 pb-3 mb-8">
        <h2 id="artworks-heading" class="text-2xl font-bold text-gray-900 dark:text-gray-100">
          Œuvres & Styles calligraphiques
        </h2>
        <span class="text-xs text-gray-500 dark:text-gray-400">
          {artworks.length} pièces
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {artworks.map((item, index) => (
          <article class="group bg-white dark:bg-gray-800 rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-700 shadow-xs hover:shadow-lg transition flex flex-col justify-between">
            <button
              type="button"
              class="gallery-trigger text-left w-full cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded-t-2xl overflow-hidden"
              data-index={index}
              data-src={item.src}
              data-alt={item.alt}
              data-title={item.title}
              data-desc={item.description}
              aria-haspopup="dialog"
              aria-label={`Agrandir : ${item.title}`}>
              <div class="h-64 sm:h-72 overflow-hidden bg-gray-50 dark:bg-gray-900 flex items-center justify-center p-3">
                <img
                  src={item.src}
                  alt={item.alt}
                  width="400"
                  height="300"
                  loading="lazy"
                  class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
                />
              </div>
            </button>

            <div class="p-5 border-t border-gray-100 dark:border-gray-700/60">
              <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
                {item.category}
              </span>
              <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mt-1">
                {item.title}
              </h3>
              <p class="text-xs text-gray-600 dark:text-gray-300 mt-2 leading-relaxed">
                {item.description}
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Section 2 : Photographies d'ateliers -->
    <section class="mt-20" aria-labelledby="workshops-heading">
      <div class="flex items-baseline justify-between border-b border-gray-200 dark:border-gray-700 pb-3 mb-8">
        <h2 id="workshops-heading" class="text-2xl font-bold text-gray-900 dark:text-gray-100">
          La pratique en atelier & en classe
        </h2>
        <span class="text-xs text-gray-500 dark:text-gray-400">
          {workshopPhotos.length} photographies
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {workshopPhotos.map((item, index) => {
          const globalIdx = artworks.length + index;
          return (
            <article class="group bg-white dark:bg-gray-800 rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-700 shadow-xs hover:shadow-lg transition flex flex-col justify-between">
              <button
                type="button"
                class="gallery-trigger text-left w-full cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded-t-2xl overflow-hidden"
                data-index={globalIdx}
                data-src={item.src}
                data-alt={item.alt}
                data-title={item.title}
                data-desc={item.description}
                aria-haspopup="dialog"
                aria-label={`Agrandir : ${item.title}`}>
                <div class="h-56 overflow-hidden bg-gray-100 dark:bg-gray-900">
                  <img
                    src={item.src}
                    alt={item.alt}
                    width="400"
                    height="260"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
              </button>

              <div class="p-5 border-t border-gray-100 dark:border-gray-700/60">
                <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
                  {item.category}
                </span>
                <h3 class="text-base font-bold text-gray-900 dark:text-gray-100 mt-1">
                  {item.title}
                </h3>
                <p class="text-xs text-gray-600 dark:text-gray-300 mt-1 leading-relaxed">
                  {item.description}
                </p>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <Cta />
  </Container>

  <!-- Lightbox Accessible avec fermeture clavier et navigation -->
  <dialog
    id="lightbox-dialog"
    class="fixed inset-0 m-auto bg-transparent backdrop:bg-black/85 p-4 max-w-5xl w-full h-fit border-0 outline-none z-50">
    <div class="relative bg-white dark:bg-gray-900 rounded-2xl p-4 sm:p-6 shadow-2xl border border-gray-300 dark:border-gray-700 flex flex-col items-center">
      
      <!-- Bouton Fermer -->
      <button
        id="lightbox-close"
        type="button"
        class="absolute top-4 right-4 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white p-2 rounded-lg text-2xl leading-none transition"
        aria-label="Fermer la vue agrandie (Échap)">
        ✕
      </button>

      <!-- Navigation boutons -->
      <button
        id="lightbox-prev"
        type="button"
        class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white rounded-full w-10 h-10 flex items-center justify-center text-xl transition z-10"
        aria-label="Image précédente (Flèche gauche)">
        ❮
      </button>

      <button
        id="lightbox-next"
        type="button"
        class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white rounded-full w-10 h-10 flex items-center justify-center text-xl transition z-10"
        aria-label="Image suivante (Flèche droite)">
        ❯
      </button>

      <!-- Image affichée -->
      <div class="w-full flex items-center justify-center max-h-[70vh] overflow-hidden my-4">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-h-[68vh] max-w-full object-contain rounded-lg"
        />
      </div>

      <!-- Légende et description -->
      <div class="w-full text-center px-4 pt-2">
        <h3 id="lightbox-title" class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100"></h3>
        <p id="lightbox-desc" class="text-sm text-gray-600 dark:text-gray-300 mt-1 max-w-2xl mx-auto"></p>
      </div>

    </div>
  </dialog>

  <script is:inline>
    (function() {
      const triggers = Array.from(document.querySelectorAll('.gallery-trigger'));
      const dialog = document.getElementById('lightbox-dialog');
      const img = document.getElementById('lightbox-img');
      const title = document.getElementById('lightbox-title');
      const desc = document.getElementById('lightbox-desc');
      const closeBtn = document.getElementById('lightbox-close');
      const prevBtn = document.getElementById('lightbox-prev');
      const nextBtn = document.getElementById('lightbox-next');

      let currentIndex = 0;

      function updateLightbox(index) {
        if (index < 0) index = triggers.length - 1;
        if (index >= triggers.length) index = 0;
        currentIndex = index;

        const trigger = triggers[currentIndex];
        const src = trigger.getAttribute('data-src');
        const alt = trigger.getAttribute('data-alt');
        const t = trigger.getAttribute('data-title');
        const d = trigger.getAttribute('data-desc');

        img.src = src;
        img.alt = alt || '';
        title.textContent = t || '';
        desc.textContent = d || '';
      }

      function openLightbox(index) {
        updateLightbox(index);
        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
        }
        closeBtn.focus();
      }

      function closeLightbox() {
        if (typeof dialog.close === 'function') {
          dialog.close();
        } else {
          dialog.removeAttribute('open');
        }
      }

      triggers.forEach((trigger, idx) => {
        trigger.addEventListener('click', () => openLightbox(idx));
      });

      closeBtn.addEventListener('click', closeLightbox);

      prevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        updateLightbox(currentIndex - 1);
      });

      nextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        updateLightbox(currentIndex + 1);
      });

      // Fermeture par clic sur le fond (backdrop)
      dialog.addEventListener('click', (e) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX && e.clientX <= rect.left + rect.width
        );
        // Si clic hors du conteneur intérieur
        if (e.target === dialog) {
          closeLightbox();
        }
      });

      // Clavier : Navigation par flèches gauche / droite
      window.addEventListener('keydown', (e) => {
        if (!dialog.open) return;
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          updateLightbox(currentIndex - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          updateLightbox(currentIndex + 1);
        } else if (e.key === 'Escape') {
          closeLightbox();
        }
      });
    })();
  </script>
</Layout>
