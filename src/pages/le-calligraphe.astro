---
import Base from "../layouts/Layout.astro";
import RelatedPages from "../components/related-pages.astro";
import fs from 'fs';
import yaml from 'js-yaml';

// --- Load YAML and normalize ---
const rawData = yaml.load(fs.readFileSync('./src/content/ateliers.yaml', 'utf8'));
const rawAteliers = Array.isArray(rawData)
  ? rawData
  : rawData && typeof rawData === 'object'
  ? Object.values(rawData).flat()
  : [];

// --- Date helpers ---
function sameDay(d1, d2) {
  return d1.getFullYear() === d2.getFullYear()
      && d1.getMonth() === d2.getMonth()
      && d1.getDate() === d2.getDate();
}

function formatDayFR(dayNum) {
  return dayNum === 1 ? "1<sup>er</sup>" : String(dayNum);
}

function formatDateFR(fromStr, toStr) {
  const from = new Date(fromStr);
  const to = toStr ? new Date(toStr) : from;

  const optionsMonthYear = { month: "long", year: "numeric" };

  const frDayFrom = formatDayFR(from.getDate());
  const frDayTo = toStr ? formatDayFR(to.getDate()) : null;

  if (sameDay(from, to)) {
    return `${frDayFrom} ${from.toLocaleDateString("fr-FR", optionsMonthYear)}`;
  } else if (from.getFullYear() === to.getFullYear() && from.getMonth() === to.getMonth()) {
    return `${frDayFrom} → ${frDayTo} ${to.toLocaleDateString("fr-FR", optionsMonthYear)}`;
  } else {
    return `${frDayFrom} ${from.toLocaleDateString("fr-FR", optionsMonthYear)} → ${frDayTo} ${to.toLocaleDateString("fr-FR", optionsMonthYear)}`;
  }
}

function formatLieuFR(lieu) {
  if (!lieu) return "";
  return lieu.replace(/Lyon 4e\b/g, "Lyon 4<sup>e</sup>");
}

// --- Group ateliers by year ---
const ateliersByYear = {};
rawAteliers.forEach(event => {
  const from = new Date(event.from);
  const to = event.to ? new Date(event.to) : from;
  const multiYear = from.getFullYear() !== to.getFullYear();

  for (let y = from.getFullYear(); y <= to.getFullYear(); y++) {
    if (!ateliersByYear[y]) ateliersByYear[y] = [];
    const key = event.from + event.titre + event.lieu;
    if (!ateliersByYear[y].some(e => (e.from + e.titre + e.lieu) === key)) {
      ateliersByYear[y].push({
        ...event,
        multiYear,
        displayDate: formatDateFR(event.from, event.to),
        lieu: formatLieuFR(event.lieu)
      });
    }
  }
});

// --- Sort years descending ---
const sortedYears = Object.keys(ateliersByYear).sort((a, b) => Number(b) - Number(a));

// Date de référence pour distinguer ateliers à venir et passés
const now = new Date();

// 1. Prochains ateliers & cycles en cours (to >= now)
const upcomingEvents = rawAteliers
  .filter(event => {
    const to = event.to ? new Date(event.to) : new Date(event.from);
    return to >= now;
  })
  .map(event => ({
    ...event,
    displayDate: formatDateFR(event.from, event.to),
    lieu: formatLieuFR(event.lieu),
    isOngoingCycle: event.from.includes("-01-01") && (event.to || "").includes("-12-31")
  }))
  .sort((a, b) => {
    if (!a.isOngoingCycle && b.isOngoingCycle) return -1;
    if (a.isOngoingCycle && !b.isOngoingCycle) return 1;
    return new Date(a.from) - new Date(b.from);
  });

// 2. Interventions récentes passées (to < now), triées par ordre antéchronologique (du plus récent au plus ancien)
const recentInterventions = rawAteliers
  .filter(event => {
    const to = event.to ? new Date(event.to) : new Date(event.from);
    return to < now;
  })
  .map(event => ({
    ...event,
    displayDate: formatDateFR(event.from, event.to),
    lieu: formatLieuFR(event.lieu)
  }))
  .sort((a, b) => new Date(b.from) - new Date(a.from))
  .slice(0, 6);

// 3. Formules & Prestations existantes
const services = [
  {
    title: "Cours collectifs hebdomadaires",
    href: "/cours-collectifs",
    description: "Pratique au Dojo Zen (lundi soir) et à la boutique Miroirs du Ciel (mercredi matin) à la Croix-Rousse. Petits groupes, tout matériel fourni.",
    badge: "Lyon 4<sup>e</sup> • Tous niveaux"
  },
  {
    title: "Cours particuliers à domicile",
    href: "/cours-individuel-a-domicile",
    description: "Enseignement personnalisé chez vous à Lyon et proche périphérie. Rythme sur mesure, éligible à 50 % de crédit d'impôt (service à la personne).",
    badge: "50 % crédit d'impôt"
  },
  {
    title: "Ateliers découverte & stages",
    href: "/atelier-de-groupe",
    description: "Séances d'initiation et de découverte de la voie du pinceau (Shodo) pour adultes, associations et curieux du geste traditionnel.",
    badge: "Initiation & groupes"
  },
  {
    title: "Interventions en milieu scolaire",
    href: "/ecoles-primaires",
    description: "Ateliers pédagogiques adaptés de la maternelle au lycée (primaires, collèges, lycées) pour ouvrir les élèves à l'art et aux caractères chinois.",
    badge: "Écoles, collèges, lycées"
  },
  {
    title: "Entreprises & Comités d'entreprise",
    href: "/comites-entreprise",
    description: "Animations culturelles, team building et ateliers de concentration et déconnexion au pinceau pour vos équipes et événements d'entreprise.",
    badge: "CSE & Séminaires"
  },
  {
    title: "Maisons de retraite & EHPAD",
    href: "/maisons-de-retraite",
    description: "Ateliers bienveillants stimulant la mémoire, la créativité et la motricité fine des résidents à travers le tracé de l'encre.",
    badge: "Seniors & Résidences"
  },
  {
    title: "Création d'œuvres originales",
    href: "/galerie",
    description: "Réalisation de calligraphies traditionnelles sur papier de riz ou support d'art, œuvres sur mesure et commandes personnalisées.",
    badge: "Encre de Chine & Rouleaux"
  },
  {
    title: "Cours de langue chinoise & culture",
    href: "/cours-de-chinois",
    description: "Apprentissage des sinogrammes, clés étymologiques et langue chinoise, complété par mon activité de traducteur littéraire.",
    badge: "Langue & Traduction"
  }
];
---

<Base
  title="Christophe Desmur, calligraphe chinois et traducteur littéraire à Lyon"
  description="Christophe Desmur transmet la calligraphie chinoise traditionnelle depuis plus de 30 ans à Lyon : cours collectifs à la Croix-Rousse, cours à domicile et ateliers sur mesure.">

