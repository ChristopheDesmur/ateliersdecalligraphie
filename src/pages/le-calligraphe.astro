          <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-4">
            Formation universitaire & diplômes
          </h3>

          <dl class="space-y-4">
            <div class="pb-3 border-b border-gray-200 dark:border-gray-700/60">
              <dt class="text-xs font-semibold uppercase tracking-widest text-indigo-700 dark:text-indigo-300">
                Master
              </dt>
