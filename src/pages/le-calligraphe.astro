                          )}
                        </div>
                        <div class="font-serif text-base text-gray-900 dark:text-gray-100">
                          {event.href ? (
                            <a href={event.href} class="text-indigo-600 dark:text-indigo-400 hover:underline">
                              {event.titre}
                            </a>
                          ) : (
                            event.titre
                          )}
                        </div>
                        <div class="text-xs text-gray-600 dark:text-gray-400 mt-1">
                          <em set:html={event.lieu} />
                        </div>
                        {event.details && (
                          <div class="text-xs text-gray-500 dark:text-gray-400 mt-1.5 pl-2.5 border-l-2 border-gray-200 dark:border-gray-700">
                            {event.details}
                          </div>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>

          </div>
        </details>
      </div>

