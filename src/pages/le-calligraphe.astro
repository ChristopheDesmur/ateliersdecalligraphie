      "@type": "Person",
      "name": "Christophe Desmur",
      "jobTitle": "Calligraphe et traducteur littéraire du chinois",
      "description": "Calligraphe et traducteur littéraire du chinois à Lyon, avec plus de 30 ans de pratique et titulaire d'un master de traduction littéraire chinois-français.",
      "url": "https://ateliersdecalligraphie.com/le-calligraphe",
      "email": "christophe.desmur@orange.fr",
      "telephone": ["+33472078861", "+33769941643"],
      "image": "https://ateliersdecalligraphie.com/assets/christophe-desmur-calligraphie-chinoise.webp",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lyon",
        "addressCountry": "FR"
      },
      "knowsAbout": [
        "Calligraphie chinoise",
        "Traduction littéraire du chinois",
        "Langue et civilisation chinoises",
        "Langue et civilisation coréennes"
      ],
      "hasCredential": [
        { "@type": "EducationalOccupationalCredential", "name": "Master de traduction littéraire du chinois vers le français" },
        { "@type": "EducationalOccupationalCredential", "name": "Maîtrise de langue et civilisation chinoises" },
        { "@type": "EducationalOccupationalCredential", "name": "DEUG de langue et civilisation coréennes" }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Accueil",
          "item": "https://ateliersdecalligraphie.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Découvrir",
          "item": "https://ateliersdecalligraphie.com"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Christophe Desmur",
          "item": "https://ateliersdecalligraphie.com/le-calligraphe"
        }
      ]
    }
  ])} />

  <div class="mx-auto max-w-5xl py-2">

    <!-- ================================================================= -->
    <!-- 1. REDESIGNED HERO SECTION                                        -->
    <!-- ================================================================= -->
    <header class="pb-12 sm:pb-16 border-b border-gray-100 dark:border-gray-800">
      <!-- Breadcrumb -->
      <nav aria-label="Fil d'Ariane" class="text-xs text-gray-500 dark:text-gray-400 mb-6 sm:mb-8">
        <ol class="flex items-center gap-1.5 flex-wrap">
          <li><a href="/" class="hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded">Accueil</a></li>
          <li aria-hidden="true" class="text-gray-400">/</li>
          <li><span class="text-gray-500">Découvrir</span></li>
          <li aria-hidden="true" class="text-gray-400">/</li>
          <li aria-current="page" class="text-gray-900 dark:text-gray-100 font-medium">Christophe Desmur</li>
        </ol>
      </nav>

      <!-- Editorial 2-column layout on desktop, natural stack on mobile -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left column: Text, Positioning & CTAs -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-100 dark:border-indigo-900/60 text-xs font-semibold text-indigo-800 dark:text-indigo-300 w-fit mb-4">
            <span aria-hidden="true">📍</span>
            <span>Lyon (Croix-Rousse)</span>
            <span class="text-indigo-300 dark:text-indigo-700" aria-hidden="true">•</span>
            <span>Plus de 30 ans de pratique</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-[3.25rem] font-serif font-medium tracking-tight text-gray-950 dark:text-gray-50 leading-[1.12]">
            Christophe Desmur
          </h1>

          <p class="text-xl sm:text-2xl font-serif text-indigo-700 dark:text-indigo-300 mt-2 font-normal">
            Calligraphe chinois à Lyon
          </p>

          <p class="text-base sm:text-lg text-gray-700 dark:text-gray-300 mt-5 leading-relaxed">
            Je transmets la calligraphie chinoise depuis plus de 30 ans, à travers des cours collectifs réguliers, des cours particuliers à domicile et des ateliers culturels sur mesure pour les écoles et les institutions.
          </p>

          <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400 mt-3 leading-relaxed">
            Lyonnais de naissance et titulaire d'un master de traduction littéraire du chinois vers le français, je propose une transmission vivante et bienveillante reliant le geste du pinceau, le souffle et la compréhension intime de l'écriture.
          </p>

          <!-- Action buttons -->
          <div class="mt-7 flex flex-wrap items-center gap-3.5">
            <a
              href="#services"
              class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm transition shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-indigo-500">
              Découvrir les ateliers
            </a>
            <a
              href="#contact"
              class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 dark:bg-gray-800 dark:hover:bg-gray-700 dark:text-gray-200 font-medium text-sm transition border border-gray-200 dark:border-gray-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400">
              Me contacter
            </a>
          </div>

          <!-- Quick reassuring key points -->
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-7 pt-6 border-t border-gray-100 dark:border-gray-800/80 text-xs text-gray-600 dark:text-gray-400">
            <li class="flex items-center gap-1.5">
              <span class="text-indigo-600 dark:text-indigo-400 font-bold">✓</span>
              <span>Cours réguliers au Dojo Zen (Lyon 4<sup>e</sup>)</span>
            </li>
            <li class="flex items-center gap-1.5">
              <span class="text-indigo-600 dark:text-indigo-400 font-bold">✓</span>
              <span>Cours particuliers (50&nbsp;% crédit d'impôt)</span>
            </li>
            <li class="flex items-center gap-1.5">
              <span class="text-indigo-600 dark:text-indigo-400 font-bold">✓</span>
              <span>Matériel traditionnel entièrement fourni</span>
            </li>
            <li class="flex items-center gap-1.5">
              <span class="text-indigo-600 dark:text-indigo-400 font-bold">✓</span>
              <span>Accessible aux débutants sans prérequis</span>
            </li>
          </ul>
        </div>

        <!-- Right column: Photograph with accessible caption -->
        <div class="lg:col-span-5">
          <figure class="relative mx-auto max-w-md lg:max-w-none">
            <div class="overflow-hidden rounded-2xl border border-gray-200/80 dark:border-gray-800 shadow-md bg-gray-50 dark:bg-gray-800">
              <img
                src="/assets/christophe-desmur-calligraphie-chinoise.webp"
                alt="Christophe Desmur en train de calligraphier au pinceau traditionnel et encre de Chine"
                width="800"
                height="533"
                loading="eager"
                class="w-full h-auto object-cover aspect-[4/3] sm:aspect-[3/2] lg:aspect-[4/3]"
              />
            </div>
            <figcaption class="mt-3 text-xs text-gray-500 dark:text-gray-400 italic text-center lg:text-left leading-normal">
              Christophe Desmur en pleine pratique au pinceau — transmission de la calligraphie chinoise traditionnelle à Lyon.
            </figcaption>
          </figure>
        </div>
      </div>
    </header>

    <!-- ================================================================= -->
    <!-- 2. "WHAT I OFFER" SECTION (SERVICES SCANNABLES)                    -->
    <!-- ================================================================= -->
    <section id="services" class="py-12 sm:py-16 border-b border-gray-100 dark:border-gray-800" aria-labelledby="services-title">
      <div class="max-w-2xl mb-8 sm:mb-10">
        <p class="text-xs font-semibold tracking-widest uppercase text-indigo-600 dark:text-indigo-400 mb-2">
          Formules & Prestations
        </p>
        <h2 id="services-title" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-medium text-gray-900 dark:text-gray-100">
          Découvrez la calligraphie chinoise
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mt-2 text-base leading-relaxed">
          De l'initiation individuelle aux ateliers de groupe et créations sur mesure, découvrez les formules d'enseignement et d'intervention proposées à Lyon et en région :
        </p>
      </div>

      <!-- Scannable editorial grid: not bulky cards, but elegant interactive items -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        {services.map((service) => (
          <a
            href={service.href}
            class="group p-5 sm:p-6 rounded-xl bg-gray-50/60 hover:bg-gray-100/80 dark:bg-gray-800/40 dark:hover:bg-gray-800/80 border border-gray-200/70 dark:border-gray-800 hover:border-indigo-300 dark:hover:border-indigo-700/60 transition-all duration-200 flex flex-col justify-between focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
            <div>
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="text-base sm:text-lg font-serif font-medium text-gray-900 dark:text-gray-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                  {service.title}
                </h3>
                <span class="text-gray-400 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 group-hover:translate-x-1 transition-transform text-sm shrink-0 font-sans" aria-hidden="true">
                  →
                </span>
              </div>
              <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-2 leading-relaxed">
                {service.description}
              </p>
            </div>
            {service.badge && (
              <div class="mt-4 pt-3 border-t border-gray-200/60 dark:border-gray-700/40 flex items-center text-[11px] font-medium text-indigo-700 dark:text-indigo-400">
                <span set:html={service.badge} />
              </div>
            )}
          </a>
        ))}
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 3. BIOGRAPHY / CREDENTIALS                                        -->
    <!-- ================================================================= -->
    <section class="py-12 sm:py-16 border-b border-gray-100 dark:border-gray-800" aria-labelledby="bio-title">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        
        <!-- Biography column (7 cols) -->
        <div class="lg:col-span-7">
          <p class="text-xs font-semibold tracking-widest uppercase text-indigo-600 dark:text-indigo-400 mb-2">
            Parcours & Transmission
          </p>
          <h2 id="bio-title" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-medium text-gray-900 dark:text-gray-100 mb-6">
            Une pratique entre calligraphie, langue et culture chinoises
          </h2>

          <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed text-base sm:text-[17px]">
            <p>
              Je suis calligraphe depuis plus de trente ans et m'intéresse particulièrement aux langues et civilisations asiatiques. Lyonnais de naissance, calligraphe passionné par les cultures du monde et la transmission, je vis la calligraphie comme un dialogue vivant entre concentration, respiration et tracé de l'encre.
            </p>
            <p>
              J'enseigne la calligraphie chinoise traditionnelle à Lyon sous plusieurs formes : en <a href="/cours-collectifs" class="text-indigo-600 dark:text-indigo-400 underline underline-offset-2 font-medium hover:text-indigo-800">cours collectifs hebdomadaires</a> au Dojo Zen et à la boutique Miroirs du Ciel (Croix-Rousse), en <a href="/cours-individuel-a-domicile" class="text-indigo-600 dark:text-indigo-400 underline underline-offset-2 font-medium hover:text-indigo-800">cours particuliers à domicile</a>, ainsi que lors d'<a href="/ecoles-primaires" class="text-indigo-600 dark:text-indigo-400 underline underline-offset-2 font-medium hover:text-indigo-800">ateliers scolaires</a> et d'interventions en entreprise. Je réalise également des <a href="/galerie" class="text-indigo-600 dark:text-indigo-400 underline underline-offset-2 font-medium hover:text-indigo-800">œuvres originales à l'encre de Chine</a> sur commande.
            </p>
            <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400 pt-1">
              Mon parcours universitaire et ma pratique de la traduction littéraire du chinois vers le français — notamment avec la traduction de nouvelles d'auteurs modernes comme <a href="/pere-nouvelle" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">«&nbsp;Père&nbsp;» de Lu Yin</a> ou <a href="/zeng-jixin-la-guerre-entre-les-rats-et-les-hommes-nouvelle" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">«&nbsp;La Guerre des rats&nbsp;» de Zeng Jixin</a> (voir le <a href="/traductions" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">sommaire des traductions</a>) — nourrissent un enseignement qui éclaire à la fois la forme plastique des caractères et leur sens profond.
            </p>
          </div>

          <!-- Diptyque photographique : Le geste du pinceau et l'apposition du sceau -->
          <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <figure class="rounded-2xl overflow-hidden border border-gray-200/80 dark:border-gray-800 bg-white dark:bg-gray-800/60 shadow-xs flex flex-col justify-between">
              <img
                src="/assets/christophe-desmur-calligraphie-dedicace.webp"
                alt="Christophe Desmur, calligraphe, en plein tracé de caractères au pinceau"
                width="1536"
                height="1024"
                loading="lazy"
                class="w-full h-auto object-cover aspect-[3/2]"
              />
              <figcaption class="p-3 bg-gray-50/80 dark:bg-gray-900/60 text-xs text-gray-600 dark:text-gray-400 border-t border-gray-100 dark:border-gray-800">
                Christophe Desmur, calligraphe, en plein tracé de caractères au pinceau.
              </figcaption>
            </figure>

            <figure class="rounded-2xl overflow-hidden border border-gray-200/80 dark:border-gray-800 bg-white dark:bg-gray-800/60 shadow-xs flex flex-col justify-between">
              <img
                src="/assets/christophe-desmur-apposition-sceau.webp"
                alt="Christophe Desmur, calligraphe, apposant son sceau traditionnel sur un ouvrage calligraphié"
                width="1536"
                height="1024"
                loading="lazy"
                class="w-full h-auto object-cover aspect-[3/2]"
              />
              <figcaption class="p-3 bg-gray-50/80 dark:bg-gray-900/60 text-xs text-gray-600 dark:text-gray-400 border-t border-gray-100 dark:border-gray-800">
                Christophe Desmur, calligraphe, apposant son sceau traditionnel à l'encre cinabre (<em>yinni</em>).
              </figcaption>
            </figure>
          </div>
        </div>

        <!-- Qualifications column (5 cols) : structured accessible definition list -->
        <div class="lg:col-span-5 bg-gray-50/90 dark:bg-gray-800/50 rounded-2xl p-6 sm:p-8 border border-gray-200/70 dark:border-gray-700/60">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-5">
            Formation universitaire & diplômes
          </h3>

          <dl class="space-y-5">
            <div class="pb-4 border-b border-gray-200 dark:border-gray-700/60">
              <dt class="text-xs font-semibold uppercase tracking-widest text-indigo-700 dark:text-indigo-300">
                Master
              </dt>
              <dd class="font-serif text-lg text-gray-950 dark:text-gray-100 font-medium mt-0.5">
                Traduction littéraire du chinois vers le français
              </dd>
            </div>

            <div class="pb-4 border-b border-gray-200 dark:border-gray-700/60">
              <dt class="text-xs font-semibold uppercase tracking-widest text-indigo-700 dark:text-indigo-300">
                Maîtrise
              </dt>
              <dd class="font-serif text-lg text-gray-950 dark:text-gray-100 font-medium mt-0.5">
                Langue et civilisation chinoises
              </dd>
            </div>

            <div>
              <dt class="text-xs font-semibold uppercase tracking-widest text-indigo-700 dark:text-indigo-300">
                DEUG
              </dt>
              <dd class="font-serif text-lg text-gray-950 dark:text-gray-100 font-medium mt-0.5">
                Langue et civilisation coréennes
              </dd>
            </div>
          </dl>

          <div class="mt-6 pt-5 border-t border-gray-200 dark:border-gray-700/60 text-xs text-gray-500 dark:text-gray-400 leading-relaxed flex items-start gap-2">
            <span class="text-indigo-600 dark:text-indigo-400 mt-0.5 font-bold" aria-hidden="true">ℹ</span>
            <span>Une triple formation universitaire combinant étude des langues, précision littéraire et transmission vivante des arts du pinceau.</span>
          </div>
        </div>

      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 4. ATELIERS & INTERVENTIONS (UPCOMING, RECENT & ARCHIVE)           -->
    <!-- ================================================================= -->
    <section id="ateliers" class="py-12 sm:py-16 border-b border-gray-100 dark:border-gray-800" aria-labelledby="workshops-title">
      
