  <!-- Script interactif du sélecteur d'année dans l'archive -->
  <script>
    const yearSelect = document.getElementById("archive-year-select");
    const yearSections = document.querySelectorAll(".archive-year-section");

    if (yearSelect) {
      yearSelect.addEventListener("change", (e) => {
        const target = e.target;
        const selectedYear = target ? (target as HTMLSelectElement).value : "";
        yearSections.forEach((sec) => {
          sec.classList.toggle("hidden", (sec as HTMLElement).dataset.year !== selectedYear);
        });
      });
    }
