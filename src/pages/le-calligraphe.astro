                  aria-label="Sélectionner l'année d'intervention">
                  {sortedYears.map((annee) => (
                    <option value={annee}>
                      Année {annee} ({ateliersByYear[annee].length} {ateliersByYear[annee].length > 1 ? 'événements' : 'événement'})
                    </option>
                  ))}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-500" aria-hidden="true">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </div>
              </div>
            </div>

            <!-- Year sections (all 19 years preserved!) -->
            <div id="archive-content" aria-live="polite">
              {sortedYears.map((annee, idx) => (
                <div
                  key={annee}
                  class={`archive-year-section ${idx === 0 ? '' : 'hidden'}`}
                  data-year={annee}>
                  <div class="flex items-center justify-between mb-3">
                    <h4 class="text-base font-serif font-medium text-gray-800 dark:text-gray-200">
                      Interventions en {annee}
                    </h4>
                    <span class="text-xs text-gray-500 dark:text-gray-400">
                      {ateliersByYear[annee].length} événement{ateliersByYear[annee].length > 1 ? 's' : ''}
                    </span>
                  </div>

                  <ul class="space-y-2.5">
                    {ateliersByYear[annee].map((event) => (
                      <li class="p-4 rounded-lg bg-white dark:bg-gray-800/80 border border-gray-100 dark:border-gray-700/60 text-sm">
                        <div class="flex flex-wrap items-center gap-2 mb-1">
                          <strong class="font-semibold text-gray-900 dark:text-gray-100 text-xs tracking-wider" set:html={event.displayDate} />
