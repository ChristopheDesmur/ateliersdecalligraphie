            Me contacter
          </a>
        </div>

        <!-- Direct coordinates & venues -->
        <div class="mt-8 pt-6 border-t border-gray-200/80 dark:border-gray-700/60 flex flex-wrap justify-center items-center gap-4 sm:gap-6 text-xs sm:text-sm text-gray-600 dark:text-gray-400">
          <a href="tel:+33472078861" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition inline-flex items-center gap-1.5 py-1">
            <span aria-hidden="true">📞</span> 04 72 07 88 61
          </a>
          <span class="text-gray-300 dark:text-gray-700 hidden sm:inline" aria-hidden="true">•</span>
          <a href="tel:+33769941643" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition inline-flex items-center gap-1.5 py-1">
            <span aria-hidden="true">📱</span> 07 69 94 16 43
          </a>
          <span class="text-gray-300 dark:text-gray-700 hidden sm:inline" aria-hidden="true">•</span>
          <span class="inline-flex items-center gap-1.5 py-1">
            <span aria-hidden="true">📍</span> Lyon 4<sup>e</sup> (Dojo Zen & Miroirs du Ciel)
          </span>
        </div>
      </div>
    </section>

    <RelatedPages current="/le-calligraphe" />

  </div>

  <!-- Client-side script for year filter interactivity inside archive -->
  <script>
    const yearSelect = document.getElementById("archive-year-select");
    const yearSections = document.querySelectorAll(".archive-year-section");

    if (yearSelect) {
      yearSelect.addEventListener("change", (e) => {
        const target = e.target;
        const selectedYear = target ? target.value : "";
        yearSections.forEach((sec) => {
          sec.classList.toggle("hidden", sec.dataset.year !== selectedYear);
        });
      });
    }
  </script>
</Base>
