  <!-- Script interactif du sélecteur d’année dans l’archive -->
  <script>
    function initArchiveSelect() {
      const yearSelect = document.getElementById("archive-year-select") as HTMLSelectElement | null;
      const yearSections = document.querySelectorAll<HTMLElement>(".archive-year-section");

      if (yearSelect && !yearSelect.dataset.init) {
        yearSelect.dataset.init = "true";
        yearSelect.addEventListener("change", (e) => {
          const target = e.target;
          const selectedYear = target ? (target as HTMLSelectElement).value : "";
          yearSections.forEach((sec) => {
            sec.classList.toggle("hidden", sec.dataset.year !== selectedYear);
          });
        });
      }
    }

    document.addEventListener("astro:page-load", initArchiveSelect);
  </script>
