---
import Base from "../layouts/Layout.astro";
import RelatedPages from "../components/related-pages.astro";
import EditorialLink from "@/components/editorial/EditorialLink.astro";
import { contact, telHref } from "../data/contact";
import { institutions, resolveLieu } from "../data/institutions";
import { testimonials } from "../data/testimonials";
import fs from "fs";
import yaml from "js-yaml";

// --- Single Source of Truth : Load YAML and normalize ---
const rawData = yaml.load(fs.readFileSync("./src/content/ateliers.yaml", "utf8"));
const rawAteliers = Array.isArray(rawData)
  ? rawData
  : rawData && typeof rawData === "object"
  ? Object.values(rawData).flat()
  : [];

// --- Date helpers ---
function sameDay(d1: Date, d2: Date) {
  return d1.getFullYear() === d2.getFullYear()
      && d1.getMonth() === d2.getMonth()
      && d1.getDate() === d2.getDate();
}

function formatDayFR(dayNum: number) {
  return dayNum === 1 ? "1<sup>er</sup>" : String(dayNum);
}

function formatTestimonialDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" });
}

function formatDateFR(fromStr: string, toStr?: string) {
  const from = new Date(fromStr);
  const to = toStr ? new Date(toStr) : from;

  const optionsMonthYear: Intl.DateTimeFormatOptions = { month: "long", year: "numeric" };

  const frDayFrom = formatDayFR(from.getDate());
  const frDayTo = toStr ? formatDayFR(to.getDate()) : null;

  if (sameDay(from, to)) {
    return `${frDayFrom} ${from.toLocaleDateString("fr-FR", optionsMonthYear)}`;
  } else if (from.getFullYear() === to.getFullYear() && from.getMonth() === to.getMonth()) {
    return `${frDayFrom} → ${frDayTo} ${to.toLocaleDateString("fr-FR", optionsMonthYear)}`;
  } else {
    return `${frDayFrom} ${from.toLocaleDateString("fr-FR", optionsMonthYear)} → ${frDayTo} ${to.toLocaleDateString("fr-FR", optionsMonthYear)}`;
  }
}

function formatLieuFR(lieu?: string) {
  if (!lieu) return "";
  return resolveLieu(lieu).replace(/Lyon 4e\b/g, "Lyon 4<sup>e</sup>");
}

// 1. Interventions récentes représentatives (générées dynamiquement depuis rawAteliers)
const now = new Date();
const recentInterventions = rawAteliers
  .filter((event: any) => {
    const to = event.to ? new Date(event.to) : new Date(event.from);
    return to < now;
  })
  .map((event: any) => ({
    ...event,
    displayDate: formatDateFR(event.from, event.to),
    lieu: formatLieuFR(event.lieu)
  }))
  .sort((a: any, b: any) => new Date(b.from).getTime() - new Date(a.from).getTime())
  .slice(0, 6);

// 2. Archive complète groupée par année (générée depuis la même source de données)
const ateliersByYear: Record<string, any[]> = {};
rawAteliers.forEach((event: any) => {
  const from = new Date(event.from);
  const to = event.to ? new Date(event.to) : from;
  const multiYear = from.getFullYear() !== to.getFullYear();

  for (let y = from.getFullYear(); y <= to.getFullYear(); y++) {
    const yStr = String(y);
    if (!ateliersByYear[yStr]) ateliersByYear[yStr] = [];
    const key = event.from + event.titre + event.lieu;
    if (!ateliersByYear[yStr].some((e: any) => (e.from + e.titre + e.lieu) === key)) {
      ateliersByYear[yStr].push({
        ...event,
        multiYear,
        displayDate: formatDateFR(event.from, event.to),
        lieu: formatLieuFR(event.lieu)
      });
    }
  }
});

const sortedYears = Object.keys(ateliersByYear).sort((a, b) => Number(b) - Number(a));

// --- Section unifiée « Témoignages & références » ---
// A. Témoignages authentiques attestés — voir src/data/testimonials.yaml

// B. Échos presse & événements artistiques
const pressAndEvents = [
  {
    title: "Lissieu : Christophe Desmur a présenté l’art de la calligraphie",
    media: "Le Progrès · 2010",
    description: "Initiation du public à la rigueur du tracé, au souffle et à l’esthétique des caractères chinois traditionnels lors d’une rencontre culturelle.",
    href: "https://www.leprogres.fr/rhone/2010/11/21/lissieu-christophe-desmur-un-moine-zen-a-presente-l-art-de-la-calligraphie",
    linkText: "Lire l’article"
  },
  {
    title: "Biennale de l’Écriture & Rencontres de calligraphes",
    media: "Collectif Les Mots Oiseaux",
    description: "Participation à l’exposition collective « Esperluette » réunissant calligraphes d’Orient et d’Occident (écritures arabe, latine, tibétaine et chinoise).",
    href: "https://lesmotsoiseaux.jimdofree.com/calligraphes/",
    linkText: "Voir la galerie"
  }
];

// C. Collaborations institutionnelles & éducatives
const institutionalReferences = [
  {
    institution: "Université Claude Bernard Lyon 1 (ISTIL)",
    category: "Enseignement supérieur",
    description: "Ateliers d’initiation pratique à la calligraphie chinoise et découverte de la culture écrite asiatique pour les élèves-ingénieurs.",
    href: null,
    linkText: null
  },
  {
    institution: "Écoles primaires de la Ville de Lyon",
    category: "Milieu scolaire & éducation",
    description: "Interventions pédagogiques régulières sur le temps scolaire (écoles Aveyron Lyon 4e, Jules Verne Lyon 3e...) pour éveiller les enfants au geste du pinceau.",
    href: "/ecoles-primaires",
    linkText: "Voir les ateliers scolaires"
  },
  {
    institution: "Destination Monts du Lyonnais Tourisme",
    category: "Patrimoine & événementiel régional",
    description: "Stages et ateliers d’initiation à la calligraphie tout public et intergénérationnels accueillis au Secret des Temps à Vaugneray.",
    href: "https://www.montsdulyonnaistourisme.fr/content/uploads/2026/03/vacances_paques_VF.pdf",
    linkText: "Voir la publication"
  },
  {
    institution: "SEES Champagnat (Centre pour jeunes sourds)",
    category: "Accessibilité & public spécifique",
    description: "Ateliers adaptés mettant l’accent sur la dimension visuelle, spatiale et corporelle du tracé de l’encre.",
    href: null,
    linkText: null
  }
];
---

<Base
  title="Christophe Desmur, calligraphe chinois à Lyon | Ateliers"
  description="Découvrez Christophe Desmur, calligraphe chinois à Lyon depuis plus de trente ans : enseignement de la calligraphie traditionnelle, compréhension des caractères et transmission vivante.">

  <!-- Schema.org Person & BreadcrumbList -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Christophe Desmur",
      "jobTitle": "Calligraphe chinois, enseignant et traducteur littéraire",
      "description": "Calligraphe chinois à Lyon depuis plus de 30 ans, enseignant et traducteur littéraire du chinois vers le français.",
      "url": "https://ateliersdecalligraphie.com/le-calligraphe",
      "email": contact.email,
      "telephone": [telHref(contact.mobile), telHref(contact.landline)],
      "image": "https://ateliersdecalligraphie.com/assets/christophe-desmur-calligraphie-chinoise.webp",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lyon",
        "addressCountry": "FR"
      },
      "knowsAbout": [
        "Calligraphie chinoise",
        "Calligraphie japonaise",
        "Traduction littéraire du chinois",
        "Langue et civilisation chinoises",
        "Langue et civilisation coréennes"
      ],
      "hasCredential": [
        { "@type": "EducationalOccupationalCredential", "name": "Master de traduction littéraire du chinois vers le français" },
        { "@type": "EducationalOccupationalCredential", "name": "Maîtrise de langue et civilisation chinoises" },
        { "@type": "EducationalOccupationalCredential", "name": "DEUG de langue et civilisation coréennes" }
      ],
      "sameAs": [
        "https://viadeo.journaldunet.com/p/christophe-desmur-4204512"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Accueil",
          "item": "https://ateliersdecalligraphie.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Découvrir",
          "item": "https://ateliersdecalligraphie.com"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Christophe Desmur",
          "item": "https://ateliersdecalligraphie.com/le-calligraphe"
        }
      ]
    }
  ])} />

  <div class="mx-auto max-w-5xl py-2">

    <!-- ================================================================= -->
    <!-- 1. HERO : CHRISTOPHE DESMUR, CALLIGRAPHE CHINOIS À LYON           -->
    <!-- ================================================================= -->
    <header class="pb-12 sm:pb-20">
      <!-- Breadcrumb -->
      <nav aria-label="Fil d’Ariane" class="meta text-xs mb-8">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="underline decoration-warm-grey underline-offset-4 hover:decoration-current">Accueil</a></li>
          <li aria-hidden="true" class="text-warm-grey">/</li>
          <li>Découvrir</li>
          <li aria-hidden="true" class="text-warm-grey">/</li>
          <li aria-current="page" class="text-ink">Christophe Desmur</li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Présentation concise et incarnée -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          <p class="eyebrow mb-5">
            Lyon (Croix-Rousse)
            <span class="mx-2 text-warm-grey" aria-hidden="true">·</span>
            30+ ans de pratique
          </p>

          <h1 class="display">
            Christophe Desmur, calligraphe chinois à Lyon
          </h1>

          <p class="eyebrow mt-5">
            Calligraphe, enseignant et traducteur littéraire
          </p>

          <div class="mt-8 lede italic border-l border-vermilion pl-5 text-ink">
            <p>
              « Je pratique et enseigne la calligraphie chinoise depuis plus de trente ans à Lyon. Mon travail relie l’exigence du geste traditionnel, la compréhension intime des caractères et la transmission vivante de la culture écrite asiatique. »
            </p>
          </div>
        </div>

        <!-- Photographie en pratique -->
        <div class="lg:col-span-5">
          <figure class="relative mx-auto max-w-md lg:max-w-none">
            <div class="ink-frame aspect-[4/5]">
              <img
                src="/assets/christophe-desmur-calligraphie-chinoise.webp"
                alt="Christophe Desmur en train de calligraphier au pinceau traditionnel et encre de Chine"
                width="800"
                height="533"
                loading="eager"
                class="h-full w-full object-cover"
                decoding="async" />
            </div>
            <figcaption class="meta mt-3 font-serif italic text-[0.95rem]">
              Christophe Desmur en atelier — transmission de la calligraphie traditionnelle à Lyon.
            </figcaption>
          </figure>
        </div>
      </div>
    </header>

    <!-- ================================================================= -->
    <!-- 2. UNE PRATIQUE DE PLUS DE 30 ANS                                 -->
    <!-- ================================================================= -->
    <section class="section border-t border-warm-grey" aria-labelledby="experience-title">
      <div class="max-w-3xl">
        <p class="eyebrow mb-4">
          Parcours & Ancrage
        </p>
        <h2 id="experience-title" class="h-section">
          Une pratique de plus de 30 ans
        </h2>
        <p class="mt-4 text-base sm:text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
          Christophe Desmur pratique et enseigne la calligraphie chinoise depuis plus de trente ans. Sa formation en langue et civilisation chinoises, complétée par un master en traduction littéraire du chinois vers le français, nourrit une approche qui associe maîtrise du geste, compréhension des caractères et découverte de la culture écrite chinoise.
        </p>
      </div>

      <!-- Repères factuels -->
      <dl data-reveal class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
        <div class="border-t border-warm-grey pt-5">
          <dt class="font-serif text-2xl text-ink">30+ ans</dt>
          <dd>
            <p class="eyebrow mt-2">de pratique & transmission</p>
            <p class="meta mt-2">Trois décennies d’expérience continue de l’encre, du papier de riz et de l’enseignement auprès de tous les publics.</p>
          </dd>
        </div>
        <div class="border-t border-warm-grey pt-5">
          <dt class="font-serif text-2xl text-ink">Écritures d’Asie</dt>
          <dd>
            <p class="eyebrow mt-2">Chinois · japonais · coréen</p>
            <p class="meta mt-2">Une pratique ouverte aux grandes traditions graphiques d’Asie, reliant forme visuelle, clés étymologiques et tracé.</p>
          </dd>
        </div>
        <div class="border-t border-warm-grey pt-5">
          <dt class="font-serif text-2xl text-ink">Tous publics</dt>
          <dd>
            <p class="eyebrow mt-2">Enfants · adultes · institutions</p>
            <p class="meta mt-2">Des ateliers menés en milieu scolaire, en université, dans des centres d’art, dojos, médiathèques et résidences seniors.</p>
          </dd>
        </div>
      </dl>
    </section>

    <!-- ================================================================= -->
    <!-- 3. LE GESTE, LE CARACTÈRE, LE SENS (CŒUR CONCEPTUEL)             -->
    <!-- ================================================================= -->
    <section class="section border-t border-warm-grey" aria-labelledby="approach-title">
      <div class="max-w-3xl mb-8">
        <p class="eyebrow mb-4">
          Approche & Expertise distinctive
        </p>
        <h2 id="approach-title" class="h-section">
          Le geste, le caractère, le sens
        </h2>
        <div class="mt-6 space-y-5 body-copy max-w-none">
          <p>
            Ce qui distingue la pratique et l’enseignement de Christophe Desmur, c’est l’articulation indissociable entre la maîtrise technique du pinceau, la compréhension structurelle des caractères et la profondeur culturelle des textes.
          </p>
          <p>
            Loin de réduire la calligraphie à une reproduction purement décorative, chaque trait est abordé à partir de sa logique interne : la tenue souple du manche de bambou, l’impulsion du corps et du souffle, l’équilibre des pleins et des vides, et l’énergie propre à chaque style — de la rigueur architecturale de l’écriture régulière (<em>kaishu</em>) au mouvement libre et condensé de l’écriture herbe (<em>caoshu</em>).
          </p>
          <p>
            Sa maîtrise de la langue chinoise et son activité de traducteur littéraire lui permettent d’éclairer l’étymologie des sinogrammes, la composition des clés sémantiques et la portée poétique ou philosophique des sentences calligraphiées. L’élève n’apprend pas seulement à tracer un signe : il apprend à en lire la structure, à en comprendre l’histoire et à habiter son geste.
          </p>
          <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400 pt-1">
            Cette démarche se déploie à travers des <a href="/cours-collectifs" class="underline decoration-warm-grey underline-offset-4 hover:decoration-current text-ink">cours collectifs à Lyon 4<sup>e</sup></a> au Dojo Zen et chez Miroirs du Ciel, des <a href="/cours-individuel-a-domicile" class="text-indigo-600 dark:text-indigo-400 underline underline-offset-2 hover:text-indigo-800 font-medium">cours particuliers à domicile</a>, ainsi que par la création d’<a href="/galerie" class="text-indigo-600 dark:text-indigo-400 underline underline-offset-2 hover:text-indigo-800 font-medium">œuvres originales à vendre</a>. Pour approfondir les fondements philosophiques et méditatifs du tracé, découvrez également <a href="/la-voie-du-pinceau" class="text-indigo-600 dark:text-indigo-400 underline underline-offset-2 hover:text-indigo-800 font-medium">la voie du pinceau</a> et l’esprit de la <a href="/calligraphie-zen" class="text-indigo-600 dark:text-indigo-400 underline underline-offset-2 hover:text-indigo-800 font-medium">calligraphie zen</a>.
          </p>
        </div>
      </div>

      <!-- Diptyque photographique : Le geste du pinceau et l’apposition du sceau -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-5">
        <figure data-reveal>
          <div class="ink-frame aspect-[3/2]">
          <img
            src="/assets/christophe-desmur-calligraphie-dedicace.webp"
            alt="Christophe Desmur en plein tracé de caractères au pinceau traditionnel"
            width="1536"
            height="1024"
            loading="lazy"
            class="h-full w-full object-cover"
            decoding="async" />
          </div>
          <figcaption class="meta mt-3 font-serif italic text-[0.95rem]">
            Christophe Desmur en plein tracé de caractères au pinceau traditionnel.
          </figcaption>
        </figure>

        <figure data-reveal>
          <div class="ink-frame aspect-[3/2]">
          <img
            src="/assets/christophe-desmur-apposition-sceau.webp"
            alt="Christophe Desmur apposant son sceau traditionnel sur un ouvrage calligraphié"
            width="1536"
            height="1024"
            loading="lazy"
            class="h-full w-full object-cover"
            decoding="async" />
          </div>
          <figcaption class="meta mt-3 font-serif italic text-[0.95rem]">
            Apposition du sceau traditionnel à l’encre cinabre (<em>yinni</em>) concluant l’œuvre.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 4. TÉMOIGNAGES & RÉFÉRENCES (SECTION UNIQUE FUSIONNÉE)            -->
    <!-- ================================================================= -->
    <section class="section border-t border-warm-grey" aria-labelledby="credibility-title">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow mb-4">
          Reconnaissance & Confiance
        </p>
        <h2 id="credibility-title" class="h-section">
          Témoignages & références
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mt-2 text-base leading-relaxed">
          Artistes, institutions culturelles, universités et partenaires témoignent de la qualité de la transmission et de la rigueur de son travail :
        </p>
      </div>

      <!-- 4.1 Témoignages & retours d’expérience -->
      <div class="mb-12">
        <h3 class="eyebrow eyebrow-mark mb-6">
          <span>Témoignages & retours d’expérience</span>
        </h3>

        <div class="grid grid-cols-1 border-t border-warm-grey md:grid-cols-2 md:gap-x-12">
          {testimonials.map((t) => (
            <article data-reveal class="border-b border-warm-grey py-7">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <p class="eyebrow">{t.badge}</p>
                <p class="meta text-xs">{t.source}{t.date && ` · ${formatTestimonialDate(t.date)}`}</p>
              </div>

              <blockquote class="font-serif text-xl sm:text-[1.35rem] italic leading-snug text-ink mt-4">
                «&nbsp;{t.quote}&nbsp;»
              </blockquote>

              <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  {t.photo && (
                    <img
                      src={t.photo}
                      alt=""
                      width="40"
                      height="40"
                      loading="lazy"
                      class="w-10 h-10 rounded-full object-cover shrink-0"
                    />
                  )}
                  <div class="meta">
                    <p class="text-ink">{t.author}</p>
                    <p>{t.role}</p>
                  </div>
                </div>
                {t.href && (
                  <EditorialLink href={t.href} external label={t.linkText} class="text-sm" />
                )}
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- 4.2 Dans la presse & événements artistiques -->
      <div class="mb-12">
        <h3 class="eyebrow eyebrow-mark mb-6">
          <span>Dans la presse & événements artistiques</span>
        </h3>

        <div class="grid grid-cols-1 border-t border-warm-grey md:grid-cols-2 md:gap-x-12">
          {pressAndEvents.map((item) => (
            <article data-reveal class="border-b border-warm-grey py-6">
              <p class="eyebrow">{item.media}</p>
              <h4 class="font-serif text-xl leading-snug text-ink mt-2">{item.title}</h4>
              <p class="meta mt-2">{item.description}</p>
              <div class="mt-2">
                <EditorialLink href={item.href} external label={item.linkText} class="text-sm" />
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- 4.3 Collaborations institutionnelles & éducatives -->
      <div>
        <h3 class="eyebrow eyebrow-mark mb-6">
          <span>Collaborations institutionnelles & éducatives</span>
        </h3>

        <div class="grid grid-cols-1 border-t border-warm-grey md:grid-cols-2 md:gap-x-12">
          {institutionalReferences.map((ref) => (
            <div data-reveal class="border-b border-warm-grey py-6">
              <p class="eyebrow">{ref.category}</p>
              <h4 class="font-serif text-xl leading-snug text-ink mt-2">{ref.institution}</h4>
              <p class="meta mt-2">{ref.description}</p>
              {ref.href && (
                <div class="mt-2">
                  <EditorialLink
                    href={ref.href}
                    external={ref.href.startsWith("http")}
                    label={ref.linkText}
                    class="text-sm" />
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 5. FORMATION & PARCOURS                                           -->
    <!-- ================================================================= -->
    <section class="section border-t border-warm-grey" aria-labelledby="education-title">
      <div class="max-w-3xl mb-8">
        <p class="eyebrow mb-4">
          Diplômes & Spécialisation
        </p>
        <h2 id="education-title" class="h-section">
          Formation & parcours
        </h2>
        <p class="mt-3 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          Une formation universitaire combinant étude linguistique, précision littéraire et maîtrise des cultures asiatiques :
        </p>
      </div>

      <!-- Présentation compacte et sobre des qualifications -->
      <div data-reveal class="max-w-3xl border-t border-ink/80 pt-8">
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div class="sm:border-r sm:border-warm-grey sm:pr-6">
            <dt class="eyebrow">
              Master
            </dt>
            <dd class="font-serif text-xl text-ink mt-1.5">
              Traduction littéraire
            </dd>
            <p class="meta mt-1">
              Du chinois vers le français
            </p>
          </div>

          <div class="sm:border-r sm:border-warm-grey sm:pr-6">
            <dt class="eyebrow">
              Maîtrise
            </dt>
            <dd class="font-serif text-xl text-ink mt-1.5">
              Langue et civilisation
            </dd>
            <p class="meta mt-1">
              Études chinoises
            </p>
          </div>

          <div>
            <dt class="eyebrow">
              DEUG
            </dt>
            <dd class="font-serif text-xl text-ink mt-1.5">
              Langue et civilisation
            </dd>
            <p class="meta mt-1">
              Études coréennes
            </p>
          </div>
        </dl>

        <div class="mt-8 pt-5 border-t border-warm-grey flex flex-col sm:flex-row sm:items-center justify-between gap-3 meta">
          <div>
