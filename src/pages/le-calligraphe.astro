    year: "Régulier",
    href: "/ecoles-primaires"
  },
  {
    institution: "Dojo Zen de Lyon",
    category: "Tradition martiale & méditation",
    description: "Enseignement hebdomadaire continu de la voie du pinceau (Shodo) reliant posture assise, respiration et geste calligraphique à la Croix-Rousse.",
    year: "Depuis 2010",
    href: "https://arts-martiaux-lyon.fr/calligraphie/"
  },
  {
    institution: "Destination Monts du Lyonnais Tourisme",
    category: "Patrimoine & événementiel régional",
    description: "Stages et ateliers d'initiation à la calligraphie tout public et intergénérationnels accueillis au Secret des Temps à Vaugneray.",
    year: "2024–2026",
    href: "https://www.montsdulyonnaistourisme.fr/content/uploads/2026/03/vacances_paques_VF.pdf"
  },
  {
    institution: "SEES Champagnat (Centre pour jeunes sourds)",
    category: "Accessibilité & public spécifique",
    description: "Ateliers adaptés mettant l'accent sur la dimension purement visuelle, spatiale et corporelle du tracé de l'encre.",
    year: "Public spécifique",
    href: null
  },
  {
    institution: "Biennale de l’Écriture & Les Mots Oiseaux",
    category: "Rencontres artistiques & expositions",
    description: "Participation à la Biennale de l'Écriture et aux expositions collectives réunissant calligraphes d'Orient et d'Occident (arabe, latine, tibétaine, chinoise).",
    year: "Expositions",
    href: "https://lesmotsoiseaux.jimdofree.com/calligraphes/"
  }
];

// --- Authentic testimonials & endorsements ---
const testimonials = [
  {
    quote: "Depuis 2023, je me lance en calligraphie cursive avec Christophe Desmur pour pratiquer la danse du pinceau !",
    author: "Pascale France",
    role: "Artiste peintre et formatrice en lavis traditionnel et Sumi-e",
    source: "Parcours artistique · Encre Paisible",
    href: "https://www.encrepaisible.com/parcours-artistique",
    badge: "Retour d'artiste"
  },
  {
    quote: "Christophe Desmur anime chaque vendredi matin l'atelier de calligraphie : un temps précieux d'attention, de motricité fine et de sérénité partagé avec nos adhérents seniors depuis plus de dix ans.",
    author: "OVPAR Villeurbanne",
    role: "Office villeurbannais des personnes âgées et des retraités",
    source: "Programme annuel des ateliers",
    href: "https://ovpar.fr/wp-content/uploads/2024/08/Ateliers-annuels-0VPAR.pdf",
    badge: "Partenaire régulier depuis 2012"
  },
  {
    quote: "Lissieu : Christophe Desmur a présenté l’art de la calligraphie. Une rencontre conviviale initiant le public à la rigueur et à la poésie de la voie du pinceau.",
    author: "Le Progrès",
    role: "Presse quotidienne régionale · Édition Ouest Lyonnais",
    source: "Revue de presse",
    href: "https://www.leprogres.fr/rhone/2010/11/21/lissieu-christophe-desmur-un-moine-zen-a-presente-l-art-de-la-calligraphie",
    badge: "Dans la presse"
  },
  {
    quote: "Une pratique attentive de la calligraphie guidée par la présence, la posture juste et la respiration, fidèle à l'esprit de la tradition martiale et méditative.",
    author: "Dojo Zen de Lyon",
    role: "Espace de pratique traditionnelle · Lyon 4e (Croix-Rousse)",
    source: "Cours réguliers du lundi soir",
    href: "https://arts-martiaux-lyon.fr/calligraphie/",
    badge: "Transmission & dojo"
  },
  {
    quote: "Participation aux rencontres de calligraphes d'Orient et d'Occident et aux expositions collectives réunissant les grandes traditions d'écriture du monde.",
    author: "Collectif Les Mots Oiseaux",
    role: "Biennale de l'Écriture & Festival des Arts du Récit",
    source: "Galerie des calligraphes",
    href: "https://lesmotsoiseaux.jimdofree.com/calligraphes/",
    badge: "Expositions collectives"
  }
];
---

<Base
  title="Christophe Desmur, calligraphe à Lyon | Ateliers de calligraphie"
  description="Découvrez Christophe Desmur, calligraphe à Lyon depuis plus de trente ans, enseignant et spécialiste des langues et cultures d’Asie.">

  <!-- Schema.org Person & BreadcrumbList -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Christophe Desmur",
      "jobTitle": "Calligraphe, enseignant et spécialiste des écritures d’Asie",
      "description": "Calligraphe à Lyon depuis plus de 30 ans, enseignant et traducteur littéraire du chinois, spécialiste des écritures asiatiques.",
      "url": "https://ateliersdecalligraphie.com/le-calligraphe",
      "email": "christophe.desmur@orange.fr",
      "telephone": ["+33472078861", "+33769941643"],
      "image": "https://ateliersdecalligraphie.com/assets/christophe-desmur-calligraphie-chinoise.webp",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lyon",
        "addressCountry": "FR"
      },
      "knowsAbout": [
        "Calligraphie chinoise",
        "Calligraphie japonaise",
        "Traduction littéraire du chinois",
        "Langue et civilisation chinoises",
        "Langue et civilisation coréennes"
      ],
      "hasCredential": [
        { "@type": "EducationalOccupationalCredential", "name": "Master de traduction littéraire du chinois vers le français" },
        { "@type": "EducationalOccupationalCredential", "name": "Maîtrise de langue et civilisation chinoises" },
        { "@type": "EducationalOccupationalCredential", "name": "DEUG de langue et civilisation coréennes" }
      ],
      "sameAs": [
        "https://viadeo.journaldunet.com/p/christophe-desmur-4204512"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Accueil",
          "item": "https://ateliersdecalligraphie.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Découvrir",
          "item": "https://ateliersdecalligraphie.com"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Christophe Desmur",
          "item": "https://ateliersdecalligraphie.com/le-calligraphe"
        }
      ]
    }
  ])} />

  <div class="mx-auto max-w-5xl py-2">

    <!-- ================================================================= -->
    <!-- 1. HERO : PERSONNE, PRÉSENCE & TRANSMISSION                        -->
    <!-- ================================================================= -->
    <header class="pb-12 sm:pb-16 border-b border-gray-100 dark:border-gray-800">
      <!-- Breadcrumb -->
      <nav aria-label="Fil d'Ariane" class="text-xs text-gray-500 dark:text-gray-400 mb-6 sm:mb-8">
        <ol class="flex items-center gap-1.5 flex-wrap">
          <li><a href="/" class="hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded">Accueil</a></li>
          <li aria-hidden="true" class="text-gray-400">/</li>
          <li><span class="text-gray-500">Découvrir</span></li>
          <li aria-hidden="true" class="text-gray-400">/</li>
          <li aria-current="page" class="text-gray-900 dark:text-gray-100 font-medium">Christophe Desmur</li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Colonne gauche : Présentation humaine et posture -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-100 dark:border-indigo-900/60 text-xs font-semibold text-indigo-800 dark:text-indigo-300 w-fit mb-4">
            <span aria-hidden="true">📍</span>
            <span>Lyon · Plus de 30 ans de pratique</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-[3.25rem] font-serif font-medium tracking-tight text-gray-950 dark:text-gray-50 leading-[1.12]">
            Christophe Desmur, calligraphe
          </h1>

          <p class="text-lg sm:text-xl font-serif text-indigo-700 dark:text-indigo-300 mt-3 font-normal leading-snug">
            Calligraphe, enseignant et spécialiste des cultures et écritures d’Asie
          </p>

          <div class="mt-6 space-y-4 text-base sm:text-lg text-gray-700 dark:text-gray-300 leading-relaxed font-serif italic border-l-2 border-indigo-200 dark:border-indigo-800 pl-4">
            <p>
              « Je pratique et transmets la calligraphie depuis plus de trente ans à Lyon. Loin d’une simple technique formelle ou d’un exercice académique, l’art du pinceau est pour moi une voie vivante : un dialogue entre le corps, le souffle, le papier et l’encre, où chaque trait révèle la présence et l’intention de celui qui trace. »
            </p>
          </div>

          <p class="mt-4 text-sm sm:text-base text-gray-600 dark:text-gray-400 leading-relaxed">
            Formé aux langues et civilisations d’Asie et titulaire d'un master de traduction littéraire du chinois, Christophe Desmur consacre son activité à faire rayonner la calligraphie à travers des cours réguliers, des stages d’initiation et des ateliers auprès de publics variés.
          </p>
        </div>

        <!-- Colonne droite : Photographie en pleine pratique -->
        <div class="lg:col-span-5">
          <figure class="relative mx-auto max-w-md lg:max-w-none">
            <div class="overflow-hidden rounded-2xl border border-gray-200/80 dark:border-gray-800 shadow-md bg-gray-50 dark:bg-gray-800">
              <img
                src="/assets/christophe-desmur-calligraphie-chinoise.webp"
                alt="Christophe Desmur en train de calligraphier au pinceau traditionnel et encre de Chine"
                width="800"
                height="533"
                loading="eager"
                class="w-full h-auto object-cover aspect-[4/3] sm:aspect-[3/2] lg:aspect-[4/3]"
                decoding="async" />
            </div>
            <figcaption class="mt-3 text-xs text-gray-500 dark:text-gray-400 italic text-center lg:text-left leading-normal">
              Christophe Desmur en pleine pratique au pinceau — transmission de la calligraphie traditionnelle à Lyon.
            </figcaption>
          </figure>
        </div>
      </div>
    </header>

    <!-- ================================================================= -->
    <!-- 2. NARRATION & BLOC DE CRÉDIBILITÉ (30+ ANS)                      -->
    <!-- ================================================================= -->
    <section class="py-12 sm:py-16 border-b border-gray-100 dark:border-gray-800" aria-labelledby="experience-title">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold tracking-widest uppercase text-indigo-600 dark:text-indigo-400 mb-2">
          Approche & Parcours
        </p>
        <h2 id="experience-title" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-medium text-gray-900 dark:text-gray-100">
          Une pratique de plus de trente ans
        </h2>
        <p class="mt-4 text-base sm:text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
          Installé à Lyon, Christophe Desmur dédie son quotidien à l’étude, à la création et à la transmission des écritures traditionnelles d’Asie. De la rigueur géométrique du tracé régulier (<em>kaishu</em>) à la liberté expressive de l’écriture herbe (<em>caoshu</em>), son travail s’enracine dans une discipline constante et une fidélité aux maîtres classiques, tout en restant accessible à quiconque désire aborder le papier et l’encre.
        </p>
      </div>

      <!-- Evidence block : 3 piliers factuels incontestables -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="p-6 rounded-2xl bg-gray-50/80 dark:bg-gray-800/50 border border-gray-200/70 dark:border-gray-700/60">
          <span class="text-2xl sm:text-3xl font-serif font-semibold text-indigo-700 dark:text-indigo-400 block mb-1">
            30+ ans
          </span>
          <h3 class="font-serif text-base font-medium text-gray-900 dark:text-gray-100 mb-1.5">
            de pratique de la calligraphie
          </h3>
          <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
            Trois décennies d’immersion ininterrompue dans l’art du trait, la maîtrise de l’encre et la recherche calligraphique.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-gray-50/80 dark:bg-gray-800/50 border border-gray-200/70 dark:border-gray-700/60">
          <span class="text-2xl sm:text-3xl font-serif font-semibold text-indigo-700 dark:text-indigo-400 block mb-1">
            Écritures d’Asie
          </span>
          <h3 class="font-serif text-base font-medium text-gray-900 dark:text-gray-100 mb-1.5">
            Chinois · japonais · coréen
          </h3>
          <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
            Une pratique approfondie des sinogrammes, des kanjis et des écritures asiatiques, reliant étymologie, sens et geste.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-gray-50/80 dark:bg-gray-800/50 border border-gray-200/70 dark:border-gray-700/60">
          <span class="text-2xl sm:text-3xl font-serif font-semibold text-indigo-700 dark:text-indigo-400 block mb-1">
            Tous publics
          </span>
          <h3 class="font-serif text-base font-medium text-gray-900 dark:text-gray-100 mb-1.5">
            Enfants · adultes · institutions
          </h3>
          <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
            Des ateliers menés dans les écoles primaires, universités, centres d’art, dojos, médiathèques et résidences seniors.
          </p>
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 3. TÉMOIGNAGES & ÉCHOS D'EXPÉRIENCE (SECTION MAJEURE)             -->
    <!-- ================================================================= -->
    <section class="py-12 sm:py-16 border-b border-gray-100 dark:border-gray-800" aria-labelledby="testimonials-title">
      <div class="max-w-2xl mb-8 sm:mb-10">
        <p class="text-xs font-semibold tracking-widest uppercase text-indigo-600 dark:text-indigo-400 mb-2">
          Retours & Échos
        </p>
        <h2 id="testimonials-title" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-medium text-gray-900 dark:text-gray-100">
          Ils parlent de leur expérience
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mt-2 text-base leading-relaxed">
          Témoignages d’artistes, retours de partenaires culturels et échos institutionnels accompagnés au fil des années :
        </p>
      </div>

      <!-- Grille éditoriale aérée de témoignages authentiques -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {testimonials.map((t) => (
          <article class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-gray-800/80 border border-gray-200/80 dark:border-gray-700/70 shadow-2xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-indigo-700 dark:text-indigo-300 font-sans">
                  {t.badge}
                </span>
                <span class="text-[11px] text-gray-400 dark:text-gray-500 font-sans">
                  {t.source}
                </span>
              </div>

              <blockquote class="font-serif text-base sm:text-lg text-gray-950 dark:text-gray-100 leading-snug italic">
                « {t.quote} »
              </blockquote>
            </div>

            <div class="mt-5 pt-4 border-t border-gray-100 dark:border-gray-700/60 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 text-xs">
              <div>
                <p class="font-medium text-gray-900 dark:text-gray-100">
                  {t.author}
                </p>
                <p class="text-gray-500 dark:text-gray-400 text-[11px]">
                  {t.role}
                </p>
              </div>
              {t.href && (
                <a
                  href={t.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 font-medium text-indigo-700 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 transition-colors shrink-0">
                  <span>En savoir plus</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 4. UNE PRATIQUE NOURRIE PAR LES LANGUES ET CULTURES D'ASIE        -->
    <!-- ================================================================= -->
    <section class="py-12 sm:py-16 border-b border-gray-100 dark:border-gray-800" aria-labelledby="languages-title">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7">
          <p class="text-xs font-semibold tracking-widest uppercase text-indigo-600 dark:text-indigo-400 mb-2">
            Ancrage & Savoirs
          </p>
          <h2 id="languages-title" class="text-2xl sm:text-3xl lg:text-4xl font-serif font-medium text-gray-900 dark:text-gray-100 mb-5">
            Une pratique nourrie par les langues et les cultures d’Asie
          </h2>

          <div class="space-y-4 text-base sm:text-[17px] text-gray-700 dark:text-gray-300 leading-relaxed">
            <p>
              Sa pratique de la calligraphie s’accompagne d’un travail approfondi sur les langues et les civilisations d’Asie. Ses études en coréen et en chinois, ainsi que sa formation en traduction littéraire, nourrissent son approche de l’écriture, du sens et du geste.
            </p>
            <p>
              Loin de dissocier la grâce graphique du caractère de sa portée philosophique, Christophe Desmur éclaire l’étymologie des sinogrammes, la symbolique des clés et l’histoire des textes classiques abordés en séance.
            </p>
            <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400">
              Cette sensibilité aux subtilités de la langue s’exprime également dans son travail de traducteur d’œuvres littéraires modernes du chinois vers le français, telles que <a href="/pere-nouvelle" class="text-indigo-600 dark:text-indigo-400 underline underline-offset-2 hover:text-indigo-800">« Père » de Lu Yin</a> ou <a href="/zeng-jixin-la-guerre-entre-les-rats-et-les-hommes-nouvelle" class="text-indigo-600 dark:text-indigo-400 underline underline-offset-2 hover:text-indigo-800">« La Guerre des rats » de Zeng Jixin</a> (retrouvez l’ensemble sur le <a href="/traductions" class="text-indigo-600 dark:text-indigo-400 underline underline-offset-2 hover:text-indigo-800">sommaire des traductions</a>).
            </p>
          </div>
        </div>

