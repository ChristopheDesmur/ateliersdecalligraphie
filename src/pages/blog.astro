---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

const dedicatedSlugs = new Set([
  "formats-atelier-pour-les-lycees",
  "universites-et-grandes-ecoles",
  "atelier-de-groupe",
  "traductions",
  "cours-de-chinois",
  "cours-individuel-a-domicile",
  "shodo-voie-pinceau",
  "calligraphie-zen",
]);

// Filter blog entries with 'draft: false' & date before current date, excluding dedicated landing pages
const publishedBlogEntries = await getCollection("blog", (entry) => {
  const slug = entry.slug.replace(/^blog\//, "");
  return !entry.data.draft && entry.data.publishDate < new Date() && !dedicatedSlugs.has(slug);
});

// Sort content entries by publication date
publishedBlogEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});
---

<Layout title="Articles & Traductions littéraires" description="Articles sur la calligraphie chinoise : histoire, techniques, traductions littéraires et écrits de Christophe Desmur, calligraphe à Lyon.">
  <Container>
    <nav aria-label="Fil d’Ariane" class="text-xs text-gray-500 dark:text-gray-400 mb-6">
      <ol class="flex items-center gap-1.5 flex-wrap">
        <li><a href="/" class="underline decoration-warm-grey underline-offset-4 hover:decoration-current">Accueil</a></li>
        <li aria-hidden="true" class="text-warm-grey">/</li>
        <li aria-current="page" class="text-ink">Articles &amp; Traductions</li>
      </ol>
    </nav>

    <Sectionhead>
      <Fragment slot="title">Articles & Traductions</Fragment>
      <Fragment slot="desc">
        Calligraphie chinoise, philosophie du geste, traductions d’auteurs chinois (Lu Yin, Zeng Jixin) et écrits par Christophe Desmur.
      </Fragment>
    </Sectionhead>
    <section class="mt-14">
      <ul class="grid max-w-4xl border-t border-warm-grey">
        {
          publishedBlogEntries.map((blogPostEntry, index) => (
            <li class="border-b border-warm-grey">
              <a href={`/${blogPostEntry.slug}`} class="group block py-8">
                <div class="grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-5 md:gap-10 items-center">
                  <div class="ink-frame aspect-[4/3] w-full">
                    <Picture
                      src={blogPostEntry.data.image.src}
                      alt={blogPostEntry.data.image.alt}
                      sizes="(max-width: 800px) 100vw, 800px"
                      width={800}
                      height={600}
                      loading={index <= 2 ? "eager" : "lazy"}
                      decoding={index <= 2 ? "sync" : "async"}
                      class="h-full w-full object-cover object-center"
                    />
                  </div>
                  <div>
                    <span class="eyebrow">
                      {blogPostEntry.data.category}
                    </span>

                    <h2 class="font-serif text-2xl sm:text-3xl font-medium leading-snug text-ink mt-2 group-hover:text-soft-ink transition-colors">
                      {blogPostEntry.data.title}
                    </h2>

                    <div class="meta flex flex-wrap gap-2 mt-3">
                      <span>
                        {blogPostEntry.data.author}
                      </span>
                      <span class="text-warm-grey" aria-hidden="true">·</span>
                      <time
                        datetime={blogPostEntry.data.publishDate.toISOString()}>
                        {blogPostEntry.data.publishDate.toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" })}
                      </time>
                    </div>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</Layout>
