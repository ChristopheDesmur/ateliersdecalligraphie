---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Page introuvable (404)"
  description="La page que vous recherchez n'existe pas ou a été déplacée. Retrouvez les cours et ateliers de calligraphie chinoise à Lyon.">
  <Container>
    <div class="min-h-[60vh] flex items-center justify-center py-16">
      <div class="text-center max-w-lg mx-auto">
        <span class="text-5xl sm:text-6xl font-serif text-indigo-600 dark:text-indigo-400">404</span>
        <h1 class="text-2xl sm:text-3xl font-bold mt-4 text-gray-900 dark:text-gray-100">
          Page introuvable
        </h1>
        <p class="text-base text-gray-600 dark:text-gray-300 mt-3 leading-relaxed">
          Le document ou la page que vous recherchez n'existe pas ou a été réorganisé(e).
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm">
          <a
            href="/"
            class="px-5 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium transition shadow-xs">
            Retour à l'accueil
          </a>
          <a
            href="/cours-collectifs"
            class="px-4 py-2.5 rounded-lg bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 font-medium transition">
            Cours collectifs à Lyon
          </a>
          <a
            href="/tarifs"
            class="px-4 py-2.5 rounded-lg bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 font-medium transition">
            Consulter les tarifs
          </a>
        </div>
      </div>
    </div>
  </Container>
</Layout>
